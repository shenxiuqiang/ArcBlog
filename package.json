{
  "name": "arcblog",
  "version": "0.3.7",
  "description": "A DID-native, Markdown-first publishing Blocklet on the Arc/AUP stack — no bundler, no dev server, no runtime dependencies in the app itself.",
  "license": "Apache-2.0",
  "author": {
    "name": "shenxiuqiang",
    "url": "https://github.com/shenxiuqiang"
  },
  "homepage": "https://github.com/shenxiuqiang/ArcBlog",
  "repository": {
    "type": "git",
    "url": "https://github.com/shenxiuqiang/ArcBlog.git"
  },
  "bugs": {
    "url": "https://github.com/shenxiuqiang/ArcBlog/issues"
  },
  "keywords": [
    "blocklet",
    "did",
    "blog",
    "markdown",
    "publishing",
    "afs",
    "aup",
    "self-hosted"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.mjs fast",
    "test:clean": "node scripts/arcblog-clean.mjs --confirm",
    "test:unit": "node scripts/run-tests.mjs fast",
    "test:live": "node scripts/run-tests.mjs live",
    "test:all": "node scripts/run-tests.mjs all",
    "test:file": "node --test --test-concurrency=1",
    "gate:docs": "node scripts/arcblog-doc-gates.mjs",
    "scrub:dist-secrets": "node scripts/arcblog-dist-secrets.mjs",
    "verify:artifacts": "node scripts/arcblog-dist-secrets.mjs --check && node scripts/arcblog-dist-secrets.mjs --check --pages",
    "build": "arc blocklet build && npm run scrub:dist-secrets"
  },
  "dependencies": {
    "@arcblock/did-ext": "^1.30.24",
    "@arcblock/did-util": "1.30.24",
    "@ocap/client": "^1.30.24",
    "@ocap/wallet": "^1.30.24",
    "bip39": "^3.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
