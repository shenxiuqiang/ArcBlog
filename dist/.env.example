

# Real chain (`--adapter ocap`). Copy to .env.local (gitignored) and fill in.
# beta = ABT Network test chain. The mnemonic is the factory-owner wallet; it must
# never be committed. ABT on beta: z35n6UoHSi9MED4uaQy6ozFgKPaZj2UKrurBG
# ARCBLOG_CHAIN_ADAPTER=ocap
# ARCBLOG_CHAIN_HOST=https://beta.abtnetwork.io/api/
# ARCBLOG_CHAIN_ID=beta
# ARCBLOG_CHAIN_NETWORK=beta
# ARCBLOG_CHAIN_TOKEN_ID=z35n6UoHSi9MED4uaQy6ozFgKPaZj2UKrurBG
# ARCBLOG_CHAIN_MNEMONIC='twelve words ...'
# Region bound into the node NFT when the acquire dialog does not send one
# ARCBLOG_NODE_REGION=CN-BJ
# Public key file the chain worker binds into the NFT (§67); never a private key
# ARCBLOG_NODE_PK_FILE=/path/to/node-pk.pem
