{
  "id": "arcblog-about-view-1",
  "type": "view",
  "props": {
    "layout": {
      "gap": "lg"
    }
  },
  "children": [
    {
      "id": "arcblog-about-view-1-card-1",
      "type": "view",
      "props": {
        "mode": "card",
        "layout": {
          "gap": "md"
        }
      },
      "children": [
        {
          "id": "arcblog-about-view-1-card-1-h2-1",
          "type": "text",
          "props": {
            "level": 2,
            "content": "$t(about.title)"
          }
        },
        {
          "id": "arcblog-about-view-1-card-1-p-2",
          "type": "text",
          "props": {
            "content": "$t(about.desc)"
          }
        }
      ]
    },
    {
      "id": "arcblog-about-view-1-card-2",
      "type": "view",
      "props": {
        "mode": "card",
        "layout": {
          "gap": "md"
        }
      },
      "children": [
        {
          "id": "arcblog-about-view-1-card-2-h3-1",
          "type": "text",
          "props": {
            "level": 3,
            "content": "$t(about.lifecycle)"
          }
        },
        {
          "id": "arcblog-about-view-1-card-2-p-2",
          "type": "text",
          "props": {
            "content": "$t(about.lifecycle-desc)",
            "intent": "muted"
          }
        }
      ]
    },
    {
      "id": "arcblog-about-view-1-action-3",
      "type": "action",
      "props": {
        "variant": "secondary",
        "label": "$t(about.rss)"
      },
      "events": {
        "click": {
          "navigate": "/rss.xml"
        }
      }
    }
  ]
}
