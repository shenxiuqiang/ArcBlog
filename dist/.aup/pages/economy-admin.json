{
  "id": "arcblog-economy-admin",
  "type": "view",
  "props": {
    "layout": {
      "gap": "lg"
    },
    "size": {
      "maxWidth": "lg"
    }
  },
  "children": [
    {
      "id": "arcblog-economy-admin-card-1",
      "type": "view",
      "props": {
        "mode": "card",
        "layout": {
          "gap": "md"
        }
      },
      "visible": "!$session.authenticated",
      "children": [
        {
          "id": "arcblog-economy-admin-card-1-h2-1",
          "type": "text",
          "props": {
            "level": 2,
            "content": "$t(economy-admin.gate-title)"
          }
        },
        {
          "id": "arcblog-economy-admin-card-1-p-2",
          "type": "text",
          "props": {
            "content": "$t(economy-admin.gate-desc)",
            "intent": "info"
          }
        },
        {
          "id": "arcblog-economy-admin-card-1-action-3",
          "type": "action",
          "props": {
            "variant": "primary",
            "label": "$t(economy-admin.login)"
          },
          "events": {
            "click": {
              "navigate": "/.well-known/service/login?return_to=%2F%3Fpage%3Deconomy-admin&cancel_to=%2F%3Fpage%3Deconomy-admin"
            }
          }
        }
      ]
    },
    {
      "id": "console-shell",
      "type": "view",
      "props": {
        "layout": {
          "direction": "row",
          "gap": "lg",
          "crossAlign": "start"
        }
      },
      "children": [
        {
          "id": "console-nav",
          "type": "view",
          "props": {
            "layout": {
              "gap": "xs"
            },
            "size": {
              "width": "200px",
              "flexShrink": 0
            },
            "style": {
              "padding": "14px",
              "border": "1px solid var(--color-border)",
              "borderRadius": "var(--radius-lg, 12px)",
              "background": "var(--color-surface)"
            }
          },
          "visible": "$session.authenticated",
          "children": [
            {
              "id": "console-nav-p-1",
              "type": "text",
              "props": {
                "content": "$t(wrapper.nav-group-content)",
                "intent": "muted",
                "scale": "caption"
              }
            },
            {
              "id": "console-nav-dashboard",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-dashboard)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "dashboard"
                  }
                }
              }
            },
            {
              "id": "console-nav-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-studio)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "admin"
                  }
                }
              }
            },
            {
              "id": "console-nav-heroes-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-heroes)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "heroes-admin"
                  }
                }
              }
            },
            {
              "id": "console-nav-p-5",
              "type": "text",
              "props": {
                "content": "$t(wrapper.nav-group-ops)",
                "intent": "muted",
                "scale": "caption"
              }
            },
            {
              "id": "console-nav-operations",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-operations)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "operations"
                  }
                }
              }
            },
            {
              "id": "console-nav-ops-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-media-agents)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "ops-admin"
                  }
                }
              }
            },
            {
              "id": "console-nav-p-8",
              "type": "text",
              "props": {
                "content": "$t(wrapper.nav-group-economy)",
                "intent": "muted",
                "scale": "caption"
              }
            },
            {
              "id": "console-nav-economy-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-policy-grants)",
                "variant": "primary"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "economy-admin"
                  }
                }
              }
            }
          ]
        },
        {
          "id": "console-pane",
          "type": "view",
          "props": {
            "layout": {
              "gap": "lg"
            },
            "size": {
              "flex": 1
            }
          },
          "children": [
            {
              "id": "console-pane-view-1",
              "type": "view",
              "props": {
                "layout": {
                  "gap": "lg"
                }
              },
              "visible": "$session.authenticated",
              "children": [
                {
                  "id": "console-pane-view-1-card-1",
                  "type": "view",
                  "props": {
                    "mode": "card",
                    "layout": {
                      "gap": "md"
                    }
                  },
                  "children": [
                    {
                      "id": "console-pane-view-1-card-1-h1-1",
                      "type": "text",
                      "props": {
                        "level": 1,
                        "content": "$t(economy-admin.title)"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-1-p-2",
                      "type": "text",
                      "props": {
                        "content": "$t(economy-admin.desc)",
                        "intent": "muted"
                      }
                    }
                  ]
                },
                {
                  "id": "console-pane-view-1-card-2",
                  "type": "view",
                  "props": {
                    "mode": "card",
                    "layout": {
                      "gap": "md"
                    }
                  },
                  "propBind": {
                    "policy": "/instance/app/arcblog/economy/policies/active.json"
                  },
                  "children": [
                    {
                      "id": "console-pane-view-1-card-2-h2-1",
                      "type": "text",
                      "props": {
                        "level": 2,
                        "content": "$t(economy-admin.policy)"
                      }
                    },
                    {
                      "id": "opsPolicyRow",
                      "type": "view",
                      "props": {
                        "layout": {
                          "direction": "row",
                          "gap": "xs"
                        }
                      },
                      "children": [
                        {
                          "id": "opspolicyrow-p-1",
                          "type": "text",
                          "props": {
                            "content": "$t(economy-admin.policy-split)",
                            "scale": "sm",
                            "intent": "muted"
                          }
                        },
                        {
                          "id": "opspolicyrow-p-2",
                          "type": "text",
                          "props": {
                            "content": "${state.policy.creator} / ${state.policy.hub} / ${state.policy.protocol}",
                            "scale": "sm"
                          }
                        },
                        {
                          "id": "opspolicyrow-p-3",
                          "type": "text",
                          "props": {
                            "content": "$t(economy-admin.policy-adapter)",
                            "scale": "sm",
                            "intent": "muted"
                          }
                        },
                        {
                          "id": "opspolicyrow-p-4",
                          "type": "text",
                          "props": {
                            "content": "${state.policy.paymentAdapter}",
                            "scale": "sm"
                          }
                        }
                      ]
                    },
                    {
                      "id": "console-pane-view-1-card-2-p-3",
                      "type": "text",
                      "props": {
                        "content": "$t(economy-admin.policy-empty)",
                        "scale": "sm",
                        "intent": "muted"
                      }
                    }
                  ]
                },
                {
                  "id": "console-pane-view-1-card-3",
                  "type": "view",
                  "props": {
                    "mode": "card",
                    "layout": {
                      "gap": "md"
                    }
                  },
                  "children": [
                    {
                      "id": "console-pane-view-1-card-3-h2-1",
                      "type": "text",
                      "props": {
                        "level": 2,
                        "content": "$t(economy-admin.products)"
                      }
                    },
                    {
                      "id": "ops-products",
                      "type": "afs-list",
                      "props": {
                        "layout": "list",
                        "itemStyle": "row",
                        "subscribe": true,
                        "showBreadcrumb": false,
                        "showParent": false,
                        "clickMode": "none",
                        "emptyText": "$t(economy-admin.products-empty)"
                      },
                      "src": "/instance/app/arcblog/economy/products",
                      "children": [
                        {
                          "id": "opsProductRow",
                          "type": "view",
                          "props": {
                            "layout": {
                              "direction": "row",
                              "gap": "xs"
                            },
                            "role": "item"
                          },
                          "children": [
                            {
                              "id": "opsproductrow-h3-1",
                              "type": "text",
                              "props": {
                                "level": 3,
                                "content": "${entry.content.id}"
                              }
                            },
                            {
                              "id": "opsproductrow-p-2",
                              "type": "text",
                              "props": {
                                "content": "$t(economy-admin.product-price)",
                                "scale": "sm",
                                "intent": "muted"
                              }
                            },
                            {
                              "id": "opsproductrow-p-3",
                              "type": "text",
                              "props": {
                                "content": "${entry.content.priceAmount}",
                                "scale": "sm"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "console-pane-view-1-card-3-p-3",
                      "type": "text",
                      "props": {
                        "content": "$t(economy-admin.products-empty)",
                        "scale": "sm",
                        "intent": "muted"
                      }
                    }
                  ]
                },
                {
                  "id": "console-pane-view-1-card-4",
                  "type": "view",
                  "props": {
                    "mode": "card",
                    "layout": {
                      "gap": "md"
                    }
                  },
                  "children": [
                    {
                      "id": "console-pane-view-1-card-4-h2-1",
                      "type": "text",
                      "props": {
                        "level": 2,
                        "content": "$t(economy-admin.grants)"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-4-p-2",
                      "type": "text",
                      "props": {
                        "content": "$t(economy-admin.admin-only)",
                        "scale": "sm",
                        "intent": "muted"
                      },
                      "visible": "!$session.authenticated"
                    },
                    {
                      "id": "ops-grants-gate",
                      "type": "view",
                      "visible": "$session.authenticated",
                      "children": [
                        {
                          "id": "ops-grants",
                          "type": "afs-list",
                          "props": {
                            "layout": "list",
                            "itemStyle": "row",
                            "subscribe": true,
                            "showBreadcrumb": false,
                            "showParent": false,
                            "clickMode": "none",
                            "emptyText": "$t(economy-admin.grants-empty)"
                          },
                          "src": "/instance/app/arcblog/economy/access-grants",
                          "children": [
                            {
                              "id": "opsGrantRow",
                              "type": "view",
                              "props": {
                                "layout": {
                                  "direction": "row",
                                  "gap": "xs"
                                },
                                "role": "item"
                              },
                              "children": [
                                {
                                  "id": "opsgrantrow-p-1",
                                  "type": "text",
                                  "props": {
                                    "content": "${entry.content.contentId}",
                                    "scale": "sm"
                                  }
                                },
                                {
                                  "id": "opsgrantrow-p-2",
                                  "type": "text",
                                  "props": {
                                    "content": "$t(economy-admin.grant-reader)",
                                    "scale": "sm",
                                    "intent": "muted"
                                  }
                                },
                                {
                                  "id": "opsgrantrow-p-3",
                                  "type": "text",
                                  "props": {
                                    "content": "${entry.content.readerDid}",
                                    "scale": "sm"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "console-pane-view-1-card-4-p-4",
                      "type": "text",
                      "props": {
                        "content": "$t(economy-admin.grants-empty)",
                        "scale": "sm",
                        "intent": "muted"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
