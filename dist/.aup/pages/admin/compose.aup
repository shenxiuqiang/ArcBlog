page compose {
  i18n {
    category { en "Category" zh "分类" }
    checks { en "Pre-publish checks" zh "发布前检查" }
    checks-desc { en "Title and slug are required. Publishing is immediately public; drafts stay private until published. Saving an existing slug overwrites that record." zh "标题和 slug 必填。发布即公开；草稿在发布前保持私有。相同 slug 会覆盖已有记录。" }
    cover-hint { en "Shown as the card cover in the story list and at the top of the article. Upload via the Images panel below, then paste the URL here." zh "展示在文章列表的卡片封面和正文顶部。可先在下方图片面板上传，再把 URL 粘贴到这里。" }
    draft-saved { en "Draft saved — preview it from the studio." zh "草稿已保存——可在工作室预览。" }
    f-body { en "Body (Markdown)" zh "正文（Markdown）" }
    f-cover { en "Cover image URL" zh "封面图 URL" }
    f-slug { en "Slug" zh "Slug" }
    f-summary { en "Summary" zh "摘要" }
    f-title { en "Title" zh "标题" }
    gate-desc { en "Sign in with DID Wallet to unlock the editor. Drafts stay in the private drafts directory until published." zh "使用 DID Wallet 登录以解锁编辑器。草稿保存在私有草稿目录中，直到发布。" }
    gate-title { en "Publish with your wallet" zh "用钱包发布" }
    images { en "Images" zh "图片" }
    images-desc { en "Drop a cover or inline image here. Media is stored in the site file space; paste the resulting URL into Markdown: ![Alt text](URL)." zh "将封面或正文插图拖到这里。媒体文件保存在站点文件空间中；把生成的 URL 粘贴进 Markdown：![Alt text](URL)。" }
    login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
    meta { en "Metadata" zh "元数据" }
    publish-now { en "Publish" zh "发布" }
    published-ok { en "Published." zh "已发布。" }
    save-draft { en "Save draft" zh "存草稿" }
    seo { en "SEO & social preview" zh "SEO 与社交分享预览" }
    seo-desc { en "Optional: set seo title/description and OG title/description/image. Defaults fall back to post title, summary, and cover image." zh "可选：设置 SEO 标题/描述与 OG 标题/描述/图片。默认回退到文章标题、摘要和封面图。" }
    slug-hint { en "Lowercase letters, numbers and dashes; used in the URL /posts/<slug>." zh "小写字母、数字和连字符；用于 URL /posts/<slug>。" }
    tags { en "Tags" zh "标签" }
  }
  view page-root gap=lg style={height: "100vh", overflow: visible} {
    view style={gap: "0"} {
      view style={width: "100vw", marginLeft: "calc(50% - 50vw)"} {
        app-header site-header variant=compact brand={title: ArcBlog, src: index} actions=[{kind: theme-toggle, icon: sun, ariaLabel: "$t(wrapper.theme-label)"}, {kind: locale-switcher, locales: [en, zh], labels: {en: EN, zh: "中文"}}, {kind: user-menu, items: [{id: console, label: "$t(wrapper.nav-console)", icon: grid, exec: dashboard}]}] events={user-menu-item: {target: _root, set: {page: $args.exec}}, nav-click: {target: _root, set: {page: $args.src}}}
      }
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "20px"} visible="!$session.authenticated" {
        h2 :gate-title level=2 style={fontSize: "var(--type-body)"}
        p :gate-desc intent=info
        action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dcompose&cancel_to=%2F%3Fpage%3Dcompose" variant=primary label=:login style={borderRadius: "var(--radius-md, 8px)"}
      }
      row gap=lg cross=stretch style={width: "100vw", marginLeft: "calc(50% - 50vw)", height: "calc(100vh - 48px)", marginBottom: "-52px", padding: "0 32px 0 0"} visible=$session.authenticated {
        view console-nav size={width: "clamp(200px, 15vw, 280px)", flexShrink: 0, height: "100%"} style={padding: "0", background: "var(--color-surface)", borderRight: "1px solid var(--color-border)", overflowY: auto, gap: "0", height: "100%"} visible=$session.authenticated {
          p "$t(wrapper.nav-group-content)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action console-nav-dashboard "$t(wrapper.nav-dashboard)" -> page dashboard style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view console-nav-divider-posts style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action console-nav-posts "$t(wrapper.nav-studio)" -> page posts style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view console-nav-divider-pages style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action console-nav-pages "$t(wrapper.nav-pages)" -> page pages style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view console-nav-divider-compose style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action console-nav-compose "$t(wrapper.nav-write)" -> page compose active=true style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view console-nav-divider-nav-group-site-group style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-site)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action console-nav-heroes "$t(wrapper.nav-heroes)" -> page heroes style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view console-nav-divider-categories style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action console-nav-categories "$t(wrapper.nav-categories)" -> page categories style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view console-nav-divider-seo style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action console-nav-seo "$t(wrapper.nav-seo)" -> page seo style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view console-nav-divider-feeds style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action console-nav-feeds "$t(wrapper.nav-feeds)" -> page feeds style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view console-nav-divider-appearance style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action console-nav-appearance "$t(wrapper.nav-appearance)" -> page appearance style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view console-nav-divider-nav-group-ops-group style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-ops)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action console-nav-operations "$t(wrapper.nav-operations)" -> page operations style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view console-nav-divider-hub style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action console-nav-hub "$t(wrapper.nav-hub)" -> page hub style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view console-nav-divider-media style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action console-nav-media "$t(wrapper.nav-media)" -> page media style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view console-nav-divider-agents style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action console-nav-agents "$t(wrapper.nav-agents)" -> page agents style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view console-nav-divider-nav-group-economy-group style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-economy)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action console-nav-policy "$t(wrapper.nav-policy)" -> page policy style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view console-nav-divider-access style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action console-nav-access "$t(wrapper.nav-access)" -> page access style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
        }
        view gap=md size={flex: 1} style={paddingTop: "14px", paddingBottom: "14px", minHeight: 0} {
          view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
            h3 :checks level=3
            p :checks-desc intent=muted
          }
          view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
            h3 :meta level=3
            input type=text label=:f-title name=title required=true state={value: ""}
            input type=text label=:f-slug name=slug required=true state={value: ""}
            p :slug-hint intent=muted scale=caption
            input type=select label=:category name=category options=[technology, design, life] state={value: technology}
            input type=text label=:tags name=tags state={value: ""}
            input type=text label=:f-summary name=summary state={value: ""}
            input type=text label=:f-cover name=coverImage state={value: ""}
            p :cover-hint intent=muted scale=caption
          }
          view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
            h3 :seo level=3
            p :seo-desc intent=muted
            input type=text label="SEO Title" name=seoTitle state={value: ""}
            input type=text label="SEO Description" name=seoDescription state={value: ""}
            input type=text label="OG Title" name=ogTitle state={value: ""}
            input type=text label="OG Description" name=ogDescription state={value: ""}
            input type=text label="OG Image" name=ogImage state={value: ""}
          }
          view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
            input type=textarea label=:f-body name=body required=true state={value: ""}
          }
          row gap=sm {
            action variant=secondary label=:save-draft onSuccessToast={intent: success, message: "$t(compose.draft-saved)", duration: 3000} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/drafts/${args.slug}.json", content: {title: "${args.title}", slug: "${args.slug}", summary: "${args.summary}", body: "${args.body}", coverImage: "${args.coverImage}", images: [], tags: "${args.tags}", category: "${args.category}", seoTitle: "${args.seoTitle}", seoDescription: "${args.seoDescription}", ogTitle: "${args.ogTitle}", ogDescription: "${args.ogDescription}", ogImage: "${args.ogImage}", status: draft, authorDid: $session.did, authorName: $session.displayName, published: false, publishedAt: "", archivedAt: "", deletedAt: "", createdAt: "${generate.timeiso}", updatedAt: "${generate.timeiso}", version: 1}}}}
            action variant=primary label=:publish-now onSuccessToast={intent: success, message: "$t(compose.published-ok)", duration: 3000} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/posts/${args.slug}.json", content: {title: "${args.title}", slug: "${args.slug}", summary: "${args.summary}", body: "${args.body}", coverImage: "${args.coverImage}", images: [], tags: "${args.tags}", category: "${args.category}", seoTitle: "${args.seoTitle}", seoDescription: "${args.seoDescription}", ogTitle: "${args.ogTitle}", ogDescription: "${args.ogDescription}", ogImage: "${args.ogImage}", status: published, authorDid: $session.did, authorName: $session.displayName, published: true, publishedAt: "${generate.timeiso}", archivedAt: "", deletedAt: "", createdAt: "${generate.timeiso}", updatedAt: "${generate.timeiso}", version: 1}}}}
          }
          view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
            h3 :images level=3
            p :images-desc intent=muted
          }
          afs-dropzone
        }
      }
    }
  }
}
