{
  "id": "arcblog-operations",
  "type": "view",
  "props": {
    "layout": {
      "gap": "lg"
    },
    "size": {
      "maxWidth": "lg"
    }
  },
  "children": [
    {
      "id": "arcblog-operations-card-1",
      "type": "view",
      "props": {
        "mode": "card",
        "layout": {
          "gap": "md"
        }
      },
      "visible": "!$session.authenticated",
      "children": [
        {
          "id": "arcblog-operations-card-1-h2-1",
          "type": "text",
          "props": {
            "level": 2,
            "content": "$t(operations.gate-title)"
          }
        },
        {
          "id": "arcblog-operations-card-1-p-2",
          "type": "text",
          "props": {
            "content": "$t(operations.gate-desc)",
            "intent": "info"
          }
        },
        {
          "id": "arcblog-operations-card-1-action-3",
          "type": "action",
          "props": {
            "variant": "primary",
            "label": "$t(operations.login)"
          },
          "events": {
            "click": {
              "navigate": "/.well-known/service/login?return_to=%2F%3Fpage%3Doperations&cancel_to=%2F%3Fpage%3Doperations"
            }
          }
        }
      ]
    },
    {
      "id": "console-shell",
      "type": "view",
      "props": {
        "layout": {
          "direction": "row",
          "gap": "lg",
          "crossAlign": "start"
        }
      },
      "children": [
        {
          "id": "console-nav",
          "type": "view",
          "props": {
            "layout": {
              "gap": "xs"
            },
            "size": {
              "width": "200px",
              "flexShrink": 0
            },
            "style": {
              "padding": "14px",
              "border": "1px solid var(--color-border)",
              "borderRadius": "var(--radius-lg, 12px)",
              "background": "var(--color-surface)"
            }
          },
          "visible": "$session.authenticated",
          "children": [
            {
              "id": "console-nav-p-1",
              "type": "text",
              "props": {
                "content": "$t(wrapper.nav-group-content)",
                "intent": "muted",
                "scale": "caption"
              }
            },
            {
              "id": "console-nav-dashboard",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-dashboard)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "dashboard"
                  }
                }
              }
            },
            {
              "id": "console-nav-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-studio)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "admin"
                  }
                }
              }
            },
            {
              "id": "console-nav-heroes-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-heroes)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "heroes-admin"
                  }
                }
              }
            },
            {
              "id": "console-nav-p-5",
              "type": "text",
              "props": {
                "content": "$t(wrapper.nav-group-ops)",
                "intent": "muted",
                "scale": "caption"
              }
            },
            {
              "id": "console-nav-operations",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-operations)",
                "variant": "primary"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "operations"
                  }
                }
              }
            },
            {
              "id": "console-nav-ops-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-media-agents)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "ops-admin"
                  }
                }
              }
            },
            {
              "id": "console-nav-p-8",
              "type": "text",
              "props": {
                "content": "$t(wrapper.nav-group-economy)",
                "intent": "muted",
                "scale": "caption"
              }
            },
            {
              "id": "console-nav-economy-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-policy-grants)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "economy-admin"
                  }
                }
              }
            }
          ]
        },
        {
          "id": "console-pane",
          "type": "view",
          "props": {
            "layout": {
              "gap": "lg"
            },
            "size": {
              "flex": 1
            }
          },
          "children": [
            {
              "id": "console-pane-view-1",
              "type": "view",
              "props": {
                "layout": {
                  "gap": "lg"
                }
              },
              "visible": "$session.authenticated",
              "children": [
                {
                  "id": "console-pane-view-1-card-1",
                  "type": "view",
                  "props": {
                    "mode": "card",
                    "layout": {
                      "gap": "md"
                    }
                  },
                  "children": [
                    {
                      "id": "console-pane-view-1-card-1-h1-1",
                      "type": "text",
                      "props": {
                        "level": 1,
                        "content": "$t(operations.title)"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-1-p-2",
                      "type": "text",
                      "props": {
                        "content": "$t(operations.desc)",
                        "intent": "muted"
                      }
                    }
                  ]
                },
                {
                  "id": "console-pane-view-1-card-2",
                  "type": "view",
                  "props": {
                    "mode": "card",
                    "layout": {
                      "gap": "md"
                    }
                  },
                  "propBind": {
                    "health": "/instance/app/arcblog/node/health.json"
                  },
                  "children": [
                    {
                      "id": "console-pane-view-1-card-2-h2-1",
                      "type": "text",
                      "props": {
                        "level": 2,
                        "content": "$t(operations.health)"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-2-p-2",
                      "type": "text",
                      "props": {
                        "content": "$t(operations.health-status)",
                        "scale": "sm",
                        "intent": "muted"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-2-p-3",
                      "type": "text",
                      "props": {
                        "content": "${state.health.status}",
                        "scale": "sm"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-2-p-4",
                      "type": "text",
                      "props": {
                        "content": "$t(operations.health-version)",
                        "scale": "sm",
                        "intent": "muted"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-2-p-5",
                      "type": "text",
                      "props": {
                        "content": "${state.health.version}",
                        "scale": "sm"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-2-p-6",
                      "type": "text",
                      "props": {
                        "content": "$t(operations.health-did)",
                        "scale": "sm",
                        "intent": "muted"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-2-p-7",
                      "type": "text",
                      "props": {
                        "content": "${state.health.did}",
                        "scale": "sm"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-2-p-8",
                      "type": "text",
                      "props": {
                        "content": "$t(operations.health-checked)",
                        "scale": "sm",
                        "intent": "muted"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-2-time-9",
                      "type": "time",
                      "props": {
                        "mode": "display",
                        "value": "${state.health.checkedAt}",
                        "timeMode": "relative"
                      }
                    }
                  ]
                },
                {
                  "id": "console-pane-view-1-card-3",
                  "type": "view",
                  "props": {
                    "mode": "card",
                    "layout": {
                      "gap": "md"
                    }
                  },
                  "propBind": {
                    "discovery": "/instance/app/arcblog/node/discovery.json"
                  },
                  "children": [
                    {
                      "id": "console-pane-view-1-card-3-h2-1",
                      "type": "text",
                      "props": {
                        "level": 2,
                        "content": "$t(operations.discovery)"
                      }
                    },
                    {
                      "id": "opsDiscoveryRow",
                      "type": "view",
                      "props": {
                        "layout": {
                          "direction": "row",
                          "gap": "xs"
                        }
                      },
                      "children": [
                        {
                          "id": "opsdiscoveryrow-p-1",
                          "type": "text",
                          "props": {
                            "content": "$t(operations.discovery-protocol)",
                            "scale": "sm",
                            "intent": "muted"
                          }
                        },
                        {
                          "id": "opsdiscoveryrow-p-2",
                          "type": "text",
                          "props": {
                            "content": "${state.discovery.protocol}",
                            "scale": "sm"
                          }
                        },
                        {
                          "id": "opsdiscoveryrow-p-3",
                          "type": "text",
                          "props": {
                            "content": "$t(operations.discovery-transport)",
                            "scale": "sm",
                            "intent": "muted"
                          }
                        },
                        {
                          "id": "opsdiscoveryrow-p-4",
                          "type": "text",
                          "props": {
                            "content": "${state.discovery.transport}",
                            "scale": "sm"
                          }
                        },
                        {
                          "id": "opsdiscoveryrow-p-5",
                          "type": "text",
                          "props": {
                            "content": "$t(operations.discovery-generated)",
                            "scale": "sm",
                            "intent": "muted"
                          }
                        },
                        {
                          "id": "opsdiscoveryrow-time-6",
                          "type": "time",
                          "props": {
                            "mode": "display",
                            "value": "${state.discovery.generatedAt}",
                            "timeMode": "relative"
                          }
                        }
                      ]
                    },
                    {
                      "id": "console-pane-view-1-card-3-p-3",
                      "type": "text",
                      "props": {
                        "content": "$t(operations.discovery-empty)",
                        "scale": "sm",
                        "intent": "muted"
                      }
                    }
                  ]
                },
                {
                  "id": "console-pane-view-1-card-4",
                  "type": "view",
                  "props": {
                    "mode": "card",
                    "layout": {
                      "gap": "md"
                    }
                  },
                  "children": [
                    {
                      "id": "console-pane-view-1-card-4-h2-1",
                      "type": "text",
                      "props": {
                        "level": 2,
                        "content": "$t(operations.hubs)"
                      }
                    },
                    {
                      "id": "ops-hubs",
                      "type": "afs-list",
                      "props": {
                        "layout": "list",
                        "itemStyle": "row",
                        "subscribe": true,
                        "showBreadcrumb": false,
                        "showParent": false,
                        "clickMode": "none",
                        "emptyText": "$t(operations.hubs-empty)",
                        "transform": {
                          "syncAt": "content.sync.lastSync",
                          "syncVersion": "content.sync.lastVersion"
                        }
                      },
                      "src": "/instance/app/arcblog/hub/registrations",
                      "children": [
                        {
                          "id": "opsHubRow",
                          "type": "view",
                          "props": {
                            "layout": {
                              "direction": "row",
                              "gap": "xs"
                            },
                            "role": "item"
                          },
                          "children": [
                            {
                              "id": "opshubrow-h3-1",
                              "type": "text",
                              "props": {
                                "level": 3,
                                "content": "${entry.content.hubDid}"
                              }
                            },
                            {
                              "id": "opshubrow-p-2",
                              "type": "text",
                              "props": {
                                "content": "$t(operations.hub-endpoint)",
                                "scale": "sm",
                                "intent": "muted"
                              }
                            },
                            {
                              "id": "opshubrow-p-3",
                              "type": "text",
                              "props": {
                                "content": "${entry.content.endpoint}",
                                "scale": "sm"
                              }
                            },
                            {
                              "id": "opshubrow-p-4",
                              "type": "text",
                              "props": {
                                "content": "$t(operations.hub-sync)",
                                "scale": "sm",
                                "intent": "muted"
                              }
                            },
                            {
                              "id": "opshubrow-p-5",
                              "type": "text",
                              "props": {
                                "content": "${entry.content.syncAt}",
                                "scale": "sm"
                              }
                            },
                            {
                              "id": "opshubrow-p-6",
                              "type": "text",
                              "props": {
                                "content": "$t(operations.hub-version)",
                                "scale": "sm",
                                "intent": "muted"
                              }
                            },
                            {
                              "id": "opshubrow-p-7",
                              "type": "text",
                              "props": {
                                "content": "${entry.content.syncVersion}",
                                "scale": "sm"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "console-pane-view-1-card-4-p-3",
                      "type": "text",
                      "props": {
                        "content": "$t(operations.hubs-empty)",
                        "scale": "sm",
                        "intent": "muted"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
