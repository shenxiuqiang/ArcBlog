page heroes {
  i18n {
    content-empty { en "Nothing here yet. Write your first post." zh "还没有内容。写下第一篇文章吧。" }
    desc { en "Home carousel records: title, image URL, target link and sort order." zh "首页轮播记录：标题、图片 URL、跳转链接与排序。" }
    gate-desc { en "Sign in with DID Wallet to manage the site." zh "使用 DID Wallet 登录后管理站点。" }
    gate-title { en "Site" zh "站点" }
    hero-add { en "Add hero" zh "添加 Hero" }
    hero-added { en "Hero added." zh "Hero 已添加。" }
    hero-admin-desc { en "Heroes render as the homepage carousel. Each record needs a title, an image URL, and a target link; sort orders the slides ascending." zh "Hero 显示为首页轮播。每条记录需要标题、图片 URL 和跳转链接；sort 按升序决定播放顺序。" }
    hero-delete { en "Delete" zh "删除" }
    hero-delete-msg { en "This removes the hero record permanently." zh "将永久删除该 Hero 记录。" }
    hero-delete-title { en "Delete hero?" zh "删除 Hero？" }
    hero-deleted { en "Hero deleted." zh "Hero 已删除。" }
    hero-dropzone-desc { en "Upload an image here, then paste the resulting URL into the form above." zh "把图片拖到这里上传，把得到的 URL 粘贴到上面的表单。" }
    hero-f-desc { en "Description" zh "描述" }
    hero-f-image { en "Image URL" zh "图片 URL" }
    hero-f-sort { en "Sort order" zh "排序" }
    hero-f-title { en "Title" zh "标题" }
    hero-f-url { en "Link URL" zh "链接 URL" }
    hero-form { en "Add hero" zh "添加 Hero" }
    hero-id { en "ID (slug)" zh "ID（slug）" }
    hero-id-hint { en "Lowercase letters, numbers and dashes; same ID overwrites." zh "小写字母、数字和连字符；相同 ID 会覆盖。" }
    hero-list-empty { en "No heroes yet." zh "还没有 Hero。" }
    hero-quickadd { en "Add to hero" zh "加入 Hero" }
    hero-quickadd-hint { en "Click a post row to stage it below, then confirm. Title, summary, cover and /posts/<slug> link are copied automatically." zh "点击文章行将其暂存到下方，确认后加入。自动带标题、摘要、封面和 /posts/<slug> 链接。" }
    hero-quickadd-title { en "Quick add from a post" zh "从文章快速加入" }
    hero-quickadded { en "Added to heroes." zh "已加入 Hero。" }
    login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
    title { en "Hero management" zh "Hero 管理" }
  }
  view gap=lg style={height: "calc(100vh - 48px)", overflow: visible} {
    view style={gap: "0"} {
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "20px"} visible="!$session.authenticated" {
        h2 :gate-title level=2 style={fontSize: "var(--type-body)"}
        p :gate-desc intent=info
        action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dheroes&cancel_to=%2F%3Fpage%3Dheroes" variant=primary label=:login style={borderRadius: "var(--radius-md, 8px)"}
      }
      row gap=lg cross=stretch style={width: "100vw", marginLeft: "calc(50% - 50vw)", height: "calc(100vh - 48px)", marginBottom: "-52px", padding: "0 32px 0 0"} visible=$session.authenticated {
        view size={width: "clamp(200px, 15vw, 280px)", flexShrink: 0, height: "100%"} style={padding: "0", background: "var(--color-surface)", borderRight: "1px solid var(--color-border)", overflowY: auto, gap: "0", height: "100%"} visible=$session.authenticated {
          p "$t(wrapper.nav-group-content)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-dashboard)" -> page dashboard style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-studio)" -> page posts style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-pages)" -> page pages style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-write)" -> page compose style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-site)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-heroes)" -> page heroes active=true style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-categories)" -> page categories style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-seo)" -> page seo style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-feeds)" -> page feeds style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-appearance)" -> page appearance style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-ops)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-operations)" -> page operations style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-hub)" -> page hub style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-media)" -> page media style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-agents)" -> page agents style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-economy)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-policy)" -> page policy style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-access)" -> page access style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-factory)" -> page factory style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
        }
        view gap=md size={flex: 1} style={paddingTop: "14px", paddingBottom: "14px", minHeight: 0} {
          view gap=lg style={height: "100%", minHeight: 0} visible=$session.authenticated {
            view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px"} {
              h2 :title level=2 style={fontSize: "var(--type-subheading)"}
              p :desc intent=muted
            }
            view gap=sm size={flex: 1} style={overflowY: auto} {
              view style={display: grid, gridTemplateColumns: "repeat(auto-fit, minmax(520px, 1fr))", gap: "14px", flexShrink: 0, alignItems: start} {
                view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px", flexShrink: 0} {
                  p :hero-admin-desc intent=muted
                }
                afs-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false emptyText=:hero-list-empty autoSelect=false clickMode=none sort={preset: heroOrder, presets: {heroOrder: {field: "content.sort", desc: false}}} transform={label: "content.title", description: "content.description", image: "content.image"} style={flexShrink: 0} from "/instance/app/arcblog/heroes" {
                  row cross=start role=item style={background: transparent, padding: "0"} {
                    row gap=sm cross=start style={flex: 1, padding: "14px", border: "1px solid var(--color-border)", borderRadius: "var(--radius-lg, 10px)", minWidth: 0} {
                      view gap=xs size={flex: 1} style={minWidth: 0} {
                        h3 "${entry.content.title}" style={fontSize: "var(--type-body)"}
                        p "${entry.content.description}" scale=sm intent=muted
                        row gap=xs cross=center {
                          p "${entry.content.url}" scale=sm intent=muted
                          p "sort ${entry.content.sort}" scale=sm intent=muted
                        }
                      }
                      action -> exec "/.actions/delete" variant=destructive size=sm icon=trash label=:hero-delete path="${entry.path}" confirm={title: :hero-delete-title, message: :hero-delete-msg} onSuccessToast={intent: success, message: "$t(heroes-admin.hero-deleted)", duration: 2500} style={borderRadius: "var(--radius-md, 8px)"}
                    }
                  }
                }
                view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px", flexShrink: 0} {
                  h3 :hero-form level=3 style={fontSize: "var(--type-body)"}
                  input type=text label=:hero-id name=heroId required=true state={value: ""}
                  p :hero-id-hint intent=muted scale=caption
                  input type=text label=:hero-f-title name=heroTitle required=true state={value: ""}
                  input type=text label=:hero-f-desc name=heroDesc state={value: ""}
                  input type=text label=:hero-f-image name=heroImage required=true state={value: ""}
                  input type=text label=:hero-f-url name=heroUrl required=true state={value: ""}
                  input type=text label=:hero-f-sort name=heroSort state={value: "0"}
                  row cross=start {
                    action variant=primary label=:hero-add onSuccessToast={intent: success, message: "$t(heroes-admin.hero-added)", duration: 2500} style={borderRadius: "var(--radius-md, 8px)"} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/heroes/${args.heroId}.json", content: {title: "${args.heroTitle}", description: "${args.heroDesc}", image: "${args.heroImage}", url: "${args.heroUrl}", sort: "${args.heroSort}", createdAt: "${generate.timeiso}"}}}}
                  }
                }
                view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px", flexShrink: 0} {
                  p :hero-dropzone-desc intent=muted
                  afs-dropzone
                }
                view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px", flexShrink: 0} {
                  h3 :hero-quickadd-title level=3 style={fontSize: "var(--type-body)"}
                  p :hero-quickadd-hint intent=muted scale=caption
                  afs-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false emptyText=:content-empty clickMode=select autoSelect=false selectAlwaysFires=true style={flexShrink: 0} from "/instance/app/arcblog/posts" events={select: [{target: qa-title, set: {state: {value: $args.item.title}}}, {target: qa-desc, set: {state: {value: $args.item.summary}}}, {target: qa-image, set: {state: {value: $args.item.coverImage}}}, {target: qa-slug, set: {state: {value: $args.item.slug}}}]} {
                    row cross=center role=item style={padding: "8px 0", borderBottom: "1px solid var(--color-border)"} {
                      view gap=xs size={flex: 1} style={minWidth: 0} {
                        h3 "${entry.content.title}" style={fontSize: "var(--type-body)"}
                        row gap=xs cross=center {
                          p "${entry.content.category}" scale=sm intent=muted style={textTransform: capitalize}
                          p "${entry.content.coverImage}" scale=sm intent=muted
                        }
                      }
                    }
                  }
                  view gap=sm style={flexShrink: 0} {
                    input qa-title type=hidden name=qaTitle state={value: ""}
                    input qa-desc type=hidden name=qaDesc state={value: ""}
                    input qa-image type=hidden name=qaImage state={value: ""}
                    input qa-slug type=hidden name=qaSlug state={value: ""}
                    row cross=start {
                      action variant=secondary size=sm label=:hero-quickadd onSuccessToast={intent: success, message: "$t(heroes-admin.hero-quickadded)", duration: 2500} style={borderRadius: "var(--radius-md, 8px)"} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/heroes/${args.qaSlug}.json", content: {title: "${args.qaTitle}", description: "${args.qaDesc}", image: "${args.qaImage}", url: "/posts/${args.qaSlug}", sort: "0", createdAt: "${generate.timeiso}"}}}}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
