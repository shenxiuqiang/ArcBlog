{
  "id": "arcblog-posts-view-1",
  "type": "view",
  "props": {
    "layout": {
      "gap": "lg"
    }
  },
  "children": [
    {
      "id": "hero-carousel-frame",
      "type": "frame",
      "props": {
        "src": "/p/en/hero-carousel/",
        "loading": "eager",
        "aspectRatio": "16 / 7",
        "title": "Hero carousel"
      }
    },
    {
      "id": "arcblog-posts-view-1-h2-2",
      "type": "text",
      "props": {
        "level": 2,
        "content": "$t(posts.feed)"
      }
    },
    {
      "id": "published-feed",
      "type": "afs-list",
      "props": {
        "layout": "list",
        "itemStyle": "row",
        "subscribe": true,
        "autoSelect": false,
        "showBreadcrumb": false,
        "showParent": false,
        "emptyText": "$t(posts.feed-empty)",
        "clickMode": "none"
      },
      "src": "/instance/app/arcblog/posts",
      "children": [
        {
          "id": "postRow",
          "type": "view",
          "props": {
            "layout": {
              "direction": "row",
              "crossAlign": "center",
              "gap": "lg"
            },
            "role": "item",
            "style": {
              "padding": "var(--space-block, 28px)",
              "border": "1px solid var(--color-border)",
              "borderRadius": "var(--radius-lg, 12px)",
              "marginBottom": "var(--space-block, 20px)"
            }
          },
          "children": [
            {
              "id": "postLink",
              "type": "view",
              "props": {
                "layout": {
                  "gap": "sm"
                },
                "href": "/posts/${entry.content.slug}",
                "size": {
                  "flex": 1
                },
                "style": {
                  "display": "block",
                  "textDecoration": "none",
                  "color": "inherit",
                  "cursor": "pointer",
                  "minWidth": 0
                }
              },
              "children": [
                {
                  "id": "postlink-h3-1",
                  "type": "text",
                  "props": {
                    "level": 3,
                    "content": "${entry.content.title}",
                    "scale": "lg",
                    "style": {
                      "margin": "0",
                      "lineHeight": "1.3"
                    }
                  }
                },
                {
                  "id": "postlink-row-2",
                  "type": "view",
                  "props": {
                    "layout": {
                      "direction": "row",
                      "gap": "xs",
                      "crossAlign": "center"
                    }
                  },
                  "children": [
                    {
                      "id": "postlink-row-2-p-1",
                      "type": "text",
                      "props": {
                        "content": "${entry.content.category}",
                        "scale": "sm",
                        "intent": "muted",
                        "style": {
                          "textTransform": "capitalize"
                        }
                      }
                    },
                    {
                      "id": "postlink-row-2-p-2",
                      "type": "text",
                      "props": {
                        "content": "·",
                        "scale": "sm",
                        "intent": "muted"
                      }
                    },
                    {
                      "id": "postlink-row-2-view-3",
                      "type": "view",
                      "props": {
                        "style": {
                          "fontSize": "var(--type-small)",
                          "color": "var(--color-dim)"
                        }
                      },
                      "children": [
                        {
                          "id": "postlink-row-2-view-3-time-1",
                          "type": "time",
                          "props": {
                            "mode": "display",
                            "value": "${entry.content.publishedAt}",
                            "timeMode": "relative"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "postlink-p-3",
                  "type": "text",
                  "props": {
                    "content": "${entry.content.summary}",
                    "intent": "muted",
                    "scale": "sm",
                    "style": {
                      "margin": "0"
                    }
                  }
                }
              ]
            },
            {
              "id": "postCover",
              "type": "view",
              "props": {
                "href": "/posts/${entry.content.slug}",
                "style": {
                  "display": "block",
                  "flexGrow": 0,
                  "flexShrink": 0,
                  "flexBasis": "200px",
                  "width": "200px",
                  "height": "132px",
                  "borderRadius": "var(--radius-lg, 12px)",
                  "background": "url(${entry.content.coverImage}) center / cover no-repeat"
                }
              },
              "visible": "${entry.content.coverImage}",
              "children": [
                {
                  "id": "postcover-text-1",
                  "type": "text",
                  "props": {
                    "content": " "
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
