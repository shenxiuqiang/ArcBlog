page index {
  i18n {
    feed { en "Latest published" zh "最新发布" }
    feed-empty { en "No published stories yet." zh "还没有已发布的文章。" }
  }
  view gap=lg {
    view style={margin: "0 calc(-1 * var(--page-gutter, 32px))"} {
      app-header site-header variant=compact brand={title: ArcBlog, src: index} actions=[{kind: theme-toggle, icon: sun, ariaLabel: "$t(wrapper.theme-label)"}, {kind: locale-switcher, locales: [en, zh], labels: {en: EN, zh: "中文"}}, {kind: user-menu, items: [{id: console, label: "$t(wrapper.nav-console)", icon: grid, exec: dashboard}]}] events={user-menu-item: {target: _root, set: {page: $args.exec}}, nav-click: {target: _root, set: {page: $args.src}}}
    }
    view gap=lg {
      frame hero-carousel-frame src="/p/en/hero-carousel/" loading=eager aspectRatio="16 / 7" title="Hero carousel" sandbox=allow-top-navigation-by-user-activation
      h2 :feed level=2
      afs-list layout=list itemStyle=row subscribe=true autoSelect=false showBreadcrumb=false showParent=false emptyText=:feed-empty clickMode=none from "/instance/app/arcblog/posts" {
        row cross=stretch role=item style={padding: "0", border: "1px solid var(--color-border)", borderRadius: "var(--radius-lg, 12px)", marginBottom: "var(--space-block, 20px)", overflow: hidden, minHeight: "176px"} {
          view layout=inline href="/posts/${entry.content.slug}" size={flex: 1} style={display: flex, flexDirection: column, justifyContent: center, textDecoration: none, color: inherit, cursor: pointer, minWidth: 0, padding: "24px 30px"} {
            h3 "${entry.content.title}" scale=lg style={margin: "0", fontSize: "clamp(1.3rem, 2vw, 1.62rem)", lineHeight: "1.25"}
            row gap=xs cross=center {
              p "${entry.content.category}" scale=sm intent=muted style={textTransform: capitalize}
              p "·" scale=sm intent=muted
              view style={fontSize: "var(--type-small)", color: "var(--color-dim)"} {
                time mode=display value="${entry.content.publishedAt}" timeMode=relative
              }
            }
            p "${entry.content.summary}" intent=muted scale=sm style={margin: "0"}
          }
          view layout=inline href="/posts/${entry.content.slug}" style={display: block, flexGrow: 0, flexShrink: 0, flexBasis: "240px", width: "240px", alignSelf: stretch, background: "url(${entry.content.coverImage}) center / cover no-repeat"} visible="${entry.content.coverImage}" {
            p " "
          }
        }
      }
    }
    app-footer brand={title: ArcBlog, tagline: "$t(wrapper.tagline)", href: "/"} columns=[{links: [{label: "$t(wrapper.nav-about)", href: "/?page=about"}, {label: "$t(wrapper.nav-store)", href: "/store"}, {label: "$t(wrapper.nav-author)", href: "/?page=author"}, {label: RSS, href: "/p/rss.xml", external: true}]}] bottomBar={copyright: "© 2026 ArcBlog"}
  }
}
