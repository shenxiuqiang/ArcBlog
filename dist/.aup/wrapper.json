{
  "id": "arcblog-wrapper",
  "type": "view",
  "props": {
    "layout": {
      "gap": "lg"
    },
    "variant": "scaffold-service-frame"
  },
  "children": [
    {
      "id": "arcblog-shell-header",
      "type": "view",
      "props": {
        "layout": {
          "direction": "row",
          "gap": "md",
          "crossAlign": "center",
          "wrap": true
        },
        "variant": "scaffold-service-header"
      },
      "children": [
        {
          "id": "arcblog-brand",
          "type": "action",
          "props": {
            "label": "ArcBlog",
            "variant": "ghost",
            "href": "/"
          }
        },
        {
          "id": "arcblog-shell-nav",
          "type": "view",
          "props": {
            "layout": {
              "direction": "row",
              "gap": "xs",
              "crossAlign": "center",
              "wrap": true
            },
            "variant": "scaffold-service-nav"
          },
          "children": [
            {
              "id": "arcblog-nav-posts",
              "type": "action",
              "props": {
                "label": "Posts",
                "variant": "ghost",
                "href": "/app?page=posts"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "posts"
                  }
                }
              }
            },
            {
              "id": "arcblog-nav-write",
              "type": "action",
              "props": {
                "label": "Write",
                "variant": "ghost",
                "href": "/app?page=compose"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "compose"
                  }
                }
              }
            },
            {
              "id": "arcblog-nav-studio",
              "type": "action",
              "props": {
                "label": "Studio",
                "variant": "ghost",
                "href": "/app?page=admin"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "admin"
                  }
                }
              }
            },
            {
              "id": "arcblog-nav-about",
              "type": "action",
              "props": {
                "label": "About",
                "variant": "ghost",
                "href": "/app?page=about"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "about"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "$ref": "content"
    },
    {
      "id": "arcblog-shell-footer",
      "type": "text",
      "props": {
        "content": "ArcBlog — DID-native writing, Markdown-first publishing.",
        "scale": "caption",
        "intent": "muted",
        "variant": "scaffold-service-footer"
      }
    }
  ]
}
