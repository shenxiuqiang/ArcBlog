{
  "id": "wrapper-view-1",
  "type": "view",
  "children": [
    {
      "id": "site-header",
      "type": "app-header",
      "props": {
        "variant": "compact",
        "brand": {
          "title": "ArcBlog",
          "src": "posts"
        },
        "actions": [
          {
            "kind": "theme-toggle",
            "icon": "sun",
            "ariaLabel": "$t(wrapper.theme-label)"
          },
          {
            "kind": "locale-switcher",
            "locales": [
              "en",
              "zh"
            ],
            "labels": {
              "en": "EN",
              "zh": "中文"
            }
          },
          {
            "kind": "user-menu",
            "items": [
              {
                "id": "console",
                "label": "$t(wrapper.nav-console)",
                "icon": "grid",
                "exec": "dashboard"
              }
            ]
          }
        ]
      },
      "events": {
        "user-menu-item": {
          "target": "_root",
          "set": {
            "page": "$args.exec"
          }
        },
        "nav-click": {
          "target": "_root",
          "set": {
            "page": "$args.src"
          }
        }
      }
    },
    {
      "$ref": "content"
    },
    {
      "id": "theme-bridge-frame",
      "type": "frame",
      "props": {
        "src": "/p/en/theme-bridge/",
        "bridge": true,
        "overlay": true,
        "loading": "eager"
      }
    },
    {
      "id": "wrapper-view-1-app-footer-4",
      "type": "app-footer",
      "props": {
        "brand": {
          "title": "ArcBlog",
          "tagline": "$t(wrapper.tagline)",
          "href": "/"
        },
        "columns": [
          {
            "links": [
              {
                "label": "$t(wrapper.nav-about)",
                "href": "/?page=about"
              },
              {
                "label": "$t(wrapper.nav-author)",
                "href": "/?page=author"
              },
              {
                "label": "RSS",
                "href": "/p/rss.xml",
                "external": true
              }
            ]
          }
        ],
        "bottomBar": {
          "copyright": "© 2026 ArcBlog"
        }
      }
    }
  ]
}
