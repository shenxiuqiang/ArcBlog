{
  "id": "console-overview-kpis",
  "type": "view",
  "props": {
    "layout": {
      "gap": "xs"
    }
  },
  "children": [
    {
      "id": "console-overview-kv",
      "type": "key-value-list",
      "props": {
        "dense": true,
        "fields": [
          {
            "label": "published",
            "value": "${content.publishedCount}",
            "monospace": true,
            "hideWhenEmpty": true
          },
          {
            "label": "drafts",
            "value": "${content.draftCount}",
            "monospace": true,
            "hideWhenEmpty": true
          },
          {
            "label": "pages online",
            "value": "${content.pageOnlineCount}",
            "monospace": true,
            "hideWhenEmpty": true
          },
          {
            "label": "pages offline",
            "value": "${content.pageDraftCount}",
            "monospace": true,
            "hideWhenEmpty": true
          },
          {
            "label": "media",
            "value": "${content.mediaCount}",
            "monospace": true,
            "hideWhenEmpty": true
          },
          {
            "label": "summaries",
            "value": "${content.summaryCount}",
            "monospace": true,
            "hideWhenEmpty": true
          },
          {
            "label": "categories",
            "value": "${content.categoryCount}",
            "monospace": true,
            "hideWhenEmpty": true
          },
          {
            "label": "tags",
            "value": "${content.tagCount}",
            "monospace": true,
            "hideWhenEmpty": true
          }
        ]
      }
    },
    {
      "id": "console-overview-note",
      "type": "text",
      "props": {
        "content": "${content.note}",
        "intent": "muted",
        "scale": "caption"
      }
    }
  ]
}
