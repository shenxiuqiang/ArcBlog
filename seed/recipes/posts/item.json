{
  "id": "post-record",
  "type": "view",
  "props": {
    "layout": {
      "gap": "md"
    }
  },
  "children": [
    {
      "id": "post-record-cover",
      "type": "view",
      "props": {
        "style": {
          "minHeight": "280px",
          "borderRadius": "var(--radius-lg, 10px)",
          "background": "var(--color-border) url(${content.coverImage}) center / cover no-repeat"
        }
      },
      "children": [
        {
          "id": "post-record-cover-spacer",
          "type": "text",
          "props": {
            "content": " "
          }
        }
      ]
    },
    {
      "id": "post-record-meta",
      "type": "view",
      "props": {
        "layout": {
          "direction": "row",
          "gap": "xs",
          "crossAlign": "center"
        }
      },
      "children": [
        {
          "id": "post-record-avatar",
          "type": "view",
          "props": {
            "style": {
              "width": "32px",
              "height": "32px",
              "flexGrow": 0,
              "flexBasis": "32px",
              "borderRadius": "999px",
              "background": "var(--color-border) url(/.well-known/service/user/avatar/${content.authorDid}?s=64) center / cover no-repeat"
            }
          }
        },
        {
          "id": "post-record-author",
          "type": "text",
          "props": {
            "content": "${content.authorName}",
            "scale": "sm",
            "intent": "muted"
          }
        },
        {
          "id": "post-record-date",
          "type": "text",
          "props": {
            "content": "${content.publishedAt}",
            "scale": "sm",
            "intent": "muted"
          }
        },
        {
          "id": "post-record-category",
          "type": "text",
          "props": {
            "content": "${content.category}",
            "scale": "sm",
            "intent": "muted"
          }
        }
      ]
    },
    {
      "id": "post-record-body",
      "type": "text",
      "props": {
        "content": "${content.body}",
        "format": "markdown"
      }
    }
  ]
}
