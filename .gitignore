# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env
.env
.env.*
!.env.example

# OS
.DS_Store

# Logs
logs/
*.log

# Editor
.vscode/
.idea/
.zed/

# Temp
tmp/
temp/
.cache/

# Build cache — regenerated by `arc blocklet build`; the published copy ships inside dist/.web-cache
.web-cache/

# Build artifacts — regenerated by `npm run build` (= arc blocklet build + scrub:dist-secrets)
dist/

# Local auth/secrets
auth.json
*.pem
*.key

# Never commit shell/credential backups — `arc blocklet build` copies root files
# into dist/, so a stray one ends up tracked by a plain `git add -A`.
.zshrc*
*.bak-*
# Local chain material (never commit keys)
.env.local
.node-pk.pem
node.key

# Local-first agent memory (PRD-AGT-11) — repo-local, deliberately OUTSIDE AFS:
# `${ARCBLOG_MEMORY_DIR:-<repo>/.arcblog/memory}/<sessionId>.jsonl` holds user-side
# context, so it carries exactly the same "never commit" status as node.key above.
.arcblog/
