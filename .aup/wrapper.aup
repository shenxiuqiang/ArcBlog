page wrapper {
  i18n {
    nav-studio { en "Studio" zh "工作室" }
    nav-about { en "About" zh "关于" }
    theme-label { en "Toggle theme" zh "切换主题" }
    tagline { en "DID-native writing, Markdown-first publishing." zh "DID 原生写作，Markdown 优先发布。" }
  }
  view {
    app-header site-header variant=compact brand={title: ArcBlog, src: posts} actions=[{kind: theme-toggle, icon: sun, ariaLabel: "$t(wrapper.theme-label)"}, {kind: locale-switcher, locales: [en, zh], labels: {en: EN, zh: "中文"}}, {kind: user-menu, items: [{id: studio, label: "$t(wrapper.nav-studio)", icon: "settings", exec: "admin"}]}] events={user-menu-item: {target: _root, set: {page: $args.exec}}}
    slot content
    frame theme-bridge-frame src="/p/en/theme-bridge/" bridge=true overlay=true loading=eager
    app-footer brand={title: ArcBlog, tagline: "$t(wrapper.tagline)", href: "/"} columns=[{links: [{label: "$t(wrapper.nav-about)", href: "/?page=about"}, {label: "RSS", href: "/rss.xml", external: true}]}] bottomBar={copyright: "© 2026 ArcBlog"}
  }
}
