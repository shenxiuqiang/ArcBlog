page wrapper {
  i18n {
    nav-posts { en "Posts" zh "文章" }
    nav-studio { en "Studio" zh "工作室" }
    nav-about { en "About" zh "关于" }
    theme-label { en "Toggle theme" zh "切换主题" }
    tagline { en "DID-native writing, Markdown-first publishing." zh "DID 原生写作，Markdown 优先发布。" }
  }
  view {
    app-header site-header variant=compact brand={title: ArcBlog, src: posts} nav={items: [{id: posts, label: "$t(wrapper.nav-posts)", src: posts}, {id: admin, label: "$t(wrapper.nav-studio)", src: admin, visible: "$session.authenticated"}, {id: about, label: "$t(wrapper.nav-about)", src: about}]} actions=[{kind: theme-toggle, icon: sun, ariaLabel: "$t(wrapper.theme-label)"}, {kind: locale-switcher, locales: [en, zh], labels: {en: EN, zh: "中文"}}, {kind: user-menu}] events={nav-click: {target: _root, set: {page: $args.src}}}
    slot content
    frame theme-bridge-frame src="/p/en/theme-bridge/" bridge=true overlay=true loading=eager
    app-footer brand={title: ArcBlog, tagline: "$t(wrapper.tagline)", href: "/"} bottomBar={copyright: "© 2026 ArcBlog"}
  }
}
