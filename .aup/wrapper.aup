page wrapper {
  i18n {
    nav-studio { en "Studio" zh "工作室" }
    nav-console { en "Management" zh "管理后台" }
    nav-heroes { en "Heroes" zh "Hero" }
    nav-pages { en "Pages" zh "页面" }
    nav-seo { en "SEO" zh "SEO" }
    nav-group-site { en "Site" zh "站点" }
    nav-media { en "Media" zh "媒体" }
    nav-agents { en "Agents" zh "Agent" }
    nav-categories { en "Categories" zh "分类" }
    nav-tags { en "Tags" zh "标签" }
    nav-feeds { en "Feeds" zh "分发" }
    nav-factory { en "Factory" zh "工厂" }
    nav-group-content { en "Content" zh "内容" }
    nav-group-ops { en "Operations" zh "运营" }
    nav-dashboard { en "Dashboard" zh "仪表盘" }
    nav-operations { en "Operations" zh "运维" }
    nav-registry { en "Registry" zh "注册表" }
    nav-about { en "About" zh "关于" }
    nav-author { en "Author" zh "作者" }
    nav-saved { en "Reading list" zh "阅读清单" }
    nav-write { en "Write" zh "写文章" }
    nav-group-settings { en "Settings" zh "设置" }
    nav-settings { en "Settings" zh "设置" }
    nav-diagnostics { en "Diagnostics" zh "诊断与维护" }
    theme-label { en "Toggle theme" zh "切换主题" }
    tagline { en "DID-native writing, Markdown-first publishing." zh "DID 原生写作，Markdown 优先发布。" }
    admin-notice { en "Signed in, but this console needs a Blocklet admin — the lists here are admin-only." zh "已登录，但本控制台需要 Blocklet 管理员——这里的列表仅管理员可读。" }
  }
  view style={gap: "0"} {
    frame theme-bridge-frame src="/p/en/theme-bridge/" bridge=true overlay=true loading=eager
    view mode=shell style={width: "100vw", marginLeft: "calc(50% - 50vw)", height: "48px", minHeight: "48px", maxHeight: "48px", padding: "0"} {
      app-header site-header variant=compact brand={title: ArcBlog, href: "/?page=index"} actions=[{kind: theme-toggle, icon: sun, ariaLabel: "$t(wrapper.theme-label)"}, {kind: locale-switcher, locales: [en, zh], labels: {en: EN, zh: "中文"}}, {kind: user-menu, items: [{id: console, label: "$t(wrapper.nav-console)", icon: grid, exec: dashboard}]}] events={user-menu-item: {target: _root, set: {page: $args.exec}}, nav-click: {target: _root, set: {page: $args.src}}}
    }
    slot content
  }
}
