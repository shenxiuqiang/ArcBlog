{
  "id": "wrapper-view-1",
  "type": "view",
  "children": [
    {
      "id": "site-header",
      "type": "app-header",
      "props": {
        "variant": "compact",
        "brand": {
          "title": "ArcBlog",
          "src": "posts"
        },
        "nav": {
          "items": [
            {
              "id": "posts",
              "label": "$t(wrapper.nav-posts)",
              "src": "posts"
            },
            {
              "id": "admin",
              "label": "$t(wrapper.nav-studio)",
              "src": "admin",
              "visible": "$session.authenticated"
            },
            {
              "id": "about",
              "label": "$t(wrapper.nav-about)",
              "src": "about"
            }
          ]
        },
        "actions": [
          {
            "kind": "theme-toggle",
            "icon": "sun",
            "ariaLabel": "$t(wrapper.theme-label)"
          },
          {
            "kind": "locale-switcher",
            "locales": [
              "en",
              "zh"
            ],
            "labels": {
              "en": "EN",
              "zh": "中文"
            }
          },
          {
            "kind": "user-menu"
          }
        ]
      },
      "events": {
        "nav-click": {
          "target": "_root",
          "set": {
            "page": "$args.src"
          }
        }
      }
    },
    {
      "$ref": "content"
    },
    {
      "id": "theme-bridge-frame",
      "type": "frame",
      "props": {
        "src": "/p/en/theme-bridge/",
        "bridge": true,
        "overlay": true,
        "loading": "eager"
      }
    },
    {
      "id": "wrapper-view-1-app-footer-4",
      "type": "app-footer",
      "props": {
        "brand": {
          "title": "ArcBlog",
          "tagline": "$t(wrapper.tagline)",
          "href": "/"
        },
        "bottomBar": {
          "copyright": "© 2026 ArcBlog"
        }
      }
    }
  ]
}
