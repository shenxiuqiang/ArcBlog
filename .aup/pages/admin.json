{
  "id": "arcblog-admin",
  "type": "view",
  "props": {
    "layout": {
      "gap": "lg"
    },
    "size": {
      "maxWidth": "lg"
    }
  },
  "children": [
    {
      "id": "arcblog-admin-card-1",
      "type": "view",
      "props": {
        "mode": "card",
        "layout": {
          "gap": "md"
        }
      },
      "visible": "!$session.authenticated",
      "children": [
        {
          "id": "arcblog-admin-card-1-h2-1",
          "type": "text",
          "props": {
            "level": 2,
            "content": "$t(admin.gate-title)"
          }
        },
        {
          "id": "arcblog-admin-card-1-p-2",
          "type": "text",
          "props": {
            "content": "$t(admin.gate-desc)",
            "intent": "info"
          }
        },
        {
          "id": "arcblog-admin-card-1-action-3",
          "type": "action",
          "props": {
            "variant": "primary",
            "label": "$t(admin.login)"
          },
          "events": {
            "click": {
              "navigate": "/.well-known/service/login?return_to=%2F%3Fpage%3Dadmin&cancel_to=%2F%3Fpage%3Dadmin"
            }
          }
        }
      ]
    },
    {
      "id": "console-shell",
      "type": "view",
      "props": {
        "layout": {
          "direction": "row",
          "gap": "lg",
          "crossAlign": "start"
        }
      },
      "children": [
        {
          "id": "console-nav",
          "type": "view",
          "props": {
            "layout": {
              "gap": "xs"
            },
            "size": {
              "width": "200px",
              "flexShrink": 0
            },
            "style": {
              "padding": "14px",
              "border": "1px solid var(--color-border)",
              "borderRadius": "var(--radius-lg, 12px)",
              "background": "var(--color-surface)"
            }
          },
          "visible": "$session.authenticated",
          "children": [
            {
              "id": "console-nav-p-1",
              "type": "text",
              "props": {
                "content": "$t(wrapper.nav-group-content)",
                "intent": "muted",
                "scale": "caption"
              }
            },
            {
              "id": "console-nav-dashboard",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-dashboard)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "dashboard"
                  }
                }
              }
            },
            {
              "id": "console-nav-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-studio)",
                "variant": "primary"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "admin"
                  }
                }
              }
            },
            {
              "id": "console-nav-heroes-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-heroes)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "heroes-admin"
                  }
                }
              }
            },
            {
              "id": "console-nav-p-5",
              "type": "text",
              "props": {
                "content": "$t(wrapper.nav-group-ops)",
                "intent": "muted",
                "scale": "caption"
              }
            },
            {
              "id": "console-nav-operations",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-operations)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "operations"
                  }
                }
              }
            },
            {
              "id": "console-nav-ops-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-media-agents)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "ops-admin"
                  }
                }
              }
            },
            {
              "id": "console-nav-p-8",
              "type": "text",
              "props": {
                "content": "$t(wrapper.nav-group-economy)",
                "intent": "muted",
                "scale": "caption"
              }
            },
            {
              "id": "console-nav-economy-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-policy-grants)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "economy-admin"
                  }
                }
              }
            }
          ]
        },
        {
          "id": "console-pane",
          "type": "view",
          "props": {
            "layout": {
              "gap": "lg"
            },
            "size": {
              "flex": 1
            }
          },
          "children": [
            {
              "id": "console-pane-view-1",
              "type": "view",
              "props": {
                "layout": {
                  "gap": "lg"
                }
              },
              "visible": "$session.authenticated",
              "children": [
                {
                  "id": "console-pane-view-1-card-1",
                  "type": "view",
                  "props": {
                    "mode": "card",
                    "layout": {
                      "gap": "md"
                    }
                  },
                  "children": [
                    {
                      "id": "console-pane-view-1-card-1-h2-1",
                      "type": "text",
                      "props": {
                        "level": 2,
                        "content": "$t(admin.studio)"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-1-p-2",
                      "type": "text",
                      "props": {
                        "content": "$t(admin.studio-desc)",
                        "intent": "muted"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-1-action-3",
                      "type": "action",
                      "props": {
                        "variant": "primary",
                        "label": "$t(admin.new-post)"
                      },
                      "events": {
                        "click": {
                          "target": "_root",
                          "set": {
                            "page": "compose"
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "id": "console-pane-view-1-card-2",
                  "type": "view",
                  "props": {
                    "mode": "card",
                    "layout": {
                      "gap": "md"
                    }
                  },
                  "children": [
                    {
                      "id": "console-pane-view-1-card-2-h3-1",
                      "type": "text",
                      "props": {
                        "level": 3,
                        "content": "$t(admin.lifecycle)"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-2-p-2",
                      "type": "text",
                      "props": {
                        "content": "$t(admin.lifecycle-desc)",
                        "intent": "muted"
                      }
                    }
                  ]
                },
                {
                  "id": "console-pane-view-1-row-3",
                  "type": "view",
                  "props": {
                    "layout": {
                      "direction": "row",
                      "gap": "sm"
                    }
                  },
                  "children": [
                    {
                      "id": "console-pane-view-1-row-3-action-1",
                      "type": "action",
                      "props": {
                        "variant": "secondary",
                        "size": "sm",
                        "label": "$t(admin.appearance)"
                      },
                      "events": {
                        "click": {
                          "target": "_root",
                          "set": {
                            "page": "settings"
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "id": "console-pane-view-1-h2-4",
                  "type": "text",
                  "props": {
                    "level": 2,
                    "content": "$t(admin.content)"
                  }
                },
                {
                  "id": "console-pane-view-1-h3-5",
                  "type": "text",
                  "props": {
                    "level": 3,
                    "content": "$t(admin.group-published)"
                  }
                },
                {
                  "id": "studio-published",
                  "type": "afs-list",
                  "props": {
                    "layout": "list",
                    "itemStyle": "row",
                    "subscribe": true,
                    "showBreadcrumb": false,
                    "showParent": false,
                    "emptyText": "$t(admin.content-empty)",
                    "clickMode": "none"
                  },
                  "src": "/instance/app/arcblog/posts",
                  "children": [
                    {
                      "id": "studioRow",
                      "type": "view",
                      "props": {
                        "layout": {
                          "direction": "row",
                          "crossAlign": "start"
                        },
                        "role": "item",
                        "style": {
                          "padding": "var(--space-block) 0",
                          "borderBottom": "1px solid var(--color-border)"
                        }
                      },
                      "children": [
                        {
                          "id": "studioLink",
                          "type": "view",
                          "props": {
                            "layout": {
                              "gap": "xs"
                            },
                            "href": "/posts/${entry.content.slug}",
                            "size": {
                              "flex": 1
                            },
                            "style": {
                              "display": "block",
                              "textDecoration": "none",
                              "color": "inherit",
                              "cursor": "pointer",
                              "minWidth": 0
                            }
                          },
                          "children": [
                            {
                              "id": "studiolink-h3-1",
                              "type": "text",
                              "props": {
                                "level": 3,
                                "content": "${entry.content.title}"
                              }
                            },
                            {
                              "id": "studiolink-row-2",
                              "type": "view",
                              "props": {
                                "layout": {
                                  "direction": "row",
                                  "gap": "xs",
                                  "crossAlign": "center"
                                }
                              },
                              "children": [
                                {
                                  "id": "studiolink-row-2-p-1",
                                  "type": "text",
                                  "props": {
                                    "content": "${entry.content.status}",
                                    "scale": "sm",
                                    "intent": "muted"
                                  }
                                },
                                {
                                  "id": "studiolink-row-2-p-2",
                                  "type": "text",
                                  "props": {
                                    "content": "${entry.content.category}",
                                    "scale": "sm",
                                    "intent": "muted",
                                    "style": {
                                      "textTransform": "capitalize"
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "id": "studio-archive",
                          "type": "action",
                          "props": {
                            "variant": "secondary",
                            "size": "sm",
                            "label": "$t(admin.admin-archive)",
                            "confirm": {
                              "title": "$t(admin.admin-archive-title)",
                              "message": "$t(admin.admin-archive-msg)"
                            },
                            "onSuccessToast": {
                              "intent": "success",
                              "message": "$t(admin.archived-ok)",
                              "duration": 3000
                            }
                          },
                          "events": {
                            "click": {
                              "exec": "/.actions/write",
                              "args": {
                                "path": "/instance/app/arcblog/drafts/${entry.content.slug}.json",
                                "content": {
                                  "title": "${entry.content.title}",
                                  "slug": "${entry.content.slug}",
                                  "summary": "${entry.content.summary}",
                                  "body": "${entry.content.body}",
                                  "coverImage": "${entry.content.coverImage}",
                                  "images": [],
                                  "tags": "${entry.content.tags}",
                                  "category": "${entry.content.category}",
                                  "seoTitle": "${entry.content.seoTitle}",
                                  "seoDescription": "${entry.content.seoDescription}",
                                  "ogTitle": "${entry.content.ogTitle}",
                                  "ogDescription": "${entry.content.ogDescription}",
                                  "ogImage": "${entry.content.ogImage}",
                                  "status": "archived",
                                  "authorDid": "${entry.content.authorDid}",
                                  "authorName": "${entry.content.authorName}",
                                  "published": false,
                                  "publishedAt": "${entry.content.publishedAt}",
                                  "archivedAt": "${generate.timeiso}",
                                  "deletedAt": "",
                                  "createdAt": "${entry.content.createdAt}",
                                  "updatedAt": "${generate.timeiso}",
                                  "version": 1
                                }
                              }
                            }
                          }
                        },
                        {
                          "id": "studio-unpublish",
                          "type": "action",
                          "props": {
                            "variant": "destructive",
                            "size": "sm",
                            "icon": "trash",
                            "label": "$t(admin.admin-unpublish)",
                            "path": "/instance/app/arcblog/posts/${entry.content.slug}.json",
                            "confirm": {
                              "title": "$t(admin.admin-unpublish-title)",
                              "message": "$t(admin.admin-unpublish-msg)"
                            },
                            "onSuccessToast": {
                              "intent": "success",
                              "message": "$t(admin.unpublished-ok)",
                              "duration": 3000
                            }
                          },
                          "events": {
                            "click": {
                              "exec": "/.actions/delete"
                            }
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "console-pane-view-1-h3-7",
                  "type": "text",
                  "props": {
                    "level": 3,
                    "content": "$t(admin.group-drafts)"
                  }
                },
                {
                  "id": "studio-drafts",
                  "type": "afs-list",
                  "props": {
                    "layout": "list",
                    "itemStyle": "row",
                    "subscribe": true,
                    "showBreadcrumb": false,
                    "showParent": false,
                    "emptyText": "$t(admin.content-empty)",
                    "clickMode": "none"
                  },
                  "src": "/instance/app/arcblog/drafts",
                  "children": [
                    {
                      "id": "draftRow",
                      "type": "view",
                      "props": {
                        "layout": {
                          "direction": "row",
                          "crossAlign": "start"
                        },
                        "role": "item",
                        "style": {
                          "padding": "var(--space-block) 0",
                          "borderBottom": "1px solid var(--color-border)"
                        }
                      },
                      "children": [
                        {
                          "id": "draftLink",
                          "type": "view",
                          "props": {
                            "layout": {
                              "gap": "xs"
                            },
                            "href": "/preview/${entry.content.slug}",
                            "size": {
                              "flex": 1
                            },
                            "style": {
                              "display": "block",
                              "textDecoration": "none",
                              "color": "inherit",
                              "cursor": "pointer",
                              "minWidth": 0
                            }
                          },
                          "children": [
                            {
                              "id": "draftlink-h3-1",
                              "type": "text",
                              "props": {
                                "level": 3,
                                "content": "${entry.content.title}"
                              }
                            },
                            {
                              "id": "draftlink-row-2",
                              "type": "view",
                              "props": {
                                "layout": {
                                  "direction": "row",
                                  "gap": "xs",
                                  "crossAlign": "center"
                                }
                              },
                              "children": [
                                {
                                  "id": "draftlink-row-2-p-1",
                                  "type": "text",
                                  "props": {
                                    "content": "${entry.content.status}",
                                    "scale": "sm",
                                    "intent": "muted"
                                  }
                                },
                                {
                                  "id": "draftlink-row-2-p-2",
                                  "type": "text",
                                  "props": {
                                    "content": "${entry.content.category}",
                                    "scale": "sm",
                                    "intent": "muted",
                                    "style": {
                                      "textTransform": "capitalize"
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "id": "studio-publish",
                          "type": "action",
                          "props": {
                            "variant": "primary",
                            "size": "sm",
                            "label": "$t(admin.admin-publish)",
                            "confirm": {
                              "title": "$t(admin.admin-publish-title)",
                              "message": "$t(admin.admin-publish-msg)"
                            },
                            "onSuccessToast": {
                              "intent": "success",
                              "message": "$t(admin.published-ok)",
                              "duration": 3000
                            }
                          },
                          "events": {
                            "click": {
                              "exec": "/.actions/write",
                              "args": {
                                "path": "/instance/app/arcblog/posts/${entry.content.slug}.json",
                                "content": {
                                  "title": "${entry.content.title}",
                                  "slug": "${entry.content.slug}",
                                  "summary": "${entry.content.summary}",
                                  "body": "${entry.content.body}",
                                  "coverImage": "${entry.content.coverImage}",
                                  "images": [],
                                  "tags": "${entry.content.tags}",
                                  "category": "${entry.content.category}",
                                  "seoTitle": "${entry.content.seoTitle}",
                                  "seoDescription": "${entry.content.seoDescription}",
                                  "ogTitle": "${entry.content.ogTitle}",
                                  "ogDescription": "${entry.content.ogDescription}",
                                  "ogImage": "${entry.content.ogImage}",
                                  "status": "published",
                                  "authorDid": "${entry.content.authorDid}",
                                  "authorName": "${entry.content.authorName}",
                                  "published": true,
                                  "publishedAt": "${generate.timeiso}",
                                  "archivedAt": "",
                                  "deletedAt": "",
                                  "createdAt": "${entry.content.createdAt}",
                                  "updatedAt": "${generate.timeiso}",
                                  "version": 1
                                }
                              }
                            }
                          }
                        },
                        {
                          "id": "studio-delete",
                          "type": "action",
                          "props": {
                            "variant": "destructive",
                            "size": "sm",
                            "icon": "trash",
                            "label": "$t(admin.admin-delete)",
                            "confirm": {
                              "title": "$t(admin.admin-delete-title)",
                              "message": "$t(admin.admin-delete-msg)"
                            },
                            "onSuccessToast": {
                              "intent": "success",
                              "message": "$t(admin.deleted-ok)",
                              "duration": 3000
                            }
                          },
                          "events": {
                            "click": {
                              "exec": "/.actions/write",
                              "args": {
                                "path": "/instance/app/arcblog/drafts/${entry.content.slug}.json",
                                "content": {
                                  "title": "${entry.content.title}",
                                  "slug": "${entry.content.slug}",
                                  "summary": "${entry.content.summary}",
                                  "body": "${entry.content.body}",
                                  "coverImage": "${entry.content.coverImage}",
                                  "images": [],
                                  "tags": "${entry.content.tags}",
                                  "category": "${entry.content.category}",
                                  "seoTitle": "${entry.content.seoTitle}",
                                  "seoDescription": "${entry.content.seoDescription}",
                                  "ogTitle": "${entry.content.ogTitle}",
                                  "ogDescription": "${entry.content.ogDescription}",
                                  "ogImage": "${entry.content.ogImage}",
                                  "status": "deleted",
                                  "authorDid": "${entry.content.authorDid}",
                                  "authorName": "${entry.content.authorName}",
                                  "published": false,
                                  "publishedAt": "${entry.content.publishedAt}",
                                  "archivedAt": "${entry.content.archivedAt}",
                                  "deletedAt": "${generate.timeiso}",
                                  "createdAt": "${entry.content.createdAt}",
                                  "updatedAt": "${generate.timeiso}",
                                  "version": 1
                                }
                              }
                            }
                          }
                        },
                        {
                          "id": "draftEdit",
                          "type": "view",
                          "props": {
                            "href": "/edit/${entry.content.slug}",
                            "style": {
                              "display": "block",
                              "cursor": "pointer",
                              "color": "var(--color-dim)"
                            }
                          },
                          "children": [
                            {
                              "id": "draftedit-p-1",
                              "type": "text",
                              "props": {
                                "content": "$t(admin.edit)",
                                "scale": "sm"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
