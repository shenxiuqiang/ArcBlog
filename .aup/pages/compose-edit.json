{
  "id": "arcblog-compose-edit-view-1",
  "type": "view",
  "props": {
    "layout": {
      "gap": "lg"
    }
  },
  "propBind": {
    "post": "/instance/app/arcblog/drafts/$params.slug.json"
  },
  "children": [
    {
      "id": "arcblog-compose-edit-view-1-card-1",
      "type": "view",
      "props": {
        "mode": "card",
        "layout": {
          "gap": "md"
        }
      },
      "visible": "!$session.authenticated",
      "children": [
        {
          "id": "arcblog-compose-edit-view-1-card-1-h2-1",
          "type": "text",
          "props": {
            "level": 2,
            "content": "$t(compose-edit.gate-title)"
          }
        },
        {
          "id": "arcblog-compose-edit-view-1-card-1-p-2",
          "type": "text",
          "props": {
            "content": "$t(compose-edit.gate-desc)",
            "intent": "info"
          }
        },
        {
          "id": "arcblog-compose-edit-view-1-card-1-action-3",
          "type": "action",
          "props": {
            "variant": "primary",
            "label": "$t(compose-edit.login)"
          },
          "events": {
            "click": {
              "navigate": "/.well-known/service/login"
            }
          }
        }
      ]
    },
    {
      "id": "arcblog-compose-edit-view-1-view-2",
      "type": "view",
      "props": {
        "layout": {
          "gap": "lg"
        }
      },
      "visible": "$session.authenticated",
      "children": [
        {
          "id": "arcblog-compose-edit-view-1-view-2-card-1",
          "type": "view",
          "props": {
            "mode": "card",
            "layout": {
              "gap": "md"
            }
          },
          "visible": "!$state.post",
          "children": [
            {
              "id": "arcblog-compose-edit-view-1-view-2-card-1-h2-1",
              "type": "text",
              "props": {
                "level": 2,
                "content": "$t(compose-edit.title)"
              }
            },
            {
              "id": "arcblog-compose-edit-view-1-view-2-card-1-p-2",
              "type": "text",
              "props": {
                "content": "$t(compose-edit.not-found)",
                "intent": "muted"
              }
            },
            {
              "id": "arcblog-compose-edit-view-1-view-2-card-1-action-3",
              "type": "action",
              "props": {
                "variant": "ghost",
                "label": "$t(compose-edit.back)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "admin"
                  }
                }
              }
            }
          ]
        },
        {
          "id": "arcblog-compose-edit-view-1-view-2-view-2",
          "type": "view",
          "props": {
            "layout": {
              "gap": "lg"
            }
          },
          "visible": "$state.post",
          "children": [
            {
              "id": "arcblog-compose-edit-view-1-view-2-view-2-card-1",
              "type": "view",
              "props": {
                "mode": "card",
                "layout": {
                  "gap": "md"
                }
              },
              "children": [
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-1-h3-1",
                  "type": "text",
                  "props": {
                    "level": 3,
                    "content": "$t(compose.editing)"
                  }
                },
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-1-p-2",
                  "type": "text",
                  "props": {
                    "content": "${state.post.slug}",
                    "intent": "muted",
                    "scale": "caption"
                  }
                }
              ]
            },
            {
              "id": "arcblog-compose-edit-view-1-view-2-view-2-card-2",
              "type": "view",
              "props": {
                "mode": "card",
                "layout": {
                  "gap": "md"
                }
              },
              "children": [
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-2-h3-1",
                  "type": "text",
                  "props": {
                    "level": 3,
                    "content": "$t(compose-edit.meta)"
                  }
                },
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-2-input-2",
                  "type": "input",
                  "props": {
                    "type": "text",
                    "label": "$t(compose-edit.f-title)",
                    "name": "title",
                    "required": true
                  },
                  "state": {
                    "value": "${state.post.title}"
                  }
                },
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-2-input-3",
                  "type": "input",
                  "props": {
                    "type": "text",
                    "label": "$t(compose-edit.f-slug)",
                    "name": "slug",
                    "required": true
                  },
                  "state": {
                    "value": "${state.post.slug}"
                  }
                },
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-2-p-4",
                  "type": "text",
                  "props": {
                    "content": "$t(compose-edit.slug-hint)",
                    "intent": "muted",
                    "scale": "caption"
                  }
                },
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-2-input-5",
                  "type": "input",
                  "props": {
                    "type": "select",
                    "label": "$t(compose-edit.category)",
                    "name": "category",
                    "options": [
                      "technology",
                      "design",
                      "life"
                    ]
                  },
                  "state": {
                    "value": "${state.post.category}"
                  }
                },
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-2-input-6",
                  "type": "input",
                  "props": {
                    "type": "text",
                    "label": "$t(compose-edit.tags)",
                    "name": "tags"
                  },
                  "state": {
                    "value": "${state.post.tags}"
                  }
                },
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-2-input-7",
                  "type": "input",
                  "props": {
                    "type": "text",
                    "label": "$t(compose-edit.f-summary)",
                    "name": "summary"
                  },
                  "state": {
                    "value": "${state.post.summary}"
                  }
                },
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-2-input-8",
                  "type": "input",
                  "props": {
                    "type": "text",
                    "label": "$t(compose-edit.f-cover)",
                    "name": "coverImage"
                  },
                  "state": {
                    "value": "${state.post.coverImage}"
                  }
                },
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-2-p-9",
                  "type": "text",
                  "props": {
                    "content": "$t(compose-edit.cover-hint)",
                    "intent": "muted",
                    "scale": "caption"
                  }
                }
              ]
            },
            {
              "id": "arcblog-compose-edit-view-1-view-2-view-2-card-3",
              "type": "view",
              "props": {
                "mode": "card",
                "layout": {
                  "gap": "md"
                }
              },
              "children": [
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-3-h3-1",
                  "type": "text",
                  "props": {
                    "level": 3,
                    "content": "$t(compose-edit.seo)"
                  }
                },
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-3-p-2",
                  "type": "text",
                  "props": {
                    "content": "$t(compose-edit.seo-desc)",
                    "intent": "muted"
                  }
                },
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-3-input-3",
                  "type": "input",
                  "props": {
                    "type": "text",
                    "label": "SEO Title",
                    "name": "seoTitle"
                  },
                  "state": {
                    "value": "${state.post.seoTitle}"
                  }
                },
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-3-input-4",
                  "type": "input",
                  "props": {
                    "type": "text",
                    "label": "SEO Description",
                    "name": "seoDescription"
                  },
                  "state": {
                    "value": "${state.post.seoDescription}"
                  }
                },
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-3-input-5",
                  "type": "input",
                  "props": {
                    "type": "text",
                    "label": "OG Title",
                    "name": "ogTitle"
                  },
                  "state": {
                    "value": "${state.post.ogTitle}"
                  }
                },
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-3-input-6",
                  "type": "input",
                  "props": {
                    "type": "text",
                    "label": "OG Description",
                    "name": "ogDescription"
                  },
                  "state": {
                    "value": "${state.post.ogDescription}"
                  }
                },
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-3-input-7",
                  "type": "input",
                  "props": {
                    "type": "text",
                    "label": "OG Image",
                    "name": "ogImage"
                  },
                  "state": {
                    "value": "${state.post.ogImage}"
                  }
                }
              ]
            },
            {
              "id": "arcblog-compose-edit-view-1-view-2-view-2-card-4",
              "type": "view",
              "props": {
                "mode": "card",
                "layout": {
                  "gap": "md"
                }
              },
              "children": [
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-4-input-1",
                  "type": "input",
                  "props": {
                    "type": "textarea",
                    "label": "$t(compose-edit.f-body)",
                    "name": "body",
                    "required": true
                  },
                  "state": {
                    "value": "${state.post.body}"
                  }
                }
              ]
            },
            {
              "id": "arcblog-compose-edit-view-1-view-2-view-2-row-5",
              "type": "view",
              "props": {
                "layout": {
                  "direction": "row",
                  "gap": "sm"
                }
              },
              "children": [
                {
                  "id": "save-draft",
                  "type": "action",
                  "props": {
                    "variant": "secondary",
                    "label": "$t(compose-edit.save-draft)",
                    "onSuccessToast": {
                      "intent": "success",
                      "message": "$t(compose.draft-saved)",
                      "duration": 3000
                    }
                  },
                  "events": {
                    "click": {
                      "exec": "/.actions/write",
                      "args": {
                        "path": "/instance/app/arcblog/drafts/${args.slug}.json",
                        "content": {
                          "title": "${args.title}",
                          "slug": "${args.slug}",
                          "summary": "${args.summary}",
                          "body": "${args.body}",
                          "coverImage": "${args.coverImage}",
                          "images": [],
                          "tags": "${args.tags}",
                          "category": "${args.category}",
                          "seoTitle": "${args.seoTitle}",
                          "seoDescription": "${args.seoDescription}",
                          "ogTitle": "${args.ogTitle}",
                          "ogDescription": "${args.ogDescription}",
                          "ogImage": "${args.ogImage}",
                          "status": "draft",
                          "authorDid": "${state.post.authorDid}",
                          "authorName": "${state.post.authorName}",
                          "published": false,
                          "publishedAt": "",
                          "archivedAt": "",
                          "deletedAt": "",
                          "createdAt": "${state.post.createdAt}",
                          "updatedAt": "${generate.timeiso}",
                          "version": "${state.post.version}"
                        }
                      }
                    }
                  }
                },
                {
                  "id": "publish-now",
                  "type": "action",
                  "props": {
                    "variant": "primary",
                    "label": "$t(compose-edit.publish-now)",
                    "onSuccessToast": {
                      "intent": "success",
                      "message": "$t(compose-edit.publish-hint)",
                      "duration": 3000
                    }
                  },
                  "events": {
                    "click": {
                      "exec": "/.actions/write",
                      "args": {
                        "path": "/instance/app/arcblog/posts/${args.slug}.json",
                        "content": {
                          "title": "${args.title}",
                          "slug": "${args.slug}",
                          "summary": "${args.summary}",
                          "body": "${args.body}",
                          "coverImage": "${args.coverImage}",
                          "images": [],
                          "tags": "${args.tags}",
                          "category": "${args.category}",
                          "seoTitle": "${args.seoTitle}",
                          "seoDescription": "${args.seoDescription}",
                          "ogTitle": "${args.ogTitle}",
                          "ogDescription": "${args.ogDescription}",
                          "ogImage": "${args.ogImage}",
                          "status": "published",
                          "authorDid": "${state.post.authorDid}",
                          "authorName": "${state.post.authorName}",
                          "published": true,
                          "publishedAt": "${generate.timeiso}",
                          "archivedAt": "",
                          "deletedAt": "",
                          "createdAt": "${state.post.createdAt}",
                          "updatedAt": "${generate.timeiso}",
                          "version": "${state.post.version}"
                        }
                      }
                    }
                  }
                }
              ]
            },
            {
              "id": "arcblog-compose-edit-view-1-view-2-view-2-card-6",
              "type": "view",
              "props": {
                "mode": "card",
                "layout": {
                  "gap": "md"
                }
              },
              "children": [
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-6-h3-1",
                  "type": "text",
                  "props": {
                    "level": 3,
                    "content": "$t(compose-edit.images)"
                  }
                },
                {
                  "id": "arcblog-compose-edit-view-1-view-2-view-2-card-6-p-2",
                  "type": "text",
                  "props": {
                    "content": "$t(compose-edit.images-desc)",
                    "intent": "muted"
                  }
                }
              ]
            },
            {
              "id": "arcblog-compose-edit-view-1-view-2-view-2-afs-dropzone-7",
              "type": "afs-dropzone"
            }
          ]
        }
      ]
    }
  ]
}
