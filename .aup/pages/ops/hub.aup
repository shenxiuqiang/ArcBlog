page hub {
  i18n {
    adv-hide { en "Hide advanced" zh "收起高级" }
    adv-show { en "Show advanced (CLI & queue)" zh "展开高级（CLI 与队列）" }
    apply-desc { en "A Studio applies to a Hub by DID and stays applied until the Hub approves. Every button here only queues ONE intent record — the local worker, run with the commands under Advanced, performs it; a success toast is not proof." zh "Studio 以 DID 向 Hub 提交申请，在 Hub 通过前保持 applied。本页按钮只入队一条意图记录——由本机 worker（用「高级」下的命令运行）执行；成功 toast 不是证据。" }
    approve { en "Approve" zh "通过" }
    btn-register { en "Apply" zh "提交申请" }
    confirm-register-msg { en "Queues ONE intent: the local worker applies to this Hub (relation applied until the Hub approves). This page writes no relation itself." zh "入队一条意图：由本机 worker 向该 Hub 提交申请（通过前 relation 保持 applied）。本页自身不写收录关系。" }
    desc { en "Studio ↔ Hub relations and the derived content index. Indexing is the Hub's sovereignty: metadata only, never the source body." zh "Studio ↔ Hub 收录关系与派生内容索引。索引是 Hub 的主权行为：只承载元数据，永不承载原文。" }
    enqueue-failed { en "Could not queue the intent — read the intent queue under Advanced (a toast is not proof)." zh "无法入队——请在「高级」下核对意图队列（toast 不是证据）。" }
    gate-desc { en "Sign in with DID Wallet to curate Studios and the content index." zh "使用 DID Wallet 登录后管理 Studio 收录与内容索引。" }
    hub-did-label { en "Hub DID" zh "Hub DID" }
    hub-endpoint-label { en "Endpoint (optional)" zh "Endpoint（可选）" }
    index-card { en "Content index (derived)" zh "内容索引（派生）" }
    login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
    purge { en "Purge" zh "彻底删除" }
    purge-msg { en "Deletes the tombstone entirely. Prefer Terminate for auditability." zh "将记录彻底删除。为了可审计性，建议使用「终止」。" }
    queue-clear { en "Clear" zh "清除" }
    queue-clear-msg { en "Deletes this intent record only. It does not change the relation or the index." zh "只删除这条意图记录。不会改变收录关系或索引。" }
    queue-title { en "Intent queue" zh "意图队列" }
    queue-legend { en "pending = queued, not run yet · applied = the worker ran it · rejected = refused, zero change · noop = already in that state" zh "pending = 已排队、尚未执行 · applied = worker 已执行 · rejected = 被拒绝、零改动 · noop = 已是该状态" }
    queued { en "Queued — the local worker executes it." zh "已入队——由本机 worker 执行。" }
    reject { en "Terminate" zh "终止" }
    relations { en "Studio ↔ Hub relations" zh "Studio ↔ Hub 收录关系" }
    relations-legend { en "relation: applied = awaiting review · indexed = live · removed = terminated (tombstone kept) · direction: studio = this Studio applied to the Hub, hub = the Hub indexed this Studio on its own · freshness: fresh / stale / never / offline (offline = the last sync failed; one Hub's failure never blocks another) · a ● dot and the machine value always appear together — this platform cannot pick a localized label per record." zh "relation：applied = 待审核 · indexed = 已收录 · removed = 已终止（保留 Tombstone）· direction：studio = 本 Studio 向该 Hub 申请，hub = 该 Hub 主动收录本 Studio · freshness：fresh / stale / never / offline（offline = 最近一次同步失败；一个 Hub 的失败不阻塞其他 Hub）· ● 色点与机器值始终同排显示——本平台无法按记录取不同的本地化文案。" }
    title { en "Hub console" zh "Hub 管理" }
    write-failed { en "Write failed — verify the record (a success toast is not proof)." zh "写入失败——请复核记录（成功 toast 不是证据）。" }
  }
  // UI-018 D4 (§7.4 / §4.10③): the queue card's status legend is byte-aligned with
  // scripts/lib/intents.mjs and deliberately does NOT mention `running`:
  // arcblog-network.mjs never writes that in-flight state (it goes
  // pending → applied|rejected|noop), and no page may claim an unreachable state.
  // Prototype declaration (docs/ArcBlog-admin-ui-design.md §2.7.1): P1 + P5.
  // P1 — the page manages one record class (Studio ↔ Hub relations) with exactly
  // one list and one register row; P5 — the derived content index is the status
  // summary, and every command (CLI + the intent queue) is folded behind the
  // level-3 "advanced" collapse (§2.7.3). No other prototype is mixed in: the
  // apply/add/index-rebuild form was removed, its capability stays reachable via
  // the CLI rows and the single queued intent the register button writes.
  view gap=lg style={height: "calc(100vh - 48px)", overflow: visible} {
    view style={gap: "0"} {
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "20px"} visible="!$session.authenticated" {
        h2 :title level=2 style={fontSize: "var(--type-body)"}
        p :gate-desc intent=muted
        row cross=start {
          action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dhub&cancel_to=%2F%3Fpage%3Dhub" variant=primary label=:login
        }
      }
      row gap=lg cross=stretch style={width: "100vw", marginLeft: "calc(50% - 50vw)", height: "calc(100vh - 48px)", marginBottom: "-52px", padding: "0 32px 0 0"} visible=$session.authenticated {
        view size={width: "clamp(200px, 15vw, 280px)", flexShrink: 0, height: "100%"} style={padding: "0", background: "var(--color-surface)", borderRight: "1px solid var(--color-border)", overflowY: auto, gap: "0", height: "100%"} visible=$session.authenticated {
          p "$t(wrapper.nav-group-content)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-dashboard)" -> page dashboard style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-studio)" -> page posts style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-pages)" -> page pages style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-write)" -> page compose style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-site)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-heroes)" -> page heroes style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-categories)" -> page categories style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-tags)" -> page tags style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-seo)" -> page seo style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-feeds)" -> page feeds style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-appearance)" -> page appearance style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-ops)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-operations)" -> page operations style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-hub)" -> page hub active=true style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-media)" -> page media style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-agents)" -> page agents style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-economy)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-orders)" -> page orders style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-policy)" -> page policy style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-access)" -> page access style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-ledger)" -> page ledger style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-factory)" -> page factory style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-settings)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-settings)" -> page general style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-diagnostics)" -> page diagnostics style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={marginTop: auto, background: "var(--color-bg)", borderTop: "1px solid var(--color-border)", flexShrink: 0, gap: "0"} {
            p "$t(wrapper.footer-brand)" scale=caption intent=muted style={padding: "10px 20px 2px 32px", flexShrink: 0}
            action "$t(wrapper.footer-about)" href="/?page=about" style={border: none, borderRadius: "0", padding: "4px 20px 4px 32px", justifyContent: flex-start, flexShrink: 0}
            action "$t(wrapper.footer-rss)" href="/p/rss.xml" target=_blank style={border: none, borderRadius: "0", padding: "4px 20px 4px 32px", justifyContent: flex-start, flexShrink: 0}
            p "$t(wrapper.footer-copyright)" scale=caption intent=muted style={padding: "2px 20px 10px 32px", flexShrink: 0}
          }
        }
        view gap=md size={flex: 1} style={paddingTop: "14px", paddingBottom: "14px", minHeight: 0} {
          view gap=xs {
            h2 :title level=2 style={fontSize: "var(--type-subheading)"}
            p :desc intent=muted
          }
          view gap=sm size={flex: 1} style={overflowY: auto} {
            // Card 1 — the relation list (P1). Register is the page's ONE primary
            // action and only queues an intent; the row keeps at most
            // approve / terminate inline, with purge behind a confirm (§2.7.1).
            view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px", flexShrink: 0} {
              h3 :relations level=3 style={fontSize: "var(--type-body)"}
              row gap=sm cross=end {
                input type=text name=hubDid label=:hub-did-label
                input type=text name=hubEndpoint label=:hub-endpoint-label
                action variant=primary label=:btn-register confirm={title: :btn-register, message: :confirm-register-msg} onSuccessToast={intent: success, message: "$t(hub.queued)", duration: 3000} onErrorToast={intent: error, message: "$t(hub.enqueue-failed)", duration: 4000} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/hub-intents/${generate.timeiso}.json", content: {id: "${generate.timeiso}", action: register, hubDid: "${args.hubDid}", endpoint: "${args.hubEndpoint}", update: "", status: pending, message: "", changed: [], counts: null, elapsedMs: null, requestedVia: console, requestedAt: "${generate.timeiso}"}}}}
              }
              p :apply-desc scale=sm intent=muted
              afs-list hub-relations-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none pagination=manual pageSize=20 from "/instance/app/arcblog/hub/registrations" {
                row gap=sm cross=start role=item {
                  view gap=xs size={flex: 1} {
                    p "${entry.content.hubDid}" format=did
                    row gap=xs cross=center {
                      p "●" scale=sm intent=muted title="${entry.content.status}"
                      p "${entry.content.relation}" scale=sm
                      p "${entry.content.direction}" scale=sm intent=muted
                      p "${entry.content.freshness.state}" scale=sm
                      time mode=display value="${entry.content.updatedAt}" timeMode=relative
                    }
                    p "${entry.content.sync.lastError}" scale=sm intent=warning visible="${entry.content.sync.lastError}"
                  }
                  // §4.7⑦ / arc-contracts §29.8(3): every `afs-list itemStyle=row`
                  // child is `flex: 1 1 0%`, so this fixed-size action cluster used to
                  // stretch to half the row (content column got 50% instead of the
                  // full remaining width — the BUG-034 overflow mechanism). Basis must
                  // be `auto`, not just `flexGrow: 0`, or the cluster collapses to 0.
                  row gap=sm cross=center style={flexGrow: 0, flexBasis: auto} {
                    action variant=secondary size=sm label=:approve onErrorToast={intent: error, message: "$t(hub.write-failed)", duration: 4000} events={click: {exec: "/.actions/write", args: {path: "${args.ePath}", mode: tree-merge, content: {relation: indexed, removedAt: "", updatedAt: "${generate.timeiso}"}}}}
                    action variant=secondary size=sm label=:reject onErrorToast={intent: error, message: "$t(hub.write-failed)", duration: 4000} events={click: {exec: "/.actions/write", args: {path: "${args.ePath}", mode: tree-merge, content: {relation: removed, removedAt: "${generate.timeiso}", updatedAt: "${generate.timeiso}"}}}}
                    action -> exec "/.actions/delete" variant=destructive size=sm icon=trash label=:purge path="${entry.path}" confirm={title: :purge, message: :purge-msg} onErrorToast={intent: error, message: "$t(hub.write-failed)", duration: 4000}
                  }
                  input type=hidden name=ePath value="${entry.path}"
                }
              }
              p :relations-legend scale=sm intent=muted
            }
            // Card 2 — the Hub's derived index (metadata only; tombstones stay
            // visible). Everything technical lives behind the level-3 collapse
            // (§2.7.3): the CLI command families and the intent queue.
            view hub-advanced gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px", flexShrink: 0} {
              h3 :index-card level=3 style={fontSize: "var(--type-body)"}
              afs-list hub-index-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none pagination=manual pageSize=20 from "/instance/app/arcblog/hub/index" {
                row gap=sm cross=center role=item {
                  view gap=xs size={flex: 1, minWidth: 0} {
                    p "${entry.content.title}" scale=lg
                    p "${entry.content.postId} · v${entry.content.version}" scale=sm intent=muted
                  }
                  p "●" scale=sm intent=muted title="${entry.content.status}"
                  p "${entry.content.status}" scale=sm
                  time mode=display value="${entry.content.indexedAt}" timeMode=relative
                }
              }
              row cross=start {
                action -> set hub-advanced state {open: "true"} variant=secondary size=sm label=:adv-show
              }
              view gap=sm visible=$state.open {
                key-value-list dense=true fields=[{label: hub, value: "node scripts/arcblog-network.mjs hub register|show|add|sync|index rebuild --hub-did <did> [--endpoint <url>] [--update] [--version <n>] [--status never|ok|stale|error] [--error <message>]", monospace: true, copyable: true}, {label: worker, value: "node scripts/arcblog-network.mjs queue|apply|watch", monospace: true, copyable: true}]
                p :queue-title scale=sm intent=muted
                p :queue-legend scale=caption intent=muted
                afs-list hub-intents layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none pagination=manual pageSize=10 from "/instance/app/arcblog/config/hub-intents" {
                  row gap=sm cross=center role=item {
                    view gap=xs size={flex: 1} {
                      row gap=xs cross=center {
                        p "●" scale=sm intent=muted title="${entry.content.action} · ${entry.content.status}"
                        p "${entry.content.action}" scale=sm
                        p "${entry.content.status}" scale=sm
                        time mode=display value="${entry.content.requestedAt}" timeMode=relative
                      }
                      p "${entry.content.message}" scale=sm intent=muted
                    }
                    action -> exec "/.actions/delete" variant=destructive size=sm icon=trash label=:queue-clear confirm={title: :queue-clear, message: :queue-clear-msg} path="${entry.path}"
                  }
                }
                row cross=start {
                  action -> set hub-advanced state {open: ""} variant=secondary size=sm label=:adv-hide
                }
              }
            }
          }
        }
      }
    }
  }
}
