page factory {
  i18n {
    title { en "Node NFT" zh "节点 NFT" }
    desc { en "The on-chain identity of this node: the SVG card it renders, the factories that mint it, and one-click buy / stake / revoke / claim." zh "本节点的链上身份：它渲染的 SVG 卡片、铸造它的工厂，以及一键购买 / 质押 / 撤回 / 取回。" }
    gate-title { en "Node NFT" zh "节点 NFT" }
    gate-desc { en "Sign in with DID Wallet to view the node NFT and operate it." zh "使用 DID Wallet 登录后查看并操作节点 NFT。" }
    login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
    projection { en "Read from the public projection node/factories.json; the authoritative records stay admin-only, and no key material is mirrored. Every state line (chain / node / card / transaction / status) is precomputed by the CLI and printed here verbatim, so each printed line is standing copy that must hold in every state. An empty state line means the projection has not been written yet — run the regeneration command above." zh "数据来自公开投影 node/factories.json；权威记录仅管理员可读，投影不含任何密钥材料。状态行（链 / 节点 / 卡片 / 交易 / 状态）由 CLI 预先算好、本页逐字打印，因此每一行都是必须在任何状态下都成立的常驻文案。状态行为空只表示投影还没写入——运行上方命令重新生成即可。" }
    render-timing { en "First-load note: on this platform the projection is bound AFTER the first render, so on a cold visit every field below can read the empty placeholder — that means \"not bound yet / unavailable\", never \"the record is empty\". Expand the advanced details or reload once to bind it (measured 2026-09-28: no channel recovers on its own)." zh "首屏提示：本平台在首次渲染之后才完成投影绑定，因此冷启动进入时下列字段可能全部显示空占位「—」——请读作「尚未绑定 / 暂不可用」，不是「记录为空」。展开高级详情或刷新一次即可绑定（2026-09-28 实测：不做任何操作不会自行恢复）。" }
    chain-adapter { en "Adapter" zh "适配器" }
    chain-network { en "Network" zh "网络" }
    chain-host { en "Chain host" zh "链地址" }
    chain-token { en "Mint token" zh "铸造代币" }
    state-note { en "Projection state (computed by the CLI)" zh "投影状态（由 CLI 计算）" }
    registry-link-label { en "Is it live right now?" zh "现在还是活的吗？" }
    dropped-label { en "Stale role records dropped (computed by the CLI)" zh "已丢弃的陈旧角色记录（由 CLI 计算）" }
    registry-link-value { en "This page is the NFT lifecycle record. Whether the node counts as a live registry entry is a separate projection — open the Registry page, or run the command on the right." zh "本页是 NFT 生命周期记录。该节点当前是否算作注册表中的存活条目是另一个投影——请打开「注册表」页，或运行右侧命令。" }
    cli-label { en "Regenerate the projection (CLI)" zh "重新生成投影（CLI）" }
    factories { en "Factories" zh "工厂" }
    factory-studio { en "Studio node factory" zh "Studio 节点工厂" }
    factory-address { en "Factory address" zh "工厂地址" }
    factory-moniker { en "Moniker" zh "标识" }
    factory-issuer { en "Issuer wallet" zh "发行钱包" }
    factory-stake { en "Stake per node" zh "每个节点质押" }
    node-moniker { en "NFT" zh "NFT" }
    node-state { en "Lifecycle" zh "生命周期" }
    node-asset { en "Asset address" zh "资产地址" }
    node-stake { en "Stake address" zh "质押地址" }
    node-owner { en "Owner" zh "所有者" }
    node-endpoint { en "Endpoint" zh "端点" }
    node-region { en "Region" zh "区域" }
    node-claimable { en "Claimable at" zh "可取回时间" }
    node-svg { en "NFT card" zh "NFT 卡片" }
    tx { en "On-chain transactions" zh "链上交易" }
    tx-acquire { en "Acquire" zh "铸造" }
    tx-stake { en "Stake" zh "质押" }
    tx-revoke { en "Revoke" zh "撤回" }
    tx-claim { en "Claim" zh "取回" }
    advanced { en "Advanced / technical details" zh "高级 / 技术详情" }
    advanced-show { en "Show advanced details" zh "展开高级详情" }
    advanced-hide { en "Hide advanced details" zh "收起高级详情" }
    advanced-note { en "Addresses and transaction hashes read from node/factories.json; the public key is bound into the on-chain NFT template, and no key material is mirrored here. Whether a value is chain truth is decided PER NODE, never from the file header — see the attribution card." zh "地址与交易哈希读自 node/factories.json；公钥绑定在链上 NFT 模板内，本投影不含任何密钥材料。某个值是否为链上事实按**逐节点**判定，绝不按文件头 —— 见归属卡片。" }
    truth-title { en "Is it really on chain? (per node)" zh "是否真的在链上？（逐节点）" }
    truth-studio { en "Node studio" zh "节点 studio" }
    truth-studio-adapter { en "Node studio · adapter" zh "节点 studio · 适配器" }
    truth-studio-sim { en "Node studio · fact kind" zh "节点 studio · 事实类型" }
    truth-factories { en "Factories" zh "工厂" }
    truth-note { en "Each node records the adapter that produced its facts, in three states — mock (simulation, never chain truth) · ocap (real chain, verifiable) · unknown (nothing was ever recorded). The header adapter describes the factory config only, so it must never decide whether a node is chain truth — judge per node." zh "每个节点各自记录产出其事实的 adapter，共三态 —— mock（模拟，绝非链上事实）· ocap（真链，可核验）· unknown（从未记录）。文件头的 adapter 只描述工厂配置，绝不能用它判定某个节点是否链上事实——请按节点判定。" }
    actions { en "Actions" zh "操作" }
    actions-desc { en "One click queues the intent; the node's chain worker signs it (the key never reaches the browser) and the queue below updates live." zh "点击即入队；由节点上的链 worker 签名执行（私钥永不下发浏览器），下方队列实时更新。" }
    act-acquire { en "Buy / mint" zh "购买 / 铸造" }
    act-stake { en "Stake" zh "质押" }
    act-revoke { en "Revoke (withdraw)" zh "撤回" }
    act-claim { en "Claim back" zh "取回" }
    confirm-acquire-title { en "Buy a node NFT?" zh "购买节点 NFT？" }
    confirm-acquire-msg { en "The factory mints one Studio node NFT to this node's owner wallet, on chain, immediately." zh "工厂会立即在链上铸造一枚 Studio 节点 NFT 给本节点属主钱包。" }
    confirm-stake-title { en "Stake the node NFT?" zh "质押节点 NFT？" }
    confirm-stake-msg { en "The NFT locks into the factory stake and the role becomes staked." zh "NFT 将锁入工厂质押，角色进入 staked。" }
    confirm-revoke-title { en "Revoke the stake?" zh "撤回质押？" }
    confirm-revoke-msg { en "Assets leave the stake and a waiting period starts before the final claim." zh "资产将离开质押，并进入等待期，之后才能最终取回。" }
    confirm-claim-title { en "Claim the stake back?" zh "取回质押？" }
    confirm-claim-msg { en "The NFT returns to the owner wallet and the stake closes." zh "NFT 回到属主钱包，质押关闭。" }
    intent-queued { en "Intent queued — watch the queue below." zh "意图已入队 —— 留意下方队列。" }
    queue { en "Intent queue" zh "意图队列" }
    queue-standing-note { en "Every queued chain intent appears in the list above, oldest first: a row is written the moment a button is clicked, so an empty list simply means nothing has been queued on this node yet." zh "凡是入队的链上意图都会出现在上方列表里（最早在前）：点击按钮的瞬间就会写入一行，因此列表为空只表示本机还没有任何入队记录。" }
    queue-admin { en "The queue lives in config/ (admin-only): only the blocklet owner can queue or watch chain operations." zh "队列位于 config/（仅管理员）：只有 Blocklet 属主可以入队或查看链上操作。" }
    queue-clear { en "Clear" zh "清除" }
    queue-clear-title { en "Clear this intent record?" zh "清除这条意图记录？" }
    queue-clear-msg { en "Removes the record from the queue. The chain transaction is unaffected." zh "从队列移除该记录。链上交易不受影响。" }
    status-intent { en "Status" zh "状态" }
    status-note { en "pending = waiting for the worker · applied = signed on chain · rejected = refused, nothing changed" zh "pending = 等待 worker · applied = 已在链上签名 · rejected = 被拒绝，无改动" }
    worker-hint { en "Queued actions are signed by this node's chain worker; the browser never holds the key." zh "入队的操作由本机链 worker 执行签名；浏览器不持有任何密钥。" }
    docs { en "Runbook and worker command: see the Diagnostics page." zh "运维手册与 worker 命令：见「诊断与维护」页。" }
  }
  view gap=lg style={height: "calc(100vh - 48px)", overflow: visible} {
    view style={gap: "0"} {
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "20px"} visible="!$session.authenticated" {
        h2 :gate-title level=2 style={fontSize: "var(--type-body)"}
        p :gate-desc intent=muted
        row cross=start {
          action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dfactory&cancel_to=%2F%3Fpage%3Dfactory" variant=primary label=:login style={borderRadius: "var(--radius-md, 8px)"}
        }
      }
      row gap=lg cross=stretch style={width: "100vw", marginLeft: "calc(50% - 50vw)", height: "calc(100vh - 48px)", marginBottom: "-52px", padding: "0 32px 0 0"} visible=$session.authenticated {
        view size={width: "clamp(200px, 15vw, 280px)", flexShrink: 0, height: "100%"} style={padding: "0", background: "var(--color-surface)", borderRight: "1px solid var(--color-border)", overflowY: auto, gap: "0", height: "100%"} visible=$session.authenticated {
          p "$t(wrapper.nav-group-content)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-dashboard)" -> page dashboard style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-studio)" -> page posts style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-pages)" -> page pages style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-write)" -> page compose style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-site)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-heroes)" -> page heroes style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-categories)" -> page categories style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-tags)" -> page tags style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-feeds)" -> page feeds style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-ops)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-operations)" -> page operations style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-registry)" -> page registry style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-factory)" -> page factory active=true style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-agents)" -> page agents style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-settings)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-settings)" -> page general style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-diagnostics)" -> page diagnostics style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view gap=xs style={padding: "10px 20px 10px 32px", background: "var(--color-bg)", borderTop: "1px solid var(--color-border)", flexShrink: 0} visible="!$session.isAdmin" {
            p "$t(wrapper.admin-notice)" scale=caption intent=muted
          }
        }
        view gap=sm size={flex: 1} style={overflowY: auto} propBind={summary: "/instance/app/arcblog/node/factories.json"} {
          view gap=xs {
            h2 :title level=2 style={fontSize: "var(--type-subheading)"}
            p :desc intent=muted
            p :projection intent=muted scale=sm
            p :render-timing intent=muted scale=sm
            key-value-list factory-cli dense=true fields=[{label: "$t(factory.cli-label)", value: "node scripts/arcblog-factory.mjs project"}]
            key-value-list factory-state dense=true fields=[{label: "$t(factory.state-note)", value: "${state.summary.stateNote}"}]
            // DEF-13: when the projection dropped a role that no longer exists, the
            // record says so and this standing line prints it (empty string otherwise —
            // the value is precomputed by the CLI; a record cannot pick a locale, §28.8).
            key-value-list factory-dropped dense=true fields=[{label: "$t(factory.dropped-label)", value: "${state.summary.droppedNote}"}]
            // Standing cross-reference (QA R4–R8 observation): this page shows the
            // node-NFT LIFECYCLE facts (what was acquired/staked/revoked, from
            // node/factories.json); whether the node is LIVE in the chain registry
            // today is a separate projection. Reading only this page can look like
            // a contradiction, so the two are linked in standing copy.
            key-value-list factory-registry-link dense=true fields=[{label: "$t(factory.registry-link-label)", value: "node scripts/arcblog-network.mjs registry show", monospace: true, copyable: true}]
          }
          grid gap=md style={gridTemplateColumns: "minmax(0, 1fr)", alignItems: start} {
            view gap=sm {
              view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px", flexShrink: 0} {
                h3 :actions level=3 style={fontSize: "var(--type-body)"}
                p :actions-desc intent=muted scale=sm
                row gap=sm {
                  action variant=primary label=:act-acquire confirm={title: :confirm-acquire-title, message: :confirm-acquire-msg} onSuccessToast={intent: success, message: "$t(factory.intent-queued)", duration: 3000} style={borderRadius: "var(--radius-md, 8px)"} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/chain-intents/pending.json", content: {id: pending, action: acquire, role: studio, status: pending, requestedBy: $session.did, requestedAt: "${generate.timeiso}", requestedVia: console, args: {}, result: {assetId: "", stakeAddress: "", hash: "", lifecycle: ""}, error: ""}}}}
                  action variant=secondary label=:act-stake confirm={title: :confirm-stake-title, message: :confirm-stake-msg} onSuccessToast={intent: success, message: "$t(factory.intent-queued)", duration: 3000} style={borderRadius: "var(--radius-md, 8px)"} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/chain-intents/pending.json", content: {id: pending, action: stake, role: studio, status: pending, requestedBy: $session.did, requestedAt: "${generate.timeiso}", requestedVia: console, args: {}, result: {assetId: "", stakeAddress: "", hash: "", lifecycle: ""}, error: ""}}}}
                  action variant=secondary label=:act-revoke confirm={title: :confirm-revoke-title, message: :confirm-revoke-msg} onSuccessToast={intent: success, message: "$t(factory.intent-queued)", duration: 3000} style={borderRadius: "var(--radius-md, 8px)"} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/chain-intents/pending.json", content: {id: pending, action: revoke, role: studio, status: pending, requestedBy: $session.did, requestedAt: "${generate.timeiso}", requestedVia: console, args: {}, result: {assetId: "", stakeAddress: "", hash: "", lifecycle: ""}, error: ""}}}}
                  action variant=secondary label=:act-claim confirm={title: :confirm-claim-title, message: :confirm-claim-msg} onSuccessToast={intent: success, message: "$t(factory.intent-queued)", duration: 3000} style={borderRadius: "var(--radius-md, 8px)"} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/chain-intents/pending.json", content: {id: pending, action: claim, role: studio, status: pending, requestedBy: $session.did, requestedAt: "${generate.timeiso}", requestedVia: console, args: {}, result: {assetId: "", stakeAddress: "", hash: "", lifecycle: ""}, error: ""}}}}
                }
                p :worker-hint intent=muted scale=sm
                p :docs intent=muted scale=sm
                h3 :queue level=3 style={fontSize: "var(--type-body)"}
                p :queue-admin intent=muted scale=sm
                afs-list factory-intents layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none pagination=manual pageSize=10 from "/instance/app/arcblog/config/chain-intents" {
                  row gap=sm cross=center role=item {
                    view gap=xs style={flex: "1 1 0%"} {
                      row gap=xs cross=center {
                        p "●" scale=sm intent=muted title="${entry.content.action} · ${entry.content.status}"
                        p :status-intent scale=sm
                        p "${entry.content.status}" scale=sm
                        p "${entry.content.role}" scale=sm intent=muted
                      }
                      row gap=xs cross=center {
                        view style={fontSize: "var(--type-small)", color: "var(--color-dim)"} {
                          time mode=display value="${entry.content.requestedAt}" timeMode=relative
                        }
                      }
                      p "${entry.content.result.hash}" scale=sm intent=muted
                      p "${entry.content.error}" scale=sm intent=warning
                    }
                    action -> exec "/.actions/delete" variant=destructive size=sm icon=trash label=:queue-clear confirm={title: :queue-clear-title, message: :queue-clear-msg} style={borderRadius: "var(--radius-md, 8px)", flexGrow: 0} path="${entry.path}"
                  }
                }
                // BUG-056 (BUG-052's shape, fixed in R21): a STANDING note, not
                // an empty-state claim. The platform cannot probe a list's
                // length (arc-contracts §21) and `afs-list emptyText` is not
                // evaluated at runtime (§20), so an unconditional "nothing
                // queued yet" could contradict a non-empty queue. Keep this
                // paragraph unconditional — no `visible` condition is possible.
                p :queue-standing-note scale=sm intent=muted
                p :status-note scale=sm intent=muted
              }
              view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px", flexShrink: 0} propBind={summary: "/instance/app/arcblog/node/factories.json"} {
                h3 :factories level=3 style={fontSize: "var(--type-body)"}
                p "${state.summary.chainNote}" intent=info scale=sm
                key-value-list factory-chain dense=true fields=[{label: "$t(factory.chain-adapter)", value: "${state.summary.adapter}"}, {label: "$t(factory.chain-network)", value: "${state.summary.network}"}]
                p :factory-studio scale=sm intent=muted
                key-value-list factory-studio-kv dense=true fields=[{label: "$t(factory.factory-moniker)", value: "${state.summary.factories.studio.moniker}"}, {label: "$t(factory.factory-stake)", value: "${state.summary.factories.studio.stakeAmount}"}]
                h3 :truth-title level=3 style={fontSize: "var(--type-body)"}
                p :truth-note scale=sm intent=muted
                key-value-list factory-truth-nodes dense=true fields=[{label: "$t(factory.truth-studio)", value: "${state.summary.nodes.studio.attribution}"}, {label: "$t(factory.truth-studio-adapter)", value: "${state.summary.nodes.studio.adapter}"}, {label: "$t(factory.truth-studio-sim)", value: "${state.summary.nodes.studio.simulatedLabel}"}]
                p :truth-factories scale=sm intent=muted
                key-value-list factory-truth-factories dense=true fields=[{label: "$t(factory.factory-studio)", value: "${state.summary.factories.studio.attribution}"}]
                h3 :node-svg level=3 style={fontSize: "var(--type-body)"}
                // Standing copy: the CLI decided this in `cardNote` / `nodeNote`, so
                // the card renders whenever it exists and the note is always true.
                media factory-nft-svg src="${state.summary.nodes.studio.svg}" alt="$t(factory.node-svg)" style={borderRadius: "var(--radius-md, 8px)", width: "100%", maxWidth: "480px"}
                p "${state.summary.nodes.studio.cardNote}" intent=muted scale=sm
                key-value-list factory-node-kv dense=true fields=[{label: "$t(factory.node-moniker)", value: "${state.summary.nodes.studio.moniker}", hideWhenEmpty: true}, {label: "$t(factory.node-state)", value: "${state.summary.nodes.studio.state}", hideWhenEmpty: true}, {label: "$t(factory.node-endpoint)", value: "${state.summary.nodes.studio.endpoint}", monospace: true, hideWhenEmpty: true}, {label: "$t(factory.node-region)", value: "${state.summary.nodes.studio.region}", hideWhenEmpty: true}, {label: "$t(factory.node-claimable)", value: "${state.summary.nodes.studio.claimableAt}", hideWhenEmpty: true}]
                p "${state.summary.nodes.studio.nodeNote}" intent=info scale=sm
                h3 :advanced level=3 style={fontSize: "var(--type-body)"}
                p :advanced-note intent=muted scale=sm
                row cross=start {
                  action -> set factory-advanced state {open: "true"} variant=secondary size=sm label=:advanced-show style={borderRadius: "var(--radius-md, 8px)"}
                }
                view gap=sm visible=$state.open {
                  key-value-list factory-node-adv dense=true fields=[{label: "$t(factory.node-asset)", value: "${state.summary.nodes.studio.assetId}", monospace: true, copyable: true, hideWhenEmpty: true}, {label: "$t(factory.node-owner)", value: "${state.summary.nodes.studio.owner}", monospace: true, copyable: true, hideWhenEmpty: true}, {label: "$t(factory.node-stake)", value: "${state.summary.nodes.studio.stakeAddress}", monospace: true, copyable: true, hideWhenEmpty: true}]
                  p "${state.summary.nodes.studio.nodeNote}" intent=muted scale=sm
                  h3 :tx level=3 style={fontSize: "var(--type-body)"}
                  p "${state.summary.nodes.studio.txNote}" intent=muted scale=sm
                  key-value-list factory-node-tx dense=true fields=[{label: "$t(factory.tx-acquire)", value: "${state.summary.nodes.studio.acquireTx}", monospace: true, copyable: true, hideWhenEmpty: true}, {label: "$t(factory.tx-stake)", value: "${state.summary.nodes.studio.stakeTx}", monospace: true, copyable: true, hideWhenEmpty: true}, {label: "$t(factory.tx-revoke)", value: "${state.summary.nodes.studio.revokeTx}", monospace: true, copyable: true, hideWhenEmpty: true}, {label: "$t(factory.tx-claim)", value: "${state.summary.nodes.studio.claimTx}", monospace: true, copyable: true, hideWhenEmpty: true}]
                  key-value-list factory-chain-adv dense=true fields=[{label: "$t(factory.chain-host)", value: "${state.summary.chainHost}", monospace: true, copyable: true, hideWhenEmpty: true}, {label: "$t(factory.chain-token)", value: "${state.summary.tokenId}", monospace: true, copyable: true, hideWhenEmpty: true}]
                  key-value-list factory-studio-adv dense=true fields=[{label: "$t(factory.factory-address)", value: "${state.summary.factories.studio.address}", monospace: true, copyable: true, hideWhenEmpty: true}, {label: "$t(factory.factory-issuer)", value: "${state.summary.factories.studio.issuer}", monospace: true, copyable: true, hideWhenEmpty: true}]
                  row cross=start {
                    action -> set factory-advanced state {open: ""} variant=secondary size=sm label=:advanced-hide style={borderRadius: "var(--radius-md, 8px)"}
                  }
                }
              }
            }
          }
          // Advanced / technical details. Addresses and transaction hashes are
          // public on chain but not part of the default view (D34): they are
          // folded into one collapsed section, still monospace and copyable.
          // The collapse is a `-> set … state {open: …}` patch on the card and
          // an expression `visible=$state.open`. String values are deliberate:
          // boolean literals in that object trip the DSL formatter's round-trip
          // guard (`content_dropped`, ArcBlock/arc#2764) — measured this round.
          // Single column is the structural fix for the 1512px overflow
          // (docs/05-开发文档/附件/arc-contracts.md §29.8: the style allowlist has no wrapping
          // keys, so the width — not CSS — is what has to change).
        }
      }
    }
  }
}
