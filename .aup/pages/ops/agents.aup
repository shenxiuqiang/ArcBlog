page agents {
  i18n {
    agent-expires { en "Expires" zh "到期" }
    agent-grants-empty { en "Issue an expiring grant with the operator commands below." zh "使用下方运营命令签发有到期时间的授权。" }
    cmd-authorize { en "Grant (TTL required)" zh "授权（必须带 TTL）" }
    cmd-revoke { en "Revoke" zh "撤销" }
    declared-agents { en "Declared agent" zh "已声明 Agent" }
    declared-budget { en "Budget" zh "预算" }
    declared-checks { en "Policy check" zh "策略检查" }
    declared-scopes { en "Declared scopes" zh "已声明范围" }
    desc { en "Review Agent grants, access policy, tools and content summaries." zh "查看 Agent 授权、访问策略、工具与内容汇总。" }
    gate-desc { en "Sign in with DID Wallet to view agent grants and policy." zh "使用 DID Wallet 登录后查看 Agent 授权与策略。" }
    gate-title { en "Agent capabilities & tools" zh "Agent 能力与工具" }
    grant-desc { en "Use these commands to issue or revoke grants. Set an explicit expiry; high-risk capabilities require confirmation." zh "使用下列命令签发或撤销授权。必须设置到期时间，高风险能力需确认。" }
    grant-forbidden { en "agent.admin is not grantable: change_role never runs from the agent surface." zh "agent.admin 不可授予：change_role 永不从 Agent 面执行。" }
    grant-title { en "Operator CLI (grants & summaries)" zh "运营者 CLI（授权与汇总）" }
    grants-desc { en "Only unexpired grants permit write tools to run." zh "写工具仅在授权有效期内可执行。" }
    grants-title { en "Current grants" zh "当前授权" }
    login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
    policy-blocked { en "Blocked write ops" zh "被阻止的写操作" }
    policy-default { en "Default-closed tools" zh "默认关闭工具" }
    policy-desc { en "Enforced on this node and audited by the check declared below. Read-only: this page has no switches." zh "在本节点强制执行，并由下方声明的审计命令核对。只读：本页没有任何开关。" }
    policy-never { en "Never exposed (prefixes)" zh "永不暴露（前缀）" }
    policy-read { en "Read-only ops" zh "只读操作" }
    policy-title { en "Policy & declaration (read-only)" zh "策略与声明（只读）" }
    runtime-note { en "Endpoint availability is provided by the ARC Runtime and must be checked on the running node." zh "接口可用性由 ARC Runtime 提供，请以运行节点的实际结果为准。" }
    status-available { en "available" zh "可用" }
    status-closed { en "closed" zh "关闭" }
    summaries-note { en "Summaries are generated by the commands below. Each row shows its recorded result; an empty list means no summary is available." zh "通过下方命令生成汇总。列表逐条展示已存结果；为空时表示暂无可用汇总。" }
    summaries-title { en "Aggregated summaries (node/summaries/)" zh "汇总记录（node/summaries/）" }
    registry-source { en "on-chain registry projection (node/registry.json + one record per node) — the operator's registry refresh writes it; run that before reading" zh "链上注册表投影（node/registry.json + 每节点一条记录）——由运营者的 registry refresh 写入；读取前请先执行" }
    registry-content { en "get_studio --content then reads that node's public surface over its staked endpoint (read-only)" zh "get_studio --content 再经该节点质押的 endpoint 只读其公开面" }
    title { en "Agent capabilities & tools" zh "Agent 能力与工具" }
    tools-closed { en "Closed tools (1) — never exposed" zh "关闭工具（1）——永不暴露" }
    tools-closed-note { en "Closed tools never run from the agent surface: change_role is agent.admin and default-closed. The economy tools left the catalogue with the economy surface — removed entirely, not merely closed." zh "关闭工具永不从 Agent 面执行：change_role 属 agent.admin 且默认关闭。经济工具已随经济面从目录整体移除，而非仅关闭。" }
    tools-desc { en "Every tool the agent surface declares, with the capability it needs and whether it can run today. Read tools are always on; write tools need a time-boxed grant; closed tools never run." zh "Agent 面声明的每个工具，含所需能力与当前可用状态。只读工具始终可用；写工具需要限时授权；关闭工具永不执行。" }
    tools-legend { en "Status: available = runs today; every tool below is available. Write tools additionally need an unexpired grant, and closed tools never run." zh "状态：可用 = 当前可执行；下列工具当前均可用。写工具另需未过期授权，关闭工具永不执行。" }
    tools-read { en "Read tools (8)" zh "只读工具（8）" }
    tools-title { en "Declared tools" zh "已声明工具" }
    tools-write { en "Write tools (3) — require a time-boxed grant" zh "写工具（3）——需要限时授权" }
  }
  view gap=lg style={height: "calc(100vh - 48px)", overflow: visible} {
    view style={gap: "0"} {
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "20px"} visible="!$session.authenticated" {
        h2 :gate-title level=2 style={fontSize: "var(--type-body)"}
        p :gate-desc intent=muted
        row cross=start {
          action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dagents&cancel_to=%2F%3Fpage%3Dagents" variant=primary label=:login style={borderRadius: "var(--radius-md, 8px)"}
        }
      }
      row gap=lg cross=stretch style={width: "100vw", marginLeft: "calc(50% - 50vw)", height: "calc(100vh - 48px)", marginBottom: "-52px", padding: "0 32px 0 0"} visible=$session.authenticated {
        view size={width: "clamp(200px, 15vw, 280px)", flexShrink: 0, height: "100%"} style={padding: "0", background: "var(--color-surface)", borderRight: "1px solid var(--color-border)", overflowY: auto, gap: "0", height: "100%"} visible=$session.authenticated {
          p "$t(wrapper.nav-group-content)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-dashboard)" -> page dashboard style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-studio)" -> page posts style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-pages)" -> page pages style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-write)" -> page compose style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-site)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-heroes)" -> page heroes style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-categories)" -> page categories style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-tags)" -> page tags style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-feeds)" -> page feeds style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-ops)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-operations)" -> page operations style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-registry)" -> page registry style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-factory)" -> page factory style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-agents)" -> page agents active=true style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-settings)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-settings)" -> page general style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-diagnostics)" -> page diagnostics style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view gap=xs style={padding: "10px 20px 10px 32px", background: "var(--color-bg)", borderTop: "1px solid var(--color-border)", flexShrink: 0} visible="!$session.isAdmin" {
            p "$t(wrapper.admin-notice)" scale=caption intent=muted
          }
        }
        view gap=md size={flex: 1} style={paddingTop: "14px", paddingBottom: "14px", minHeight: 0} {
          view gap=lg style={height: "100%", minHeight: 0} visible=$session.authenticated {
            view gap=xs style={padding: "4px 0 16px", borderBottom: "1px solid var(--color-border)", flexShrink: 0} {
              h2 :title level=2
              p :desc intent=muted
            }
            view gap=sm size={flex: 1} style={overflowY: auto} {
              view gap=sm style={borderTop: "1px solid var(--color-border)", paddingTop: "18px", flexShrink: 0} {
                h3 :grants-title level=3
                p :grants-desc intent=muted
                view visible=$session.authenticated {
                  afs-list agents-grants-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none emptyText=:agent-grants-empty pagination=manual pageSize=10 from "/instance/app/arcblog/config/agent-grants" {
                    row gap=xs role=item style={background: transparent, borderBottom: "1px solid var(--color-border)", padding: "8px 0"} {
                      view gap=sm size={width: fill} {
                        p "${entry.content.agentDid}" scale=sm style={fontFamily: monospace} format=did title="${entry.content.agentDid}"
                        p "${entry.content.capabilities}" scale=sm
                        p :agent-expires scale=sm intent=muted
                        view style={fontSize: "var(--type-small)", color: "var(--color-dim)"} {
                          time mode=display value="${entry.content.expiresAt}" timeMode=relative
                        }
                      }
                    }
                  }
                }
                p :agent-grants-empty scale=sm intent=muted
                h3 :grant-title level=3
                p :grant-desc intent=muted
                key-value-list agent-grant-cmds dense=true fields=[{label: "$t(agents.cmd-authorize)", value: "node scripts/arcblog-agent.mjs authorize --agent <did> --capability agent.write --ttl 30", monospace: true, copyable: true}, {label: "$t(agents.cmd-revoke)", value: "node scripts/arcblog-agent.mjs revoke --agent <did>", monospace: true, copyable: true}]
                p :grant-forbidden scale=sm intent=muted
                p :runtime-note scale=sm intent=muted
              }
              view gap=sm style={borderTop: "1px solid var(--color-border)", paddingTop: "18px", flexShrink: 0} {
                h3 :policy-title level=3
                p :policy-desc intent=muted
                key-value-list agent-policy dense=true fields=[{label: "$t(agents.policy-read)", value: "read, list, stat, search", monospace: true}, {label: "$t(agents.policy-blocked)", value: "write, delete, exec, mount, unmount, create, update", monospace: true}, {label: "$t(agents.policy-never)", value: "/instance/app/arcblog/drafts, /instance/app/arcblog/page-drafts, /blocklets", monospace: true}, {label: "$t(agents.policy-default)", value: change_role, monospace: true}]
                key-value-list agent-declaration dense=true fields=[{label: "$t(agents.declared-agents)", value: "arcblog-agent — agents/arcblog-agent (type ai, model gpt-5.5, instructions system.md)"}, {label: "$t(agents.declared-scopes)", value: "/instance/app/arcblog/posts/** · categories/** · node/** — ops read, list, stat; maxDepth 2", monospace: true}, {label: "$t(agents.declared-budget)", value: "maxRounds 6 · totalTokens 64000", monospace: true}, {label: "$t(agents.declared-checks)", value: "node scripts/arcblog-agent.mjs check — ok true, failed [], 8 checks", monospace: true}]
                h3 :tools-title level=3
                p :tools-desc intent=muted
                h3 :tools-read level=3
                key-value-list agent-tools-read dense=true fields=[{label: search_posts, value: "$t(agents.status-available) · agent.read"}, {label: get_post, value: "$t(agents.status-available) · agent.read"}, {label: list_categories, value: "$t(agents.status-available) · agent.read"}, {label: get_node_profile, value: "$t(agents.status-available) · agent.read"}, {label: get_analytics, value: "$t(agents.status-available) · agent.read"}, {label: list_studios, value: "$t(agents.status-available) · agent.read — $t(agents.registry-source)"}, {label: get_studio, value: "$t(agents.status-available) · agent.read — $t(agents.registry-source); $t(agents.registry-content)"}, {label: list_summaries, value: "$t(agents.status-available) · agent.read — $t(agents.summaries-title)"}]
                h3 :tools-write level=3
                key-value-list agent-tools-write dense=true fields=[{label: create_draft, value: "$t(agents.status-available) · agent.write"}, {label: update_draft, value: "$t(agents.status-available) · agent.write"}, {label: publish_post, value: "$t(agents.status-available) · agent.publish"}]
                h3 :tools-closed level=3
                key-value-list agent-tools-closed dense=true fields=[{label: change_role, value: "$t(agents.status-closed) · agent.admin"}]
                p :tools-legend scale=caption intent=muted
                p :tools-closed-note scale=caption intent=muted
                h3 :summaries-title level=3
                p :summaries-note intent=muted
                afs-list agents-summaries-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none pagination=manual pageSize=10 from "/instance/app/arcblog/node/summaries" {
                  row gap=xs role=item {
                    view gap=sm size={width: fill} {
                      p "${entry.content.id}" scale=sm
                      p "${entry.content.totalNote}" scale=sm intent=muted
                      p "${entry.content.registryRefreshedAt}" scale=sm intent=muted
                    }
                  }
                }
                key-value-list dense=true fields=[{label: build, value: "node scripts/arcblog-summarize.mjs build --from-registry --id s1 --limit 10", monospace: true, copyable: true}, {label: show, value: "node scripts/arcblog-summarize.mjs show s1", monospace: true, copyable: true}, {label: ask, value: "node scripts/arcblog-summarize.mjs ask --id s1 --question \"为什么这条入选\" --json", monospace: true, copyable: true}]
              }
              // DEF-19: the aggregation section is its own card with the same heading
              // style as its siblings (it lived inside the grants card before, which
              // left its h3 unstyled to avoid a baseline re-record).
            }
          }
        }
      }
    }
  }
}
