page general {
  i18n {
    basics-desc { en "Choose the timezone used when generating the RSS feed." zh "选择生成 RSS 订阅所用的时区。" }
    basics-options { en "Allowed values" zh "允许值" }
    basics-save { en "Save" zh "保存" }
    basics-error { en "Not saved. Choose a value and check your write permission." zh "未保存。请确认已选择取值，并具有写入权限。" }
    basics-saved { en "Setting saved." zh "设置已保存。" }
    choose { en "Choose a value…" zh "请选择取值…" }
    basics-title { en "Site basics" zh "基础信息" }
    basics-value { en "Value" zh "取值" }
    desc { en "Manage the feed timezone, instance switches and role status. Branding and appearance are managed in the platform console." zh "管理订阅时区、实例开关与角色状态。站点品牌和外观在平台控制台设置。" }
    gate-desc { en "Sign in with DID Wallet to manage this instance's General settings." zh "使用 DID Wallet 登录后管理本实例的通用设置。" }
    gate-title { en "Settings" zh "设置" }
    init-basics { en "Create basics" zh "创建基础记录" }
    init-confirm-msg { en "Creates any missing record with its documented default; existing records are left untouched." zh "为缺失的记录按文档默认值创建；已存在的记录保持不动。" }
    init-confirm-title { en "Create missing settings records?" zh "创建缺失的设置记录？" }
    init-desc { en "Create missing defaults without overwriting existing settings." zh "补齐缺失的默认记录，不覆盖已有设置。" }
    init-switches { en "Create switches" zh "创建开关记录" }
    init-title { en "Initialize records" zh "初始化记录" }
    login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
    sw-agent-consumer { en "Turning this off blocks subsequent Agent tool calls; the public site remains readable." zh "关闭后，后续 Agent 工具调用会被拒绝；公开站点仍可阅读。" }
    sw-agent-name { en "Agent Access (master switch)" zh "Agent Access（总开关）" }
    sw-comments-consumer { en "Recorded only: comments are not available yet, so this switch has no effect." zh "仅作记录：目前没有评论功能，开关暂不影响站点。" }
    sw-comments-name { en "Comments" zh "评论" }
    sw-off { en "Off" zh "关闭" }
    sw-on { en "On" zh "开启" }
    sw-rss-consumer { en "Turning this off removes items from the next generated feed; published posts remain available." zh "关闭后，下次生成的订阅不含文章条目；已发布文章仍可阅读。" }
    sw-rss-name { en "RSS" zh "RSS" }
    sw-saved { en "Switch updated." zh "开关已更新。" }
    switches-desc { en "Changes apply to this node. The current stored value is shown below." zh "设置对本节点生效，下方显示已存取值。" }
    switches-title { en "Instance switches" zh "Instance 开关" }
    stored { en "Stored value" zh "已存取值" }
    records-title { en "Stored records" zh "已存记录" }
    timezone-hint { en "IANA timezone for dates in the generated feed." zh "生成订阅中日期使用的 IANA 时区。" }
    timezone-label { en "Timezone" zh "时区" }
    roles-title { en "Roles & capabilities" zh "角色与能力" }
    roles-desc { en "Read-only role snapshots. Update addresses or networks using the operator commands below; a snapshot is not proof of on-chain ownership." zh "角色快照只读。地址和网络通过下方运营命令修改；快照不代表链上所有权证明。" }
    roles-states { en "Lifecycle: none → acquired → staked → revoking → claimable. Declaring a state does not activate capabilities; only the verifier can grant them." zh "生命周期：none → acquired → staked → revoking → claimable。声明状态不会激活能力，授权以验证结果为准。" }
    roles-config-title { en "Externalized config (read-only)" zh "外部化配置（只读）" }
    roles-cmd-init { en "Change the address / network from the CLI (the only path)" zh "用 CLI 修改地址 / 网络（唯一路径）" }
    roles-cmd-show { en "Read the record back" zh "读回记录" }
    roles-cmd-check { en "Validate the record" zh "校验记录" }
    roles-status-title { en "Withheld capabilities & the raw reason" zh "被扣留的能力与原始原因" }
    roles-two-stage-note { en "A dash means no value or a binding still loading. If a newly opened editor stays blank, reload once; it does not mean there are no roles." zh "破折号表示无取值或绑定仍在加载。首次打开仍为空时请刷新一次，不代表没有角色。" }
    roles-honesty { en "Honesty note: a leftover assetId in a record does NOT mean an asset is owned — ownership is derived from the lifecycle state. And this re-derivation is NOT a chain verification: no value on this card is chain truth." zh "诚实说明：记录里残留的 assetId 不代表拥有资产——归属由生命周期状态派生。并且这次重新派生不是**链上验证**：本卡片上没有任何链上事实。" }
    roles-verify-title { en "Refresh role verification" zh "刷新角色核验" }
    roles-verify-desc { en "Queues a local worker check of the records and projection. This does not sign a transaction or change on-chain verification." zh "提交本机任务，核对记录与公开投影的一致性；不会签名交易或改变链上验证。" }
    roles-verify-worker { en "Run the worker (copyable)" zh "运行 worker（可复制）" }
    roles-verify-button { en "Queue re-verification" zh "排队重新验证" }
    roles-verify-confirm-title { en "Queue a re-verification?" zh "排队一次重新验证？" }
    roles-verify-confirm-msg { en "Writes one intent record only; the snapshot changes when the worker runs. Nothing is verified on chain." zh "只写入一条意图记录；快照在 worker 运行后才变化。不会做任何链上验证。" }
    roles-verify-queued { en "Intent queued — read config/role-verify-intents back." zh "意图已入队——请读回 config/role-verify-intents。" }
    roles-verify-error { en "Not queued — the write was refused and nothing changed." zh "未入队——写入被拒绝，没有任何改动。" }
    roles-factory-title { en "Buy / stake / revoke / claim" zh "购买 / 质押 / 撤回 / 取回" }
    roles-factory-desc { en "Open Node NFT to queue purchases, stakes, withdrawals or claims for the chain worker." zh "前往节点 NFT 页提交购买、质押、撤回或取回任务，由链 worker 执行。" }
    roles-factory-link { en "Open the Node NFT page" zh "打开节点 NFT 页" }
    roles-k-checked { en "Checked at" zh "核验时间" }
    roles-claimable-note { en "The waiting-period deadline is shown only when recorded; no countdown is inferred." zh "有记录时展示等待期截止时间，不推算倒计时。" }
    roles-k-effective { en "effective capabilities" zh "实际授予的能力" }
    roles-k-withheld { en "withheld capabilities" zh "被扣留的能力" }
    roles-k-roles { en "declared roles" zh "声明角色" }
    roles-k-basic-stake-state { en "basic.stakeState" zh "基本角色·生命周期状态" }
    roles-k-basic-active { en "basic.active" zh "基本角色·能力状态" }
    roles-k-basic-configured { en "basic.configured" zh "基本角色·已配置" }
    roles-k-basic-asset-owned { en "basic.assetOwned" zh "基本角色·持有资产" }
    roles-k-basic-reason { en "basic.reason (verbatim)" zh "基本角色·原因（逐字；非扣留原因）" }
    roles-k-studio-stake-state { en "studio.stakeState" zh "Studio 角色·生命周期状态" }
    roles-k-studio-active { en "studio.active" zh "Studio 角色·能力状态" }
    roles-k-studio-configured { en "studio.configured" zh "Studio 角色·已配置" }
    roles-k-studio-asset-owned { en "studio.assetOwned" zh "Studio 角色·持有资产" }
    roles-k-studio-reason { en "studio.reason (verbatim)" zh "Studio 角色·扣留原因（逐字）" }
    roles-k-studio-consistency { en "studio config ↔ projection" zh "Studio 配置 ↔ 公开投影" }
    roles-reason-note { en "Values are verbatim: granted / withheld = capability allowed / blocked; yes / no = true / false; (none) = nothing withheld. For basic, reason explains the implicit grant." zh "取值保留原文：granted / withheld＝授予 / 扣留，yes / no＝是 / 否，(none)＝无扣留项。basic 的 reason 解释隐式授予原因。" }
    title { en "Settings" zh "设置" }
  }
  view gap=lg style={height: "100vh", overflow: visible} {
    view style={gap: "0"} {
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "20px"} visible="!$session.authenticated" {
        h2 :gate-title level=2 style={fontSize: "var(--type-body)"}
        p :gate-desc intent=muted
        row cross=start {
          action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dgeneral&cancel_to=%2F%3Fpage%3Dgeneral" variant=primary label=:login style={borderRadius: "var(--radius-md, 8px)"}
        }
      }
      row gap=lg cross=stretch style={width: "100vw", marginLeft: "calc(50% - 50vw)", height: "calc(100vh - 48px)", marginBottom: "-52px", padding: "0 32px 0 0"} visible=$session.authenticated {
        view size={width: "clamp(200px, 15vw, 280px)", flexShrink: 0, height: "100%"} style={padding: "0", background: "var(--color-surface)", borderRight: "1px solid var(--color-border)", overflowY: auto, gap: "0", height: "100%"} visible=$session.authenticated {
          p "$t(wrapper.nav-group-content)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-dashboard)" -> page dashboard style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-studio)" -> page posts style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-pages)" -> page pages style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-write)" -> page compose style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-site)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-heroes)" -> page heroes style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-categories)" -> page categories style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-tags)" -> page tags style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-feeds)" -> page feeds style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-ops)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-operations)" -> page operations style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-registry)" -> page registry style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-factory)" -> page factory style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-agents)" -> page agents style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-settings)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-settings)" -> page general active=true style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-diagnostics)" -> page diagnostics style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view gap=xs style={padding: "10px 20px 10px 32px", background: "var(--color-bg)", borderTop: "1px solid var(--color-border)", flexShrink: 0} visible="!$session.isAdmin" {
            p "$t(wrapper.admin-notice)" scale=caption intent=muted
          }
        }
        view gap=md size={flex: 1} style={paddingTop: "14px", paddingBottom: "14px", minHeight: 0} {
          view gap=xs style={padding: "4px 0 16px", borderBottom: "1px solid var(--color-border)", flexShrink: 0} {
            h2 :title level=2
            p :desc intent=muted
          }
          view gap=sm size={flex: 1} style={overflowY: auto} {
            view style={display: grid, gridTemplateColumns: "minmax(0, 1fr)", gap: "14px", flexShrink: 0, alignItems: start} {
              view gap=sm style={borderTop: "1px solid var(--color-border)", paddingTop: "18px", flexShrink: 0} propBind={timezone: "/instance/app/arcblog/config/general/timezone.json"} {
                h3 :basics-title level=3
                p :basics-desc scale=sm intent=muted
                view gap=xs {
                  h3 :timezone-label level=3
                  p :timezone-hint scale=sm intent=muted
                  // Allowed values are offered by the timezone select.
                  row gap=xs cross=center {
                    input type=select name=eValue label=:basics-value options=[{label: :choose, value: ""}, {label: UTC, value: UTC}, {label: "Asia/Shanghai", value: "Asia/Shanghai"}, {label: "Asia/Tokyo", value: "Asia/Tokyo"}, {label: "Asia/Singapore", value: "Asia/Singapore"}, {label: "Europe/London", value: "Europe/London"}, {label: "Europe/Berlin", value: "Europe/Berlin"}, {label: "America/New_York", value: "America/New_York"}, {label: "America/Los_Angeles", value: "America/Los_Angeles"}] value="${state.timezone.value}" required=true
                    action variant=secondary size=sm label=:basics-save onSuccessToast={intent: success, message: "$t(general.basics-saved)", duration: 2500} onErrorToast={intent: error, message: "$t(general.basics-error)", duration: 4000} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/general/timezone.json", mode: tree-merge, content: {value: $args.eValue}}}}
                  }
                }
                h3 :records-title level=3
                afs-list general-config-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none pagination=manual pageSize=10 from "/instance/app/arcblog/config/general" {
                  view gap=xs role=item style={borderBottom: "1px solid var(--color-border)", padding: "8px 0"} {
                    view gap=sm size={width: fill} {
                      h3 "${entry.content.label}"
                      p "${entry.content.description}" scale=sm intent=muted
                      p "$t(general.basics-options): ${entry.content.options}" scale=sm intent=muted
                      row gap=xs {
                        p :stored scale=sm intent=muted
                        p "${entry.content.value}" scale=sm
                      }
                    }
                  }
                }
                h3 :init-title level=3
                p :init-desc scale=sm intent=muted
                row gap=sm {
                  action variant=secondary size=sm label=:init-basics confirm={title: :init-confirm-title, message: :init-confirm-msg} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/general/language.json", mode: create, content: {label: Language, description: "Value of the RSS <language> element of the generated feed.", scope: instance, type: select, options: [en, zh], pattern: "en|zh"}}, afterSuccess: [{exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/general/timezone.json", mode: create, content: {label: Timezone, description: "IANA timezone used for the <pubDate>/<lastBuildDate> UTC offset of the generated RSS feed.", scope: instance, type: select, options: [UTC, "Asia/Shanghai", "Asia/Tokyo", "Asia/Singapore", "Europe/London", "Europe/Berlin", "America/New_York", "America/Los_Angeles"], pattern: "UTC|Asia/Shanghai|Asia/Tokyo|Asia/Singapore|Europe/London|Europe/Berlin|America/New_York|America/Los_Angeles", value: UTC}}}]}}
                  action variant=secondary size=sm label=:init-switches confirm={title: :init-confirm-title, message: :init-confirm-msg} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/switches/comments.json", mode: create, content: {label: Comments, description: "No consumer yet: ArcBlog has no comment feature, so this switch is recorded only.", scope: instance, type: toggle, value: false}}, afterSuccess: [{exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/switches/rss.json", mode: create, content: {label: RSS, description: "When off, the generated RSS feed carries a channel with no items.", scope: instance, type: toggle, value: true}}}, {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/switches/agent-access.json", mode: create, content: {label: "Agent Access", description: "When off, the Agent Access CLI refuses to run tools (fail closed).", scope: instance, type: toggle, value: true}}}]}}
                }
                h3 :switches-title level=3
                p :switches-desc scale=sm intent=muted
                view gap=xs {
                  h3 :sw-comments-name level=3
                  p :sw-comments-consumer scale=sm intent=muted
                }
                view gap=xs {
                  h3 :sw-rss-name level=3
                  p :sw-rss-consumer scale=sm intent=muted
                }
                view gap=xs {
                  h3 :sw-agent-name level=3
                  p :sw-agent-consumer scale=sm intent=muted
                }
                afs-list general-switches-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none pagination=manual pageSize=10 from "/instance/app/arcblog/config/switches" {
                  view gap=xs role=item style={borderBottom: "1px solid var(--color-border)", padding: "8px 0"} {
                    view gap=sm size={width: fill} {
                      input type=hidden name=sPath value="${entry.path}"
                      row cross=center gap=sm {
                        h3 "${entry.content.label}"
                        p :stored scale=sm intent=muted
                        p "${entry.content.value}" scale=sm intent=muted
                      }
                      row gap=xs {
                        action variant=secondary size=sm label=:sw-on onSuccessToast={intent: success, message: "$t(general.sw-saved)", duration: 2500} onErrorToast={intent: error, message: "$t(general.basics-error)", duration: 4000} events={click: {exec: "/.actions/write", args: {path: "${args.sPath}", mode: tree-merge, content: {value: true}}}}
                        action size=sm label=:sw-off onSuccessToast={intent: success, message: "$t(general.sw-saved)", duration: 2500} events={click: {exec: "/.actions/write", args: {path: "${args.sPath}", mode: tree-merge, content: {value: false}}}}
                      }
                    }
                  }
                }
              }
              // ---- Roles & capabilities (REQ-034 / spec §15.9) --------------------
              // Read-only by design: spec §1273 forbids an address/network input on
              // this page, so the config is displayed only. The five lifecycle words
              // mirror STAKE_STATES in scripts/lib/roles.mjs — the engine stays the
              // single vocabulary source; the derived values are read from the CLI's
              // projection under node/ (written by `verify apply`, never by the page),
              // and the ONE write here is a queued verification intent under config/
              // (role-verify-intents) — a real consumer, not a fake button.
              // BUG-077/BUG-078 (Round 27): the role rows used to carry English
              // literals as LABELS and the engine's own words (granted / withheld /
              // yes / no) as VALUES. The labels are static, so they are page i18n
              // keys now (general.roles-k-*) and the zh side glosses the engine
              // vocabulary inline. The VALUES stay verbatim: `$t()` keys must be
              // compile-time constants (arc-contracts §28.8) and this console cannot
              // translate a runtime value — the design-doc degradation path is
              // "localized label + raw value visible" (docs/04-UI设计规范/04-文案与i18n.md
              // 与 docs/04-UI设计规范/03-状态与降级.md). The roles-reason-note line states unconditionally that a
              // granted role carries no withheld reason instead of faking a condition.
              view gap=sm style={borderTop: "1px solid var(--color-border)", paddingTop: "18px", flexShrink: 0} propBind={roles: "/instance/app/arcblog/config/roles.json", verification: "/instance/app/arcblog/node/role-verification.json", basic: "/instance/app/arcblog/node/role-status/basic.json", studio: "/instance/app/arcblog/node/role-status/studio.json"} {
                h3 :roles-title level=3
                p :roles-desc scale=sm intent=muted
                p :roles-states scale=sm
                h3 :roles-config-title level=3
                // BUG-083 (R29): `.aup-kv-label` is a platform-owned grid item — the row
                // is `grid-template-columns: minmax(140px, 28%) 1fr` (measured in
                // aup-app.*.css: UI-011 P-01 / UI-012 P-02 + BUG-034), so the page has
                // NO style hook on the label, and the 67-key safe-style allowlist has
                // no wordBreak/overflowWrap either (arc-contracts §29.8(1)).
                // At 1512x765 that 28% track is 160.88px while the single unbreakable
                // token `studio.lifecycle.claimableAt` is 171px -> its text painted 10px
                // past its own box (the other 12 labels of this list stayed 161/161).
                // Fix in the D1/D3 family (Lead R29 P-2: "let the KV label wrap", no
                // hardcoded width): a ZERO-WIDTH SPACE after the last dot is a break
                // opportunity that is used ONLY when the track is too narrow — it adds
                // no glyph, the label text stays `studio.lifecycle.claimableAt`, and at
                // 1803x908 the 195px track keeps it on one line exactly as before.
                key-value-list roles-config-kv dense=true fields=[{label: chainVerification, value: "${state.roles.chainVerification}"}, {label: "studio.collectionAddress", value: "${state.roles.studio.collectionAddress}", monospace: true, hideWhenEmpty: true}, {label: "studio.network", value: "${state.roles.studio.network}", hideWhenEmpty: true}, {label: "studio.assetType", value: "${state.roles.studio.assetType}", hideWhenEmpty: true}, {label: "studio.lifecycle.state", value: "${state.roles.studio.lifecycle.state}"}, {label: "studio.lifecycle.assetId", value: "${state.roles.studio.lifecycle.assetId}", monospace: true, hideWhenEmpty: true}, {label: "studio.lifecycle.​claimableAt", value: "${state.roles.studio.lifecycle.claimableAt}", hideWhenEmpty: true}]
                key-value-list roles-cmd-config dense=true fields=[{label: :roles-cmd-init, value: "node scripts/arcblog-roles.mjs init --update --studio-collection <addr> --network <net>", monospace: true, copyable: true}, {label: :roles-cmd-show, value: "node scripts/arcblog-roles.mjs show", monospace: true, copyable: true}, {label: :roles-cmd-check, value: "node scripts/arcblog-roles.mjs check", monospace: true, copyable: true}]
                h3 :roles-status-title level=3
                // UI-018 D2 (§7.2): the old `roles-no-snapshot` line was gated by
                // `visible="!${state.verification.lastVerifiedAt}"` and rendered in
                // NEITHER state (measured in both cold-load and after-reload), and its
                // wording claimed node/role-verification.json does not exist — the record
                // does exist. §4.8 / arc-contracts §21.11 require an UNCONDITIONAL
                // two-stage note that never reads a first-paint blank as "no record".
                p :roles-two-stage-note scale=sm intent=muted
                key-value-list roles-scope-kv dense=true fields=[{label: :roles-k-checked, value: "${state.verification.lastVerifiedAt}", hideWhenEmpty: true}, {label: :roles-k-effective, value: "${state.verification.effectiveCapabilitiesLabel}", hideWhenEmpty: true}, {label: :roles-k-withheld, value: "${state.verification.withheldCapabilitiesLabel}", hideWhenEmpty: true}, {label: :roles-k-roles, value: "${state.verification.declaredRolesLabel}", hideWhenEmpty: true}]
                key-value-list roles-basic-kv dense=true fields=[{label: :roles-k-basic-stake-state, value: "${state.basic.stakeState}"}, {label: :roles-k-basic-active, value: "${state.basic.activeLabel}"}, {label: :roles-k-basic-configured, value: "${state.basic.configuredLabel}"}, {label: :roles-k-basic-asset-owned, value: "${state.basic.assetOwnedLabel}"}, {label: :roles-k-basic-reason, value: "${state.basic.reason}"}]
                key-value-list roles-studio-kv dense=true fields=[{label: :roles-k-studio-stake-state, value: "${state.studio.stakeState}"}, {label: :roles-k-studio-active, value: "${state.studio.activeLabel}"}, {label: :roles-k-studio-configured, value: "${state.studio.configuredLabel}"}, {label: :roles-k-studio-asset-owned, value: "${state.studio.assetOwnedLabel}"}, {label: :roles-k-studio-reason, value: "${state.studio.reason}"}, {label: :roles-k-studio-consistency, value: "${state.studio.consistencyReason}"}]
                p :roles-reason-note scale=caption intent=muted
                // B4: the waiting period, shown honestly. The raw `claimableAt` value
                // is rendered (hideWhenEmpty). A relative `time` row is deliberately
                // NOT rendered: measured twice on this platform (2026-09-29) that
                // `visible="${state.x}"` keeps an empty value visible while
                // `visible="!!${state.x}"` hides a non-empty one — and the `time`
                // primitive reads an EMPTY value as "just now". A fabricated
                // "claimable now" is worse than no widget (L-R26R-4).
                key-value-list roles-claimable-kv dense=true fields=[{label: "studio.claimableAt", value: "${state.studio.claimableAt}", monospace: true, hideWhenEmpty: true}]
                p :roles-claimable-note scale=caption intent=muted
                p :roles-honesty scale=sm intent=info
                h3 :roles-verify-title level=3
                p :roles-verify-desc scale=sm intent=muted
                row gap=sm {
                  action variant=secondary size=sm label=:roles-verify-button confirm={title: :roles-verify-confirm-title, message: :roles-verify-confirm-msg} onSuccessToast={intent: success, message: "$t(general.roles-verify-queued)", duration: 3000} onErrorToast={intent: error, message: "$t(general.roles-verify-error)", duration: 4000} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/role-verify-intents/${generate.timeiso}.json", mode: create, content: {id: "${generate.timeiso}", action: verify, role: all, status: pending, message: "queued — a local worker has not run this yet", changed: [], requestedVia: console, requestedAt: "${generate.timeiso}"}}}}
                }
                key-value-list roles-verify-worker-cmds dense=true fields=[{label: :roles-verify-worker, value: "node scripts/arcblog-roles.mjs verify apply", monospace: true, copyable: true}, {label: :roles-cmd-show, value: "node scripts/arcblog-roles.mjs verify show", monospace: true, copyable: true}]
                h3 :roles-factory-title level=3
                p :roles-factory-desc scale=sm intent=muted
                row gap=xs {
                  // UI-018 D8 (§7.7, lane-O variant): the bare `href="/?page=factory"`
                  // rendered `<a>` WITHOUT a target, so one click replaced the whole
                  // console document (the §9 equivalent assertion counted total=1).
                  // Lane O opens it in a NEW TAB instead (the in-repo pattern
                  // `action href=… target=_blank`, arc-contracts §21.10, same as the
                  // footer RSS link): no document navigation happens in this tab, so
                  // the §9 assertion is total=0 again. If the standard's §2.6 table
                  // (console sections switch in-frame via `-> page <name>`) is to be
                  // followed literally, `-> page factory` also yields total=0 — Lead call.
                  action variant=primary size=sm label=:roles-factory-link href="/?page=factory" target=_blank
                }
              }
            }
          }
        }
      }
    }
  }
}
