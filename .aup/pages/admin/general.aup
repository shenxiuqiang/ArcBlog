page general {
  i18n {
    basics-desc { en "Site-level values. They live in this blocklet's own config collection and are read by the RSS generator." zh "站点级取值。它们存放在本 Blocklet 自己的 config 集合中，由 RSS 生成器读取。" }
    basics-options { en "Allowed values" zh "允许值" }
    basics-save { en "Save" zh "保存" }
    basics-error { en "Not saved — the write was refused and nothing changed. Check that a value is chosen (or filled in) and that the runtime allows the write; the console shows the platform error." zh "未保存——写入被拒绝，没有任何改动。请确认已选择（或填写）取值，且运行期允许该写入；具体平台错误见浏览器控制台。" }
    basics-guard { en "Each field offers only its own record’s allowed values, so this page cannot submit an out-of-options value, and a field must be chosen (or filled) explicitly before Save. The current values are shown under “Stored records” — that list is the source of truth. Two platform notes: on a brand-new tab the prefill can stay empty until the page is reloaded or reached by an in-page menu click (arc-contracts §21.11), and the readers fall back to the documented default if a record was written out-of-band — see `node scripts/arcblog-settings.mjs general show`." zh "每个字段只提供该记录自己的允许值，因此本页无法提交选项外的取值；保存前必须显式选择（或填写）该字段。当前取值见下方「已存记录」——那才是真相来源。两点平台说明：全新标签页首次加载时预填可能为空，需重载或用页内菜单再次进入（arc-contracts §21.11）；若记录被带外写入，读取方会回退到文档默认值——见 `node scripts/arcblog-settings.mjs general show`。" }
    basics-saved { en "Setting saved." zh "设置已保存。" }
    choose { en "Choose a value…" zh "请选择取值…" }
    basics-title { en "Site basics" zh "基础信息" }
    basics-value { en "Value" zh "取值" }
    desc { en "Instance-level General settings: site name, language, timezone and the three Instance switches. One home for every \"where is that switch?\" question." zh "Instance 级通用设置：站点名称、语言、时区，以及三个 Instance 开关。「这个开关在哪」的答案只有一个地方。" }
    gate-desc { en "Sign in with DID Wallet to manage this instance's General settings." zh "使用 DID Wallet 登录后管理本实例的通用设置。" }
    gate-title { en "Settings" zh "设置" }
    init-basics { en "Create basics" zh "创建基础记录" }
    init-confirm-msg { en "Creates any missing record with its documented default. Existing records are left untouched (the platform refuses to overwrite an existing path in create mode)." zh "为缺失的记录按文档默认值创建；已存在的记录不会被改动（create 模式下平台会拒绝覆盖已存在路径）。" }
    init-confirm-title { en "Create missing settings records?" zh "创建缺失的设置记录？" }
    init-desc { en "Create only the records that are missing, with their documented default; an existing record is never overwritten (create mode refuses an existing path). These are ordinary records: the CLI and this page can both update them afterwards — arc-contracts §29.2 (corrected in Round 10) says a browser write to an existing record is not refused in general; it depends on the origin of the record, the write mode and the daemon process. If a Save ever fails, probe before deleting anything: delete + recreate loses createdAt." zh "只为缺失的记录按文档默认值创建；已存在的记录不会被覆盖（create 模式拒绝已存在路径）。这些就是普通记录：之后 CLI 与本页都能更新它们——arc-contracts §29.2（Round 10 已更正）说明浏览器写已存在记录并非一律被拒，而是与记录来源、写入模式和当时的 daemon 进程相关。若某次保存失败，先探针再决定：删除重建会丢掉 createdAt。" }
    init-switches { en "Create switches" zh "创建开关记录" }
    init-title { en "Initialize records" zh "初始化记录" }
    login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
    scope-desc { en "These are Instance-level values: they are stored at /instance/app/arcblog/config/{general,switches}/<field>.json and apply to the whole node. The impact of every switch is written next to it below." zh "这些是 Instance 级取值：存放在 /instance/app/arcblog/config/{general,switches}/<field>.json，对整个节点生效。每个开关的影响范围都在下方写明。" }
    scope-title { en "What belongs here" zh "归属与范围" }
    sw-agent-consumer { en "Consumed by scripts/arcblog-agent.mjs: when off, `run` refuses every tool and `check` reports the switch as disabled (fail closed). Takes effect on the next CLI run." zh "由 scripts/arcblog-agent.mjs 消费：关闭后 `run` 拒绝执行任何工具，`check` 报告开关已停用（fail closed）。下次 CLI 运行时生效。" }
    sw-agent-impact { en "Impact: every Agent Access tool call on this node. It does not affect the read-only public web surface." zh "影响范围：本节点上所有 Agent Access 工具调用；不影响只读的公开站点面。" }
    sw-agent-name { en "Agent Access (master switch)" zh "Agent Access（总开关）" }
    sw-comments-consumer { en "No consumer yet — ArcBlog has no comment feature at all, so this switch is recorded only. It is not a fake control: the page says so, and the record is readable by the CLI." zh "目前没有消费方——ArcBlog 根本没有评论功能，因此该开关仅记录。它不是伪造的控件：页面如实标注，且记录可被 CLI 读取。" }
    sw-comments-impact { en "Impact: none today. Planned to gate a comment surface if one is built (spec §15.9)." zh "影响范围：当前无。若未来实现评论面，将用于总开关（spec §15.9）。" }
    sw-comments-name { en "Comments" zh "评论" }
    sw-off { en "Off" zh "关闭" }
    sw-on { en "On" zh "开启" }
    sw-rss-consumer { en "Consumed by scripts/arcblog-rss.mjs: when off, the generated feed keeps its channel but carries no <item>. Takes effect on the next feed generation." zh "由 scripts/arcblog-rss.mjs 消费：关闭后生成的订阅仍保留 channel，但不含任何 <item>。下次生成订阅时生效。" }
    sw-rss-impact { en "Impact: the public RSS feed (and therefore every subscriber). It does not remove published posts." zh "影响范围：公开 RSS 订阅（以及所有订阅者）；不会删除已发布文章。" }
    sw-rss-name { en "RSS" zh "RSS" }
    sw-saved { en "Switch updated." zh "开关已更新。" }
    switches-desc { en "Instance-level master switches. Every switch states its impact and whether anything actually consumes it." zh "Instance 级总开关。每个开关都写明影响范围，以及是否真有消费方。" }
    switches-title { en "Instance switches" zh "Instance 开关" }
    stored { en "Stored value" zh "已存取值" }
    language-hint { en "Value of the RSS <language> element of the generated feed." zh "生成的 RSS 订阅中 <language> 元素的取值。" }
    language-label { en "Language" zh "语言" }
    records-desc { en "What is actually stored under /instance/app/arcblog/config/general/. This list is the source of truth: if an edit above is refused, the value here does not change." zh "实际存放在 /instance/app/arcblog/config/general/ 的内容。此列表才是真相来源：上面的编辑若被拒绝，这里的取值不会变化。" }
    records-title { en "Stored records" zh "已存记录" }
    site-name-hint { en "Channel title of the generated RSS feed. It does not rename the blocklet or the console brand." zh "生成的 RSS 订阅的 channel 标题。不会重命名 Blocklet 或控制台品牌。" }
    site-name-label { en "Site name" zh "站点名称" }
    timezone-hint { en "IANA timezone used for the <pubDate>/<lastBuildDate> UTC offset of the generated feed." zh "生成的订阅中 <pubDate>/<lastBuildDate> UTC 偏移所用的 IANA 时区。" }
    timezone-label { en "Timezone" zh "时区" }
    roles-title { en "Roles & capabilities" zh "角色与能力" }
    roles-desc { en "Spec §15.9. This card shows the ENGINE's own role state: the five lifecycle words and every derived value come from scripts/lib/roles.mjs and its CLI, never from a second vocabulary typed into a page. The externalized config is read-only here (spec §9), and changing an address or a network is a CLI/operator step only." zh "spec §15.9。本卡片展示**引擎自己的**角色状态：五个生命周期词与所有派生取值都来自 scripts/lib/roles.mjs 及其 CLI，绝不来自页面里另写的一套词表。外部化配置在此只读（spec §9），修改地址或网络只能由 CLI/operator 完成。" }
    roles-states { en "Lifecycle (source: STAKE_STATES in scripts/lib/roles.mjs): none → acquired → staked → revoking → claimable. The page repeats these five words verbatim so that a drift is visible, and revoking derives to claimable at read time once claimableAt has passed — the record itself is not rewritten." zh "生命周期（来源：scripts/lib/roles.mjs 的 STAKE_STATES）：none → acquired → staked → revoking → claimable。本页逐字重复这五个词，漂移即可见；revoking 在 claimableAt 到期后于读取时派生为 claimable——记录本身不被改写。" }
    roles-states-note { en "Every state here is operator-declared: setting staked does NOT activate a role. Until a verifier exists every chain role stays active=false and its capabilities stay withheld (fail closed, spec §114/§115). This card never asserts that a role is active." zh "这些状态都是 operator 声明的：把状态设为 staked **不会**激活角色。在验证器接通前，每个链角色始终 active=false、能力始终 withheld（fail closed，spec §114/§115）。本卡片绝不断言某角色已激活。" }
    roles-config-title { en "Externalized config (read-only)" zh "外部化配置（只读）" }
    roles-config-desc { en "Collection address, network, assetType and the declared lifecycle are record values (config/roles.json, spec §9, admin-only). This page only displays them; the record is the authority and the CLI below is the only way to change it." zh "集合地址、网络、assetType 与已声明生命周期都是记录取值（config/roles.json，spec §9，仅管理员）。本页只做展示；记录才是权威，下方 CLI 是唯一的修改入口。" }
    roles-no-input { en "There is no address and no network input on this page, on purpose — spec §1273 forbids typing an address into the UI. A value shown as unbound means \"not bound yet / unavailable\", never \"the record is empty\"." zh "本页刻意**没有**地址与网络输入框——spec §1273 禁止在界面手填地址。显示为未绑定的取值读作「尚未绑定 / 暂不可用」，绝不是「记录为空」。" }
    roles-cmd-init { en "Change the address / network from the CLI (the only path)" zh "用 CLI 修改地址 / 网络（唯一路径）" }
    roles-cmd-show { en "Read the record back" zh "读回记录" }
    roles-cmd-check { en "Validate the record" zh "校验记录" }
    roles-status-title { en "Withheld capabilities & the raw reason" zh "被扣留的能力与原始原因" }
    roles-status-desc { en "Derived by the CLI (never typed here) from config/roles.json + node/factories.json + node/profile.json and landed under node/role-status/. The reason string is rendered verbatim in English: this console cannot translate a runtime value, and a paraphrase would hide the real cause." zh "由 CLI 从 config/roles.json + node/factories.json + node/profile.json 派生（绝不在此输入），落在 node/role-status/ 下。原因字符串按英文原文逐字展示：控制台无法翻译运行期取值，改写会掩盖真实原因。" }
    roles-two-stage-note { en "Reading the dashes: this platform renders an em dash when the bound record has no such value, or when the binding has not resolved yet — on a freshly opened tab the rows below can all read as dashes until a reload (or an in-page menu round-trip) resolves them, and the reload shows the real values. A dash never means \"no roles\". This note is unconditional: it does not claim that any record is missing. The authority is `node scripts/arcblog-roles.mjs status`." zh "如何读破折号：绑定记录没有该值时平台渲染破折号；全新标签页首次打开、绑定尚未解析时同样如此——此时下方各行可能全部显示破折号，重载（或用页内菜单往返一次）后即出现真值。破折号绝不代表「没有角色」。本说明是常驻的：它不断言任何记录缺失。权威入口是 `node scripts/arcblog-roles.mjs status`。" }
    roles-honesty { en "Honesty note: a leftover assetId in the record (for example a test value) does NOT mean an asset is owned — assetOwned is derived from the lifecycle state. And this re-derivation is NOT a chain verification: chainVerification stays false and no value on this card is chain truth (spec §114/§115)." zh "诚实说明：记录里残留的 assetId（例如测试残留）**不**代表拥有资产——assetOwned 由生命周期状态派生。并且这次重新派生**不是**链上验证：chainVerification 保持 false，本卡片上没有任何链上事实（spec §114/§115）。" }
    roles-verify-title { en "Re-verify — the real path (no fake button)" zh "重新验证——真实路径（无假按钮）" }
    roles-verify-desc { en "The button queues ONE intent record under config/role-verify-intents/<id>.json (admin-only, the same config collection as the policy queue — zero permission change). It runs nothing itself and never touches config/roles.json. The node's worker consumes it:" zh "按钮只入队**一条**意图记录到 config/role-verify-intents/<id>.json（仅管理员，与策略队列同属 config 集合——零权限改动）。它自身不执行任何动作，也绝不动 config/roles.json。由本机 worker 消费：" }
    roles-verify-kind { en "What the worker does: a READ-ONLY re-derivation of every RoleStatus from the existing records; it writes node/role-status/<role>.json + node/role-verification.json and reports whether config/roles.json and the public node/factories.json projection agree. It never flips chainVerification and signs nothing." zh "worker 做什么：只读地基于既有记录重新派生每个 RoleStatus，写入 node/role-status/<role>.json 与 node/role-verification.json，并报告 config/roles.json 与公开投影 node/factories.json 是否一致。它绝不翻转 chainVerification，也不做任何签名。" }
    roles-verify-queue { en "writes: /instance/app/arcblog/config/role-verify-intents/<timestamp>.json with status pending — read it back; a toast is not evidence." zh "写入：/instance/app/arcblog/config/role-verify-intents/<时间戳>.json，status 为 pending——请读回；toast 不是证据。" }
    roles-verify-worker { en "Run the worker (copyable)" zh "运行 worker（可复制）" }
    roles-verify-button { en "Queue re-verification" zh "排队重新验证" }
    roles-verify-confirm-title { en "Queue a re-verification?" zh "排队一次重新验证？" }
    roles-verify-confirm-msg { en "Writes one intent record only; the snapshot changes when the worker runs. Nothing is verified on chain." zh "只写入一条意图记录；快照在 worker 运行后才变化。不会做任何链上验证。" }
    roles-verify-queued { en "Intent queued — read config/role-verify-intents back." zh "意图已入队——请读回 config/role-verify-intents。" }
    roles-verify-error { en "Not queued — the write was refused and nothing changed." zh "未入队——写入被拒绝，没有任何改动。" }
    roles-factory-title { en "Buy / stake / revoke / claim" zh "购买 / 质押 / 撤回 / 取回" }
    roles-factory-desc { en "These four actions already live on the Node NFT page and are NOT duplicated here: each one queues an intent record there and the node's chain worker signs it. This card only links there, so the purchase-to-stake guide stays inside the console (spec §15.9)." zh "这四个动作已在「节点 NFT」页实现，本页**不重复**：每个动作在该页入队一条意图记录，并由节点链 worker 签名执行。本卡片只做跳转，购买到质押的引导因此仍在控制台内闭环（spec §15.9）。" }
    roles-factory-link { en "Open the Node NFT page" zh "打开节点 NFT 页" }
    roles-source-note { en "Authoritative source for every value: node scripts/arcblog-roles.mjs status (RoleStatus) and capabilities. This card renders a projection; when the two disagree, the CLI wins." zh "每个取值的权威来源：node scripts/arcblog-roles.mjs status（RoleStatus）与 capabilities。本卡片渲染的是投影；两者不一致时以 CLI 为准。" }
    roles-k-checked { en "Checked at" zh "核验时间" }
    roles-claimable-note { en "Waiting period: the raw claimableAt value is shown above when the record carries one; this console deliberately renders no countdown (the platform's conditional `visible` cannot gate a relative-time row on a bound value, measured 2026-09-29 — and an empty value would otherwise read as \"just now\")." zh "等待期：记录里带有 claimableAt 时，上方展示其原始取值；本控制台刻意不渲染倒计时（实测 2026-09-29：平台的条件 `visible` 无法用绑定值门控相对时间行——而空值会被读成「刚刚」）。" }
    roles-k-effective { en "effective capabilities" zh "实际授予的能力" }
    roles-k-withheld { en "withheld capabilities" zh "被扣留的能力" }
    roles-k-roles { en "declared roles" zh "声明角色" }
    roles-k-basic-stake-state { en "basic.stakeState" zh "基本角色·生命周期状态" }
    roles-k-basic-active { en "basic.active" zh "基本角色·能力状态" }
    roles-k-basic-configured { en "basic.configured" zh "基本角色·已配置" }
    roles-k-basic-asset-owned { en "basic.assetOwned" zh "基本角色·持有资产" }
    roles-k-basic-reason { en "basic.reason (verbatim)" zh "基本角色·原因（逐字；非扣留原因）" }
    roles-k-studio-stake-state { en "studio.stakeState" zh "Studio 角色·生命周期状态" }
    roles-k-studio-active { en "studio.active" zh "Studio 角色·能力状态" }
    roles-k-studio-configured { en "studio.configured" zh "Studio 角色·已配置" }
    roles-k-studio-asset-owned { en "studio.assetOwned" zh "Studio 角色·持有资产" }
    roles-k-studio-reason { en "studio.reason (verbatim)" zh "Studio 角色·扣留原因（逐字）" }
    roles-k-studio-consistency { en "studio config ↔ projection" zh "Studio 配置 ↔ 公开投影" }
    roles-k-hub-stake-state { en "hub.stakeState" zh "Hub 角色·生命周期状态" }
    roles-k-hub-active { en "hub.active" zh "Hub 角色·能力状态" }
    roles-k-hub-configured { en "hub.configured" zh "Hub 角色·已配置" }
    roles-k-hub-asset-owned { en "hub.assetOwned" zh "Hub 角色·持有资产" }
    roles-k-hub-reason { en "hub.reason (verbatim)" zh "Hub 角色·扣留原因（逐字）" }
    roles-k-hub-consistency { en "hub config ↔ projection" zh "Hub 配置 ↔ 公开投影" }
    roles-reason-note { en "How to read these rows: the label is this console's own field name and the value is the role engine's own text, rendered verbatim. Why verbatim: a `$t()` key must be a compile-time constant (arc-contracts §28.8) and `visible` only supports synchronous `$session.*` expressions (arc-contracts §28.1), so this console has no mechanism to switch a value's wording from a record value — the engine vocabulary is therefore glossed here: `granted` = the capability is granted; `withheld` = it is withheld (fail closed); `yes` / `no` = the boolean the engine derived; `(none)` = nothing is withheld (not a missing value). A granted role has nothing withheld — for `basic` the `reason` explains why the capability is implicit, not why it is withheld; a withheld capability carries its cause in the same row." zh "如何读这些行：标签是本控制台自己的字段名，取值是角色引擎自己的原文。为何逐字：`$t()` 的 key 必须是编译期常量（arc-contracts §28.8），`visible` 只支持同步的 `$session.*` 表达式（arc-contracts §28.1），因此本控制台没有「按运行期取值切换文案」的机制——引擎词表在此对照：`granted` = 能力已授予；`withheld` = 能力被扣留（fail closed）；`yes` / `no` = 引擎派生的布尔取值；`(none)` = 无 withheld（不是取值缺失）。能力已授予的角色没有被扣留的东西——`basic` 那行的 `reason` 说明的是「为什么它是隐式授予」，不是「为什么被扣留」；能力被扣留的角色在同一行给出扣留原因。" }
    title { en "General" zh "通用" }
  }
  view gap=lg style={height: "100vh", overflow: visible} {
    view style={gap: "0"} {
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "20px"} visible="!$session.authenticated" {
        h2 :gate-title level=2 style={fontSize: "var(--type-body)"}
        p :gate-desc intent=muted
        row cross=start {
          action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dgeneral&cancel_to=%2F%3Fpage%3Dgeneral" variant=primary label=:login style={borderRadius: "var(--radius-md, 8px)"}
        }
      }
      row gap=lg cross=stretch style={width: "100vw", marginLeft: "calc(50% - 50vw)", height: "calc(100vh - 48px)", marginBottom: "-52px", padding: "0 32px 0 0"} visible=$session.authenticated {
        view size={width: "clamp(200px, 15vw, 280px)", flexShrink: 0, height: "100%"} style={padding: "0", background: "var(--color-surface)", borderRight: "1px solid var(--color-border)", overflowY: auto, gap: "0", height: "100%"} visible=$session.authenticated {
          p "$t(wrapper.nav-group-content)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-dashboard)" -> page dashboard style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-studio)" -> page posts style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-pages)" -> page pages style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
