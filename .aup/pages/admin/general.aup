          }
          action "$t(wrapper.nav-factory)" -> page factory style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-settings)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-settings)" -> page general active=true style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-diagnostics)" -> page diagnostics style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={marginTop: auto, background: "var(--color-bg)", borderTop: "1px solid var(--color-border)", flexShrink: 0, gap: "0"} {
            p "$t(wrapper.footer-brand)" scale=caption intent=muted style={padding: "10px 20px 2px 32px", flexShrink: 0}
            action "$t(wrapper.footer-about)" href="/?page=about" style={border: none, borderRadius: "0", padding: "4px 20px 4px 32px", justifyContent: flex-start, flexShrink: 0}
            action "$t(wrapper.footer-rss)" href="/p/rss.xml" target=_blank style={border: none, borderRadius: "0", padding: "4px 20px 4px 32px", justifyContent: flex-start, flexShrink: 0}
            p "$t(wrapper.footer-copyright)" scale=caption intent=muted style={padding: "2px 20px 10px 32px", flexShrink: 0}
          }
        }
        view gap=md size={flex: 1} style={paddingTop: "14px", paddingBottom: "14px", minHeight: 0} {
          view gap=xs {
            h2 :title level=2 style={fontSize: "var(--type-subheading)"}
            p :desc intent=muted
          }
          view gap=sm size={flex: 1} style={overflowY: auto} {
            view style={display: grid, gridTemplateColumns: "repeat(auto-fit, minmax(520px, 1fr))", gap: "14px", flexShrink: 0, alignItems: start} {
              view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px", flexShrink: 0} {
                h3 :scope-title level=3 style={fontSize: "var(--type-body)"}
                p :scope-desc scale=sm intent=muted
              }
              view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px", flexShrink: 0} propBind={siteName: "/instance/app/arcblog/config/general/site-name.json", language: "/instance/app/arcblog/config/general/language.json", timezone: "/instance/app/arcblog/config/general/timezone.json"} {
                h3 :basics-title level=3 style={fontSize: "var(--type-body)"}
                p :basics-desc scale=sm intent=muted
                p :basics-guard scale=sm intent=muted
                view gap=xs {
                  h3 :site-name-label level=3 style={fontSize: "var(--type-body)"}
                  p :site-name-hint scale=sm intent=muted
                  row gap=xs cross=center {
                    input type=text name=eValue label=:basics-value value="${state.siteName.value}" required=true maxLength=120
                    action variant=secondary size=sm label=:basics-save onSuccessToast={intent: success, message: "$t(general.basics-saved)", duration: 2500} onErrorToast={intent: error, message: "$t(general.basics-error)", duration: 4000} style={borderRadius: "var(--radius-md, 8px)"} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/general/site-name.json", mode: tree-merge, content: {value: $args.eValue}}}}
                  }
                }
                view gap=xs {
                  h3 :language-label level=3 style={fontSize: "var(--type-body)"}
                  p :language-hint scale=sm intent=muted
                  p "$t(general.basics-options): en, zh" scale=sm intent=muted
                  row gap=xs cross=center {
                    input type=select name=eValue label=:basics-value options=[{label: :choose, value: ""}, {label: en, value: en}, {label: zh, value: zh}] value="${state.language.value}" required=true
                    action variant=secondary size=sm label=:basics-save onSuccessToast={intent: success, message: "$t(general.basics-saved)", duration: 2500} onErrorToast={intent: error, message: "$t(general.basics-error)", duration: 4000} style={borderRadius: "var(--radius-md, 8px)"} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/general/language.json", mode: tree-merge, content: {value: $args.eValue}}}}
                  }
                }
                view gap=xs {
                  h3 :timezone-label level=3 style={fontSize: "var(--type-body)"}
                  p :timezone-hint scale=sm intent=muted
                  p "$t(general.basics-options): UTC, Asia/Shanghai, Asia/Tokyo, Asia/Singapore, Europe/London, Europe/Berlin, America/New_York, America/Los_Angeles" scale=sm intent=muted
                  row gap=xs cross=center {
                    input type=select name=eValue label=:basics-value options=[{label: :choose, value: ""}, {label: UTC, value: UTC}, {label: "Asia/Shanghai", value: "Asia/Shanghai"}, {label: "Asia/Tokyo", value: "Asia/Tokyo"}, {label: "Asia/Singapore", value: "Asia/Singapore"}, {label: "Europe/London", value: "Europe/London"}, {label: "Europe/Berlin", value: "Europe/Berlin"}, {label: "America/New_York", value: "America/New_York"}, {label: "America/Los_Angeles", value: "America/Los_Angeles"}] value="${state.timezone.value}" required=true
                    action variant=secondary size=sm label=:basics-save onSuccessToast={intent: success, message: "$t(general.basics-saved)", duration: 2500} onErrorToast={intent: error, message: "$t(general.basics-error)", duration: 4000} style={borderRadius: "var(--radius-md, 8px)"} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/general/timezone.json", mode: tree-merge, content: {value: $args.eValue}}}}
                  }
                }
                h3 :records-title level=3 style={fontSize: "var(--type-body)"}
                p :records-desc scale=sm intent=muted
                afs-list general-config-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none pagination=manual pageSize=10 from "/instance/app/arcblog/config/general" {
                  view gap=xs role=item style={borderBottom: "1px solid var(--color-border)", padding: "8px 0"} {
                    h3 "${entry.content.label}" style={fontSize: "var(--type-body)"}
                    p "${entry.content.description}" scale=sm intent=muted
                    p "$t(general.basics-options): ${entry.content.options}" scale=sm intent=muted
                    row gap=xs {
                      p :stored scale=sm intent=muted
                      p "${entry.content.value}" scale=sm
                    }
                  }
                }
              }
              view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px", flexShrink: 0} {
                h3 :switches-title level=3 style={fontSize: "var(--type-body)"}
                p :switches-desc scale=sm intent=muted
                view gap=xs {
                  h3 :sw-comments-name level=3 style={fontSize: "var(--type-body)"}
                  p :sw-comments-impact scale=sm
                  p :sw-comments-consumer scale=sm intent=muted
                }
                view gap=xs {
                  h3 :sw-rss-name level=3 style={fontSize: "var(--type-body)"}
                  p :sw-rss-impact scale=sm
                  p :sw-rss-consumer scale=sm intent=muted
                }
                view gap=xs {
                  h3 :sw-agent-name level=3 style={fontSize: "var(--type-body)"}
                  p :sw-agent-impact scale=sm
                  p :sw-agent-consumer scale=sm intent=muted
                }
                afs-list general-switches-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none pagination=manual pageSize=10 from "/instance/app/arcblog/config/switches" {
                  view gap=xs role=item style={borderBottom: "1px solid var(--color-border)", padding: "8px 0"} {
                    input type=hidden name=sPath value="${entry.path}"
                    row cross=center gap=sm {
                      h3 "${entry.content.label}" style={fontSize: "var(--type-body)"}
                      p :stored scale=sm intent=muted
                      p "${entry.content.value}" scale=sm intent=muted
                    }
                    row gap=xs {
                      action variant=secondary size=sm label=:sw-on onSuccessToast={intent: success, message: "$t(general.sw-saved)", duration: 2500} onErrorToast={intent: error, message: "$t(general.basics-error)", duration: 4000} style={borderRadius: "var(--radius-md, 8px)"} events={click: {exec: "/.actions/write", args: {path: "${args.sPath}", mode: tree-merge, content: {value: true}}}}
                      action size=sm label=:sw-off onSuccessToast={intent: success, message: "$t(general.sw-saved)", duration: 2500} style={borderRadius: "var(--radius-md, 8px)"} events={click: {exec: "/.actions/write", args: {path: "${args.sPath}", mode: tree-merge, content: {value: false}}}}
                    }
                  }
                }
              }
              view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px", flexShrink: 0} {
                h3 :init-title level=3 style={fontSize: "var(--type-body)"}
                p :init-desc scale=sm intent=muted
                row gap=sm {
                  action variant=secondary size=sm label=:init-basics confirm={title: :init-confirm-title, message: :init-confirm-msg} style={borderRadius: "var(--radius-md, 8px)"} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/general/site-name.json", mode: create, content: {label: "Site name", description: "Channel title of the generated RSS feed. It does not rename the blocklet or the console brand.", scope: instance, type: text, maxLength: 120, value: ArcBlog}}, afterSuccess: [{exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/general/language.json", mode: create, content: {label: Language, description: "Value of the RSS <language> element of the generated feed.", scope: instance, type: select, options: [en, zh], pattern: "en|zh", value: en}}}, {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/general/timezone.json", mode: create, content: {label: Timezone, description: "IANA timezone used for the <pubDate>/<lastBuildDate> UTC offset of the generated RSS feed.", scope: instance, type: select, options: [UTC, "Asia/Shanghai", "Asia/Tokyo", "Asia/Singapore", "Europe/London", "Europe/Berlin", "America/New_York", "America/Los_Angeles"], pattern: "UTC|Asia/Shanghai|Asia/Tokyo|Asia/Singapore|Europe/London|Europe/Berlin|America/New_York|America/Los_Angeles", value: UTC}}}]}}
                  action variant=secondary size=sm label=:init-switches confirm={title: :init-confirm-title, message: :init-confirm-msg} style={borderRadius: "var(--radius-md, 8px)"} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/switches/comments.json", mode: create, content: {label: Comments, description: "No consumer yet: ArcBlog has no comment feature, so this switch is recorded only.", scope: instance, type: toggle, value: false}}, afterSuccess: [{exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/switches/rss.json", mode: create, content: {label: RSS, description: "When off, the generated RSS feed carries a channel with no items.", scope: instance, type: toggle, value: true}}}, {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/switches/agent-access.json", mode: create, content: {label: "Agent Access", description: "When off, the Agent Access CLI refuses to run tools (fail closed).", scope: instance, type: toggle, value: true}}}]}}
                }
              }
              // ---- Roles & capabilities (REQ-034 / spec §15.9) --------------------
              // Read-only by design: spec §1273 forbids an address/network input on
              // this page, so the config is displayed only. The five lifecycle words
              // mirror STAKE_STATES in scripts/lib/roles.mjs — the engine stays the
              // single vocabulary source; the derived values are read from the CLI's
              // projection under node/ (written by `verify apply`, never by the page),
              // and the ONE write here is a queued verification intent under config/
              // (role-verify-intents) — a real consumer, not a fake button.
              // BUG-077/BUG-078 (Round 27): the role rows used to carry English
              // literals as LABELS and the engine's own words (granted / withheld /
              // yes / no) as VALUES. The labels are static, so they are page i18n
              // keys now (general.roles-k-*) and the zh side glosses the engine
              // vocabulary inline. The VALUES stay verbatim: `$t()` keys must be
              // compile-time constants (arc-contracts §28.8) and this console cannot
              // translate a runtime value — the design-doc degradation path is
              // "localized label + raw value visible" (docs/ArcBlog-admin-ui-design.md
              // §4.1 / §5.5). The roles-reason-note line states unconditionally that a
              // granted role carries no withheld reason instead of faking a condition.
              view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px", flexShrink: 0} propBind={roles: "/instance/app/arcblog/config/roles.json", verification: "/instance/app/arcblog/node/role-verification.json", basic: "/instance/app/arcblog/node/role-status/basic.json", studio: "/instance/app/arcblog/node/role-status/studio.json", hub: "/instance/app/arcblog/node/role-status/hub.json"} {
                h3 :roles-title level=3 style={fontSize: "var(--type-body)"}
                p :roles-desc scale=sm intent=muted
                p :roles-states scale=sm
                p :roles-states-note scale=sm intent=muted
                h3 :roles-config-title level=3 style={fontSize: "var(--type-body)"}
                p :roles-config-desc scale=sm intent=muted
                // BUG-083 (R29): `.aup-kv-label` is a platform-owned grid item — the row
                // is `grid-template-columns: minmax(140px, 28%) 1fr` (measured in
                // aup-app.*.css: UI-011 P-01 / UI-012 P-02 + BUG-034), so the page has
                // NO style hook on the label, and the 67-key safe-style allowlist has
                // no wordBreak/overflowWrap either (arc-contracts §29.8(1)).
                // At 1512x765 that 28% track is 160.88px while the single unbreakable
                // token `studio.lifecycle.claimableAt` is 171px -> its text painted 10px
                // past its own box (the other 12 labels of this list stayed 161/161).
                // Fix in the D1/D3 family (Lead R29 P-2: "let the KV label wrap", no
                // hardcoded width): a ZERO-WIDTH SPACE after the last dot is a break
                // opportunity that is used ONLY when the track is too narrow — it adds
                // no glyph, the label text stays `studio.lifecycle.claimableAt`, and at
                // 1803x908 the 195px track keeps it on one line exactly as before.
                key-value-list roles-config-kv dense=true fields=[{label: chainVerification, value: "${state.roles.chainVerification}"}, {label: "studio.collectionAddress", value: "${state.roles.studio.collectionAddress}", monospace: true, hideWhenEmpty: true}, {label: "studio.network", value: "${state.roles.studio.network}", hideWhenEmpty: true}, {label: "studio.assetType", value: "${state.roles.studio.assetType}", hideWhenEmpty: true}, {label: "studio.lifecycle.state", value: "${state.roles.studio.lifecycle.state}"}, {label: "studio.lifecycle.assetId", value: "${state.roles.studio.lifecycle.assetId}", monospace: true, hideWhenEmpty: true}, {label: "studio.lifecycle.​claimableAt", value: "${state.roles.studio.lifecycle.claimableAt}", hideWhenEmpty: true}, {label: "hub.collectionAddress", value: "${state.roles.hub.collectionAddress}", monospace: true, hideWhenEmpty: true}, {label: "hub.network", value: "${state.roles.hub.network}", hideWhenEmpty: true}, {label: "hub.assetType", value: "${state.roles.hub.assetType}", hideWhenEmpty: true}, {label: "hub.lifecycle.state", value: "${state.roles.hub.lifecycle.state}"}, {label: "hub.lifecycle.assetId", value: "${state.roles.hub.lifecycle.assetId}", monospace: true, hideWhenEmpty: true}]
                p :roles-no-input scale=sm intent=muted
                key-value-list roles-cmd-config dense=true fields=[{label: :roles-cmd-init, value: "node scripts/arcblog-roles.mjs init --update --studio-collection <addr> --hub-collection <addr> --network <net>", monospace: true, copyable: true}, {label: :roles-cmd-show, value: "node scripts/arcblog-roles.mjs show", monospace: true, copyable: true}, {label: :roles-cmd-check, value: "node scripts/arcblog-roles.mjs check", monospace: true, copyable: true}]
                h3 :roles-status-title level=3 style={fontSize: "var(--type-body)"}
                p :roles-status-desc scale=sm intent=muted
                // UI-018 D2 (§7.2): the old `roles-no-snapshot` line was gated by
                // `visible="!${state.verification.lastVerifiedAt}"` and rendered in
                // NEITHER state (measured in both cold-load and after-reload), and its
                // wording claimed node/role-verification.json does not exist — the record
                // does exist. §4.8 / arc-contracts §21.11 require an UNCONDITIONAL
                // two-stage note that never reads a first-paint blank as "no record".
                p :roles-two-stage-note scale=sm intent=muted
                key-value-list roles-scope-kv dense=true fields=[{label: :roles-k-checked, value: "${state.verification.lastVerifiedAt}", hideWhenEmpty: true}, {label: :roles-k-effective, value: "${state.verification.effectiveCapabilitiesLabel}", hideWhenEmpty: true}, {label: :roles-k-withheld, value: "${state.verification.withheldCapabilitiesLabel}", hideWhenEmpty: true}, {label: :roles-k-roles, value: "${state.verification.declaredRolesLabel}", hideWhenEmpty: true}]
                key-value-list roles-basic-kv dense=true fields=[{label: :roles-k-basic-stake-state, value: "${state.basic.stakeState}"}, {label: :roles-k-basic-active, value: "${state.basic.activeLabel}"}, {label: :roles-k-basic-configured, value: "${state.basic.configuredLabel}"}, {label: :roles-k-basic-asset-owned, value: "${state.basic.assetOwnedLabel}"}, {label: :roles-k-basic-reason, value: "${state.basic.reason}"}]
                key-value-list roles-studio-kv dense=true fields=[{label: :roles-k-studio-stake-state, value: "${state.studio.stakeState}"}, {label: :roles-k-studio-active, value: "${state.studio.activeLabel}"}, {label: :roles-k-studio-configured, value: "${state.studio.configuredLabel}"}, {label: :roles-k-studio-asset-owned, value: "${state.studio.assetOwnedLabel}"}, {label: :roles-k-studio-reason, value: "${state.studio.reason}"}, {label: :roles-k-studio-consistency, value: "${state.studio.consistencyReason}"}]
                key-value-list roles-hub-kv dense=true fields=[{label: :roles-k-hub-stake-state, value: "${state.hub.stakeState}"}, {label: :roles-k-hub-active, value: "${state.hub.activeLabel}"}, {label: :roles-k-hub-configured, value: "${state.hub.configuredLabel}"}, {label: :roles-k-hub-asset-owned, value: "${state.hub.assetOwnedLabel}"}, {label: :roles-k-hub-reason, value: "${state.hub.reason}"}, {label: :roles-k-hub-consistency, value: "${state.hub.consistencyReason}"}]
                p :roles-reason-note scale=caption intent=muted
                // B4: the waiting period, shown honestly. The raw `claimableAt` value
                // is rendered (hideWhenEmpty). A relative `time` row is deliberately
                // NOT rendered: measured twice on this platform (2026-09-29) that
                // `visible="${state.x}"` keeps an empty value visible while
                // `visible="!!${state.x}"` hides a non-empty one — and the `time`
                // primitive reads an EMPTY value as "just now". A fabricated
                // "claimable now" is worse than no widget (L-R26R-4).
                key-value-list roles-claimable-kv dense=true fields=[{label: "studio.claimableAt", value: "${state.studio.claimableAt}", monospace: true, hideWhenEmpty: true}]
                p :roles-claimable-note scale=caption intent=muted
                p :roles-honesty scale=sm intent=info
                h3 :roles-verify-title level=3 style={fontSize: "var(--type-body)"}
                p :roles-verify-desc scale=sm intent=muted
                p :roles-verify-kind scale=sm intent=muted
                p :roles-verify-queue scale=sm intent=muted
                row gap=sm {
                  action variant=secondary size=sm label=:roles-verify-button confirm={title: :roles-verify-confirm-title, message: :roles-verify-confirm-msg} onSuccessToast={intent: success, message: "$t(general.roles-verify-queued)", duration: 3000} onErrorToast={intent: error, message: "$t(general.roles-verify-error)", duration: 4000} style={borderRadius: "var(--radius-md, 8px)"} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/role-verify-intents/${generate.timeiso}.json", mode: create, content: {id: "${generate.timeiso}", action: verify, role: all, status: pending, message: "queued — a local worker has not run this yet", changed: [], requestedVia: console, requestedAt: "${generate.timeiso}"}}}}
                }
                key-value-list roles-verify-worker-cmds dense=true fields=[{label: :roles-verify-worker, value: "node scripts/arcblog-roles.mjs verify apply", monospace: true, copyable: true}, {label: :roles-cmd-show, value: "node scripts/arcblog-roles.mjs verify show", monospace: true, copyable: true}]
                h3 :roles-factory-title level=3 style={fontSize: "var(--type-body)"}
                p :roles-factory-desc scale=sm intent=muted
                row gap=xs {
                  // UI-018 D8 (§7.7, lane-O variant): the bare `href="/?page=factory"`
                  // rendered `<a>` WITHOUT a target, so one click replaced the whole
                  // console document (the §9 equivalent assertion counted total=1).
                  // Lane O opens it in a NEW TAB instead (the in-repo pattern
                  // `action href=… target=_blank`, arc-contracts §21.10, same as the
                  // footer RSS link): no document navigation happens in this tab, so
                  // the §9 assertion is total=0 again. If the standard's §2.6 table
                  // (console sections switch in-frame via `-> page <name>`) is to be
                  // followed literally, `-> page factory` also yields total=0 — Lead call.
                  action variant=primary size=sm label=:roles-factory-link href="/?page=factory" target=_blank style={borderRadius: "var(--radius-md, 8px)"}
                }
                p :roles-source-note scale=caption intent=muted
              }
            }
          }
        }
      }
    }
  }
}
