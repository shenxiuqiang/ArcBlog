page compose {
  i18n {
    category { en "Category" zh "分类" }
    desc { en "Write a story, then save it as a private draft or publish it to the site." zh "撰写文章，然后存为私有草稿或直接发布到站点。" }
    f-body { en "Body (Markdown)" zh "正文（Markdown）" }
    f-cover { en "Cover image URL" zh "封面图 URL" }
    f-og-desc { en "OG Description" zh "OG 描述" }
    f-og-image { en "OG Image" zh "OG 图" }
    f-og-title { en "OG Title" zh "OG 标题" }
    f-seo-desc { en "SEO Description" zh "SEO 描述" }
    f-seo-title { en "SEO Title" zh "SEO 标题" }
    f-slug { en "Slug (lowercase letters, numbers, dashes)" zh "Slug（小写字母、数字、连字符）" }
    f-summary { en "Summary" zh "摘要" }
    f-title { en "Title" zh "标题" }
    g-content { en "Content" zh "内容" }
    g-publish { en "Publish" zh "发布" }
    g-taxonomy { en "Category & tags" zh "分类与标签" }
    gate-desc { en "Sign in with DID Wallet to unlock the editor. Drafts stay in the private drafts directory until published." zh "使用 DID Wallet 登录以解锁编辑器。草稿保存在私有草稿目录中，直到发布。" }
    gate-title { en "Write a post" zh "写文章" }
    login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
    publish-now { en "Publish" zh "发布" }
    save-draft { en "Save draft" zh "存草稿" }
    saved { en "Saved." zh "已保存。" }
    tab-advanced { en "Advanced" zh "高级" }
    tab-basic { en "Essentials" zh "基本" }
    tags { en "Tags" zh "标签" }
    title { en "Write a post" zh "写文章" }
  }
  view gap=lg style={height: "calc(100vh - 48px)", overflow: visible} {
    view style={gap: "0"} {
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "20px"} visible="!$session.authenticated" {
        h2 :gate-title level=2 style={fontSize: "var(--type-body)"}
        p :gate-desc intent=muted
        row cross=start {
          action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dcompose&cancel_to=%2F%3Fpage%3Dcompose" variant=primary label=:login style={borderRadius: "var(--radius-md, 8px)"}
        }
      }
      row gap=lg cross=stretch style={width: "100vw", marginLeft: "calc(50% - 50vw)", height: "calc(100vh - 48px)", marginBottom: "-52px", padding: "0 32px 0 0"} visible=$session.authenticated {
        view size={width: "clamp(200px, 15vw, 280px)", flexShrink: 0, height: "100%"} style={padding: "0", background: "var(--color-surface)", borderRight: "1px solid var(--color-border)", overflowY: auto, gap: "0", height: "100%"} visible=$session.authenticated {
          p "$t(wrapper.nav-group-content)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-dashboard)" -> page dashboard style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-studio)" -> page posts style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-pages)" -> page pages style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-write)" -> page compose active=true style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-site)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-heroes)" -> page heroes style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-categories)" -> page categories style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-tags)" -> page tags style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-seo)" -> page seo style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-feeds)" -> page feeds style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-appearance)" -> page appearance style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-ops)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-operations)" -> page operations style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-registry)" -> page registry style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-factory)" -> page factory style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-media)" -> page media style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-agents)" -> page agents style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-settings)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-settings)" -> page general style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-diagnostics)" -> page diagnostics style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view gap=xs style={padding: "10px 20px 10px 32px", background: "var(--color-bg)", borderTop: "1px solid var(--color-border)", flexShrink: 0} visible="!$session.isAdmin" {
            p "$t(wrapper.admin-notice)" scale=caption intent=muted
          }
        }
        view gap=md size={flex: 1} style={paddingTop: "14px", paddingBottom: "14px", minHeight: 0} {
          view gap=sm {
            h2 :title level=2 style={fontSize: "var(--type-subheading)"}
            p :desc intent=muted
          }
          view gap=lg size={flex: 1} style={overflowY: auto} {
            view gap=lg style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "16px", flexShrink: 0} {
              view compose-form-tabs mode=tabs {
                view compose-form-basic label=:tab-basic {
                  view gap=sm {
                    h3 :g-content level=3
                    input type=text label=:f-title name=title required=true state={value: ""}
                    input type=text label=:f-slug name=slug required=true state={value: ""}
                    input type=text label=:f-summary name=summary state={value: ""}
                    input type=textarea label=:f-body name=body required=true state={value: ""}
                  }
                  view gap=sm {
                    h3 :g-taxonomy level=3
                    input type=select label=:category name=category options=[technology, design, life] state={value: technology}
                    input type=text label=:tags name=tags state={value: ""}
                  }
                  view gap=sm {
                    h3 :g-publish level=3
                    input type=text label=:f-cover name=coverImage state={value: ""}
                  }
                }
                view compose-form-advanced label=:tab-advanced {
                  view gap=sm {
                    input type=text label=:f-seo-title name=seoTitle state={value: ""}
                    input type=text label=:f-seo-desc name=seoDescription state={value: ""}
                    input type=text label=:f-og-title name=ogTitle state={value: ""}
                    input type=text label=:f-og-desc name=ogDescription state={value: ""}
                    input type=text label=:f-og-image name=ogImage state={value: ""}
                  }
                  afs-dropzone
                }
              }
            }
          }
          row gap=sm style={justifyContent: flex-end, flexShrink: 0} {
            action variant=secondary label=:save-draft style={borderRadius: "var(--radius-md, 8px)"} onSuccessToast={intent: success, message: "$t(compose.saved)", duration: 3000} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/drafts/${args.slug}.json", content: {title: "${args.title}", slug: "${args.slug}", summary: "${args.summary}", body: "${args.body}", coverImage: "${args.coverImage}", images: [], tags: "${args.tags}", category: "${args.category}", seoTitle: "${args.seoTitle}", seoDescription: "${args.seoDescription}", ogTitle: "${args.ogTitle}", ogDescription: "${args.ogDescription}", ogImage: "${args.ogImage}", status: draft, authorDid: $session.did, authorName: $session.displayName, published: false, publishedAt: "", archivedAt: "", deletedAt: "", createdAt: "${generate.timeiso}", updatedAt: "${generate.timeiso}", version: 1}}}}
            action variant=primary label=:publish-now style={borderRadius: "var(--radius-md, 8px)"} onSuccessToast={intent: success, message: "$t(compose.saved)", duration: 3000} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/posts/${args.slug}.json", content: {title: "${args.title}", slug: "${args.slug}", summary: "${args.summary}", body: "${args.body}", coverImage: "${args.coverImage}", images: [], tags: "${args.tags}", category: "${args.category}", seoTitle: "${args.seoTitle}", seoDescription: "${args.seoDescription}", ogTitle: "${args.ogTitle}", ogDescription: "${args.ogDescription}", ogImage: "${args.ogImage}", status: published, authorDid: $session.did, authorName: $session.displayName, published: true, publishedAt: "${generate.timeiso}", archivedAt: "", deletedAt: "", createdAt: "${generate.timeiso}", updatedAt: "${generate.timeiso}", version: 1}}}}
          }
        }
      }
    }
  }
}
