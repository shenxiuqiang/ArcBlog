page dashboard {
  i18n {
    kpi-published { en "Published" zh "已发布" }
    kpi-drafts { en "Drafts" zh "草稿" }
    kpi-pages { en "Pages online" zh "已上线页面" }
    kpi-media { en "Media" zh "素材" }
    refresh { en "Reload" zh "刷新" }
    anomalies { en "Anomaly zone" zh "异常区" }
    anomalies-desc { en "One entry per class; every row links to where it is fixed." zh "四类检查各一行，每行都能点进「去处理」。" }
    anomalies-evidence { en "Raw evidence (English source + check time)" zh "原始证据（英文原文与检查时间）" }
    anomalies-evidence-hide { en "Hide raw evidence" zh "收起原始证据" }
    anomalies-open { en "Open" zh "去处理" }
    anomalies-severity { en "Severity" zh "级别" }
    anomalies-state { en "Last check, verbatim" zh "最近一次检查（原话）" }
    content { en "Recent published" zh "最近发布" }
    content-desc { en "Five newest stories." zh "最新 5 篇已发布。" }
    content-empty { en "No published stories yet." zh "还没有已发布的文章。" }
    drafts { en "Drafts to finish" zh "待处理草稿" }
    drafts-all { en "View all" zh "查看全部" }
    drafts-desc { en "Newest drafts (deleted ones excluded)." zh "最近更新的草稿（不含已删除）。" }
    drafts-empty { en "No drafts yet." zh "还没有草稿。" }
    gate-desc { en "Sign in with DID Wallet to see the drafts waiting for you and what is already live." zh "使用 DID Wallet 登录后查看待处理的草稿与已发布内容。" }
    gate-title { en "Dashboard" zh "仪表盘" }
    login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
    purpose { en "Drafts to finish, anomalies to clear, what is live." zh "草稿、异常、已发布，一眼看完。" }
    q-write { en "Write a post" zh "写文章" }
    title { en "Dashboard" zh "仪表盘" }
  }
  view gap=lg style={height: "calc(100vh - 48px)", overflow: visible} {
    view style={gap: "0"} {
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "20px"} visible="!$session.authenticated" {
        h2 :gate-title level=2 style={fontSize: "var(--type-body)"}
        p :gate-desc intent=muted
        row cross=start {
          action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Ddashboard&cancel_to=%2F%3Fpage%3Ddashboard" variant=primary label=:login style={borderRadius: "var(--radius-md, 8px)"}
        }
      }
      row gap=lg cross=stretch style={width: "100vw", marginLeft: "calc(50% - 50vw)", height: "calc(100vh - 48px)", marginBottom: "-52px", padding: "0 32px 0 0"} visible=$session.authenticated {
        view size={width: "clamp(200px, 15vw, 280px)", flexShrink: 0, height: "100%"} style={padding: "0", background: "var(--color-surface)", borderRight: "1px solid var(--color-border)", overflowY: auto, gap: "0", height: "100%"} visible=$session.authenticated {
          p "$t(wrapper.nav-group-content)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-dashboard)" -> page dashboard active=true style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-studio)" -> page posts style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-pages)" -> page pages style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-write)" -> page compose style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-site)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-heroes)" -> page heroes style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-categories)" -> page categories style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-tags)" -> page tags style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-feeds)" -> page feeds style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-ops)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-operations)" -> page operations style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-registry)" -> page registry style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-factory)" -> page factory style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-agents)" -> page agents style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-settings)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-settings)" -> page general style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-diagnostics)" -> page diagnostics style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view gap=xs style={padding: "10px 20px 10px 32px", background: "var(--color-bg)", borderTop: "1px solid var(--color-border)", flexShrink: 0} visible="!$session.isAdmin" {
            p "$t(wrapper.admin-notice)" scale=caption intent=muted
          }
        }
        // ---- 内容列：唯一滚动容器在本列内部（standard §2.5 单一滚动归属）------
        view gap=0 size={flex: 1} style={paddingTop: "18px", paddingBottom: "18px", minHeight: 0} {
          // ---- 刊头（masthead）：标题 / 一句话用途 / 唯一主操作 -------------------
          // 三者压在同一基线上，下沿一条 1px 细线把「刊头」与「正文」分开 —— 本条是整页
          // 唯一的分隔手段。字号一律取运行时的 --type-* 阶梯，颜色一律 --color-*：
          // 页面不新造字号、不写颜色（UI 规范 V01）。
          view style={padding: "4px 0 16px", borderBottom: "1px solid var(--color-border)", flexShrink: 0} {
            row gap=md cross=end {
              view gap=0 size={flex: 1} {
                h2 :title level=2
                p :purpose intent=muted
              }
              // §4.3：平台在 tone=editorial 下把所有 action 抹成 2rem 药丸，圆角必须内联
              // 覆盖回 var(--radius-md, 8px)。
              row cross=start size={width: hug} {
                action -> page compose variant=primary label=:q-write style={borderRadius: "var(--radius-md, 8px)", padding: "9px 14px", fontSize: "var(--type-caption)", fontWeight: "500"}
              }
            }
          }
          view gap=0 size={flex: 1} style={overflowY: auto, paddingTop: "18px"} {
            // ---- 计数带（KPI）：数字成带，没有卡片边框 -----------------------------
            // 数字由 CLI 预计算成一条记录（config/console/kpi/overview.json），页面用
            // `afs-list` 的行内模板 `${entry.content.*}` 逐字打印 —— 这是**首次渲染就出数**
            // 的唯一通道；`propBind` 要等第二次渲染才把记录挂进 session state，冷启动首帧
            // 四个格子只有标签（B14 / arc-contracts §57）。页面不自算任何数字（B13）。
            // 记录独占 `kpi/` 目录：列表会把该目录下的每条记录都渲染成一行，而
            // `config/console/` 里还有 `recent-drafts/`。
            // item 的全部内容收在一个 role=item 的 view 里 —— item 容器按栅格排布，
            // 直接子节点会被摊成并列的列。四列等分（size={flex: 1}），上沿一条细线，
            // 下沿交给下一节的分节线 —— 中间不留空行，避免"两条横线夹一行字"。
            view gap=0 style={borderTop: "1px solid var(--color-border)", paddingTop: "14px", flexShrink: 0} {
              afs-list dashboard-kpi-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none emptyText=" " pagination=manual pageSize=1 from "/instance/app/arcblog/config/console/kpi" {
                view gap=0 role=item {
                  row gap=lg size={width: fill} {
                    view gap=xs size={flex: 1} {
                      view layout=inline href="/?page=posts" {
                        p "${entry.content.publishedCount}" style={fontSize: "var(--type-display, 32px)", fontWeight: "600", lineHeight: "1.1"}
                      }
                      p "$t(dashboard.kpi-published)" style={fontSize: "var(--type-small)", letterSpacing: "0.07em", textTransform: uppercase, color: "var(--color-dim)"}
                    }
                    view gap=xs size={flex: 1} {
                      view layout=inline href="/?page=posts" {
                        p "${entry.content.draftCount}" style={fontSize: "var(--type-display, 32px)", fontWeight: "600", lineHeight: "1.1"}
                      }
                      p "$t(dashboard.kpi-drafts)" style={fontSize: "var(--type-small)", letterSpacing: "0.07em", textTransform: uppercase, color: "var(--color-dim)"}
                    }
                    view gap=xs size={flex: 1} {
                      view layout=inline href="/?page=pages" {
                        p "${entry.content.pageOnlineCount}" style={fontSize: "var(--type-display, 32px)", fontWeight: "600", lineHeight: "1.1"}
                      }
                      p "$t(dashboard.kpi-pages)" style={fontSize: "var(--type-small)", letterSpacing: "0.07em", textTransform: uppercase, color: "var(--color-dim)"}
                    }
                    // 素材数不再有独立页（`?page=media` 随 S11-02 删除），所以这一格不给链接：
                    // 指到别处比不给链接更糟——点进去找不到"素材"这件事本身就是缺陷。
                    view gap=xs size={flex: 1} {
                      view gap=0 {
                        p "${entry.content.mediaCount}" style={fontSize: "var(--type-display, 32px)", fontWeight: "600", lineHeight: "1.1"}
                      }
                      p "$t(dashboard.kpi-media)" style={fontSize: "var(--type-small)", letterSpacing: "0.07em", textTransform: uppercase, color: "var(--color-dim)"}
                    }
                  }
                  // 分账不一致时才是可见的：`divergences` 是预计算文本，空字符串 = 数据库计数与
                  // 目录清单一致（正常情况），此时什么都不显示。
                  p "${entry.content.divergences}" scale=caption intent=warning
                  row cross=center style={justifyContent: space-between, paddingTop: "10px"} {
                    p "${entry.content.measuredAtLocal}" scale=sm intent=muted
                    action -> navigate "/?page=dashboard" icon=refresh variant=secondary size={width: hug} label=:refresh style={borderRadius: "var(--radius-sm, 4px)", fontSize: "var(--type-small)"}
                  }
                }
              }
            }
            // ---- 异常区：整页唯一的告警面（也是唯一的卡片）---------------------------
            // 判定全部由 `arcblog-anomalies.mjs refresh` 预计算（B13：页面不能条件化
            // `$state.*`）。左侧 2px --color-warning 竖线是「颜色只用来传话」的那一处：
            // 其余全部是墨色 + 细线。行内 `view href=` 是唯一可靠的数据分支。
            view gap=0 style={borderTop: "1px solid var(--color-border)", marginTop: "20px", paddingTop: "18px", flexShrink: 0} {
              h3 :anomalies level=3
              p :anomalies-desc scale=sm intent=muted
              view gap=xs style={marginTop: "10px", padding: "2px 14px", background: "var(--card-bg)", border: "var(--card-border)", borderLeft: "2px solid var(--color-warning)", borderRadius: "0 var(--radius-md, 8px) var(--radius-md, 8px) 0"} {
                // 列头：整块只有这一处「级别」标签（每行不再重复），行内只剩值本身。
                row cross=center {
                  p :anomalies-severity scale=caption intent=muted
                }
                afs-list dashboard-anomalies-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none pagination=manual pageSize=10 from "/instance/app/arcblog/node/anomalies" {
                  row gap=md cross=start role=item {
                    p "${entry.content.severityZh}" size={width: hug} intent=warning style={minWidth: "34px"}
                    view gap=0 size={flex: 1} {
                      p "${entry.content.titleZh}"
                      p "${entry.content.detailZh}" scale=sm intent=muted
                    }
                    view layout=inline href="${entry.content.href}" size={width: hug} {
                      p :anomalies-open scale=sm
                    }
                  }
                }
                // 原始证据（英文原文 + 检查时间）默认折叠：首屏只留中文结论与「去处理」。
                row cross=start style={padding: "6px 0 8px"} {
                  action -> set dashboard-anomalies-evidence state {open: "true"} variant=secondary size=sm label=:anomalies-evidence style={borderRadius: "var(--radius-sm, 4px)", fontSize: "var(--type-small)"}
                }
                view gap=sm visible=$state.open {
                  afs-list dashboard-anomalies-raw-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none pagination=manual pageSize=10 from "/instance/app/arcblog/node/anomalies" {
                    row gap=xs cross=center role=item {
                      view gap=xs size={flex: 1} {
                        row gap=xs cross=center {
                          p "${entry.content.severity}" scale=caption intent=muted
                          p "${entry.content.title}" scale=caption
                        }
                        p "${entry.content.detail}" scale=caption intent=muted
                      }
                    }
                  }
                  surface url="/instance/app/arcblog/node/anomalies.json" editable=false {
                    p :anomalies-state scale=caption intent=muted
                  }
                  row cross=start {
                    action -> set dashboard-anomalies-evidence state {open: ""} variant=secondary size=sm label=:anomalies-evidence-hide style={borderRadius: "var(--radius-sm, 4px)", fontSize: "var(--type-small)"}
                  }
                }
              }
            }
            // ---- 待处理草稿 -------------------------------------------------------
            view gap=0 style={borderTop: "1px solid var(--color-border)", marginTop: "18px", paddingTop: "18px", flexShrink: 0} {
              row cross=center {
                view gap=0 size={flex: 1} {
                  h3 :drafts level=3
                  p :drafts-desc scale=sm intent=muted
                }
                row cross=start size={width: hug} {
                  action -> page posts variant=secondary size=sm label=:drafts-all style={borderRadius: "var(--radius-sm, 4px)", fontSize: "var(--type-small)"}
                }
              }
              afs-list dashboard-drafts-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none emptyText=:drafts-empty pagination=manual pageSize=3 pageSizeOptions=[3] pagerStyle=compact sort={field: mtime, desc: true} from "/instance/app/arcblog/config/console/recent-drafts" {
                row gap=md cross=center role=item {
                  view layout=inline href="/edit/${entry.content.slug}" target=_blank size={flex: 1} {
                    row gap=xs cross=baseline {
                      p "${entry.content.title}"
                      p "${entry.content.status}" scale=sm intent=muted
                      p "${entry.content.updatedLocal}" scale=sm intent=muted
                    }
                  }
                }
              }
            }
            // ---- 最近发布 ---------------------------------------------------------
            view gap=0 style={borderTop: "1px solid var(--color-border)", marginTop: "18px", paddingTop: "18px", flexShrink: 0} {
              h3 :content level=3
              p :content-desc scale=sm intent=muted
              afs-list dashboard-published-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none emptyText=:content-empty pagination=manual pageSize=5 pageSizeOptions=[5] pagerStyle=compact sort={field: mtime, desc: true} from "/instance/app/arcblog/posts" {
                row gap=md cross=center role=item {
                  view layout=inline href="/posts/${entry.content.slug}" target=_blank size={flex: 1} {
                    row gap=xs cross=baseline {
                      p "${entry.content.title}"
                      p "${entry.content.category}" scale=sm intent=muted
                      time mode=display value="${entry.content.publishedAt}" timeMode=relative scale=sm intent=muted
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
