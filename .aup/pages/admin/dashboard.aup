page dashboard {
  i18n {
    content { en "Recent published" zh "最近发布" }
    content-empty { en "No published stories yet." zh "还没有已发布的文章。" }
    content-guide { en "Write and publish from Write; the newest five stories appear here." zh "在「写文章」页撰写并发布；最新五篇会显示在这里。" }
    drafts { en "Drafts to finish" zh "待处理草稿" }
    drafts-all { en "All drafts & published" zh "全部草稿与已发布" }
    drafts-desc { en "The three most recently updated records in the private drafts area." zh "私有草稿区中最近更新的 3 条记录。" }
    drafts-empty { en "No drafts waiting. Use “Write a post” above to start one." zh "没有待处理的草稿。用上方的「写文章」开始一篇。" }
    gate-desc { en "Sign in with DID Wallet to see the drafts waiting for you and what is already live." zh "使用 DID Wallet 登录后查看待处理的草稿与已发布内容。" }
    gate-title { en "Dashboard" zh "仪表盘" }
    login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
    pagesize-note { en "Pagination note (BUG-063): the per-page selector (“Show”) is stored by THIS browser as localStorage['aup-list-pagesize:<list id>'] and overrides the page default. Choosing a value ≥ the total makes the platform drop the whole paginator — including the selector itself — so no in-page control can bring it back. Recovery: clear this site's data, or delete that localStorage key, then reload." zh "分页说明（BUG-063）：每页条数选择器（Show）由**本浏览器**以 localStorage['aup-list-pagesize:<列表 id>'] 记住，并覆盖页面默认值。选到 ≥ 总数的值会让平台移除整个分页器——包括选择器本身——页面因此无法提供回退入口。恢复：清除本站点数据，或删除该 localStorage 键，然后刷新。" }
    purpose { en "What needs you now: the drafts still to finish, and what is already live." zh "现在要你处理的：还没写完的草稿，以及已经发布的内容。" }
    q-write { en "Write a post" zh "写文章" }
    title { en "Dashboard" zh "仪表盘" }
  }
  view gap=lg style={height: "calc(100vh - 48px)", overflow: visible} {
    view style={gap: "0"} {
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "20px"} visible="!$session.authenticated" {
        h2 :gate-title level=2 style={fontSize: "var(--type-body)"}
        p :gate-desc intent=muted
        row cross=start {
          action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Ddashboard&cancel_to=%2F%3Fpage%3Ddashboard" variant=primary label=:login style={borderRadius: "var(--radius-md, 8px)"}
        }
      }
      row gap=lg cross=stretch style={width: "100vw", marginLeft: "calc(50% - 50vw)", height: "calc(100vh - 48px)", marginBottom: "-52px", padding: "0 32px 0 0"} visible=$session.authenticated {
        view size={width: "clamp(200px, 15vw, 280px)", flexShrink: 0, height: "100%"} style={padding: "0", background: "var(--color-surface)", borderRight: "1px solid var(--color-border)", overflowY: auto, gap: "0", height: "100%"} visible=$session.authenticated {
          p "$t(wrapper.nav-group-content)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-dashboard)" -> page dashboard active=true style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-studio)" -> page posts style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-pages)" -> page pages style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-write)" -> page compose style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-site)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-heroes)" -> page heroes style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-categories)" -> page categories style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-tags)" -> page tags style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-seo)" -> page seo style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-feeds)" -> page feeds style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-appearance)" -> page appearance style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-ops)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-operations)" -> page operations style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-hub)" -> page hub style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-media)" -> page media style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-agents)" -> page agents style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-economy)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-orders)" -> page orders style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-policy)" -> page policy style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-access)" -> page access style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-ledger)" -> page ledger style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-factory)" -> page factory style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-settings)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-settings)" -> page general style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-diagnostics)" -> page diagnostics style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={marginTop: auto, background: "var(--color-bg)", borderTop: "1px solid var(--color-border)", flexShrink: 0, gap: "0"} {
            p "$t(wrapper.footer-brand)" scale=caption intent=muted style={padding: "10px 20px 2px 32px", flexShrink: 0}
            action "$t(wrapper.footer-about)" href="/?page=about" style={border: none, borderRadius: "0", padding: "4px 20px 4px 32px", justifyContent: flex-start, flexShrink: 0}
            action "$t(wrapper.footer-rss)" href="/p/rss.xml" target=_blank style={border: none, borderRadius: "0", padding: "4px 20px 4px 32px", justifyContent: flex-start, flexShrink: 0}
            p "$t(wrapper.footer-copyright)" scale=caption intent=muted style={padding: "2px 20px 10px 32px", flexShrink: 0}
          }
        }
        // ---- 页头（standard §2.4）：标题 + 一句话用途 + 唯一主操作 --------------
        // 原型 = P2 概览（standard §2.7.1），声明在 .aup/man/dashboard.yaml 的 synopsis 里。
        // 「写文章」是本页唯一的 variant=primary；未登录态的门禁卡里那个登录按钮
        // 是另一态的唯一主操作（两态互斥，standard §4.3「每屏一个 primary」）。
        view gap=md size={flex: 1} style={paddingTop: "14px", paddingBottom: "14px", minHeight: 0} {
          row gap=md cross=center {
            view gap=xs size={flex: 1} {
              h2 :title level=2 style={fontSize: "var(--type-subheading)"}
              p :purpose intent=muted
            }
            // §4.3：平台在 tone=editorial 下把所有 action 抹成 2rem 药丸，
            // 圆角必须内联覆盖回 var(--radius-md, 8px)。
            row cross=start {
              action -> page compose variant=primary label=:q-write style={borderRadius: "var(--radius-md, 8px)"}
            }
          }
          // ---- 内容区：唯一滚动容器（standard §2.5 单一滚动归属）----------------
          view gap=sm size={flex: 1} style={overflowY: auto} {
            // 一张卡、两个区块。P2 允许 ≤2 张卡，但「2 张卡 + 2 个区块标题 + 2 个按钮」
            // 要占 9 处内联 style，越过 §2.7.2 的硬上限 8；A.4 的口径是「多出来的
            // 卡片合并成区块，不要并排堆」，因此待处理草稿与最近已发布同卡分区。
            view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px", flexShrink: 0} {
              h3 :drafts level=3 style={fontSize: "var(--type-body)"}
              p :drafts-desc scale=sm intent=muted
              // 最新 3 条。sort 走平台自己的 `/.actions/query`：实测 2026-09-29
              // `orderBy [["mtime","desc"]]` 返回 drafts total=46（与目录一致）且按
              // updatedAt 倒序；`mtime` 是运行期 `Le` 白名单里的 entry column，
              // content.* 字段不在其中（读 arc 2.0.0-beta.50 的 aup.* bundle 得到）。
              // 计数由平台分页器给出（pagerStyle=compact → "N total"）：本平台没有
              // length / 比较原语，页面侧数不出来（docs/arc-contracts.md §21），
              // 因此不放任何页面自算的数字。
              // pageSizeOptions=[3] 把「Show」固定成唯一取值：BUG-063 的 localStorage
              // 记忆一旦选到 ≥ 总数就会摘掉整个分页器，这里从结构上消除该路径。
              afs-list dashboard-drafts-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none emptyText=:drafts-empty pagination=manual pageSize=3 pageSizeOptions=[3] pagerStyle=compact sort={field: mtime, desc: true} from "/instance/app/arcblog/drafts" {
                row gap=xs cross=center role=item {
                  // 记录绑定页 /edit/<slug>：standard §2.6 → 新标签页，不替换控制台。
                  view layout=inline href="/edit/${entry.content.slug}" target=_blank size={flex: 1} {
                    p "${entry.content.title}"
                    row gap=xs cross=center intent=muted {
                      p "${entry.content.status}"
                      time mode=display value="${entry.content.updatedAt}" timeMode=relative
                    }
                  }
                }
              }
              // 待处理草稿的去向：工作室（?page=posts）里才有发布 / 软删 / 行内编辑。
              // 空态时它也是引导动作。
              row cross=start {
                action -> page posts variant=secondary size=sm label=:drafts-all style={borderRadius: "var(--radius-md, 8px)"}
              }
              p :pagesize-note scale=caption intent=muted
              h3 :content level=3 style={fontSize: "var(--type-body)"}
              p :content-guide scale=sm intent=muted
              // 最近已发布 5 条，同一套 mtime desc 排序。
              afs-list dashboard-published-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none emptyText=:content-empty pagination=manual pageSize=5 pageSizeOptions=[5] pagerStyle=compact sort={field: mtime, desc: true} from "/instance/app/arcblog/posts" {
                row gap=xs cross=center role=item {
                  view layout=inline href="/posts/${entry.content.slug}" target=_blank size={flex: 1} {
                    p "${entry.content.title}"
                    row gap=xs cross=center intent=muted {
                      p "${entry.content.category}"
                      time mode=display value="${entry.content.publishedAt}" timeMode=relative
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
