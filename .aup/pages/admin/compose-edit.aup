page compose-edit {
  i18n {
    back { en "Back to studio" zh "返回工作室" }
    category { en "Category" zh "分类" }
    desc { en "Edit this draft, then save it back to the private drafts or publish it to the site." zh "编辑此草稿，然后存回私有草稿或直接发布到站点。" }
    f-body { en "Body (Markdown)" zh "正文（Markdown）" }
    f-cover { en "Cover image URL" zh "封面图 URL" }
    f-og-desc { en "OG Description" zh "OG 描述" }
    f-og-image { en "OG Image" zh "OG 图" }
    f-og-title { en "OG Title" zh "OG 标题" }
    f-seo-desc { en "SEO Description" zh "SEO 描述" }
    f-seo-title { en "SEO Title" zh "SEO 标题" }
    f-slug { en "Slug (lowercase letters, numbers, dashes)" zh "Slug（小写字母、数字、连字符）" }
    f-summary { en "Summary" zh "摘要" }
    f-title { en "Title" zh "标题" }
    g-content { en "Content" zh "内容" }
    g-publish { en "Publish" zh "发布" }
    g-taxonomy { en "Category & tags" zh "分类与标签" }
    gate-desc { en "Sign in with DID Wallet to edit this draft; save it back to the private drafts or publish it." zh "使用 DID Wallet 登录后编辑这篇草稿，可存回私有草稿或直接发布。" }
    gate-title { en "Edit post" zh "编辑文章" }
    login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
    runtime-note { en "The editor binds the draft record after the first load. If the fields stay empty, reload once — or open the studio and pick an existing draft." zh "编辑器在首次加载之后才绑定草稿记录。若表单仍为空，刷新一次即可；也可以回工作室挑选一个已有草稿。" }
    publish-now { en "Publish" zh "发布" }
    save-draft { en "Save draft" zh "存草稿" }
    saved { en "Saved." zh "已保存。" }
    tags { en "Tags" zh "标签" }
    title { en "Edit post" zh "编辑文章" }
  }
  view gap=lg style={height: "calc(100vh - 48px)", overflow: visible} {
    view gap=lg size={flex: 1} style={minHeight: 0} propBind={post: "/instance/app/arcblog/drafts/$params.slug.json"} {
      view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "20px"} visible="!$session.authenticated" {
        h2 :gate-title level=2 style={fontSize: "var(--type-body)"}
        p :gate-desc intent=muted
        row cross=start {
          action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dcompose-edit&cancel_to=%2F%3Fpage%3Dcompose-edit" variant=primary label=:login
        }
      }
      view gap=lg size={flex: 1} visible=$session.authenticated {
        view gap=sm {
          row cross=start {
            action -> page posts variant=ghost size=sm label=:back style={borderRadius: "var(--radius-md, 8px)", padding: "5px 12px"}
          }
          h2 :title level=2 style={fontSize: "var(--type-subheading)"}
          p :desc intent=muted
        }
        // DEF-15/DEF-18: the old card used `visible="!$state.post"`, evaluated once
        // before `propBind` resolved and then frozen (arc-contracts §28.1). Standing
        // copy only — it must not claim the draft is missing.
        view gap=sm {
          p :runtime-note intent=muted
        }
        // DEF-18 measured exception: keep the write surface gated — cold-load rendering would expose an empty-state publish/save control
        view gap=lg size={flex: 1} visible=$state.post {
          view gap=lg size={flex: 1} style={overflowY: auto} {
            // 左右两列（2026-10-13，与 `?page=compose` 同形）：左列只放写作面（标题 / 摘要 / 正文 rows=18），
            // 右列是其余设置（slug / 分类 / 标签 / 封面 + 上传 / SEO·OG）；页签取消后 `tab-basic` 键随之删除。
            grid style={gridTemplateColumns: "minmax(0, 1fr) minmax(320px, 400px)", gap: "16px", alignItems: start} {
              view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "16px", flexShrink: 0} {
                view gap=sm {
                  h3 :g-content level=3
                  input type=text label=:f-title name=title required=true value="${state.post.title}"
                  input type=text label=:f-summary name=summary value="${state.post.summary}"
                  input type=textarea rows=18 label=:f-body name=body required=true value="${state.post.body}"
                }
              }
              view gap=lg {
                view gap=sm {
                  h3 :g-taxonomy level=3
                  input type=text label=:f-slug name=slug required=true value="${state.post.slug}"
                  input type=select label=:category name=category options=[technology, design, life] value="${state.post.category}"
                  input type=text label=:tags name=tags value="${state.post.tags}"
                }
                view gap=sm {
                  h3 :g-publish level=3
                  input type=text label=:f-cover name=coverImage value="${state.post.coverImage}"
                  afs-dropzone
                }
                view gap=sm {
                  input type=text label=:f-seo-title name=seoTitle value="${state.post.seoTitle}"
                  input type=text label=:f-seo-desc name=seoDescription value="${state.post.seoDescription}"
                  input type=text label=:f-og-title name=ogTitle value="${state.post.ogTitle}"
                  input type=text label=:f-og-desc name=ogDescription value="${state.post.ogDescription}"
                  input type=text label=:f-og-image name=ogImage value="${state.post.ogImage}"
                }
              }
            }
          }
          row gap=sm style={justifyContent: flex-end, flexShrink: 0} {
            action variant=secondary label=:save-draft style={borderRadius: "var(--radius-md, 8px)"} onSuccessToast={intent: success, message: "$t(compose-edit.saved)", duration: 3000} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/drafts/${args.slug}.json", content: {title: "${args.title}", slug: "${args.slug}", summary: "${args.summary}", body: "${args.body}", coverImage: "${args.coverImage}", images: [], tags: "${args.tags}", category: "${args.category}", seoTitle: "${args.seoTitle}", seoDescription: "${args.seoDescription}", ogTitle: "${args.ogTitle}", ogDescription: "${args.ogDescription}", ogImage: "${args.ogImage}", status: draft, authorDid: "${state.post.authorDid}", authorName: "${state.post.authorName}", published: false, publishedAt: "", archivedAt: "", deletedAt: "", createdAt: "${state.post.createdAt}", updatedAt: "${generate.timeiso}", version: "${state.post.version}"}}}}
            action variant=primary label=:publish-now style={borderRadius: "var(--radius-md, 8px)"} onSuccessToast={intent: success, message: "$t(compose-edit.saved)", duration: 3000} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/posts/${args.slug}.json", content: {title: "${args.title}", slug: "${args.slug}", summary: "${args.summary}", body: "${args.body}", coverImage: "${args.coverImage}", images: [], tags: "${args.tags}", category: "${args.category}", seoTitle: "${args.seoTitle}", seoDescription: "${args.seoDescription}", ogTitle: "${args.ogTitle}", ogDescription: "${args.ogDescription}", ogImage: "${args.ogImage}", status: published, authorDid: "${state.post.authorDid}", authorName: "${state.post.authorName}", published: true, publishedAt: "${generate.timeiso}", archivedAt: "", deletedAt: "", createdAt: "${state.post.createdAt}", updatedAt: "${generate.timeiso}", version: "${state.post.version}"}}}}
          }
        }
      }
    }
  }
}
