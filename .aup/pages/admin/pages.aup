page pages {
  i18n {
    act-delete { en "Delete" zh "删除" }
    act-delete-msg { en "Pages have no soft delete — this removes the record." zh "页面没有软删除——这将直接移除记录。" }
    act-delete-title { en "Delete this page?" zh "删除这个页面？" }
    adv-hide { en "Hide advanced (CLI)" zh "收起高级（CLI）" }
    adv-show { en "Show advanced (CLI)" zh "展开高级（CLI）" }
    act-offline { en "Take offline" zh "下线" }
    act-offline-msg { en "Queues ONE \"Take offline\" intent under config/page-intents/ — this page writes nothing to your records. This node's worker performs the move (it reads the page, merges it into page-drafts/, then removes the public copy): `arcblog-pages.mjs apply` once, or `watch` to keep it running. Read the intent record back — a toast is not evidence." zh "只向 config/page-intents/ 入队一条「下线」意图——本页不改动任何记录。真正的迁移由本节点 worker 执行（读取页面→合并→写入 page-drafts/→移除公开副本）：`arcblog-pages.mjs apply` 跑一次，或用 `watch` 常驻。请读回意图记录——toast 不是证据。" }
    act-offline-title { en "Take this page offline?" zh "下线这个页面？" }
    act-publish { en "Bring online" zh "上线" }
    act-publish-msg { en "Queues ONE \"Bring online\" intent under config/page-intents/ — this page writes nothing to your records. This node's worker writes the public copy and removes the offline copy; an older public copy (written by the old CLI or by root authority) is replaced too, because the worker writes with this node's own authority — the very write the platform refuses when a page asks for it." zh "只向 config/page-intents/ 入队一条「上线」意图——本页不改动任何记录。由本节点 worker 写入公开副本并移除离线副本；旧 CLI / root 授权留下的公开副本也会被替换，因为 worker 用的是本节点自己的权限——而这正是平台拒绝页面发起的那种写入。" }
    act-publish-title { en "Bring this page online?" zh "上线这个页面？" }
    act-remove-public { en "Remove public copy" zh "移除公开副本" }
    create { en "New page" zh "新建页面" }
    create-offline { en "Create (offline)" zh "创建（离线）" }
    created-ok { en "Page created offline. Bring it online when ready." zh "页面已创建（离线）。准备好后再上线。" }
    desc { en "Standalone pages such as About. Two states only — online and offline; no post lifecycle, no RSS, no Hub indexing." zh "About 等独立页面。只有上线 / 下线两个状态——不复用文章生命周期，不进 RSS，不被 Hub 索引。" }
    f-body { en "Body (Markdown)" zh "正文（Markdown）" }
    f-slug { en "Slug" zh "别名" }
    f-summary { en "Summary" zh "摘要" }
    f-title { en "Title" zh "标题" }
    gate-desc { en "Sign in with DID Wallet to manage standalone pages." zh "使用 DID Wallet 登录后管理独立页面。" }
    gate-title { en "Pages" zh "页面" }
    list-empty { en "No pages yet. Create your first page above." zh "还没有页面。在上方创建第一个页面。" }
    login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
    offline-hint { en "Offline pages are admin-only. 「Bring online」 only queues an intent under config/page-intents/; the local worker performs the move (arcblog-pages.mjs queue prints those rows read-only, apply runs them once, watch keeps running). The list below the two page lists is that queue, read straight from AFS: action · status · message." zh "离线页面仅后台可见。「上线」只向 config/page-intents/ 入队一条意图；真正的迁移由本机 worker 执行（arcblog-pages.mjs queue 只读列出这些行，apply 执行一次，watch 常驻）。两个页面列表下方那个列表就是该队列，直接读 AFS：action · status · message。" }
    offline-list { en "Offline" zh "已下线" }
    offline-ok { en "Intent queued — read config/page-intents to confirm; the local worker takes the page offline." zh "意图已入队——请读 config/page-intents 确认；由本机 worker 执行下线。" }
    online-hint { en "Online pages are public at /pages/<slug>; they stay out of RSS and the Hub index. 「Take offline」 only queues an intent under config/page-intents/ — the local worker completes the move. 「Remove public copy」 is a different, immediate action: it hard-deletes the public record (pages have no soft delete)." zh "上线页面公开于 /pages/<别名>；不进 RSS，也不被 Hub 索引。「下线」只向 config/page-intents/ 入队一条意图——真正的迁移由本机 worker 完成。「移除公开副本」是另一条立即生效的动作：硬删除公开记录（页面没有软删除）。" }
    online-list { en "Online" zh "已上线" }
    queue-legend { en "pending = queued, not run yet · applied = the worker ran it · rejected = refused, zero change · noop = already in that state" zh "pending = 已排队、尚未执行 · applied = worker 已执行 · rejected = 被拒绝、零改动 · noop = 已是该状态" }
    queue-empty-note { en "Empty state: when a list has no records this platform prints its own hard-coded English empty-list text (arc-contracts §20 measures that `emptyText` is not evaluated at runtime), so this page cannot localize it. This note is standing and does not claim that any list is empty; the authority for the queue is `node scripts/arcblog-pages.mjs queue`." zh "空态说明：列表没有记录时，平台会打印它自带的英文空列表文案（arc-contracts §20 实测 `emptyText` 在运行期不求值），因此本页无法将其本地化。本说明常驻，不代表任何列表为空；队列的权威入口是 `node scripts/arcblog-pages.mjs queue`。" }
    queue-title { en "Intent queue" zh "意图队列" }
    published-ok { en "Intent queued — read config/page-intents to confirm; the local worker brings the page online." zh "意图已入队——请读 config/page-intents 确认；由本机 worker 执行上线。" }
    removed-ok { en "Removed." zh "已移除。" }
    status-offline { en "Offline" zh "已下线" }
    status-online { en "Online" zh "已上线" }
    title { en "Pages" zh "页面" }
    view-page { en "View" zh "查看" }
  }
  // UI-018 D5 (§7.5 ①②): the intent-queue area gets a title and a status legend,
  // and the three CLI rows move into the level-3 "advanced" collapse. The legend
  // is byte-aligned with scripts/lib/intents.mjs and deliberately omits `running`:
  // arcblog-pages.mjs never writes that in-flight state (pending → applied|rejected|
  // noop), and §4.10③ forbids a page from claiming an unreachable state.
  // §4.8 / §7.5⑤: `emptyText` is not evaluated at runtime (arc-contracts §20), so the
  // platform prints its own English empty string. This standing note is status-neutral
  // (it never claims the queue is empty) and points at the CLI authority.
  view gap=lg style={height: "calc(100vh - 48px)", overflow: visible} {
    view style={gap: "0"} {
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "20px"} visible="!$session.authenticated" {
        h2 :gate-title level=2 style={fontSize: "var(--type-body)"}
        p :gate-desc intent=muted
        row cross=start {
          action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dpages&cancel_to=%2F%3Fpage%3Dpages" variant=primary label=:login style={borderRadius: "var(--radius-md, 8px)"}
        }
      }
      row gap=lg cross=stretch style={width: "100vw", marginLeft: "calc(50% - 50vw)", height: "calc(100vh - 48px)", marginBottom: "-52px", padding: "0 32px 0 0"} visible=$session.authenticated {
        view size={width: "clamp(200px, 15vw, 280px)", flexShrink: 0, height: "100%"} style={padding: "0", background: "var(--color-surface)", borderRight: "1px solid var(--color-border)", overflowY: auto, gap: "0", height: "100%"} visible=$session.authenticated {
          p "$t(wrapper.nav-group-content)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-dashboard)" -> page dashboard style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-studio)" -> page posts style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-pages)" -> page pages active=true style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-write)" -> page compose style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-site)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-heroes)" -> page heroes style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-categories)" -> page categories style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-tags)" -> page tags style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-seo)" -> page seo style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-feeds)" -> page feeds style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-appearance)" -> page appearance style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-ops)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-operations)" -> page operations style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-hub)" -> page hub style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-media)" -> page media style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-agents)" -> page agents style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-economy)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-orders)" -> page orders style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-policy)" -> page policy style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-access)" -> page access style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-ledger)" -> page ledger style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-factory)" -> page factory style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-settings)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-settings)" -> page general style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-diagnostics)" -> page diagnostics style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={marginTop: auto, background: "var(--color-bg)", borderTop: "1px solid var(--color-border)", flexShrink: 0, gap: "0"} {
            p "$t(wrapper.footer-brand)" scale=caption intent=muted style={padding: "10px 20px 2px 32px", flexShrink: 0}
            action "$t(wrapper.footer-about)" href="/?page=about" style={border: none, borderRadius: "0", padding: "4px 20px 4px 32px", justifyContent: flex-start, flexShrink: 0}
            action "$t(wrapper.footer-rss)" href="/p/rss.xml" target=_blank style={border: none, borderRadius: "0", padding: "4px 20px 4px 32px", justifyContent: flex-start, flexShrink: 0}
            p "$t(wrapper.footer-copyright)" scale=caption intent=muted style={padding: "2px 20px 10px 32px", flexShrink: 0}
          }
        }
        view gap=md size={flex: 1} style={paddingTop: "14px", paddingBottom: "14px", minHeight: 0} {
          view gap=xs {
            h2 :title level=2 style={fontSize: "var(--type-subheading)"}
            p :desc intent=muted
          }
          view gap=sm size={flex: 1} style={overflowY: auto} {
            view style={display: grid, gridTemplateColumns: "repeat(auto-fit, minmax(520px, 1fr))", gap: "14px", flexShrink: 0, alignItems: start} {
              view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px", flexShrink: 0} {
                h3 :create level=3 style={fontSize: "var(--type-body)"}
                input type=text label=:f-slug name=slug required=true state={value: ""}
                input type=text label=:f-title name=title required=true state={value: ""}
                input type=text label=:f-summary name=summary state={value: ""}
                input type=textarea label=:f-body name=body required=true state={value: ""}
                row cross=start {
                  action variant=primary label=:create-offline onSuccessToast={intent: success, message: "$t(pages-admin.created-ok)", duration: 3000} style={borderRadius: "var(--radius-md, 8px)"} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/page-drafts/${args.slug}.json", content: {slug: "${args.slug}", title: "${args.title}", summary: "${args.summary}", body: "${args.body}", status: offline, authorDid: $session.did, createdAt: "${generate.timeiso}", updatedAt: "${generate.timeiso}", version: 1}}}}
                }
              }
              view gap=sm style={flexShrink: 0} {
                h3 :online-list level=3 style={fontSize: "var(--type-body)"}
                afs-list pages-published-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false emptyText=:list-empty autoSelect=false clickMode=none pagination=manual pageSize=20 from "/instance/app/arcblog/pages" {
                  row gap=sm cross=center role=item {
                    view gap=xs style={flex: "1 1 0%"} {
                      p "${entry.content.title}" scale=lg
                      row gap=xs cross=center {
                        p "●" scale=sm intent=success
                        p :status-online scale=sm intent=muted
                        view style={fontSize: "var(--type-small)", color: "var(--color-dim)"} {
                          time mode=display value="${entry.content.updatedAt}" timeMode=relative
                        }
                      }
                      p "/pages/${entry.content.slug}" scale=sm intent=muted
                    }
                    view layout=inline href="/pages/${entry.content.slug}" target=_blank style={cursor: pointer, color: "var(--color-dim)", flexGrow: 0, flexBasis: auto} {
                      p :view-page scale=sm
                    }
                    action variant=secondary size=sm label=:act-offline confirm={title: :act-offline-title, message: :act-offline-msg} onSuccessToast={intent: success, message: "$t(pages.offline-ok)", duration: 3000} style={borderRadius: "var(--radius-md, 8px)"} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/page-intents/${generate.timeiso}.json", content: {id: "${generate.timeiso}", action: offline, slug: "${args.eSlug}", status: pending, message: "", changed: [], fromStatus: "", toStatus: "", requestedVia: console, requestedAt: "${generate.timeiso}"}}}}
                    action -> exec "/.actions/delete" variant=destructive size=sm icon=trash label=:act-remove-public path="/instance/app/arcblog/pages/${entry.content.slug}.json" confirm={title: :act-delete-title, message: :act-delete-msg} onSuccessToast={intent: success, message: "$t(pages.removed-ok)", duration: 2500} style={borderRadius: "var(--radius-md, 8px)"}
                    input type=hidden name=eSlug value="${entry.content.slug}"
                  }
                }
                p :online-hint scale=sm intent=muted
              }
              view gap=sm style={flexShrink: 0} {
                h3 :offline-list level=3 style={fontSize: "var(--type-body)"}
                afs-list pages-drafts-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false emptyText=:list-empty autoSelect=false clickMode=none pagination=manual pageSize=20 from "/instance/app/arcblog/page-drafts" {
                  row gap=sm cross=center role=item {
                    view gap=xs style={flex: "1 1 0%"} {
                      p "${entry.content.title}" scale=lg
                      row gap=xs cross=center {
                        p "●" scale=sm intent=muted
                        p :status-offline scale=sm intent=muted
                        view style={fontSize: "var(--type-small)", color: "var(--color-dim)"} {
                          time mode=display value="${entry.content.updatedAt}" timeMode=relative
                        }
                      }
                      p "${entry.content.slug}" scale=sm intent=muted
                    }
                    action variant=secondary size=sm label=:act-publish confirm={title: :act-publish-title, message: :act-publish-msg} onSuccessToast={intent: success, message: "$t(pages.published-ok)", duration: 3000} style={borderRadius: "var(--radius-md, 8px)"} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/config/page-intents/${generate.timeiso}.json", content: {id: "${generate.timeiso}", action: online, slug: "${args.eSlug}", status: pending, message: "", changed: [], fromStatus: "", toStatus: "", requestedVia: console, requestedAt: "${generate.timeiso}"}}}}
                    action -> exec "/.actions/delete" variant=destructive size=sm icon=trash label=:act-delete path="/instance/app/arcblog/page-drafts/${entry.content.slug}.json" confirm={title: :act-delete-title, message: :act-delete-msg} onSuccessToast={intent: success, message: "$t(pages.removed-ok)", duration: 2500} style={borderRadius: "var(--radius-md, 8px)"}
                    input type=hidden name=eSlug value="${entry.content.slug}"
                  }
                }
                p :offline-hint scale=sm intent=muted
              }
            }
            // 待执行意图队列（REQ-019 第四批）：两个页面列表下方的这个列表就是本页按钮写入的队列，
            // 直接读 AFS（config/page-intents，admin-only），逐行显示 action · slug · status · message。
            // 稳定 id 是 URL 契约（`pages-intent-list.page=<n>`，arc-contracts §38）。
            // UI-018 D5（§7.5 ①②④）：标题 + 状态图例（不含 `running`，见 i18n 注释），
            // CLI 三行折进「高级」——折叠本身是页内 `-> set`，零 AFS 写入。
            view pages-advanced gap=sm {
              h3 :queue-title level=3 style={fontSize: "var(--type-body)"}
              p :queue-legend scale=caption intent=muted
              p :queue-empty-note scale=caption intent=muted
              afs-list pages-intent-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false emptyText=:list-empty autoSelect=false clickMode=none pagination=manual pageSize=10 from "/instance/app/arcblog/config/page-intents" {
                row gap=sm cross=start role=item {
                  view gap=xs {
                    p "${entry.content.slug} · ${entry.content.action} · ${entry.content.status}" scale=lg
                    p "${entry.content.message}" scale=sm intent=muted
                  }
                }
              }
              row cross=start {
                action -> set pages-advanced state {open: "true"} variant=secondary size=sm label=:adv-show style={borderRadius: "var(--radius-md, 8px)"}
              }
              view gap=sm visible=$state.open {
                key-value-list pages-intent-cmds dense=true fields=[{label: queue, value: "node scripts/arcblog-pages.mjs queue", monospace: true, copyable: true}, {label: apply, value: "node scripts/arcblog-pages.mjs apply", monospace: true, copyable: true}, {label: watch, value: "node scripts/arcblog-pages.mjs watch", monospace: true, copyable: true}]
                row cross=start {
                  action -> set pages-advanced state {open: ""} variant=secondary size=sm label=:adv-hide style={borderRadius: "var(--radius-md, 8px)"}
                }
              }
            }
          }
        }
      }
    }
  }
}
