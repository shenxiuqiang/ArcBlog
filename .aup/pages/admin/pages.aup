page pages {
  i18n {
    act-delete { en "Delete" zh "删除" }
    act-delete-msg { en "Pages have no soft delete — this removes the record." zh "页面没有软删除——这将直接移除记录。" }
    act-delete-title { en "Delete this page?" zh "删除这个页面？" }
    act-offline { en "Take offline" zh "下线" }
    act-offline-msg { en "Takes this page off the public site. The content is kept, so you can edit it and bring it back online at any time." zh "把页面从公开站点撤下。内容完整保留，随时可以修改后再上线。" }
    act-offline-title { en "Take this page offline?" zh "下线这个页面？" }
    act-publish { en "Bring online" zh "上线" }
    act-publish-msg { en "Publishes the current content to the public site at /pages/<slug>." zh "把当前内容发布到公开站点（/pages/<别名>）。" }
    act-publish-title { en "Bring this page online?" zh "上线这个页面？" }
    create-offline { en "Create (offline)" zh "创建（离线）" }
    create-title { en "New page" zh "新建页面" }
    created-ok { en "Page created offline. Bring it online when ready." zh "页面已创建（离线）。准备好后再上线。" }
    desc { en "Create and edit standalone pages; bring them online when ready. Pages are excluded from RSS." zh "创建和编辑独立页面，准备好后上线；页面不进入 RSS。" }
    edit-hint { en "An online page saves straight to the public copy. An offline page can be saved, published (public copy, offline copy removed) or deleted." zh "上线页面「保存」直接写公开副本；离线页面可「保存」到离线区、可「上线」（写公开副本并移除离线副本）、也可删除。" }
    edit-title { en "Edit page" zh "编辑页面" }
    f-body { en "Body (Markdown)" zh "正文（Markdown）" }
    f-slug { en "Slug" zh "别名" }
    f-summary { en "Summary" zh "摘要" }
    f-title { en "Title" zh "标题" }
    gate-desc { en "Sign in with DID Wallet to manage standalone pages." zh "使用 DID Wallet 登录后管理独立页面。" }
    gate-title { en "Pages" zh "页面" }
    login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
    offline-ok { en "Taken offline." zh "已下线。" }
    list-hint { en "Choose a page to edit, or create a new one using the form." zh "选择页面进行编辑，或使用表单新建页面。" }
    status-offline { en "Offline" zh "已下线" }
    status-online { en "Online" zh "已上线" }
    published-ok { en "Brought online." zh "已上线。" }
    removed-ok { en "Removed." zh "已删除。" }
    runtime-note { en "The editor loads the record after the first render — if the form is still empty, reload once." zh "编辑器在首次渲染之后才载入记录——若表单仍为空，刷新一次即可。" }
    save { en "Save" zh "保存" }
    saved-ok { en "Saved." zh "已保存。" }
    title { en "Pages" zh "页面" }
  }
  // ?page=pages — a master/detail console: the list on the left, the create/edit form on
  // the right. Two measured platform constraints shape it, and both are why the old
  // "intent queue" is gone (human ruling 2026-10-19):
  //   1. A page CANNOT rewrite an EXISTING record it did not write (arc-contracts §29.2),
  //      but it CAN write a path that does not exist yet — exactly what a state move does.
  //      So each row's switch writes the destination copy and only then deletes the source
  //      (`afterSuccess` chain, §29.3), instead of queueing an intent for a CLI worker.
  //   2. The edit form needs the record BEFORE it renders; that channel is `propBind` +
  //      a route that carries `{slug}` (§57). Its state lands after the first render, so
  //      the form prints a standing "reload once" note instead of pretending to be empty
  //      (the same shape `?page=compose-edit` uses).
  // The online/offline lists stay TWO `afs-list`s on purpose: truth lives in the directory
  // boundary (pages/ vs page-drafts/), never in a status field the page cannot branch on.
  view gap=lg style={height: "calc(100vh - 48px)", overflow: visible} {
    view style={gap: "0"} {
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "20px"} visible="!$session.authenticated" {
        h2 :gate-title level=2 style={fontSize: "var(--type-body)"}
        p :gate-desc intent=muted
        row cross=start {
          action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dpages&cancel_to=%2F%3Fpage%3Dpages" variant=primary label=:login style={borderRadius: "var(--radius-md, 8px)"}
        }
      }
      row gap=lg cross=stretch style={width: "100vw", marginLeft: "calc(50% - 50vw)", height: "calc(100vh - 48px)", marginBottom: "-52px", padding: "0 32px 0 0"} visible=$session.authenticated {
        view size={width: "clamp(200px, 15vw, 280px)", flexShrink: 0, height: "100%"} style={padding: "0", background: "var(--color-surface)", borderRight: "1px solid var(--color-border)", overflowY: auto, gap: "0", height: "100%"} visible=$session.authenticated {
          p "$t(wrapper.nav-group-content)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-dashboard)" -> page dashboard style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-studio)" -> page posts style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-pages)" -> page pages active=true style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-write)" -> page compose style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-site)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-heroes)" -> page heroes style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-categories)" -> page categories style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-tags)" -> page tags style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-feeds)" -> page feeds style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-ops)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-operations)" -> page operations style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-registry)" -> page registry style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-factory)" -> page factory style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-agents)" -> page agents style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          p "$t(wrapper.nav-group-settings)" intent=muted scale=caption style={padding: "10px 20px 4px", background: "var(--color-bg)", flexShrink: 0}
          action "$t(wrapper.nav-settings)" -> page general style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view style={height: "1px", background: "var(--color-border)", flexShrink: 0} {
            p " "
          }
          action "$t(wrapper.nav-diagnostics)" -> page diagnostics style={border: none, borderRadius: "0", padding: "8px 20px 8px 32px", justifyContent: flex-start, flexShrink: 0}
          view gap=xs style={padding: "10px 20px 10px 32px", background: "var(--color-bg)", borderTop: "1px solid var(--color-border)", flexShrink: 0} visible="!$session.isAdmin" {
            p "$t(wrapper.admin-notice)" scale=caption intent=muted
          }
        }
        view gap=md size={flex: 1} style={paddingTop: "14px", paddingBottom: "14px", minHeight: 0} {
          view gap=xs style={padding: "4px 0 16px", borderBottom: "1px solid var(--color-border)", flexShrink: 0} {
            h2 :title level=2
            p :desc intent=muted
          }
          // Left = the two state lists (truth by directory), right = the form (wider).
          // One content scroller holds the list and editor. The shared bridge stacks the
          // desktop columns on narrow screens. The sidebar above is generated.
          view gap=lg size={flex: 1} style={overflowY: auto, minHeight: 0} {
            grid style={gridTemplateColumns: "minmax(240px, 300px) minmax(0, 1fr)", gap: "24px", alignItems: start, flexShrink: 0} {
              view gap=sm style={borderTop: "1px solid var(--color-border)", paddingTop: "18px", flexShrink: 0} {
                // ONE list, two states (human 2026-10-19): the rows of both directories share
                // one card and one row layout — only the status text (and the one switch
                // label) differs. Truth still lives in the directory boundary, never in a
                // status field the page cannot branch on.
                afs-list pages-published-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false emptyText=" " autoSelect=false clickMode=none pagination=manual pageSize=20 from "/instance/app/arcblog/pages" {
                  row gap=sm cross=center role=item {
                    row gap=sm cross=center size={width: fill} {
                      // The move carries the record over verbatim: the platform cannot read a
                      // record inside an `exec` payload (§29.1), so every field rides along in
                      // a hidden input, exactly like `posts.aup`'s publish/archive copies.
                      view gap=xs size={flex: "1 1 0%"} {
                        view href="/pages-edit/pages/${entry.content.slug}?online=1" style={cursor: pointer, color: "var(--color-text)", flexGrow: 0, flexBasis: auto} {
                          view {
                            p "${entry.content.title}" scale=lg
                          }
                        }
                        row gap=xs cross=center {
                          p :status-online scale=sm intent=success
                          p "/pages/${entry.content.slug}" scale=sm intent=muted
                        }
                      }
                      row gap=sm cross=center size={width: hug} {
                        input type=hidden name=eSlug value="${entry.content.slug}"
                        input type=hidden name=eTitle value="${entry.content.title}"
                        input type=hidden name=eSummary value="${entry.content.summary}"
                        input type=hidden name=eBody value="${entry.content.body}"
                        input type=hidden name=eAuthorDid value="${entry.content.authorDid}"
                        input type=hidden name=eCreatedAt value="${entry.content.createdAt}"
                        action variant=secondary size=sm label=:act-offline confirm={title: :act-offline-title, message: :act-offline-msg} onSuccessToast={intent: success, message: "$t(pages.offline-ok)", duration: 3000} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/page-drafts/${args.eSlug}.json", content: {slug: "${args.eSlug}", title: "${args.eTitle}", summary: "${args.eSummary}", body: "${args.eBody}", status: offline, authorDid: "${args.eAuthorDid}", createdAt: "${args.eCreatedAt}", updatedAt: "${generate.timeiso}"}}, afterSuccess: [{exec: "/.actions/delete", args: {path: "/instance/app/arcblog/pages/${args.eSlug}.json"}}]}}
                      }
                    }
                  }
                }
                afs-list pages-drafts-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false emptyText=" " autoSelect=false clickMode=none pagination=manual pageSize=20 from "/instance/app/arcblog/page-drafts" {
                  row gap=sm cross=center role=item {
                    row gap=sm cross=center size={width: fill} {
                      view gap=xs size={flex: "1 1 0%"} {
                        view href="/pages-edit/page-drafts/${entry.content.slug}?draft=1" style={cursor: pointer, color: "var(--color-text)", flexGrow: 0, flexBasis: auto} {
                          view {
                            p "${entry.content.title}" scale=lg
                          }
                        }
                        row gap=xs cross=center {
                          p :status-offline scale=sm intent=muted
                          p "${entry.content.slug}" scale=sm intent=muted
                        }
                      }
                      row gap=sm cross=center size={width: hug} {
                        input type=hidden name=eSlug value="${entry.content.slug}"
                        input type=hidden name=eTitle value="${entry.content.title}"
                        input type=hidden name=eSummary value="${entry.content.summary}"
                        input type=hidden name=eBody value="${entry.content.body}"
                        input type=hidden name=eAuthorDid value="${entry.content.authorDid}"
                        input type=hidden name=eCreatedAt value="${entry.content.createdAt}"
                        action variant=secondary size=sm label=:act-publish confirm={title: :act-publish-title, message: :act-publish-msg} onSuccessToast={intent: success, message: "$t(pages.published-ok)", duration: 3000} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/pages/${args.eSlug}.json", content: {slug: "${args.eSlug}", title: "${args.eTitle}", summary: "${args.eSummary}", body: "${args.eBody}", status: online, authorDid: "${args.eAuthorDid}", createdAt: "${args.eCreatedAt}", updatedAt: "${generate.timeiso}"}}, afterSuccess: [{exec: "/.actions/delete", args: {path: "/instance/app/arcblog/page-drafts/${args.eSlug}.json"}}]}}
                      }
                    }
                  }
                }
                p :list-hint scale=caption intent=muted
              }
              // Right = the form. `propBind` rides the `/pages-edit/{dir}/{slug}` route and binds
              // into THIS node's subtree (measured 2026-10-19, arc-contracts §84: a warm
              // session gets the record at first paint, a cold one needs one reload).
              view gap=sm style={borderTop: "1px solid var(--color-border)", paddingTop: "18px", flexShrink: 0} propBind={page: "/instance/app/arcblog/$params.dir/$params.slug.json"} {
                // Header + actions share one row: the buttons must stay reachable while the
                // body textarea grows (it is `field-sizing: content`, capped at 28rem), so they
                // sit on top and the body fills whatever is left to the bottom.
                row gap=sm cross=center style={justifyContent: space-between, flexShrink: 0} {
                  view gap=xs visible="!$state.slug" {
                    h3 :create-title level=3
                  }
                  view gap=xs visible=$state.slug {
                    h3 :edit-title level=3
                    p "/pages/${state.page.slug}" scale=sm intent=muted
                    p :runtime-note scale=caption intent=muted
                    p :edit-hint scale=caption intent=muted
                  }
                  // Mode is the URL, never bound data: `$state.slug` says "editing", and the
                  // row's own marker (`?online=1` / `?draft=1`) says which directory the record
                  // came from. `$state.page` is NOT usable as a gate — an unresolved `propBind`
                  // still leaves it truthy (measured 2026-10-19). `required` on title/body is
                  // the second line of defence, and every write path below is a FIXED literal.
                  row gap=sm cross=start size={width: hug} visible="!$state.slug" {
                    action variant=primary label=:create-offline onSuccessToast={intent: success, message: "$t(pages.created-ok)", duration: 3000} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/page-drafts/${args.slug}.json", content: {slug: "${args.slug}", title: "${args.title}", summary: "${args.summary}", body: "${args.body}", status: offline, authorDid: $session.did, createdAt: "${generate.timeiso}", updatedAt: "${generate.timeiso}"}}}}
                  }
                  row gap=sm cross=start size={width: hug} visible=$state.online {
                    action variant=secondary label=:save onSuccessToast={intent: success, message: "$t(pages.saved-ok)", duration: 3000} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/pages/${args.eSlug}.json", content: {slug: "${args.eSlug}", title: "${args.title}", summary: "${args.summary}", body: "${args.body}", status: online, authorDid: "${state.page.authorDid}", createdAt: "${state.page.createdAt}", updatedAt: "${generate.timeiso}"}}}}
                  }
                  row gap=sm cross=start size={width: hug} visible=$state.draft {
                    action variant=primary label=:act-publish confirm={title: :act-publish-title, message: :act-publish-msg} onSuccessToast={intent: success, message: "$t(pages.published-ok)", duration: 3000} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/pages/${args.eSlug}.json", content: {slug: "${args.eSlug}", title: "${args.title}", summary: "${args.summary}", body: "${args.body}", status: online, authorDid: "${state.page.authorDid}", createdAt: "${state.page.createdAt}", updatedAt: "${generate.timeiso}"}}, afterSuccess: [{exec: "/.actions/delete", args: {path: "/instance/app/arcblog/page-drafts/${args.eSlug}.json"}}]}}
                    action variant=secondary label=:save onSuccessToast={intent: success, message: "$t(pages.saved-ok)", duration: 3000} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/page-drafts/${args.eSlug}.json", content: {slug: "${args.eSlug}", title: "${args.title}", summary: "${args.summary}", body: "${args.body}", status: offline, authorDid: "${state.page.authorDid}", createdAt: "${state.page.createdAt}", updatedAt: "${generate.timeiso}"}}}}
                    action variant=destructive size=sm icon=trash label=:act-delete confirm={title: :act-delete-title, message: :act-delete-msg} onSuccessToast={intent: success, message: "$t(pages.removed-ok)", duration: 2500} events={click: {exec: "/.actions/delete", args: {path: "/instance/app/arcblog/page-drafts/${args.eSlug}.json"}}}
                  }
                }
                view gap=xs visible="!$state.slug" {
                  input type=text label=:f-slug name=slug required=true
                }
                input type=hidden name=eSlug value="${state.page.slug}"
                input type=text label=:f-title name=title required=true value="${state.page.title}"
                input type=text label=:f-summary name=summary value="${state.page.summary}"
                input type=textarea rows=15 label=:f-body name=body required=true value="${state.page.body}"
              }
            }
          }
        }
      }
    }
  }
}
