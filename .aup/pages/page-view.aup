page page-view {
  i18n {
    title { en "Page" zh "页面" }
    runtime-note { en "The page below is read from the record bound to this address, so it is here on the first load — no reload needed. If the body area is empty, the record does not exist (or this session may not read it)." zh "下方正文读取的是本地址绑定的记录，首次打开即已取到，无需刷新。若正文区为空，说明该记录不存在（或本次会话无权读取）。" }
    back { en "Back to latest stories" zh "返回最新文章" }
  }
  view gap=lg {
    row gap=sm {
      view href="/posts" style={cursor: pointer, color: "var(--color-dim)", padding: "3px 0"} {
        p :back scale=sm
      }
    }
    // DEF-21 / B14 — same channel as reader.aup: `surface url="$state.loc"` reads
    // the record bound to `/pages/<slug>` on the first paint (the runtime derives
    // `$state.loc` from `__AUP_BOOT__.bindings`), while `propBind` only lands in
    // the session state after the first render. `url` is the interpolated prop;
    // a node-level `src` would keep the literal `$state.loc`. The markup comes
    // from the item recipe `pages/.aup/item.json` (`scripts/arcblog-recipes.mjs`).
    surface url=$state.loc editable=false {
      p :runtime-note intent=muted scale=sm
    }
    app-footer brand={title: ArcBlog, tagline: "$t(wrapper.tagline)", href: "/?page=index"} columns=[{links: [{label: "$t(wrapper.nav-about)", href: "/?page=about"}, {label: "$t(wrapper.nav-author)", href: "/?page=author"}, {label: RSS, href: "/p/rss.xml", external: true}]}]
  }
}
