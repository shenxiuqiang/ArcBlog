page page-view {
  i18n {
    title { en "Page" zh "页面" }
    runtime-note { en "This page binds its record after the first load. If the content is empty, reload once." zh "本页在首次加载之后才绑定记录。若内容为空，刷新一次即可。" }
    back { en "Back to latest stories" zh "返回最新文章" }
  }
  view gap=lg {
    view gap=lg propBind={page: "/instance/app/arcblog/pages/$params.slug.json"} {
      row gap=sm {
        view href="/posts" style={cursor: pointer, color: "var(--color-dim)", padding: "3px 0"} {
          p :back scale=sm
        }
      }
      // DEF-15/DEF-18: the old card used `visible="!$state.page"`, evaluated once
      // before `propBind` resolved and then frozen — it reported a missing page for a
      // record that exists (arc-contracts §28.1). The body is unconditional and this
      // line states the platform behaviour instead of claiming anything is missing.
      view gap=xs {
        h2 :title level=2 scale=sm intent=muted
        p :runtime-note intent=muted scale=sm
      }
      view gap=md {
        h1 "${state.page.title}" scale=display
        p "${state.page.body}" format=markdown
      }
    }
    app-footer brand={title: ArcBlog, tagline: "$t(wrapper.tagline)", href: "/?page=index"} columns=[{links: [{label: "$t(wrapper.nav-about)", href: "/?page=about"}, {label: "$t(wrapper.nav-author)", href: "/?page=author"}, {label: RSS, href: "/p/rss.xml", external: true}]}] bottomBar={copyright: "$t(wrapper.footer-copyright)"}
  }
}
