{
  "id": "arcblog-settings-view-1",
  "type": "view",
  "props": {
    "layout": {
      "gap": "lg"
    }
  },
  "children": [
    {
      "id": "arcblog-settings-view-1-h1-1",
      "type": "text",
      "props": {
        "level": 1,
        "content": "$t(settings.title)"
      }
    },
    {
      "id": "arcblog-settings-view-1-p-2",
      "type": "text",
      "props": {
        "content": "$t(settings.desc)",
        "intent": "muted"
      }
    },
    {
      "id": "appearance-settings",
      "type": "auto-surface",
      "props": {
        "title": "Appearance"
      },
      "src": "/instance/settings/arcblog"
    }
  ]
}
