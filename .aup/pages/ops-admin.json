{
  "id": "arcblog-ops-admin",
  "type": "view",
  "props": {
    "layout": {
      "gap": "lg"
    },
    "size": {
      "maxWidth": "lg"
    }
  },
  "children": [
    {
      "id": "arcblog-ops-admin-card-1",
      "type": "view",
      "props": {
        "mode": "card",
        "layout": {
          "gap": "md"
        }
      },
      "visible": "!$session.authenticated",
      "children": [
        {
          "id": "arcblog-ops-admin-card-1-h2-1",
          "type": "text",
          "props": {
            "level": 2,
            "content": "$t(ops-admin.gate-title)"
          }
        },
        {
          "id": "arcblog-ops-admin-card-1-p-2",
          "type": "text",
          "props": {
            "content": "$t(ops-admin.gate-desc)",
            "intent": "info"
          }
        },
        {
          "id": "arcblog-ops-admin-card-1-action-3",
          "type": "action",
          "props": {
            "variant": "primary",
            "label": "$t(ops-admin.login)"
          },
          "events": {
            "click": {
              "navigate": "/.well-known/service/login?return_to=%2F%3Fpage%3Dops-admin&cancel_to=%2F%3Fpage%3Dops-admin"
            }
          }
        }
      ]
    },
    {
      "id": "console-shell",
      "type": "view",
      "props": {
        "layout": {
          "direction": "row",
          "gap": "lg",
          "crossAlign": "start"
        }
      },
      "children": [
        {
          "id": "console-nav",
          "type": "view",
          "props": {
            "layout": {
              "gap": "xs"
            },
            "size": {
              "width": "200px",
              "flexShrink": 0
            },
            "style": {
              "padding": "14px",
              "border": "1px solid var(--color-border)",
              "borderRadius": "var(--radius-lg, 12px)",
              "background": "var(--color-surface)"
            }
          },
          "visible": "$session.authenticated",
          "children": [
            {
              "id": "console-nav-p-1",
              "type": "text",
              "props": {
                "content": "$t(wrapper.nav-group-content)",
                "intent": "muted",
                "scale": "caption"
              }
            },
            {
              "id": "console-nav-dashboard",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-dashboard)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "dashboard"
                  }
                }
              }
            },
            {
              "id": "console-nav-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-studio)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "admin"
                  }
                }
              }
            },
            {
              "id": "console-nav-heroes-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-heroes)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "heroes-admin"
                  }
                }
              }
            },
            {
              "id": "console-nav-p-5",
              "type": "text",
              "props": {
                "content": "$t(wrapper.nav-group-ops)",
                "intent": "muted",
                "scale": "caption"
              }
            },
            {
              "id": "console-nav-operations",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-operations)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "operations"
                  }
                }
              }
            },
            {
              "id": "console-nav-ops-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-media-agents)",
                "variant": "primary"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "ops-admin"
                  }
                }
              }
            },
            {
              "id": "console-nav-p-8",
              "type": "text",
              "props": {
                "content": "$t(wrapper.nav-group-economy)",
                "intent": "muted",
                "scale": "caption"
              }
            },
            {
              "id": "console-nav-economy-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-policy-grants)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "economy-admin"
                  }
                }
              }
            }
          ]
        },
        {
          "id": "console-pane",
          "type": "view",
          "props": {
            "layout": {
              "gap": "lg"
            },
            "size": {
              "flex": 1
            }
          },
          "children": [
            {
              "id": "console-pane-view-1",
              "type": "view",
              "props": {
                "layout": {
                  "gap": "lg"
                }
              },
              "visible": "$session.authenticated",
              "children": [
                {
                  "id": "console-pane-view-1-card-1",
                  "type": "view",
                  "props": {
                    "mode": "card",
                    "layout": {
                      "gap": "md"
                    }
                  },
                  "children": [
                    {
                      "id": "console-pane-view-1-card-1-h1-1",
                      "type": "text",
                      "props": {
                        "level": 1,
                        "content": "$t(ops-admin.title)"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-1-p-2",
                      "type": "text",
                      "props": {
                        "content": "$t(ops-admin.desc)",
                        "intent": "muted"
                      }
                    }
                  ]
                },
                {
                  "id": "console-pane-view-1-card-2",
                  "type": "view",
                  "props": {
                    "mode": "card",
                    "layout": {
                      "gap": "md"
                    }
                  },
                  "children": [
                    {
                      "id": "console-pane-view-1-card-2-h2-1",
                      "type": "text",
                      "props": {
                        "level": 2,
                        "content": "$t(ops-admin.media)"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-2-p-2",
                      "type": "text",
                      "props": {
                        "content": "$t(ops-admin.admin-only)",
                        "scale": "sm",
                        "intent": "muted"
                      },
                      "visible": "!$session.authenticated"
                    },
                    {
                      "id": "ops-media-gate",
                      "type": "view",
                      "visible": "$session.authenticated",
                      "children": [
                        {
                          "id": "ops-media",
                          "type": "afs-list",
                          "props": {
                            "layout": "list",
                            "itemStyle": "row",
                            "subscribe": true,
                            "showBreadcrumb": false,
                            "showParent": false,
                            "clickMode": "none",
                            "emptyText": "$t(ops-admin.media-empty)"
                          },
                          "src": "/instance/app/arcblog/media",
                          "children": [
                            {
                              "id": "opsMediaRow",
                              "type": "view",
                              "props": {
                                "layout": {
                                  "direction": "row",
                                  "gap": "xs"
                                },
                                "role": "item"
                              },
                              "children": [
                                {
                                  "id": "opsmediarow-h3-1",
                                  "type": "text",
                                  "props": {
                                    "level": 3,
                                    "content": "${entry.content.id}"
                                  }
                                },
                                {
                                  "id": "opsmediarow-p-2",
                                  "type": "text",
                                  "props": {
                                    "content": "${entry.content.mimeType}",
                                    "scale": "sm",
                                    "intent": "muted"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "console-pane-view-1-card-2-p-4",
                      "type": "text",
                      "props": {
                        "content": "$t(ops-admin.media-empty)",
                        "scale": "sm",
                        "intent": "muted"
                      }
                    }
                  ]
                },
                {
                  "id": "console-pane-view-1-card-3",
                  "type": "view",
                  "props": {
                    "mode": "card",
                    "layout": {
                      "gap": "md"
                    }
                  },
                  "children": [
                    {
                      "id": "console-pane-view-1-card-3-h2-1",
                      "type": "text",
                      "props": {
                        "level": 2,
                        "content": "$t(ops-admin.agent-grants)"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-3-p-2",
                      "type": "text",
                      "props": {
                        "content": "$t(ops-admin.admin-only)",
                        "scale": "sm",
                        "intent": "muted"
                      },
                      "visible": "!$session.authenticated"
                    },
                    {
                      "id": "ops-agent-gate",
                      "type": "view",
                      "visible": "$session.authenticated",
                      "children": [
                        {
                          "id": "ops-agent",
                          "type": "afs-list",
                          "props": {
                            "layout": "list",
                            "itemStyle": "row",
                            "subscribe": true,
                            "showBreadcrumb": false,
                            "showParent": false,
                            "clickMode": "none",
                            "emptyText": "$t(ops-admin.agent-grants-empty)"
                          },
                          "src": "/instance/app/arcblog/config/agent-grants",
                          "children": [
                            {
                              "id": "opsAgentRow",
                              "type": "view",
                              "props": {
                                "layout": {
                                  "direction": "row",
                                  "gap": "xs"
                                },
                                "role": "item"
                              },
                              "children": [
                                {
                                  "id": "opsagentrow-h3-1",
                                  "type": "text",
                                  "props": {
                                    "level": 3,
                                    "content": "${entry.content.agentDid}"
                                  }
                                },
                                {
                                  "id": "opsagentrow-p-2",
                                  "type": "text",
                                  "props": {
                                    "content": "${entry.content.capabilities}",
                                    "scale": "sm"
                                  }
                                },
                                {
                                  "id": "opsagentrow-p-3",
                                  "type": "text",
                                  "props": {
                                    "content": "$t(ops-admin.agent-expires)",
                                    "scale": "sm",
                                    "intent": "muted"
                                  }
                                },
                                {
                                  "id": "opsagentrow-p-4",
                                  "type": "text",
                                  "props": {
                                    "content": "${entry.content.expiresAt}",
                                    "scale": "sm"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "id": "console-pane-view-1-card-3-p-4",
                      "type": "text",
                      "props": {
                        "content": "$t(ops-admin.agent-grants-empty)",
                        "scale": "sm",
                        "intent": "muted"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-3-p-5",
                      "type": "text",
                      "props": {
                        "content": "$t(ops-admin.agent-closed)",
                        "scale": "sm",
                        "intent": "muted"
                      }
                    },
                    {
                      "id": "console-pane-view-1-card-3-p-6",
                      "type": "text",
                      "props": {
                        "content": "$t(ops-admin.mutations)",
                        "scale": "sm",
                        "intent": "muted"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
