{
  "id": "arcblog-posts-view-1",
  "type": "view",
  "props": {
    "layout": {
      "gap": "lg"
    }
  },
  "children": [
    {
      "id": "hero-carousel-frame",
      "type": "frame",
      "props": {
        "src": "/p/en/hero-carousel/",
        "loading": "eager",
        "aspectRatio": "16 / 7",
        "title": "Hero carousel"
      }
    },
    {
      "id": "arcblog-posts-view-1-h2-2",
      "type": "text",
      "props": {
        "level": 2,
        "content": "$t(posts.feed)"
      }
    },
    {
      "id": "published-feed",
      "type": "afs-list",
      "props": {
        "layout": "list",
        "itemStyle": "row",
        "subscribe": true,
        "showBreadcrumb": false,
        "showParent": false,
        "emptyText": "$t(posts.feed-empty)",
        "clickMode": "none",
        "filter": {
          "field": "content.status",
          "match": "published"
        },
        "serverFilters": [
          {
            "key": "category",
            "control": "chips",
            "urlParam": "category",
            "options": [
              {
                "value": "",
                "label": "$t(posts.tf-all)"
              },
              {
                "value": "technology",
                "label": "$t(posts.tf-tech)"
              },
              {
                "value": "design",
                "label": "$t(posts.tf-design)"
              },
              {
                "value": "life",
                "label": "$t(posts.tf-life)"
              }
            ],
            "push": {
              "field": "category",
              "op": "eq"
            }
          }
        ]
      },
      "src": "/instance/app/arcblog/posts",
      "children": [
        {
          "id": "postRow",
          "type": "view",
          "props": {
            "layout": {
              "direction": "row",
              "crossAlign": "center",
              "gap": "md"
            },
            "role": "item",
            "style": {
              "padding": "var(--space-block, 24px)",
              "border": "1px solid var(--color-border)",
              "borderRadius": "var(--radius-lg, 12px)",
              "marginBottom": "var(--space-block, 24px)"
            }
          },
          "children": [
            {
              "id": "postLink",
              "type": "view",
              "props": {
                "layout": {
                  "gap": "xs"
                },
                "href": "/posts/${entry.content.slug}",
                "size": {
                  "flex": 1
                },
                "style": {
                  "display": "block",
                  "textDecoration": "none",
                  "color": "inherit",
                  "cursor": "pointer",
                  "minWidth": 0
                }
              },
              "children": [
                {
                  "id": "postlink-h3-1",
                  "type": "text",
                  "props": {
                    "level": 3,
                    "content": "${entry.content.title}"
                  }
                },
                {
                  "id": "postlink-p-2",
                  "type": "text",
                  "props": {
                    "content": "${entry.content.summary}",
                    "intent": "muted"
                  }
                },
                {
                  "id": "postlink-row-3",
                  "type": "view",
                  "props": {
                    "layout": {
                      "direction": "row",
                      "gap": "xs",
                      "crossAlign": "center"
                    }
                  },
                  "children": [
                    {
                      "id": "postlink-row-3-p-1",
                      "type": "text",
                      "props": {
                        "content": "${entry.content.category}",
                        "scale": "sm",
                        "intent": "muted",
                        "style": {
                          "textTransform": "capitalize"
                        }
                      }
                    },
                    {
                      "id": "postlink-row-3-view-2",
                      "type": "view",
                      "props": {
                        "style": {
                          "fontSize": "var(--type-small)",
                          "color": "var(--color-dim)"
                        }
                      },
                      "children": [
                        {
                          "id": "postlink-row-3-view-2-time-1",
                          "type": "time",
                          "props": {
                            "mode": "display",
                            "value": "${entry.content.publishedAt}",
                            "timeMode": "relative"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "postCover",
              "type": "view",
              "props": {
                "href": "/posts/${entry.content.slug}",
                "style": {
                  "display": "block",
                  "width": "168px",
                  "height": "112px",
                  "flexShrink": 0,
                  "borderRadius": "var(--radius-lg, 12px)",
                  "background": "url(${entry.content.coverImage}) center / cover no-repeat, linear-gradient(135deg, var(--color-border), var(--color-dim))"
                }
              },
              "children": [
                {
                  "id": "postcover-text-1",
                  "type": "text",
                  "props": {
                    "content": " "
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
