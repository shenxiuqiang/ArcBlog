{
  "id": "arcblog-posts-view-1",
  "type": "view",
  "props": {
    "layout": {
      "gap": "lg"
    }
  },
  "children": [
    {
      "id": "arcblog-posts-view-1-card-1",
      "type": "view",
      "props": {
        "mode": "card",
        "layout": {
          "gap": "md"
        }
      },
      "children": [
        {
          "id": "arcblog-posts-view-1-card-1-h1-1",
          "type": "text",
          "props": {
            "level": 1,
            "content": "$t(posts.hero-title)",
            "scale": "display"
          }
        },
        {
          "id": "arcblog-posts-view-1-card-1-p-2",
          "type": "text",
          "props": {
            "content": "$t(posts.hero-desc)",
            "intent": "info"
          }
        },
        {
          "id": "arcblog-posts-view-1-card-1-row-3",
          "type": "view",
          "props": {
            "layout": {
              "direction": "row",
              "gap": "sm"
            }
          },
          "children": [
            {
              "id": "arcblog-posts-view-1-card-1-row-3-action-1",
              "type": "action",
              "props": {
                "variant": "primary",
                "label": "$t(posts.hero-cta)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "compose"
                  }
                }
              }
            },
            {
              "id": "arcblog-posts-view-1-card-1-row-3-action-2",
              "type": "action",
              "props": {
                "variant": "ghost",
                "label": "$t(posts.rss)"
              },
              "events": {
                "click": {
                  "navigate": "/rss.xml"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "arcblog-posts-view-1-card-2",
      "type": "view",
      "props": {
        "mode": "card",
        "layout": {
          "gap": "md"
        }
      },
      "children": [
        {
          "id": "arcblog-posts-view-1-card-2-h3-1",
          "type": "text",
          "props": {
            "level": 3,
            "content": "$t(posts.topics)"
          }
        },
        {
          "id": "arcblog-posts-view-1-card-2-row-2",
          "type": "view",
          "props": {
            "layout": {
              "direction": "row",
              "gap": "sm"
            }
          },
          "children": [
            {
              "id": "arcblog-posts-view-1-card-2-row-2-action-1",
              "type": "action",
              "props": {
                "variant": "secondary",
                "size": "sm",
                "label": "$t(posts.tech)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "posts"
                  }
                }
              }
            },
            {
              "id": "arcblog-posts-view-1-card-2-row-2-action-2",
              "type": "action",
              "props": {
                "variant": "secondary",
                "size": "sm",
                "label": "$t(posts.design)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "posts"
                  }
                }
              }
            },
            {
              "id": "arcblog-posts-view-1-card-2-row-2-action-3",
              "type": "action",
              "props": {
                "variant": "secondary",
                "size": "sm",
                "label": "$t(posts.life)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "posts"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "arcblog-posts-view-1-h2-3",
      "type": "text",
      "props": {
        "level": 2,
        "content": "$t(posts.feed)"
      }
    },
    {
      "id": "published-feed",
      "type": "afs-list",
      "props": {
        "layout": "list",
        "itemStyle": "row",
        "subscribe": true,
        "showBreadcrumb": false,
        "showParent": false,
        "emptyText": "$t(posts.feed-empty)",
        "clickMode": "none",
        "filter": {
          "field": "content.status",
          "match": "published"
        }
      },
      "src": "/instance/app/arcblog/posts",
      "children": [
        {
          "id": "postRow",
          "type": "view",
          "props": {
            "layout": {
              "direction": "row",
              "crossAlign": "start"
            },
            "role": "item",
            "style": {
              "padding": "var(--space-block) 0",
              "borderBottom": "1px solid var(--color-border)"
            }
          },
          "children": [
            {
              "id": "postLink",
              "type": "view",
              "props": {
                "layout": {
                  "gap": "xs"
                },
                "href": "/posts/${entry.content.slug}",
                "size": {
                  "flex": 1
                },
                "style": {
                  "display": "block",
                  "textDecoration": "none",
                  "color": "inherit",
                  "cursor": "pointer",
                  "minWidth": 0
                }
              },
              "children": [
                {
                  "id": "postlink-h3-1",
                  "type": "text",
                  "props": {
                    "level": 3,
                    "content": "${entry.content.title}"
                  }
                },
                {
                  "id": "postlink-p-2",
                  "type": "text",
                  "props": {
                    "content": "${entry.content.summary}",
                    "intent": "muted"
                  }
                },
                {
                  "id": "postlink-row-3",
                  "type": "view",
                  "props": {
                    "layout": {
                      "direction": "row",
                      "gap": "xs",
                      "crossAlign": "center"
                    }
                  },
                  "children": [
                    {
                      "id": "postlink-row-3-p-1",
                      "type": "text",
                      "props": {
                        "content": "${entry.content.category}",
                        "scale": "sm",
                        "intent": "muted",
                        "style": {
                          "textTransform": "capitalize"
                        }
                      }
                    },
                    {
                      "id": "postlink-row-3-view-2",
                      "type": "view",
                      "props": {
                        "style": {
                          "fontSize": "var(--type-small)",
                          "color": "var(--color-dim)"
                        }
                      },
                      "children": [
                        {
                          "id": "postlink-row-3-view-2-time-1",
                          "type": "time",
                          "props": {
                            "mode": "display",
                            "value": "${entry.content.publishedAt}",
                            "timeMode": "relative"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
