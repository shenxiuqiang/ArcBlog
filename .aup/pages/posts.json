{
  "id": "arcblog-posts-view-1",
  "type": "view",
  "props": {
    "layout": {
      "gap": "lg"
    }
  },
  "children": [
    {
      "id": "hero-wrap",
      "type": "view",
      "visible": "!$state.heroesEmpty",
      "children": [
        {
          "id": "hero-carousel",
          "type": "afs-list",
          "props": {
            "layout": "slideshow",
            "itemStyle": "hero",
            "subscribe": true,
            "showBreadcrumb": false,
            "showParent": false,
            "emptyText": "$t(posts.hero-empty)",
            "sort": {
              "preset": "heroOrder",
              "presets": {
                "heroOrder": {
                  "field": "content.sort",
                  "desc": false
                }
              }
            }
          },
          "src": "/instance/app/arcblog/heroes",
          "events": {
            "empty": [
              {
                "target": "hero-wrap",
                "set": {
                  "state": {
                    "heroesEmpty": true
                  }
                }
              }
            ],
            "error": [
              {
                "target": "hero-wrap",
                "set": {
                  "state": {
                    "heroesEmpty": true
                  }
                }
              }
            ]
          },
          "children": [
            {
              "id": "heroSlide",
              "type": "view",
              "props": {
                "layout": {
                  "direction": "row"
                },
                "role": "item",
                "style": {
                  "width": "100%",
                  "height": "100%"
                }
              },
              "children": [
                {
                  "id": "heroSlideLink",
                  "type": "view",
                  "props": {
                    "href": "${entry.content.url}",
                    "style": {
                      "display": "flex",
                      "flexDirection": "column",
                      "justifyContent": "flex-end",
                      "width": "100%",
                      "minHeight": "300px",
                      "borderRadius": "var(--radius-lg, 12px)",
                      "overflow": "hidden",
                      "background": "var(--color-border) url(${entry.content.image}) center / cover no-repeat",
                      "textDecoration": "none"
                    }
                  },
                  "children": [
                    {
                      "id": "heroslidelink-view-1",
                      "type": "view",
                      "props": {
                        "layout": {
                          "gap": "xs"
                        },
                        "style": {
                          "padding": "var(--space-block, 24px)",
                          "background": "linear-gradient(transparent, rgba(0,0,0,0.72))"
                        }
                      },
                      "children": [
                        {
                          "id": "heroslidelink-view-1-h2-1",
                          "type": "text",
                          "props": {
                            "level": 2,
                            "content": "${entry.content.title}",
                            "style": {
                              "color": "#fff",
                              "margin": "0"
                            }
                          }
                        },
                        {
                          "id": "heroslidelink-view-1-p-2",
                          "type": "text",
                          "props": {
                            "content": "${entry.content.description}",
                            "intent": "muted",
                            "style": {
                              "color": "rgba(255,255,255,0.85)",
                              "margin": "0"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "arcblog-posts-view-1-card-2",
      "type": "view",
      "props": {
        "mode": "card",
        "layout": {
          "gap": "md"
        }
      },
      "children": [
        {
          "id": "arcblog-posts-view-1-card-2-h1-1",
          "type": "text",
          "props": {
            "level": 1,
            "content": "$t(posts.hero-title)",
            "scale": "display"
          }
        },
        {
          "id": "arcblog-posts-view-1-card-2-p-2",
          "type": "text",
          "props": {
            "content": "$t(posts.hero-desc)",
            "intent": "info"
          }
        },
        {
          "id": "arcblog-posts-view-1-card-2-row-3",
          "type": "view",
          "props": {
            "layout": {
              "direction": "row",
              "gap": "sm"
            }
          },
          "children": [
            {
              "id": "arcblog-posts-view-1-card-2-row-3-action-1",
              "type": "action",
              "props": {
                "variant": "primary",
                "label": "$t(posts.hero-cta)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "compose"
                  }
                }
              }
            },
            {
              "id": "arcblog-posts-view-1-card-2-row-3-action-2",
              "type": "action",
              "props": {
                "variant": "ghost",
                "label": "$t(posts.rss)"
              },
              "events": {
                "click": {
                  "navigate": "/rss.xml"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "arcblog-posts-view-1-h2-3",
      "type": "text",
      "props": {
        "level": 2,
        "content": "$t(posts.feed)"
      }
    },
    {
      "id": "published-feed",
      "type": "afs-list",
      "props": {
        "layout": "list",
        "itemStyle": "row",
        "subscribe": true,
        "showBreadcrumb": false,
        "showParent": false,
        "emptyText": "$t(posts.feed-empty)",
        "clickMode": "none",
        "filter": {
          "field": "content.status",
          "match": "published"
        },
        "serverFilters": [
          {
            "key": "category",
            "control": "chips",
            "urlParam": "category",
            "options": [
              {
                "value": "",
                "label": "$t(posts.tf-all)"
              },
              {
                "value": "technology",
                "label": "$t(posts.tf-tech)"
              },
              {
                "value": "design",
                "label": "$t(posts.tf-design)"
              },
              {
                "value": "life",
                "label": "$t(posts.tf-life)"
              }
            ],
            "push": {
              "field": "category",
              "op": "eq"
            }
          }
        ]
      },
      "src": "/instance/app/arcblog/posts",
      "children": [
        {
          "id": "postRow",
          "type": "view",
          "props": {
            "layout": {
              "direction": "row",
              "crossAlign": "start"
            },
            "role": "item",
            "style": {
              "padding": "var(--space-block) 0",
              "borderBottom": "1px solid var(--color-border)"
            }
          },
          "children": [
            {
              "id": "postLink",
              "type": "view",
              "props": {
                "layout": {
                  "gap": "xs"
                },
                "href": "/posts/${entry.content.slug}",
                "size": {
                  "flex": 1
                },
                "style": {
                  "display": "block",
                  "textDecoration": "none",
                  "color": "inherit",
                  "cursor": "pointer",
                  "minWidth": 0
                }
              },
              "children": [
                {
                  "id": "postlink-h3-1",
                  "type": "text",
                  "props": {
                    "level": 3,
                    "content": "${entry.content.title}"
                  }
                },
                {
                  "id": "postlink-p-2",
                  "type": "text",
                  "props": {
                    "content": "${entry.content.summary}",
                    "intent": "muted"
                  }
                },
                {
                  "id": "postlink-row-3",
                  "type": "view",
                  "props": {
                    "layout": {
                      "direction": "row",
                      "gap": "xs",
                      "crossAlign": "center"
                    }
                  },
                  "children": [
                    {
                      "id": "postlink-row-3-p-1",
                      "type": "text",
                      "props": {
                        "content": "${entry.content.category}",
                        "scale": "sm",
                        "intent": "muted",
                        "style": {
                          "textTransform": "capitalize"
                        }
                      }
                    },
                    {
                      "id": "postlink-row-3-view-2",
                      "type": "view",
                      "props": {
                        "style": {
                          "fontSize": "var(--type-small)",
                          "color": "var(--color-dim)"
                        }
                      },
                      "children": [
                        {
                          "id": "postlink-row-3-view-2-time-1",
                          "type": "time",
                          "props": {
                            "mode": "display",
                            "value": "${entry.content.publishedAt}",
                            "timeMode": "relative"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
