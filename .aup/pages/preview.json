{
  "id": "arcblog-preview-view-1",
  "type": "view",
  "props": {
    "layout": {
      "gap": "lg"
    }
  },
  "propBind": {
    "post": "/instance/app/arcblog/drafts/$params.slug.json"
  },
  "children": [
    {
      "id": "arcblog-preview-view-1-row-1",
      "type": "view",
      "props": {
        "layout": {
          "direction": "row",
          "gap": "sm"
        }
      },
      "children": [
        {
          "id": "preview-back",
          "type": "action",
          "props": {
            "variant": "ghost",
            "label": "$t(preview.back)"
          },
          "events": {
            "click": {
              "target": "_root",
              "set": {
                "page": "admin"
              }
            }
          }
        }
      ]
    },
    {
      "id": "arcblog-preview-view-1-card-2",
      "type": "view",
      "props": {
        "mode": "card",
        "layout": {
          "gap": "md"
        }
      },
      "visible": "!$state.post",
      "children": [
        {
          "id": "arcblog-preview-view-1-card-2-h2-1",
          "type": "text",
          "props": {
            "level": 2,
            "content": "$t(preview.title)"
          }
        },
        {
          "id": "arcblog-preview-view-1-card-2-p-2",
          "type": "text",
          "props": {
            "content": "$t(preview.not-found)",
            "intent": "muted"
          }
        }
      ]
    },
    {
      "id": "preview-article",
      "type": "view",
      "props": {
        "layout": {
          "gap": "md"
        }
      },
      "visible": "$state.post",
      "children": [
        {
          "id": "preview-article-card-1",
          "type": "view",
          "props": {
            "mode": "card",
            "layout": {
              "gap": "sm"
            }
          },
          "children": [
            {
              "id": "preview-article-card-1-p-1",
              "type": "text",
              "props": {
                "content": "$t(preview.notice)",
                "intent": "info"
              }
            }
          ]
        },
        {
          "id": "preview-title",
          "type": "text",
          "props": {
            "level": 1,
            "content": "${state.post.title}",
            "scale": "display"
          }
        },
        {
          "id": "preview-article-row-3",
          "type": "view",
          "props": {
            "layout": {
              "direction": "row",
              "gap": "xs",
              "crossAlign": "center"
            }
          },
          "children": [
            {
              "id": "preview-article-row-3-p-1",
              "type": "text",
              "props": {
                "content": "${state.post.status}",
                "scale": "sm",
                "intent": "muted"
              }
            },
            {
              "id": "preview-article-row-3-p-2",
              "type": "text",
              "props": {
                "content": "${state.post.authorName}",
                "scale": "sm",
                "intent": "muted"
              }
            },
            {
              "id": "preview-article-row-3-p-3",
              "type": "text",
              "props": {
                "content": "${state.post.category}",
                "scale": "sm",
                "intent": "muted",
                "style": {
                  "textTransform": "capitalize"
                }
              }
            }
          ]
        },
        {
          "id": "preview-body",
          "type": "text",
          "props": {
            "format": "markdown",
            "content": "${state.post.body}"
          }
        }
      ]
    }
  ]
}
