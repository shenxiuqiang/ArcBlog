page index {
  i18n {
    feed { en "Latest published" zh "最新发布" }
    feed-empty { en "No published stories yet." zh "还没有已发布的文章。" }
  }
  view gap=lg {
    view gap=lg {
      frame hero-carousel-frame src="/p/en/hero-carousel/" loading=eager aspectRatio="16 / 7" title="Hero carousel" sandbox=allow-top-navigation-by-user-activation
      h2 :feed level=2
      afs-list feed-list layout=list itemStyle=row subscribe=true autoSelect=false showBreadcrumb=false showParent=false emptyText=:feed-empty clickMode=none pagination=manual pageSize=10 from "/instance/app/arcblog/posts" {
        row cross=stretch role=item style={padding: "0", border: "1px solid var(--color-border)", borderRadius: "var(--radius-lg, 10px)", marginBottom: "var(--space-block, 20px)", overflow: hidden, minHeight: "176px"} {
          view layout=inline href="/posts/${entry.content.slug}" size={flex: 1} style={display: flex, flexDirection: column, justifyContent: center, textDecoration: none, color: inherit, cursor: pointer, minWidth: 0, padding: "24px 30px"} {
            h3 "${entry.content.title}" scale=lg style={margin: "0", fontSize: "clamp(1.3rem, 2vw, 1.62rem)", lineHeight: "1.25"}
            row gap=xs cross=center {
              p "${entry.content.category}" scale=sm intent=muted style={textTransform: capitalize}
              p "·" scale=sm intent=muted
              view style={fontSize: "var(--type-small)", color: "var(--color-dim)"} {
                time mode=display value="${entry.content.publishedAt}" timeMode=relative
              }
            }
            p "${entry.content.summary}" intent=muted scale=sm style={margin: "0"}
          }
          // DEF-15 measured exception (Lead ruling 2026-10-12): `$entry.*` inside an `afs-list`
          // ROW template works both ways — the row renders after its entry is bound. Measured on
          // the served DOM for the 3 published posts: exactly ONE `flex: 0 0 240px` cover tile
          // exists, and it belongs to the only post that has a coverImage; the two coverless rows
          // render no tile at all (the negated form hid nothing). Kept as-is, and the blanket "no
          // data-state condition" rule is narrowed to `$state.*` (arc-contracts §28.1).
          // DEF-27 / E7 (human ruling 2026-10-13: "put visible copy"): the cover tile used to carry
          // a single space, so the link had NO accessible name (a screen reader read the URL only).
          // The title is now rendered over the cover, which both names the link and labels the image.
          view layout=inline href="/posts/${entry.content.slug}" style={display: flex, alignItems: flex-end, flexGrow: 0, flexShrink: 0, flexBasis: "240px", width: "240px", alignSelf: stretch, background: "url(${entry.content.coverImage}) center / cover no-repeat"} visible="${entry.content.coverImage}" {
            p "${entry.content.title}" scale=caption style={margin: "0", padding: "6px 8px", width: "100%", color: "#fff", background: "rgba(0, 0, 0, 0.55)"}
          }
        }
      }
    }
    app-footer brand={title: ArcBlog, tagline: "$t(wrapper.tagline)", href: "/?page=index"} columns=[{links: [{label: "$t(wrapper.nav-about)", href: "/?page=about"}, {label: "$t(wrapper.nav-author)", href: "/?page=author"}, {label: "$t(wrapper.nav-saved)", href: "/?page=saved"}, {label: RSS, href: "/p/rss.xml", external: true}]}]
  }
}
