{
  "id": "arcblog-dashboard",
  "type": "view",
  "props": {
    "layout": {
      "gap": "lg"
    },
    "size": {
      "maxWidth": "lg"
    }
  },
  "children": [
    {
      "id": "arcblog-dashboard-card-1",
      "type": "view",
      "props": {
        "mode": "card",
        "layout": {
          "gap": "md"
        }
      },
      "visible": "!$session.authenticated",
      "children": [
        {
          "id": "arcblog-dashboard-card-1-h2-1",
          "type": "text",
          "props": {
            "level": 2,
            "content": "$t(dashboard.gate-title)"
          }
        },
        {
          "id": "arcblog-dashboard-card-1-p-2",
          "type": "text",
          "props": {
            "content": "$t(dashboard.gate-desc)",
            "intent": "info"
          }
        },
        {
          "id": "arcblog-dashboard-card-1-action-3",
          "type": "action",
          "props": {
            "variant": "primary",
            "label": "$t(dashboard.login)"
          },
          "events": {
            "click": {
              "navigate": "/.well-known/service/login?return_to=%2F%3Fpage%3Ddashboard&cancel_to=%2F%3Fpage%3Ddashboard"
            }
          }
        }
      ]
    },
    {
      "id": "console-shell",
      "type": "view",
      "props": {
        "layout": {
          "direction": "row",
          "gap": "lg",
          "crossAlign": "start"
        }
      },
      "visible": "$session.authenticated",
      "children": [
        {
          "id": "console-nav",
          "type": "view",
          "props": {
            "layout": {
              "gap": "xs"
            },
            "size": {
              "width": "200px",
              "flexShrink": 0
            },
            "style": {
              "padding": "14px",
              "border": "1px solid var(--color-border)",
              "borderRadius": "var(--radius-lg, 12px)",
              "background": "var(--color-surface)"
            }
          },
          "visible": "$session.authenticated",
          "children": [
            {
              "id": "console-nav-p-1",
              "type": "text",
              "props": {
                "content": "$t(wrapper.nav-group-content)",
                "intent": "muted",
                "scale": "caption"
              }
            },
            {
              "id": "console-nav-dashboard",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-dashboard)",
                "variant": "primary"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "dashboard"
                  }
                }
              }
            },
            {
              "id": "console-nav-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-studio)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "admin"
                  }
                }
              }
            },
            {
              "id": "console-nav-heroes-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-heroes)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "heroes-admin"
                  }
                }
              }
            },
            {
              "id": "console-nav-p-5",
              "type": "text",
              "props": {
                "content": "$t(wrapper.nav-group-ops)",
                "intent": "muted",
                "scale": "caption"
              }
            },
            {
              "id": "console-nav-operations",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-operations)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "operations"
                  }
                }
              }
            },
            {
              "id": "console-nav-ops-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-media-agents)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "ops-admin"
                  }
                }
              }
            },
            {
              "id": "console-nav-p-8",
              "type": "text",
              "props": {
                "content": "$t(wrapper.nav-group-economy)",
                "intent": "muted",
                "scale": "caption"
              }
            },
            {
              "id": "console-nav-economy-admin",
              "type": "action",
              "props": {
                "label": "$t(wrapper.nav-policy-grants)"
              },
              "events": {
                "click": {
                  "target": "_root",
                  "set": {
                    "page": "economy-admin"
                  }
                }
              }
            }
          ]
        },
        {
          "id": "console-pane",
          "type": "view",
          "props": {
            "layout": {
              "gap": "lg"
            },
            "size": {
              "flex": 1
            }
          },
          "children": [
            {
              "id": "console-pane-card-1",
              "type": "view",
              "props": {
                "mode": "card",
                "layout": {
                  "gap": "md"
                }
              },
              "children": [
                {
                  "id": "console-pane-card-1-h1-1",
                  "type": "text",
                  "props": {
                    "level": 1,
                    "content": "$t(dashboard.title)"
                  }
                },
                {
                  "id": "console-pane-card-1-p-2",
                  "type": "text",
                  "props": {
                    "content": "$t(dashboard.desc)",
                    "intent": "muted"
                  }
                }
              ]
            },
            {
              "id": "console-pane-card-2",
              "type": "view",
              "props": {
                "mode": "card",
                "layout": {
                  "gap": "md"
                }
              },
              "children": [
                {
                  "id": "console-pane-card-2-h2-1",
                  "type": "text",
                  "props": {
                    "level": 2,
                    "content": "$t(dashboard.node)"
                  }
                },
                {
                  "id": "dash-node",
                  "type": "afs-list",
                  "props": {
                    "layout": "list",
                    "itemStyle": "row",
                    "subscribe": true,
                    "showBreadcrumb": false,
                    "showParent": false,
                    "clickMode": "none",
                    "emptyText": "$t(dashboard.node-empty)"
                  },
                  "src": "/instance/app/arcblog/node",
                  "children": [
                    {
                      "id": "dashNodeRow",
                      "type": "view",
                      "props": {
                        "layout": {
                          "direction": "row",
                          "gap": "xs"
                        },
                        "role": "item"
                      },
                      "children": [
                        {
                          "id": "dashnoderow-h3-1",
                          "type": "text",
                          "props": {
                            "level": 3,
                            "content": "${entry.content.name}"
                          }
                        },
                        {
                          "id": "dashnoderow-p-2",
                          "type": "text",
                          "props": {
                            "content": "${entry.content.did}",
                            "scale": "sm",
                            "intent": "muted"
                          }
                        },
                        {
                          "id": "dashnoderow-p-3",
                          "type": "text",
                          "props": {
                            "content": "${entry.content.version}",
                            "scale": "sm",
                            "intent": "muted"
                          }
                        },
                        {
                          "id": "dashnoderow-p-4",
                          "type": "text",
                          "props": {
                            "content": "$t(dashboard.roles-label)",
                            "scale": "sm",
                            "intent": "muted"
                          }
                        },
                        {
                          "id": "dashnoderow-p-5",
                          "type": "text",
                          "props": {
                            "content": "${entry.content.roles}",
                            "scale": "sm"
                          }
                        },
                        {
                          "id": "dashnoderow-p-6",
                          "type": "text",
                          "props": {
                            "content": "$t(dashboard.capabilities-label)",
                            "scale": "sm",
                            "intent": "muted"
                          }
                        },
                        {
                          "id": "dashnoderow-p-7",
                          "type": "text",
                          "props": {
                            "content": "${entry.content.capabilities}",
                            "scale": "sm"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "console-pane-card-3",
              "type": "view",
              "props": {
                "mode": "card",
                "layout": {
                  "gap": "md"
                }
              },
              "children": [
                {
                  "id": "console-pane-card-3-h2-1",
                  "type": "text",
                  "props": {
                    "level": 2,
                    "content": "$t(dashboard.content)"
                  }
                },
                {
                  "id": "dash-published",
                  "type": "afs-list",
                  "props": {
                    "layout": "list",
                    "itemStyle": "row",
                    "subscribe": true,
                    "showBreadcrumb": false,
                    "showParent": false,
                    "clickMode": "none",
                    "pageSize": 5,
                    "emptyText": "$t(dashboard.content-empty)"
                  },
                  "src": "/instance/app/arcblog/posts",
                  "children": [
                    {
                      "id": "dashPostRow",
                      "type": "view",
                      "props": {
                        "layout": {
                          "direction": "row",
                          "gap": "xs"
                        },
                        "role": "item"
                      },
                      "children": [
                        {
                          "id": "dashPostLink",
                          "type": "view",
                          "props": {
                            "href": "/posts/${entry.content.slug}",
                            "style": {
                              "display": "block",
                              "textDecoration": "none",
                              "color": "inherit"
                            }
                          },
                          "children": [
                            {
                              "id": "dashpostlink-h3-1",
                              "type": "text",
                              "props": {
                                "level": 3,
                                "content": "${entry.content.title}"
                              }
                            }
                          ]
                        },
                        {
                          "id": "dashpostrow-p-2",
                          "type": "text",
                          "props": {
                            "content": "${entry.content.category}",
                            "scale": "sm",
                            "intent": "muted"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "console-pane-card-4",
              "type": "view",
              "props": {
                "mode": "card",
                "layout": {
                  "gap": "md"
                }
              },
              "children": [
                {
                  "id": "console-pane-card-4-h2-1",
                  "type": "text",
                  "props": {
                    "level": 2,
                    "content": "$t(dashboard.quick)"
                  }
                },
                {
                  "id": "console-pane-card-4-row-2",
                  "type": "view",
                  "props": {
                    "layout": {
                      "direction": "row",
                      "gap": "sm"
                    }
                  },
                  "children": [
                    {
                      "id": "console-pane-card-4-row-2-action-1",
                      "type": "action",
                      "props": {
                        "variant": "primary",
                        "label": "$t(dashboard.q-write)"
                      },
                      "events": {
                        "click": {
                          "target": "_root",
                          "set": {
                            "page": "compose"
                          }
                        }
                      }
                    },
                    {
                      "id": "console-pane-card-4-row-2-action-2",
                      "type": "action",
                      "props": {
                        "variant": "secondary",
                        "label": "$t(dashboard.q-studio)"
                      },
                      "events": {
                        "click": {
                          "target": "_root",
                          "set": {
                            "page": "admin"
                          }
                        }
                      }
                    },
                    {
                      "id": "console-pane-card-4-row-2-action-3",
                      "type": "action",
                      "props": {
                        "variant": "secondary",
                        "label": "$t(dashboard.q-ops)"
                      },
                      "events": {
                        "click": {
                          "target": "_root",
                          "set": {
                            "page": "operations"
                          }
                        }
                      }
                    },
                    {
                      "id": "console-pane-card-4-row-2-action-4",
                      "type": "action",
                      "props": {
                        "variant": "ghost",
                        "label": "$t(dashboard.q-settings)"
                      },
                      "events": {
                        "click": {
                          "target": "_root",
                          "set": {
                            "page": "settings"
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
