page reader {
  i18n {
    title { en "Article" zh "文章" }
    runtime-note { en "The article below is read from the record bound to this address, so it is here on the first load — no reload needed. If the body area is empty, the record does not exist (or this session may not read it)." zh "下方正文读取的是本地址绑定的记录，首次打开即已取到，无需刷新。若正文区为空，说明该记录不存在（或本次会话无权读取）。" }
    back { en "Back to latest stories" zh "返回最新文章" }
  }
  view gap=lg {
    breadcrumb items=[{label: "$t(reader.back)", href: "/posts"}, {label: "$t(reader.title)"}]
    // DEF-21 / B14 (measured 2026-10-12): `propBind` resolves the record into the
    // daemon's SESSION state only AFTER the first render — the first `aup render`
    // frame carries `propBind` and no `state`, the served client bundle has no
    // `propBind` handler, and no later push arrives. A cold entry therefore
    // painted an empty body (265 chars) and only a reload (which reuses the
    // session) showed the article (3893 chars).
    //
    // The cold-start channel is `surface url="$state.loc"`: the runtime derives
    // the record path from `__AUP_BOOT__.bindings` + `location.pathname`
    // (`Vi()` → `Un()`, exposed to props as `$state.loc`, `$state.slug`,
    // `$state.page`) and the surface reads it with `window.afs.read()` on mount.
    // `url` is used (not `src`) because only PROPS are rewritten with the state
    // context (`N0()`); a node-level `src` keeps the literal `$state.loc` and
    // fails with "Path not found". The article markup is the item recipe
    // `<dir>/.aup/item.json`, installed by `node scripts/arcblog-recipes.mjs install`.
    //
    // The note is the surface's chrome child (rendered above the record) and is
    // an unconditional statement about the platform, never a claim about a record
    // it has not read.
    surface url=$state.loc editable=false {
      p :runtime-note intent=muted scale=sm
    }
    app-footer brand={title: ArcBlog, tagline: "$t(wrapper.tagline)", href: "/?page=index"} columns=[{links: [{label: "$t(wrapper.nav-about)", href: "/?page=about"}, {label: "$t(wrapper.nav-author)", href: "/?page=author"}, {label: "$t(wrapper.nav-saved)", href: "/?page=saved"}, {label: RSS, href: "/p/rss.xml", external: true}]}]
  }
}
