page preview {
  i18n {
    back-home { en "Back to latest stories" zh "返回最新文章" }
    title { en "Preview" zh "预览" }
    notice { en "Draft preview — this record is not public." zh "草稿预览 — 该记录未公开。" }
    runtime-note { en "The draft below is read from the record bound to this address, so it is here on the first load — no reload needed. If the body area is empty, the draft does not exist (or this session may not read it)." zh "下方草稿读取的是本地址绑定的记录，首次打开即已取到，无需刷新。若正文区为空，说明该草稿不存在（或本次会话无权读取）。" }
    write-note { en "Publish / delete need the record in the session binding, which the platform only attaches after the first render — reload once before using them." zh "发布 / 删除需要会话已绑定该记录，而平台只在首次渲染之后才附加该绑定 —— 使用前刷新一次即可。" }
    back { en "Back to studio" zh "返回工作室" }
    edit { en "Edit" zh "编辑" }
    preview-publish { en "Publish" zh "发布" }
    published-hint { en "Published. The draft copy is still in studio drafts — remove it when done." zh "已发布。草稿副本仍保留在工作室草稿列表中，可随后删除。" }
    preview-delete { en "Delete draft" zh "删除草稿" }
    preview-delete-title { en "Delete this draft?" zh "删除这篇草稿？" }
    preview-delete-msg { en "The record stays in the archive with status deleted (soft delete)." zh "记录将以 deleted 状态保留（软删除）。" }
    deleted-ok { en "Draft deleted." zh "草稿已删除。" }
  }
  view gap=lg {
    // `propBind` is kept on this wrapper for the WRITE controls only: their exec
    // args are interpolated from `${state.post.*}`, and the daemon attaches that
    // binding to the session after the first render (DEF-21 / B14). The read-only
    // display below does NOT wait for it — it uses `surface url="$state.loc"`,
    // which reads the record on the first paint.
    view gap=lg propBind={post: "/instance/app/arcblog/drafts/$params.slug.json"} {
      row gap=sm {
        view visible=$session.authenticated {
          action -> page posts variant=ghost label=:back
        }
        view href="/posts" style={cursor: pointer, color: "var(--color-dim)"} visible="!$session.authenticated" {
          p :back-home
        }
        // `$state.slug` comes from the route binding (not from `propBind`), so the
        // link works on a cold load; `$session.authenticated` is synchronous and
        // therefore a reliable gate.
        view layout=inline href="/edit/${state.slug}" style={cursor: pointer, color: "var(--color-dim)"} visible=$session.authenticated {
          p :edit scale=sm
        }
      }
      // Standing statement about the platform; never a "missing record" claim.
      view gap=xs {
        h2 :title level=2 scale=sm intent=muted
        p :runtime-note intent=muted scale=sm
      }
      // Deliberate DEF-18 exception (allowlisted in
      // scripts/visible-conditions-allowlist.json), unlike the read-only bodies:
      // THIS block carries the publish/delete writes, whose args are interpolated
      // from `${state.post.*}`. Rendering it before the record is bound would offer a
      // live "publish" button that writes `/instance/app/arcblog/posts/.json` with an
      // empty title into the PUBLIC posts directory — a corrupt record. So the write
      // surface keeps its gate (fail closed), and `preview.write-note` states why it
      // needs a reload.
      view gap=md visible=$state.post {
        row gap=sm {
          action variant=primary label=:preview-publish onSuccessToast={intent: success, message: "$t(preview.published-hint)", duration: 3000} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/posts/${state.post.slug}.json", content: {title: "${state.post.title}", slug: "${state.post.slug}", summary: "${state.post.summary}", body: "${state.post.body}", coverImage: "${state.post.coverImage}", images: [], tags: "${state.post.tags}", category: "${state.post.category}", seoTitle: "${state.post.seoTitle}", seoDescription: "${state.post.seoDescription}", ogTitle: "${state.post.ogTitle}", ogDescription: "${state.post.ogDescription}", ogImage: "${state.post.ogImage}", status: published, authorDid: "${state.post.authorDid}", authorName: "${state.post.authorName}", published: true, publishedAt: "${generate.timeiso}", archivedAt: "", deletedAt: "", createdAt: "${state.post.createdAt}", updatedAt: "${generate.timeiso}", version: 1}}}}
          action variant=destructive label=:preview-delete confirm={title: :preview-delete-title, message: :preview-delete-msg} onSuccessToast={intent: success, message: "$t(preview.deleted-ok)", duration: 3000} events={click: {exec: "/.actions/write", args: {path: "/instance/app/arcblog/drafts/${state.post.slug}.json", content: {title: "${state.post.title}", slug: "${state.post.slug}", summary: "${state.post.summary}", body: "${state.post.body}", coverImage: "${state.post.coverImage}", images: [], tags: "${state.post.tags}", category: "${state.post.category}", seoTitle: "${state.post.seoTitle}", seoDescription: "${state.post.seoDescription}", ogTitle: "${state.post.ogTitle}", ogDescription: "${state.post.ogDescription}", ogImage: "${state.post.ogImage}", status: deleted, authorDid: "${state.post.authorDid}", authorName: "${state.post.authorName}", published: false, publishedAt: "${state.post.publishedAt}", archivedAt: "${state.post.archivedAt}", deletedAt: "${generate.timeiso}", createdAt: "${state.post.createdAt}", updatedAt: "${generate.timeiso}", version: 1}}}}
        }
        view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
          p :notice intent=info
        }
      }
    }
    // The record itself: read on the first paint through the binding-derived path
    // (`$state.loc` = `/instance/app/arcblog/drafts/<slug>.json`), rendered with
    // `drafts/.aup/item.json`. Guests get the platform's own permission/not-found
    // message — a real answer, not a stale-gate guess.
    surface url=$state.loc editable=false {
      p :write-note intent=muted scale=sm
    }
    app-footer brand={title: ArcBlog, tagline: "$t(wrapper.tagline)", href: "/?page=index"} columns=[{links: [{label: "$t(wrapper.nav-about)", href: "/?page=about"}, {label: "$t(wrapper.nav-author)", href: "/?page=author"}, {label: RSS, href: "/p/rss.xml", external: true}]}] bottomBar={copyright: "$t(wrapper.footer-copyright)"}
  }
}
