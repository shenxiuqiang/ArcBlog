page saved {
  i18n {
    add { en "Add to reading list" zh "加入阅读清单" }
    add-note { en "A page write stores exactly the three fields below — a real record under the reader's own DID Space user scope, so a refresh reads it back from AFS rather than from a cache." zh "页面写入恰好这三条字段——记录真实落在读者自己的 DID Space 用户作用域，刷新后从 AFS 读回，而不是从缓存读回。" }
    add-title { en "Add a post" zh "新增收藏" }
    added { en "Saved to your reading list." zh "已加入阅读清单。" }
    desc { en "A private reading list. Every record lives in the signed-in reader's own user scope (/user/arcblog/bookmarks/<slug>.json), which the platform only materialises for that caller — no other visitor and no other signed-in DID resolves the same list." zh "私有阅读清单。每条记录都落在已登录读者自己的用户作用域（/user/arcblog/bookmarks/<slug>.json），平台只为该调用者解析它——其他访客与其他已登录 DID 都不会看到同一份清单。" }
    f-slug { en "Post slug" zh "文章标识（slug）" }
    f-title { en "Title (optional)" zh "标题（可选）" }
    gate-desc { en "Sign in with DID Wallet to keep a private reading list." zh "使用 DID Wallet 登录后维护私有阅读清单。" }
    gate-title { en "Reading list" zh "阅读清单" }
    cmd-list { en "List this reader's reading list" zh "列出该读者的阅读清单" }
    cmd-remove { en "Remove one saved post" zh "移除一条收藏" }
    cmd-where { en "Show both storage paths for a DID" zh "显示某个 DID 的两条存储路径" }
    gov-desc { en "This page lists and adds; it deliberately does not delete. Measured (REQ-028): an AUP page validates ALL of its inputs on ANY action submit, so one empty required field blocks every other action on the page — a page-side delete would be hostage to the add form below. Removal is therefore the CLI's job, exactly as on the other console pages." zh "本页只做列举与新增，刻意不做删除。实测（REQ-028）：AUP 页面在任何 action 提交时都会校验页面上全部输入，因此一个空的 required 字段会阻断本页其他所有动作——页面直删会被人质化于下方的新增表单。删除因此交给 CLI，与其他控制台页的做法一致。" }
    gov-title { en "Commands (copy and run)" zh "命令（复制后执行）" }
    list-desc { en "One row per record under /user/arcblog/bookmarks/ in this session's own user scope. The path is caller-scoped, not a shared directory: the same URL resolves to a different list for a different DID, and a signed-out visitor has no /user view at all." zh "来自本会话自身用户作用域 /user/arcblog/bookmarks/ 的每条记录一行。该路径按调用者分区，不是共享目录：同一 URL 对不同 DID 解析出不同清单，未登录访客则根本没有 /user 视图。" }
    list-empty { en "Nothing saved yet. An empty list means no record exists in this reader's user scope — the form below writes the first one." zh "还没有收藏。列表为空说明该读者的用户作用域里没有记录——下方表单会写入第一条。" }
    list-title { en "Saved posts" zh "已收藏文章" }
    login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
    slug-hint { en "Lowercase letters, digits and hyphens, exactly as it appears in /posts/<slug>. The CLI enforces the same rule." zh "小写字母、数字与连字符，与 /posts/<slug> 中的写法一致。CLI 强制同一规则。" }
    title { en "Reading list" zh "阅读清单" }
    where-note { en "Storage: /user/arcblog/bookmarks/<slug>.json (this caller's DID Space user scope, AFS path /blocklets/arcblog/users/<your-did>/arcblog/bookmarks/). ArcBlog declares no blocklet.yaml permission for it: the user scope is authorized by the session, not by a replicated collection — measured (arc-contracts.md)." zh "存储位置：/user/arcblog/bookmarks/<slug>.json（本调用者的 DID Space 用户作用域，AFS 路径 /blocklets/arcblog/users/<你的 DID>/arcblog/bookmarks/）。ArcBlog 没有为它声明任何 blocklet.yaml 权限：用户作用域由会话授权，而不是由 replicated 集合授权——已实测（arc-contracts.md）。" }
  }
  view gap=lg {
    view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "20px"} visible="!$session.authenticated" {
      h2 :gate-title level=2 style={fontSize: "var(--type-body)"}
      p :gate-desc intent=muted
      row cross=start {
        action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dsaved&cancel_to=%2F%3Fpage%3Dsaved" variant=primary label=:login style={borderRadius: "var(--radius-md, 8px)"}
      }
    }
    view gap=lg visible=$session.authenticated {
      view gap=xs {
        h2 :title level=2 style={fontSize: "var(--type-subheading)"}
        p :desc intent=muted
      }
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px", flexShrink: 0} {
        h3 :list-title level=3 style={fontSize: "var(--type-body)"}
        p :list-desc scale=sm intent=muted
        afs-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none from "/user/arcblog/bookmarks" {
          view gap=xs role=item style={borderBottom: "1px solid var(--color-border)", padding: "8px 0"} {
            h3 "${entry.content.slug}" style={fontSize: "var(--type-body)"}
            p "${entry.content.title}" scale=sm intent=muted
            view style={fontSize: "var(--type-small)", color: "var(--color-dim)"} {
              time mode=display value="${entry.content.addedAt}" timeMode=relative
            }
          }
        }
        p :list-empty scale=caption intent=muted
      }
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px", flexShrink: 0} {
        h3 :gov-title level=3 style={fontSize: "var(--type-body)"}
        p :gov-desc scale=sm intent=muted
        key-value-list dense=true fields=[{label: "$t(saved.cmd-list)", value: "node scripts/arcblog-bookmarks.mjs list --user <your-did>", monospace: true, copyable: true}, {label: "$t(saved.cmd-remove)", value: "node scripts/arcblog-bookmarks.mjs remove --user <your-did> --slug <slug>", monospace: true, copyable: true}, {label: "$t(saved.cmd-where)", value: "node scripts/arcblog-bookmarks.mjs where --user <your-did>", monospace: true, copyable: true}]
      }
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: none, padding: "14px", flexShrink: 0} {
        h3 :add-title level=3 style={fontSize: "var(--type-body)"}
        p :add-note scale=sm intent=muted
        input type=text label=:f-slug name=bSlug required=true state={value: ""}
        p :slug-hint intent=muted scale=caption
        input type=text label=:f-title name=bTitle state={value: ""}
        row cross=start {
          action variant=primary label=:add onSuccessToast={intent: success, message: "$t(saved.added)", duration: 2500} style={borderRadius: "var(--radius-md, 8px)"} events={click: {exec: "/.actions/write", args: {path: "/user/arcblog/bookmarks/${args.bSlug}.json", content: {slug: "${args.bSlug}", title: "${args.bTitle}", addedAt: "${generate.timeiso}"}}}}
        }
      }
      view gap=xs style={background: "var(--color-surface)", border: "1px solid var(--color-border)", borderRadius: "var(--radius-lg, 10px)", padding: "14px"} {
        p :where-note scale=caption intent=muted
      }
    }
  }
}
