app "ArcBlog" {
  default posts
  tone editorial
  palette natural
  locales [en, zh]
  wrapper "wrapper.json"

  page settings "Appearance" {
    i18n {
      gate-title { en "Appearance" zh "外观" }
      gate-desc { en "Sign in with DID Wallet to set this site's palette and tone. Signed-in users can also personalize their own theme." zh "使用 DID Wallet 登录后可设置本站的配色与风格；登录用户还可以个性化自己的主题。" }
      login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      title { en "Appearance" zh "外观" }
      desc { en "Theme, tone and palette for this site. Admins set the defaults; signed-in users can personalize their own theme." zh "本站的主题、风格与配色。管理员设置默认值；登录用户可以个性化自己的主题。" }
    }
    card gap=md visible="!$session.authenticated" {
      h2 :gate-title level=2
      p :gate-desc intent=info
      action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dsettings&cancel_to=%2F%3Fpage%3Dsettings" variant=primary label=:login
    }
    view gap=lg visible=$session.authenticated {
      h1 :title level=1
      p :desc intent=muted
      auto-surface appearance-settings "Appearance" from "/instance/settings/arcblog"
    }
  }

  page posts "Latest stories" {
    i18n {
      hero-title { en "A calmer place to read." zh "一个安静阅读的地方。" }
      hero-desc { en "Only published stories appear in the public feed. Every post remains DID-attributed and follows a draft → published → archived lifecycle." zh "公共 feed 只展示已发布的文章。每篇文章都带有 DID 署名，并遵循 草稿 → 发布 → 归档 的生命周期。" }
      hero-cta { en "Write a post" zh "开始写作" }
      hero-about { en "About this node" zh "关于本节点" }
      tf-all { en "All" zh "全部" }
      tf-tech { en "Technology" zh "技术" }
      tf-design { en "Design" zh "设计" }
      tf-life { en "Life" zh "生活" }
      feed { en "Latest published" zh "最新发布" }
      feed-empty { en "No published stories yet." zh "还没有已发布的文章。" }
      hero-empty { en "" zh "" }
      rss { en "Subscribe via RSS" zh "订阅 RSS" }
    }
    view gap=lg {
      frame hero-carousel-frame src="/p/en/hero-carousel/" loading=eager aspectRatio="16 / 7" title="Hero carousel" sandbox="allow-top-navigation-by-user-activation"
      h2 :feed level=2
  afs-list published-feed layout=list itemStyle=row subscribe=true autoSelect=false showBreadcrumb=false showParent=false emptyText=:feed-empty clickMode=none from "/instance/app/arcblog/posts" {
        row postRow cross=stretch role=item style={padding: "0", border: "1px solid var(--color-border)", borderRadius: "var(--radius-lg, 12px)", marginBottom: "var(--space-block, 20px)", overflow: "hidden", minHeight: "176px"} {
          view postLink gap=sm href="/posts/${entry.content.slug}" size={flex: 1} style={display: "flex", flexDirection: "column", justifyContent: "center", textDecoration: "none", color: "inherit", cursor: "pointer", minWidth: 0, padding: "24px 30px"} {
            h3 "${entry.content.title}" scale=lg style={margin: "0", fontSize: "clamp(1.3rem, 2vw, 1.62rem)", lineHeight: "1.25"}
            row gap=xs cross=center {
              p "${entry.content.category}" scale=sm intent=muted style={textTransform: capitalize}
              p "·" scale=sm intent=muted
              view style={fontSize: "var(--type-small)", color: "var(--color-dim)"} {
                time mode=display value="${entry.content.publishedAt}" timeMode=relative
              }
            }
            p "${entry.content.summary}" intent=muted scale=sm style={margin: "0"}
          }
          view postCover visible="${entry.content.coverImage}" href="/posts/${entry.content.slug}" style={display: "block", flexGrow: 0, flexShrink: 0, flexBasis: "240px", width: "240px", alignSelf: "stretch", background: "url(${entry.content.coverImage}) center / cover no-repeat"} {
            text content=" "
          }
        }
      }
    }
  }

  page compose "Write" {
    i18n {
      gate-title { en "Publish with your wallet" zh "用钱包发布" }
      gate-desc { en "Sign in with DID Wallet to unlock the editor. Drafts stay in the private drafts directory until published." zh "使用 DID Wallet 登录以解锁编辑器。草稿保存在私有草稿目录中，直到发布。" }
      login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      checks { en "Pre-publish checks" zh "发布前检查" }
      checks-desc { en "Title and slug are required. Publishing is immediately public; drafts stay private until published. Saving an existing slug overwrites that record." zh "标题和 slug 必填。发布即公开；草稿在发布前保持私有。相同 slug 会覆盖已有记录。" }
      meta { en "Metadata" zh "元数据" }
      f-title { en "Title" zh "标题" }
      f-slug { en "Slug" zh "Slug" }
      slug-hint { en "Lowercase letters, numbers and dashes; used in the URL /posts/<slug>." zh "小写字母、数字和连字符；用于 URL /posts/<slug>。" }
      f-summary { en "Summary" zh "摘要" }
      f-cover { en "Cover image URL" zh "封面图 URL" }
      cover-hint { en "Shown as the card cover in the story list and at the top of the article. Upload via the Images panel below, then paste the URL here." zh "展示在文章列表的卡片封面和正文顶部。可先在下方图片面板上传，再把 URL 粘贴到这里。" }
      f-body { en "Body (Markdown)" zh "正文（Markdown）" }
      category { en "Category" zh "分类" }
      tags { en "Tags" zh "标签" }
      save-draft { en "Save draft" zh "存草稿" }
      publish-now { en "Publish" zh "发布" }
      draft-saved { en "Draft saved — preview it from the studio." zh "草稿已保存——可在工作室预览。" }
      published-ok { en "Published." zh "已发布。" }
      seo { en "SEO & social preview" zh "SEO 与社交分享预览" }
      seo-desc { en "Optional: set seo title/description and OG title/description/image. Defaults fall back to post title, summary, and cover image." zh "可选：设置 SEO 标题/描述与 OG 标题/描述/图片。默认回退到文章标题、摘要和封面图。" }
      images { en "Images" zh "图片" }
      images-desc { en "Drop a cover or inline image here. Media is stored in the site file space; paste the resulting URL into Markdown: ![Alt text](URL)." zh "将封面或正文插图拖到这里。媒体文件保存在站点文件空间中；把生成的 URL 粘贴进 Markdown：![Alt text](URL)。" }
    }
    view gap=lg {
      card gap=md visible="!$session.authenticated" {
        h2 :gate-title level=2
        p :gate-desc intent=info
        action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dcompose&cancel_to=%2F%3Fpage%3Dcompose" variant=primary label=:login
      }
      view gap=lg visible=$session.authenticated {
        card gap=md {
          h3 :checks level=3
          p :checks-desc intent=muted
        }
        card gap=md {
          h3 :meta level=3
          input type=text label=:f-title name=title required=true state={value: ""}
          input type=text label=:f-slug name=slug required=true state={value: ""}
          p :slug-hint intent=muted scale=caption
          input type=select label=:category name=category options=[technology, design, life] state={value: technology}
          input type=text label=:tags name=tags state={value: ""}
          input type=text label=:f-summary name=summary state={value: ""}
          input type=text label=:f-cover name=coverImage state={value: ""}
          p :cover-hint intent=muted scale=caption
        }
        card gap=md {
          h3 :seo level=3
          p :seo-desc intent=muted
          input type=text label="SEO Title" name=seoTitle state={value: ""}
          input type=text label="SEO Description" name=seoDescription state={value: ""}
          input type=text label="OG Title" name=ogTitle state={value: ""}
          input type=text label="OG Description" name=ogDescription state={value: ""}
          input type=text label="OG Image" name=ogImage state={value: ""}
        }
        card gap=md {
          input type=textarea label=:f-body name=body required=true state={value: ""}
        }
        row gap=sm {
          action save-draft -> exec "/.actions/write" variant=secondary label=:save-draft args={path: "/instance/app/arcblog/drafts/${args.slug}.json", content: {title: "${args.title}", slug: "${args.slug}", summary: "${args.summary}", body: "${args.body}", coverImage: "${args.coverImage}", images: [], tags: "${args.tags}", category: "${args.category}", seoTitle: "${args.seoTitle}", seoDescription: "${args.seoDescription}", ogTitle: "${args.ogTitle}", ogDescription: "${args.ogDescription}", ogImage: "${args.ogImage}", status: draft, authorDid: "$session.did", authorName: "$session.displayName", published: false, publishedAt: "", archivedAt: "", deletedAt: "", createdAt: "${generate.timeiso}", updatedAt: "${generate.timeiso}", version: 1}} onSuccessToast={intent: success, message: "$t(compose.draft-saved)", duration: 3000}
          action publish-now -> exec "/.actions/write" variant=primary label=:publish-now args={path: "/instance/app/arcblog/posts/${args.slug}.json", content: {title: "${args.title}", slug: "${args.slug}", summary: "${args.summary}", body: "${args.body}", coverImage: "${args.coverImage}", images: [], tags: "${args.tags}", category: "${args.category}", seoTitle: "${args.seoTitle}", seoDescription: "${args.seoDescription}", ogTitle: "${args.ogTitle}", ogDescription: "${args.ogDescription}", ogImage: "${args.ogImage}", status: published, authorDid: "$session.did", authorName: "$session.displayName", published: true, publishedAt: "${generate.timeiso}", archivedAt: "", deletedAt: "", createdAt: "${generate.timeiso}", updatedAt: "${generate.timeiso}", version: 1}} onSuccessToast={intent: success, message: "$t(compose.published-ok)", duration: 3000}
        }
        card gap=md {
          h3 :images level=3
          p :images-desc intent=muted
        }
        afs-dropzone
      }
    }
  }

  page compose-edit "Edit post" {
    i18n {
      title { en "Edit post" zh "编辑文章" }
      not-found { en "Draft not found." zh "草稿不存在。" }
      back { en "Back to studio" zh "返回工作室" }
      gate-title { en "Publish with your wallet" zh "用钱包发布" }
      gate-desc { en "Sign in with DID Wallet to unlock the editor. Drafts stay in the private drafts directory until published." zh "使用 DID Wallet 登录以解锁编辑器。草稿保存在私有草稿目录中，直到发布。" }
      login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      meta { en "Metadata" zh "元数据" }
      f-title { en "Title" zh "标题" }
      f-slug { en "Slug" zh "Slug" }
      slug-hint { en "Lowercase letters, numbers and dashes; used in the URL /posts/<slug>." zh "小写字母、数字和连字符；用于 URL /posts/<slug>。" }
      f-summary { en "Summary" zh "摘要" }
      f-cover { en "Cover image URL" zh "封面图 URL" }
      cover-hint { en "Shown as the card cover in the story list and at the top of the article. Upload via the Images panel below, then paste the URL here." zh "展示在文章列表的卡片封面和正文顶部。可先在下方图片面板上传，再把 URL 粘贴到这里。" }
      f-body { en "Body (Markdown)" zh "正文（Markdown）" }
      category { en "Category" zh "分类" }
      tags { en "Tags" zh "标签" }
      save-draft { en "Save draft" zh "存草稿" }
      publish-now { en "Publish" zh "发布" }
      seo { en "SEO & social preview" zh "SEO 与社交分享预览" }
      seo-desc { en "Optional: set seo title/description and OG title/description/image. Defaults fall back to post title, summary, and cover image." zh "可选：设置 SEO 标题/描述与 OG 标题/描述/图片。默认回退到文章标题、摘要和封面图。" }
      images { en "Images" zh "图片" }
      images-desc { en "Drop a cover or inline image here. Media is stored in the site file space; paste the resulting URL into Markdown: ![Alt text](URL)." zh "将封面或正文插图拖到这里。媒体文件保存在站点文件空间中；把生成的 URL 粘贴进 Markdown：![Alt text](URL)。" }
      editing { en "Editing" zh "编辑中" }
      publish-hint { en "Published. The draft copy is still in studio drafts — delete it there when done." zh "已发布。草稿副本仍保留在工作室草稿列表中，可随后删除。" }
    }
    view gap=lg propBind={post: "/instance/app/arcblog/drafts/$params.slug.json"} {
      card gap=md visible="!$session.authenticated" {
        h2 :gate-title level=2
        p :gate-desc intent=info
        action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dadmin&cancel_to=%2F%3Fpage%3Dadmin" variant=primary label=:login
      }
      view gap=lg visible=$session.authenticated {
        card gap=md visible="!$state.post" {
          h2 :title level=2
          p :not-found intent=muted
          action -> page admin variant=ghost label=:back
        }
        view gap=lg visible="$state.post" {
          card gap=md {
            h3 "$t(compose-edit.editing)" level=3
            p "${state.post.slug}" intent=muted scale=caption
          }
          card gap=md {
            h3 :meta level=3
            input type=text label=:f-title name=title required=true state={value: "${state.post.title}"}
            input type=text label=:f-slug name=slug required=true state={value: "${state.post.slug}"}
            p :slug-hint intent=muted scale=caption
            input type=select label=:category name=category options=[technology, design, life] state={value: "${state.post.category}"}
            input type=text label=:tags name=tags state={value: "${state.post.tags}"}
            input type=text label=:f-summary name=summary state={value: "${state.post.summary}"}
            input type=text label=:f-cover name=coverImage state={value: "${state.post.coverImage}"}
            p :cover-hint intent=muted scale=caption
          }
          card gap=md {
            h3 :seo level=3
            p :seo-desc intent=muted
            input type=text label="SEO Title" name=seoTitle state={value: "${state.post.seoTitle}"}
            input type=text label="SEO Description" name=seoDescription state={value: "${state.post.seoDescription}"}
            input type=text label="OG Title" name=ogTitle state={value: "${state.post.ogTitle}"}
            input type=text label="OG Description" name=ogDescription state={value: "${state.post.ogDescription}"}
            input type=text label="OG Image" name=ogImage state={value: "${state.post.ogImage}"}
          }
          card gap=md {
            input type=textarea label=:f-body name=body required=true state={value: "${state.post.body}"}
          }
          row gap=sm {
            action save-draft -> exec "/.actions/write" variant=secondary label=:save-draft args={path: "/instance/app/arcblog/drafts/${args.slug}.json", content: {title: "${args.title}", slug: "${args.slug}", summary: "${args.summary}", body: "${args.body}", coverImage: "${args.coverImage}", images: [], tags: "${args.tags}", category: "${args.category}", seoTitle: "${args.seoTitle}", seoDescription: "${args.seoDescription}", ogTitle: "${args.ogTitle}", ogDescription: "${args.ogDescription}", ogImage: "${args.ogImage}", status: draft, authorDid: "${state.post.authorDid}", authorName: "${state.post.authorName}", published: false, publishedAt: "", archivedAt: "", deletedAt: "", createdAt: "${state.post.createdAt}", updatedAt: "${generate.timeiso}", version: "${state.post.version}"}} onSuccessToast={intent: success, message: "$t(compose.draft-saved)", duration: 3000}
            action publish-now -> exec "/.actions/write" variant=primary label=:publish-now args={path: "/instance/app/arcblog/posts/${args.slug}.json", content: {title: "${args.title}", slug: "${args.slug}", summary: "${args.summary}", body: "${args.body}", coverImage: "${args.coverImage}", images: [], tags: "${args.tags}", category: "${args.category}", seoTitle: "${args.seoTitle}", seoDescription: "${args.seoDescription}", ogTitle: "${args.ogTitle}", ogDescription: "${args.ogDescription}", ogImage: "${args.ogImage}", status: published, authorDid: "${state.post.authorDid}", authorName: "${state.post.authorName}", published: true, publishedAt: "${generate.timeiso}", archivedAt: "", deletedAt: "", createdAt: "${state.post.createdAt}", updatedAt: "${generate.timeiso}", version: "${state.post.version}"}} onSuccessToast={intent: success, message: "$t(compose-edit.publish-hint)", duration: 3000}
          }
          card gap=md {
            h3 :images level=3
            p :images-desc intent=muted
          }
          afs-dropzone
        }
      }
    }
  }

  page reader "Read" {
    i18n {
      title { en "Article" zh "文章" }
      desc { en "This surface renders only published post records (status=published). Body remains Markdown at rest and is sanitized at render time." zh "此页面只渲染已发布的文章（status=published）。正文以 Markdown 存储，渲染时经过消毒。" }
      not-found { en "Post not found." zh "文章不存在。" }
      back { en "Back to latest stories" zh "返回最新文章" }
    }
    view gap=lg propBind={post: "/instance/app/arcblog/posts/$params.slug.json"} {
      row gap=sm {
        view reader-back href="/posts" style={cursor: "pointer", color: "var(--color-dim)"} {
          p :back scale=sm
        }
      }
      card gap=md visible="!$state.post" {
        h2 :title level=2
        p :not-found intent=muted
      }
      view reader-article gap=md visible="$state.post" {
        view reader-cover visible="${state.post.coverImage}" style={minHeight: "280px", borderRadius: "var(--radius-lg, 12px)", background: "var(--color-border) url(${state.post.coverImage}) center / cover no-repeat"} {
          text content=" "
        }
        h1 reader-title "${state.post.title}" level=1 scale=display
        row gap=xs cross=center {
          p "${state.post.authorName}" scale=sm intent=muted
          view style={fontSize: "var(--type-small)", color: "var(--color-dim)"} {
            time mode=display value="${state.post.publishedAt}" timeMode=relative
          }
          p "${state.post.category}" scale=sm intent=muted style={textTransform: capitalize}
        }
        text reader-body format=markdown content="${state.post.body}"
      }
    }
  }

  page admin "Creator Studio" {
    i18n {
      admin-archive { en "Archive" zh "归档" }
      admin-archive-msg { en "This writes an archived copy to private drafts. The public post stays live until you remove it from public." zh "这会在私有 drafts 中写入一份 archived 副本。公开文章会继续保留，直到你执行从公开移除。" }
      admin-archive-title { en "Archive this post?" zh "归档这篇文章？" }
      admin-delete { en "Delete" zh "删除" }
      admin-delete-msg { en "The record stays in drafts with status deleted and can be republished later." zh "记录会以 deleted 状态保留在 drafts 中，后续仍可重新发布。" }
      admin-delete-title { en "Soft-delete this record?" zh "软删除这条记录？" }
      admin-publish { en "Publish" zh "发布" }
      admin-publish-msg { en "This publishes the current draft record. Deleted records can be republished." zh "这会发布当前草稿记录。deleted 状态记录也可以重新发布。" }
      admin-publish-title { en "Publish this draft record?" zh "发布这条草稿记录？" }
      admin-unpublish { en "Remove from public" zh "从公开移除" }
      admin-unpublish-msg { en "Archive first keeps a copy in drafts. Removing from public deletes the original from public posts." zh "请先归档以在 drafts 保留副本。从公开移除会删除公开 posts 中的原记录。" }
      admin-unpublish-title { en "Remove this post from public?" zh "将这篇文章从公开移除？" }
      appearance { en "Appearance settings" zh "外观设置" }
      content { en "Your content" zh "你的内容" }
      content-empty { en "Nothing here yet. Write your first post." zh "还没有内容。写下第一篇文章吧。" }
      edit { en "Edit" zh "编辑" }
      gate-desc { en "Sign in with DID Wallet to view node health, Hubs, economy and agent state." zh "使用 DID Wallet 登录后查看节点健康、Hub、经济与 Agent 状态。" }
      gate-title { en "Operations" zh "运维" }
      group-drafts { en "Drafts & archived" zh "草稿与归档" }
      group-published { en "Published" zh "已发布" }
      lifecycle { en "Lifecycle controls" zh "生命周期控制" }
      lifecycle-desc { en "Archive copies a post to the private drafts directory; Remove from public takes it off the public feed. Drafts can be published or soft-deleted from the row actions." zh "归档会把文章复制到私有 drafts 目录；从公开移除会把它从公开 feed 下线。草稿可在行内操作中发布或软删除。" }
      login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      new-post { en "New post" zh "新建文章" }
      studio { en "Your studio" zh "你的工作室" }
      studio-desc { en "Manage drafts, published stories, archived stories, and uploaded media from one wallet-bound workspace." zh "在一个与钱包绑定的工作区中管理草稿、已发布、已归档的文章和已上传的媒体。" }
    }
    card gap=md visible="!$session.authenticated" {
      h2 :gate-title level=2
      p :gate-desc intent=info
      action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dadmin&cancel_to=%2F%3Fpage%3Dadmin" variant=primary label=:login
    }
    row console-shell gap=lg cross=start {
      view console-nav gap=xs size={width: "200px", flexShrink: 0} style={padding: "14px", border: "1px solid var(--color-border)", borderRadius: "var(--radius-lg, 12px)", background: "var(--color-surface)"} visible=$session.authenticated {
        p "$t(wrapper.nav-group-content)" intent=muted scale=caption
        action console-nav-dashboard -> page dashboard label="$t(wrapper.nav-dashboard)"
        action console-nav-admin -> page admin label="$t(wrapper.nav-studio)" variant=primary
        action console-nav-heroes-admin -> page heroes-admin label="$t(wrapper.nav-heroes)"
        p "$t(wrapper.nav-group-ops)" intent=muted scale=caption
        action console-nav-operations -> page operations label="$t(wrapper.nav-operations)"
        action console-nav-ops-admin -> page ops-admin label="$t(wrapper.nav-media-agents)"
        p "$t(wrapper.nav-group-economy)" intent=muted scale=caption
        action console-nav-economy-admin -> page economy-admin label="$t(wrapper.nav-policy-grants)"
      }
      view console-pane gap=lg size={flex: 1} {
        view gap=lg visible=$session.authenticated {
        card gap=md {
          h2 :studio level=2
          p :studio-desc intent=muted
          action -> page compose variant=primary label=:new-post
        }
        card gap=md {
          h3 :lifecycle level=3
          p :lifecycle-desc intent=muted
        }
        row gap=sm {
          action -> page settings variant=secondary size=sm label=:appearance
        }
        h2 :content level=2
        h3 :group-published level=3
        afs-list studio-published layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false emptyText=:content-empty clickMode=none from "/instance/app/arcblog/posts" {
          row studioRow cross=start role=item style={padding: "var(--space-block) 0", borderBottom: "1px solid var(--color-border)"} {
            view studioLink gap=xs href="/posts/${entry.content.slug}" size={flex: 1} style={display: block, textDecoration: none, color: inherit, cursor: pointer, minWidth: 0} {
              h3 "${entry.content.title}"
              row gap=xs cross=center {
                p "${entry.content.status}" scale=sm intent=muted
                p "${entry.content.category}" scale=sm intent=muted style={textTransform: capitalize}
              }
            }
            action studio-archive -> exec "/.actions/write" variant=secondary size=sm label=:admin-archive args={path: "/instance/app/arcblog/drafts/${entry.content.slug}.json", content: {title: "${entry.content.title}", slug: "${entry.content.slug}", summary: "${entry.content.summary}", body: "${entry.content.body}", coverImage: "${entry.content.coverImage}", images: [], tags: "${entry.content.tags}", category: "${entry.content.category}", seoTitle: "${entry.content.seoTitle}", seoDescription: "${entry.content.seoDescription}", ogTitle: "${entry.content.ogTitle}", ogDescription: "${entry.content.ogDescription}", ogImage: "${entry.content.ogImage}", status: archived, authorDid: "${entry.content.authorDid}", authorName: "${entry.content.authorName}", published: false, publishedAt: "${entry.content.publishedAt}", archivedAt: "${generate.timeiso}", deletedAt: "", createdAt: "${entry.content.createdAt}", updatedAt: "${generate.timeiso}", version: 1}} confirm={title: :admin-archive-title, message: :admin-archive-msg} onSuccessToast={intent: success, message: "$t(admin.archived-ok)", duration: 3000}
            action studio-unpublish -> exec "/.actions/delete" variant=destructive size=sm icon=trash label=:admin-unpublish path="/instance/app/arcblog/posts/${entry.content.slug}.json" confirm={title: :admin-unpublish-title, message: :admin-unpublish-msg} onSuccessToast={intent: success, message: "$t(admin.unpublished-ok)", duration: 3000}
          }
        }
        h3 :group-drafts level=3
        afs-list studio-drafts layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false emptyText=:content-empty clickMode=none from "/instance/app/arcblog/drafts" {
          row draftRow cross=start role=item style={padding: "var(--space-block) 0", borderBottom: "1px solid var(--color-border)"} {
            view draftLink gap=xs href="/preview/${entry.content.slug}" size={flex: 1} style={display: block, textDecoration: none, color: inherit, cursor: pointer, minWidth: 0} {
              h3 "${entry.content.title}"
              row gap=xs cross=center {
                p "${entry.content.status}" scale=sm intent=muted
                p "${entry.content.category}" scale=sm intent=muted style={textTransform: capitalize}
              }
            }
            action studio-publish -> exec "/.actions/write" variant=primary size=sm label=:admin-publish args={path: "/instance/app/arcblog/posts/${entry.content.slug}.json", content: {title: "${entry.content.title}", slug: "${entry.content.slug}", summary: "${entry.content.summary}", body: "${entry.content.body}", coverImage: "${entry.content.coverImage}", images: [], tags: "${entry.content.tags}", category: "${entry.content.category}", seoTitle: "${entry.content.seoTitle}", seoDescription: "${entry.content.seoDescription}", ogTitle: "${entry.content.ogTitle}", ogDescription: "${entry.content.ogDescription}", ogImage: "${entry.content.ogImage}", status: published, authorDid: "${entry.content.authorDid}", authorName: "${entry.content.authorName}", published: true, publishedAt: "${generate.timeiso}", archivedAt: "", deletedAt: "", createdAt: "${entry.content.createdAt}", updatedAt: "${generate.timeiso}", version: 1}} confirm={title: :admin-publish-title, message: :admin-publish-msg} onSuccessToast={intent: success, message: "$t(admin.published-ok)", duration: 3000}
            action studio-delete -> exec "/.actions/write" variant=destructive size=sm icon=trash label=:admin-delete args={path: "/instance/app/arcblog/drafts/${entry.content.slug}.json", content: {title: "${entry.content.title}", slug: "${entry.content.slug}", summary: "${entry.content.summary}", body: "${entry.content.body}", coverImage: "${entry.content.coverImage}", images: [], tags: "${entry.content.tags}", category: "${entry.content.category}", seoTitle: "${entry.content.seoTitle}", seoDescription: "${entry.content.seoDescription}", ogTitle: "${entry.content.ogTitle}", ogDescription: "${entry.content.ogDescription}", ogImage: "${entry.content.ogImage}", status: deleted, authorDid: "${entry.content.authorDid}", authorName: "${entry.content.authorName}", published: false, publishedAt: "${entry.content.publishedAt}", archivedAt: "${entry.content.archivedAt}", deletedAt: "${generate.timeiso}", createdAt: "${entry.content.createdAt}", updatedAt: "${generate.timeiso}", version: 1}} confirm={title: :admin-delete-title, message: :admin-delete-msg} onSuccessToast={intent: success, message: "$t(admin.deleted-ok)", duration: 3000}
            view draftEdit href="/edit/${entry.content.slug}" style={display: block, cursor: pointer, color: "var(--color-dim)"} {
              p :edit scale=sm
            }
          }
        }
        }
      }
    }
  }

  page preview "Draft preview" {
    i18n {
      back-home { en "Back to latest stories" zh "返回最新文章" }
      title { en "Preview" zh "预览" }
      notice { en "Draft preview — this record is not public." zh "草稿预览 — 该记录未公开。" }
      not-found { en "Preview not found." zh "预览不存在。" }
      back { en "Back to studio" zh "返回工作室" }
      edit { en "Edit" zh "编辑" }
      preview-publish { en "Publish" zh "发布" }
      published-ok { en "Published." zh "已发布。" }
      published-hint { en "Published. The draft copy is still in studio drafts — remove it when done." zh "已发布。草稿副本仍保留在工作室草稿列表中，可随后删除。" }
      preview-delete { en "Delete draft" zh "删除草稿" }
      preview-delete-title { en "Delete this draft?" zh "删除这篇草稿？" }
      preview-delete-msg { en "The record stays in the archive with status deleted (soft delete)." zh "记录将以 deleted 状态保留（软删除）。" }
      deleted-ok { en "Draft deleted." zh "草稿已删除。" }
    }
    view gap=lg propBind={post: "/instance/app/arcblog/drafts/$params.slug.json"} {
      row gap=sm {
        view preview-back-studio visible=$session.authenticated {
          action preview-back -> page admin variant=ghost label=:back
        }
        view preview-back-home href="/posts" visible="!$session.authenticated" style={cursor: "pointer", color: "var(--color-dim)"} {
          p :back-home
        }
        view preview-edit href="/edit/${state.post.slug}" visible="$state.post" style={cursor: "pointer", color: "var(--color-dim)"} {
          p :edit scale=sm
        }
      }
      card gap=md visible="!$state.post" {
        h2 :title level=2
        p :not-found intent=muted
      }
      view preview-article gap=md visible="$state.post" {
        row gap=sm {
          action preview-publish -> exec "/.actions/write" variant=primary label=:preview-publish args={path: "/instance/app/arcblog/posts/${state.post.slug}.json", content: {title: "${state.post.title}", slug: "${state.post.slug}", summary: "${state.post.summary}", body: "${state.post.body}", coverImage: "${state.post.coverImage}", images: [], tags: "${state.post.tags}", category: "${state.post.category}", seoTitle: "${state.post.seoTitle}", seoDescription: "${state.post.seoDescription}", ogTitle: "${state.post.ogTitle}", ogDescription: "${state.post.ogDescription}", ogImage: "${state.post.ogImage}", status: published, authorDid: "${state.post.authorDid}", authorName: "${state.post.authorName}", published: true, publishedAt: "${generate.timeiso}", archivedAt: "", deletedAt: "", createdAt: "${state.post.createdAt}", updatedAt: "${generate.timeiso}", version: 1}} onSuccessToast={intent: success, message: "$t(preview.published-hint)", duration: 3000}
          action preview-delete -> exec "/.actions/write" variant=destructive label=:preview-delete args={path: "/instance/app/arcblog/drafts/${state.post.slug}.json", content: {title: "${state.post.title}", slug: "${state.post.slug}", summary: "${state.post.summary}", body: "${state.post.body}", coverImage: "${state.post.coverImage}", images: [], tags: "${state.post.tags}", category: "${state.post.category}", seoTitle: "${state.post.seoTitle}", seoDescription: "${state.post.seoDescription}", ogTitle: "${state.post.ogTitle}", ogDescription: "${state.post.ogDescription}", ogImage: "${state.post.ogImage}", status: deleted, authorDid: "${state.post.authorDid}", authorName: "${state.post.authorName}", published: false, publishedAt: "${state.post.publishedAt}", archivedAt: "${state.post.archivedAt}", deletedAt: "${generate.timeiso}", createdAt: "${state.post.createdAt}", updatedAt: "${generate.timeiso}", version: 1}} confirm={title: :preview-delete-title, message: :preview-delete-msg} onSuccessToast={intent: success, message: "$t(preview.deleted-ok)", duration: 3000}
        }
        card gap=sm {
          p :notice intent=info
        }
        view preview-cover visible="$state.post.coverImage" style={minHeight: "280px", borderRadius: "var(--radius-lg, 12px)", background: "var(--color-border) url(${state.post.coverImage}) center / cover no-repeat"} {
          text content=" "
        }
        h1 preview-title "${state.post.title}" level=1 scale=display
        row gap=xs cross=center {
          p "${state.post.status}" scale=sm intent=muted
          p "${state.post.authorName}" scale=sm intent=muted
          p "${state.post.category}" scale=sm intent=muted style={textTransform: capitalize}
        }
        text preview-body format=markdown content="${state.post.body}"
      }
    }
  }

  page about "About" {
    i18n {
      title { en "About ArcBlog" zh "关于 ArcBlog" }
      desc { en "ArcBlog is a Blocklet blog: DID Wallet identity is the author credential, posts are Markdown-first, and images live in the Arc file space." zh "ArcBlog 是一个 Blocklet 博客：DID Wallet 身份即作者凭证，文章以 Markdown 优先，图片存放在 Arc 文件空间中。" }
      lifecycle { en "Lifecycle" zh "生命周期" }
      lifecycle-desc { en "Posts follow a draft → published → archived lifecycle with optimistic concurrency and a full audit trail. Soft deletes keep records recoverable." zh "文章遵循 草稿 → 发布 → 归档 的生命周期，带乐观并发控制和完整审计日志。软删除保证记录可恢复。" }
      rss { en "Subscribe via RSS" zh "订阅 RSS" }
    }
    view gap=lg {
      card gap=md {
        h2 :title level=2
        p :desc
      }
      card gap=md {
        h3 :lifecycle level=3
        p :lifecycle-desc intent=muted
      }
      action -> navigate "/p/rss.xml" variant=secondary label=:rss
    }
  }

  page dashboard "Dashboard" {
    i18n {
      gate-title { en "Dashboard" zh "仪表盘" }
      gate-desc { en "Sign in with DID Wallet to view node identity, roles, taxonomy and operations data." zh "使用 DID Wallet 登录后查看节点身份、角色、分类与运营数据。" }
      login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      title { en "Dashboard" zh "仪表盘" }
      desc { en "Node identity, roles, taxonomy and recent activity for this ArcBlog instance." zh "本 ArcBlog 实例的节点身份、角色、分类与近期动态。" }
      node { en "Node" zh "节点" }
      node-empty { en "No node profile yet. Run: node scripts/arcblog-node.mjs init" zh "还没有节点档案。运行：node scripts/arcblog-node.mjs init" }
      roles-label { en "Roles" zh "角色" }
      capabilities-label { en "Capabilities" zh "能力" }
      content { en "Recent published" zh "最近发布" }
      content-empty { en "No published stories yet." zh "还没有已发布的文章。" }
      quick { en "Quick actions" zh "快捷操作" }
      q-write { en "Write a post" zh "写文章" }
      q-studio { en "Creator Studio" zh "创作者工作室" }
      q-settings { en "Appearance" zh "外观" }
      q-ops { en "Operations" zh "运维" }
    }
    card gap=md visible="!$session.authenticated" {
      h2 :gate-title level=2
      p :gate-desc intent=info
      action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Ddashboard&cancel_to=%2F%3Fpage%3Ddashboard" variant=primary label=:login
    }
    row console-shell gap=lg cross=start visible=$session.authenticated {
      view console-nav gap=xs size={width: "200px", flexShrink: 0} style={padding: "14px", border: "1px solid var(--color-border)", borderRadius: "var(--radius-lg, 12px)", background: "var(--color-surface)"} visible=$session.authenticated {
        p "$t(wrapper.nav-group-content)" intent=muted scale=caption
        action console-nav-dashboard -> page dashboard label="$t(wrapper.nav-dashboard)" variant=primary
        action console-nav-admin -> page admin label="$t(wrapper.nav-studio)"
        action console-nav-heroes-admin -> page heroes-admin label="$t(wrapper.nav-heroes)"
        p "$t(wrapper.nav-group-ops)" intent=muted scale=caption
        action console-nav-operations -> page operations label="$t(wrapper.nav-operations)"
        action console-nav-ops-admin -> page ops-admin label="$t(wrapper.nav-media-agents)"
        p "$t(wrapper.nav-group-economy)" intent=muted scale=caption
        action console-nav-economy-admin -> page economy-admin label="$t(wrapper.nav-policy-grants)"
      }
      view console-pane gap=lg size={flex: 1} {
      card gap=md {
        h1 :title level=1
        p :desc intent=muted
      }
      card gap=md {
        h2 :node level=2
        afs-list dash-node layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false clickMode=none emptyText=:node-empty from "/instance/app/arcblog/node" {
          row dashNodeRow role=item gap=xs {
            h3 "${entry.content.name}"
            p "${entry.content.did}" scale=sm intent=muted
            p "${entry.content.version}" scale=sm intent=muted
            p :roles-label scale=sm intent=muted
            p "${entry.content.roles}" scale=sm
            p :capabilities-label scale=sm intent=muted
            p "${entry.content.capabilities}" scale=sm
          }
        }
      }
      card gap=md {
        h2 :content level=2
        afs-list dash-published layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false clickMode=none pageSize=5 emptyText=:content-empty from "/instance/app/arcblog/posts" {
          row dashPostRow role=item gap=xs {
            view dashPostLink href="/posts/${entry.content.slug}" style={display: block, textDecoration: none, color: inherit} {
              h3 "${entry.content.title}"
            }
            p "${entry.content.category}" scale=sm intent=muted
          }
        }
      }
      card gap=md {
        h2 :quick level=2
        row gap=sm {
          action -> page compose variant=primary label=:q-write
          action -> page admin variant=secondary label=:q-studio
          action -> page operations variant=secondary label=:q-ops
          action -> page settings variant=ghost label=:q-settings
        }
      }
    }
      }
  }

  page operations "Operations" {
    i18n {
      desc { en "Live state of this node: health, discovery, Hubs, economy, media and agent grants." zh "本节点实时状态：健康、发现、Hub、经济、媒体与 Agent 授权。" }
      discovery { en "Discovery document" zh "发现文档" }
      discovery-empty { en "How to publish it: node scripts/arcblog-network.mjs discovery publish" zh "如何发布：node scripts/arcblog-network.mjs discovery publish" }
      discovery-generated { en "Generated" zh "生成于" }
      discovery-protocol { en "Protocol" zh "协议" }
      discovery-transport { en "Transport" zh "传输" }
      gate-desc { en "Sign in with DID Wallet to view node health, Hubs, economy and agent state." zh "使用 DID Wallet 登录后查看节点健康、Hub、经济与 Agent 状态。" }
      gate-title { en "Operations" zh "运维" }
      health { en "Node health" zh "节点健康" }
      health-checked { en "Checked" zh "检查于" }
      health-did { en "DID" zh "DID" }
      health-status { en "Status" zh "状态" }
      health-version { en "Blocklet version" zh "Blocklet 版本" }
      hub-endpoint { en "Endpoint" zh "端点" }
      hub-sync { en "Last sync" zh "最近同步" }
      hub-version { en "Last version" zh "最后版本" }
      hubs { en "Registered Hubs" zh "已注册 Hub" }
      hubs-empty { en "How to add one: node scripts/arcblog-network.mjs hub register --hub-did <did>" zh "如何添加：node scripts/arcblog-network.mjs hub register --hub-did <did>" }
      login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      title { en "Operations" zh "运维" }
    }
    card gap=md visible="!$session.authenticated" {
      h2 :gate-title level=2
      p :gate-desc intent=info
      action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Doperations&cancel_to=%2F%3Fpage%3Doperations" variant=primary label=:login
    }
    row console-shell gap=lg cross=start {
      view console-nav gap=xs size={width: "200px", flexShrink: 0} style={padding: "14px", border: "1px solid var(--color-border)", borderRadius: "var(--radius-lg, 12px)", background: "var(--color-surface)"} visible=$session.authenticated {
        p "$t(wrapper.nav-group-content)" intent=muted scale=caption
        action console-nav-dashboard -> page dashboard label="$t(wrapper.nav-dashboard)"
        action console-nav-admin -> page admin label="$t(wrapper.nav-studio)"
        action console-nav-heroes-admin -> page heroes-admin label="$t(wrapper.nav-heroes)"
        p "$t(wrapper.nav-group-ops)" intent=muted scale=caption
        action console-nav-operations -> page operations label="$t(wrapper.nav-operations)" variant=primary
        action console-nav-ops-admin -> page ops-admin label="$t(wrapper.nav-media-agents)"
        p "$t(wrapper.nav-group-economy)" intent=muted scale=caption
        action console-nav-economy-admin -> page economy-admin label="$t(wrapper.nav-policy-grants)"
      }
      view console-pane gap=lg size={flex: 1} {
        view gap=lg visible=$session.authenticated {
      card gap=md {
        h1 :title level=1
        p :desc intent=muted
      }
      card gap=md propBind={health: "/instance/app/arcblog/node/health.json"} {
        h2 :health level=2
        p :health-status scale=sm intent=muted
        p "${state.health.status}" scale=sm
        p :health-version scale=sm intent=muted
        p "${state.health.version}" scale=sm
        p :health-did scale=sm intent=muted
        p "${state.health.did}" scale=sm
        p :health-checked scale=sm intent=muted
        time mode=display value="${state.health.checkedAt}" timeMode=relative
      }
      card gap=md propBind={discovery: "/instance/app/arcblog/node/discovery.json"} {
        h2 :discovery level=2
        row opsDiscoveryRow gap=xs {
          p :discovery-protocol scale=sm intent=muted
          p "${state.discovery.protocol}" scale=sm
          p :discovery-transport scale=sm intent=muted
          p "${state.discovery.transport}" scale=sm
          p :discovery-generated scale=sm intent=muted
          time mode=display value="${state.discovery.generatedAt}" timeMode=relative
        }
        p :discovery-empty scale=sm intent=muted
      }
      card gap=md {
        h2 :hubs level=2
          afs-list ops-hubs layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false clickMode=none emptyText=:hubs-empty transform={syncAt: "content.sync.lastSync", syncVersion: "content.sync.lastVersion"} from "/instance/app/arcblog/hub/registrations" {
            row opsHubRow role=item gap=xs {
              h3 "${entry.content.hubDid}"
              p :hub-endpoint scale=sm intent=muted
              p "${entry.content.endpoint}" scale=sm
              p :hub-sync scale=sm intent=muted
              p "${entry.content.syncAt}" scale=sm
              p :hub-version scale=sm intent=muted
              p "${entry.content.syncVersion}" scale=sm
            }
          }
        p :hubs-empty scale=sm intent=muted
      }
        }
      }
    }
  }

  page heroes-admin "Heroes & categories" {
    i18n {
      cat-add { en "Add category" zh "添加分类" }
      cat-desc { en "Taxonomy used by the publish validator and the public feed." zh "发布校验器与公开信息流使用的分类法。" }
      cat-empty { en "No categories yet." zh "还没有分类。" }
      cat-f-desc { en "Description" zh "描述" }
      cat-f-name { en "Name" zh "名称" }
      cat-f-slug { en "Slug" zh "标识（slug）" }
      cat-remove { en "Remove" zh "删除" }
      cat-remove-msg { en "Existing posts keep their category text, but the publish validator will reject it afterwards." zh "已有文章会保留其分类文本，但发布校验器之后会拒绝该分类。" }
      cat-remove-title { en "Remove this category?" zh "删除该分类？" }
      cat-slug-hint { en "Lowercase letters, digits and hyphens, e.g. technology." zh "小写字母、数字与连字符，例如 technology。" }
      cat-title { en "Categories" zh "分类" }
      content-empty { en "Nothing here yet. Write your first post." zh "还没有内容。写下第一篇文章吧。" }
      desc { en "Home carousel slides and the post taxonomy." zh "首页轮播与文章分类。" }
      gate-desc { en "Sign in with DID Wallet to view node health, Hubs, economy and agent state." zh "使用 DID Wallet 登录后查看节点健康、Hub、经济与 Agent 状态。" }
      gate-title { en "Operations" zh "运维" }
      hero-add { en "Add hero" zh "添加 Hero" }
      hero-admin { en "Hero management" zh "Hero 管理" }
      hero-admin-desc { en "Heroes render as the homepage carousel. Each record needs a title, an image URL, and a target link; sort orders the slides ascending." zh "Hero 显示为首页轮播。每条记录需要标题、图片 URL 和跳转链接；sort 按升序决定播放顺序。" }
      hero-delete { en "Delete" zh "删除" }
      hero-delete-msg { en "This removes the hero record permanently." zh "将永久删除该 Hero 记录。" }
      hero-delete-title { en "Delete hero?" zh "删除 Hero？" }
      hero-dropzone-desc { en "Upload an image here, then paste the resulting URL into the form above." zh "把图片拖到这里上传，把得到的 URL 粘贴到上面的表单。" }
      hero-f-desc { en "Description" zh "描述" }
      hero-f-image { en "Image URL" zh "图片 URL" }
      hero-f-sort { en "Sort order" zh "排序" }
      hero-f-title { en "Title" zh "标题" }
      hero-f-url { en "Link URL" zh "链接 URL" }
      hero-form { en "Add hero" zh "添加 Hero" }
      hero-id { en "ID (slug)" zh "ID（slug）" }
      hero-id-hint { en "Lowercase letters, numbers and dashes; same ID overwrites." zh "小写字母、数字和连字符；相同 ID 会覆盖。" }
      hero-list-empty { en "No heroes yet." zh "还没有 Hero。" }
      hero-quickadd { en "Add to hero" zh "加入 Hero" }
      hero-quickadd-hint { en "Click a post row to stage it below, then confirm. Title, summary, cover and /posts/<slug> link are copied automatically." zh "点击文章行将其暂存到下方，确认后加入。自动带标题、摘要、封面和 /posts/<slug> 链接。" }
      hero-quickadd-title { en "Quick add from a post" zh "从文章快速加入" }
      login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      title { en "Heroes & categories" zh "Hero 与分类" }
    }
    card gap=md visible="!$session.authenticated" {
      h2 :gate-title level=2
      p :gate-desc intent=info
      action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dheroes-admin&cancel_to=%2F%3Fpage%3Dheroes-admin" variant=primary label=:login
    }
    row console-shell gap=lg cross=start {
      view console-nav gap=xs size={width: "200px", flexShrink: 0} style={padding: "14px", border: "1px solid var(--color-border)", borderRadius: "var(--radius-lg, 12px)", background: "var(--color-surface)"} visible=$session.authenticated {
        p "$t(wrapper.nav-group-content)" intent=muted scale=caption
        action console-nav-dashboard -> page dashboard label="$t(wrapper.nav-dashboard)"
        action console-nav-admin -> page admin label="$t(wrapper.nav-studio)"
        action console-nav-heroes-admin -> page heroes-admin label="$t(wrapper.nav-heroes)" variant=primary
        p "$t(wrapper.nav-group-ops)" intent=muted scale=caption
        action console-nav-operations -> page operations label="$t(wrapper.nav-operations)"
        action console-nav-ops-admin -> page ops-admin label="$t(wrapper.nav-media-agents)"
        p "$t(wrapper.nav-group-economy)" intent=muted scale=caption
        action console-nav-economy-admin -> page economy-admin label="$t(wrapper.nav-policy-grants)"
      }
      view console-pane gap=lg size={flex: 1} {
        view gap=lg visible=$session.authenticated {
        card gap=md {
          h1 :title level=1
          p :desc intent=muted
        }
        h2 :hero-admin level=2
        card gap=md {
          p :hero-admin-desc intent=muted
        }
        afs-list hero-admin-list layout=grid itemStyle=card subscribe=true showBreadcrumb=false showParent=false emptyText=:hero-list-empty clickMode=none sort={preset: heroOrder, presets: {heroOrder: {field: "content.sort", desc: false}}} transform={label: "content.title", description: "content.description", image: "content.image"} from "/instance/app/arcblog/heroes" {
          row heroAdminRow role=item {
            action hero-delete -> exec "/.actions/delete" variant=destructive size=sm icon=trash label=:hero-delete path="${entry.path}" confirm={title: :hero-delete-title, message: :hero-delete-msg} onSuccessToast={intent: success, message: "$t(admin.hero-deleted)", duration: 2500}
          }
        }
        card gap=md {
          h3 :hero-form level=3
          input type=text label=:hero-id name=heroId required=true state={value: ""}
          p :hero-id-hint intent=muted scale=caption
          input type=text label=:hero-f-title name=heroTitle required=true state={value: ""}
          input type=text label=:hero-f-desc name=heroDesc state={value: ""}
          input type=text label=:hero-f-image name=heroImage required=true state={value: ""}
          input type=text label=:hero-f-url name=heroUrl required=true state={value: ""}
          input type=text label=:hero-f-sort name=heroSort state={value: "0"}
          action hero-add -> exec "/.actions/write" variant=primary label=:hero-add args={path: "/instance/app/arcblog/heroes/${args.heroId}.json", content: {title: "${args.heroTitle}", description: "${args.heroDesc}", image: "${args.heroImage}", url: "${args.heroUrl}", sort: "${args.heroSort}", createdAt: "${generate.timeiso}"}} onSuccessToast={intent: success, message: "$t(admin.hero-added)", duration: 2500}
        }
        card gap=md {
          p :hero-dropzone-desc intent=muted
        }
        afs-dropzone
        h3 :hero-quickadd-title level=3
        p :hero-quickadd-hint intent=muted scale=caption
        afs-list hero-quickadd-list layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false emptyText=:content-empty clickMode=select autoSelect=false selectAlwaysFires=true events={select: [{target: qa-title, set: {state: {value: $args.item.title}}}, {target: qa-desc, set: {state: {value: $args.item.summary}}}, {target: qa-image, set: {state: {value: $args.item.coverImage}}}, {target: qa-slug, set: {state: {value: $args.item.slug}}}]} from "/instance/app/arcblog/posts" {
          row heroPostRow cross=center role=item style={padding: "var(--space-block) 0", borderBottom: "1px solid var(--color-border)"} {
            view gap=xs size={flex: 1} style={minWidth: 0} {
              h3 "${entry.content.title}"
              row gap=xs cross=center {
                p "${entry.content.category}" scale=sm intent=muted style={textTransform: capitalize}
                p "${entry.content.coverImage}" scale=sm intent=muted
              }
            }
          }
        }
        view gap=sm {
          input qa-title type=hidden name=qaTitle state={value: ""}
          input qa-desc type=hidden name=qaDesc state={value: ""}
          input qa-image type=hidden name=qaImage state={value: ""}
          input qa-slug type=hidden name=qaSlug state={value: ""}
          action hero-quickadd-confirm -> exec "/.actions/write" variant=secondary size=sm label=:hero-quickadd args={path: "/instance/app/arcblog/heroes/${args.qaSlug}.json", content: {title: "${args.qaTitle}", description: "${args.qaDesc}", image: "${args.qaImage}", url: "/posts/${args.qaSlug}", sort: "0", createdAt: "${generate.timeiso}"}} onSuccessToast={intent: success, message: "$t(admin.hero-quickadded)", duration: 2500}
        }
        card gap=md {
          h3 :cat-title level=3
          p :cat-desc intent=muted
          afs-list studio-categories layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false clickMode=none emptyText=:cat-empty from "/instance/app/arcblog/categories" {
            row studioCategoryRow cross=center role=item style={padding: "var(--space-block) 0", borderBottom: "1px solid var(--color-border)"} {
              view gap=xs size={flex: 1} style={minWidth: 0} {
                h3 "${entry.content.name}"
                p "${entry.content.slug}" scale=sm intent=muted
                p "${entry.content.description}" scale=sm intent=muted
              }
              action cat-remove -> exec "/.actions/delete" variant=destructive size=sm icon=trash label=:cat-remove path="/instance/app/arcblog/categories/${entry.content.slug}.json" confirm={title: :cat-remove-title, message: :cat-remove-msg} onSuccessToast={intent: success, message: "$t(admin.cat-removed)", duration: 2500}
            }
          }
          input type=text label=:cat-f-slug name=catSlug required=true state={value: ""}
          p :cat-slug-hint intent=muted scale=caption
          input type=text label=:cat-f-name name=catName required=true state={value: ""}
          input type=text label=:cat-f-desc name=catDesc state={value: ""}
          action cat-add -> exec "/.actions/write" variant=primary label=:cat-add args={path: "/instance/app/arcblog/categories/${args.catSlug}.json", content: {slug: "${args.catSlug}", name: "${args.catName}", description: "${args.catDesc}", sort: "0", createdAt: "${generate.timeiso}", updatedAt: "${generate.timeiso}"}} onSuccessToast={intent: success, message: "$t(admin.cat-added)", duration: 2500}
        }
        }
      }
    }
  }

  page ops-admin "Media & agents" {
    i18n {
      admin-only { en "Sign in as an administrator to see this list." zh "以管理员身份登录后可见该列表。" }
      agent-closed { en "Default-closed (spec §130): settle_payment, change_wallet, change_role never run from the agent surface." zh "默认关闭（spec §130）：settle_payment、change_wallet、change_role 永不从 Agent 面执行。" }
      agent-expires { en "Expires" zh "到期" }
      agent-grants { en "Agent capability grants" zh "Agent 能力授权" }
      agent-grants-empty { en "How to grant one: node scripts/arcblog-agent.mjs authorize --agent <did> --capability agent.write --ttl 30" zh "如何授权：node scripts/arcblog-agent.mjs authorize --agent <did> --capability agent.write --ttl 30" }
      desc { en "The media index and the Agent capability grants." zh "媒体索引与 Agent 能力授权。" }
      gate-desc { en "Sign in with DID Wallet to view node health, Hubs, economy and agent state." zh "使用 DID Wallet 登录后查看节点健康、Hub、经济与 Agent 状态。" }
      gate-title { en "Operations" zh "运维" }
      login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      media { en "Media index" zh "媒体索引" }
      media-empty { en "How to add one: node scripts/arcblog-media.mjs add" zh "如何添加：node scripts/arcblog-media.mjs add" }
      mutations { en "This console reports state only. Value-bearing mutations (settlement, wallets, roles, payments) stay deliberate CLI actions with a DID session." zh "本页只报告状态。涉及价值的写操作（结算、钱包、角色、支付）仍是需要 DID 会话的显式 CLI 动作。" }
      title { en "Media & agents" zh "媒体与 Agent" }
    }
    card gap=md visible="!$session.authenticated" {
      h2 :gate-title level=2
      p :gate-desc intent=info
      action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dops-admin&cancel_to=%2F%3Fpage%3Dops-admin" variant=primary label=:login
    }
    row console-shell gap=lg cross=start {
      view console-nav gap=xs size={width: "200px", flexShrink: 0} style={padding: "14px", border: "1px solid var(--color-border)", borderRadius: "var(--radius-lg, 12px)", background: "var(--color-surface)"} visible=$session.authenticated {
        p "$t(wrapper.nav-group-content)" intent=muted scale=caption
        action console-nav-dashboard -> page dashboard label="$t(wrapper.nav-dashboard)"
        action console-nav-admin -> page admin label="$t(wrapper.nav-studio)"
        action console-nav-heroes-admin -> page heroes-admin label="$t(wrapper.nav-heroes)"
        p "$t(wrapper.nav-group-ops)" intent=muted scale=caption
        action console-nav-operations -> page operations label="$t(wrapper.nav-operations)"
        action console-nav-ops-admin -> page ops-admin label="$t(wrapper.nav-media-agents)" variant=primary
        p "$t(wrapper.nav-group-economy)" intent=muted scale=caption
        action console-nav-economy-admin -> page economy-admin label="$t(wrapper.nav-policy-grants)"
      }
      view console-pane gap=lg size={flex: 1} {
        view gap=lg visible=$session.authenticated {
        card gap=md {
          h1 :title level=1
          p :desc intent=muted
        }
      card gap=md {
        h2 :media level=2
        p :admin-only scale=sm intent=muted visible="!$session.authenticated"
        view ops-media-gate visible=$session.authenticated {
          afs-list ops-media layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false clickMode=none emptyText=:media-empty from "/instance/app/arcblog/media" {
            row opsMediaRow role=item gap=xs {
              h3 "${entry.content.id}"
              p "${entry.content.mimeType}" scale=sm intent=muted
            }
          }
        }
        p :media-empty scale=sm intent=muted
      }
      card gap=md {
        h2 :agent-grants level=2
        p :admin-only scale=sm intent=muted visible="!$session.authenticated"
        view ops-agent-gate visible=$session.authenticated {
          afs-list ops-agent layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false clickMode=none emptyText=:agent-grants-empty from "/instance/app/arcblog/config/agent-grants" {
            row opsAgentRow role=item gap=xs {
              h3 "${entry.content.agentDid}"
              p "${entry.content.capabilities}" scale=sm
              p :agent-expires scale=sm intent=muted
              p "${entry.content.expiresAt}" scale=sm
            }
          }
        }
        p :agent-grants-empty scale=sm intent=muted
        p :agent-closed scale=sm intent=muted
        p :mutations scale=sm intent=muted
      }
        }
      }
    }
  }

  page economy-admin "Policy & access" {
    i18n {
      admin-only { en "Sign in as an administrator to see this list." zh "以管理员身份登录后可见该列表。" }
      desc { en "The split policy, the products and the access grants." zh "分成策略、商品与访问授权。" }
      gate-desc { en "Sign in with DID Wallet to view node health, Hubs, economy and agent state." zh "使用 DID Wallet 登录后查看节点健康、Hub、经济与 Agent 状态。" }
      gate-title { en "Operations" zh "运维" }
      grant-reader { en "Reader" zh "读者" }
      grants { en "Access grants" zh "访问授权" }
      grants-empty { en "Created automatically when a paid reading order settles." zh "付费阅读订单结算后自动生成。" }
      login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      policy { en "Settlement policy" zh "结算策略" }
      policy-adapter { en "Payment adapter" zh "支付适配器" }
      policy-empty { en "How to set it: node scripts/arcblog-economy.mjs policy init" zh "如何设置：node scripts/arcblog-economy.mjs policy init" }
      policy-split { en "Split (creator / hub / protocol)" zh "分成（创作者 / Hub / 协议）" }
      product-price { en "Price" zh "价格" }
      products { en "Products" zh "商品" }
      products-empty { en "How to add one: node scripts/arcblog-economy.mjs product add --id <id> --creator-did <did> --price-amount <n>" zh "如何添加：node scripts/arcblog-economy.mjs product add --id <id> --creator-did <did> --price-amount <n>" }
      title { en "Policy & access" zh "策略与授权" }
    }
    card gap=md visible="!$session.authenticated" {
      h2 :gate-title level=2
      p :gate-desc intent=info
      action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Deconomy-admin&cancel_to=%2F%3Fpage%3Deconomy-admin" variant=primary label=:login
    }
    row console-shell gap=lg cross=start {
      view console-nav gap=xs size={width: "200px", flexShrink: 0} style={padding: "14px", border: "1px solid var(--color-border)", borderRadius: "var(--radius-lg, 12px)", background: "var(--color-surface)"} visible=$session.authenticated {
        p "$t(wrapper.nav-group-content)" intent=muted scale=caption
        action console-nav-dashboard -> page dashboard label="$t(wrapper.nav-dashboard)"
        action console-nav-admin -> page admin label="$t(wrapper.nav-studio)"
        action console-nav-heroes-admin -> page heroes-admin label="$t(wrapper.nav-heroes)"
        p "$t(wrapper.nav-group-ops)" intent=muted scale=caption
        action console-nav-operations -> page operations label="$t(wrapper.nav-operations)"
        action console-nav-ops-admin -> page ops-admin label="$t(wrapper.nav-media-agents)"
        p "$t(wrapper.nav-group-economy)" intent=muted scale=caption
        action console-nav-economy-admin -> page economy-admin label="$t(wrapper.nav-policy-grants)" variant=primary
      }
      view console-pane gap=lg size={flex: 1} {
        view gap=lg visible=$session.authenticated {
        card gap=md {
          h1 :title level=1
          p :desc intent=muted
        }
      card gap=md propBind={policy: "/instance/app/arcblog/economy/policies/active.json"} {
        h2 :policy level=2
        row opsPolicyRow gap=xs {
          p :policy-split scale=sm intent=muted
          p "${state.policy.creator} / ${state.policy.hub} / ${state.policy.protocol}" scale=sm
          p :policy-adapter scale=sm intent=muted
          p "${state.policy.paymentAdapter}" scale=sm
        }
        p :policy-empty scale=sm intent=muted
      }
      card gap=md {
        h2 :products level=2
          afs-list ops-products layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false clickMode=none emptyText=:products-empty from "/instance/app/arcblog/economy/products" {
            row opsProductRow role=item gap=xs {
              h3 "${entry.content.id}"
              p :product-price scale=sm intent=muted
              p "${entry.content.priceAmount}" scale=sm
            }
          }
        p :products-empty scale=sm intent=muted
      }
      card gap=md {
        h2 :grants level=2
        p :admin-only scale=sm intent=muted visible="!$session.authenticated"
        view ops-grants-gate visible=$session.authenticated {
          afs-list ops-grants layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false clickMode=none emptyText=:grants-empty from "/instance/app/arcblog/economy/access-grants" {
            row opsGrantRow role=item gap=xs {
              p "${entry.content.contentId}" scale=sm
              p :grant-reader scale=sm intent=muted
              p "${entry.content.readerDid}" scale=sm
            }
          }
        }
        p :grants-empty scale=sm intent=muted
      }
        }
      }
    }
  }

  page author "Author" {
    i18n {
      title { en "Author" zh "作者" }
      desc { en "Who publishes here: this node's DID-bound author identity." zh "谁在这里发布：与本节点 DID 绑定的作者身份。" }
      did { en "DID" zh "DID" }
      auth { en "Auth method" zh "认证方式" }
      roles { en "Roles" zh "角色" }
      stories { en "Stories" zh "文章" }
      stories-empty { en "No published stories yet." zh "还没有已发布的文章。" }
    }
    view gap=lg propBind={profile: "/instance/app/arcblog/node/profile.json", identity: "/instance/app/arcblog/node/identity.json"} {
      card gap=md {
        h1 "${state.profile.name}" level=1
        p "${state.profile.description}" intent=muted
        p :did scale=sm intent=muted
        p "${state.profile.did}" scale=sm
        p :auth scale=sm intent=muted
        p "${state.identity.authMethod}" scale=sm
        p :roles scale=sm intent=muted
        p "${state.profile.roles}" scale=sm
      }
      card gap=md {
        h2 :stories level=2
        afs-list author-posts layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false clickMode=none emptyText=:stories-empty from "/instance/app/arcblog/posts" {
          row authorPostRow role=item gap=xs {
            view authorPostLink href="/posts/${entry.content.slug}" style={display: block, textDecoration: none, color: inherit} {
              h3 "${entry.content.title}"
            }
            p "${entry.content.summary}" scale=sm intent=muted
          }
        }
      }
    }
  }
}
