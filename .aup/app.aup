      pages-admin-login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      pages-admin-offline-hint { en "Offline pages are admin-only. Bring one online when it is ready." zh "离线页面仅后台可见；准备好后点击「上线」。" }
      pages-admin-offline-list { en "Offline" zh "已下线" }
