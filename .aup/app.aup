      view console-pane gap=md size={flex: 1} style={paddingTop: "14px", paddingBottom: "14px", minHeight: 0} {
      view console-sections mode=tabs size={flex: 1} style={height: "100%", minHeight: 0} {
      view console-section-dashboard label="Dashboard" style={height: "100%", minHeight: 0} propBind={nodeProfile: "/instance/app/arcblog/node/profile.json", nodeHealth: "/instance/app/arcblog/node/health.json"} {
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px"} {
        h2 :dashboard-title level=2 style={fontSize: "var(--type-subheading)"}
        p :dashboard-desc intent=muted
      }
      view console-scroll-dashboard gap=sm size={flex: 1} style={overflowY: "auto"} {
      view console-grid-dashboard style={display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(520px, 1fr))", gap: "14px", flexShrink: 0, alignItems: "start"} {
      view gap=sm visible="${state.nodeProfile}" style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px", flexShrink: 0} {
        row gap=sm cross=center {
          h3 "${state.nodeProfile.name}"
          p "${state.nodeProfile.did}" scale=sm intent=muted style={fontFamily: "monospace"}
          p "v${state.nodeProfile.version}" scale=sm intent=muted
          row gap=xs cross=center visible="${state.nodeHealth}" {
            p "●" intent=success scale=sm
            p "${state.nodeHealth.status}" scale=sm
          }
        }
        row gap=sm cross=center {
          p :dashboard-roles-label scale=sm intent=muted
          p "${state.nodeProfile.roles}" scale=sm
          p :dashboard-capabilities-label scale=sm intent=muted
          p "${state.nodeProfile.capabilities}" scale=sm
        }
      }
      view gap=sm visible="!${state.nodeProfile}" style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px", flexShrink: 0} {
        p :dashboard-node-empty intent=info
      }
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px", flexShrink: 0} {
        h2 :dashboard-content level=2 style={fontSize: "var(--type-body)"}
        afs-list dash-published layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none pageSize=5 emptyText=:dashboard-content-empty from "/instance/app/arcblog/posts" {
          row dashPostRow role=item gap=xs style={background: "transparent", borderBottom: "1px solid var(--color-border)", padding: "8px 0"} {
            view dashPostLink layout=inline href="/posts/${entry.content.slug}" target=_blank style={display: block, textDecoration: none, color: inherit} {
              h3 "${entry.content.title}" style={fontSize: "var(--type-body)"}
            }
            row gap=xs cross=center {
              p "${entry.content.category}" scale=sm intent=muted
              view style={fontSize: "var(--type-small)", color: "var(--color-dim)"} {
                time mode=display value="${entry.content.publishedAt}" timeMode=relative
              }
            }
          }
        }
      }
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px", flexShrink: 0} {
        h2 :dashboard-economy level=2 style={fontSize: "var(--type-body)"}
        afs-list dash-orders layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none pageSize=5 emptyText=:dashboard-economy-empty from "/instance/app/arcblog/economy/orders" {
          row dashOrderRow role=item gap=xs style={background: "transparent", borderBottom: "1px solid var(--color-border)", padding: "8px 0"} {
            h3 "${entry.content.id}"
            p "${entry.content.amount} ${entry.content.asset}" scale=sm
            p "${entry.content.status}" scale=sm intent=muted
          }
        }
      }
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px", flexShrink: 0} {
        h2 :dashboard-agents level=2 style={fontSize: "var(--type-body)"}
        afs-list dash-agents layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none pageSize=5 emptyText=:dashboard-agents-empty from "/instance/app/arcblog/config/agent-grants" {
          row dashAgentRow role=item gap=xs style={background: "transparent", borderBottom: "1px solid var(--color-border)", padding: "8px 0"} {
            p "${entry.content.agentDid}" scale=sm style={fontFamily: "monospace"}
            p "${entry.content.capabilities}" scale=sm intent=muted
          }
        }
      }
      }
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px", flexShrink: 0} {
        h2 :dashboard-quick level=2 style={fontSize: "var(--type-body)"}
        row gap=sm {
          action dashboard-out-compose href="#compose" variant=primary label=:dashboard-q-write style={borderRadius: "var(--radius-md, 8px)"}
          action dashboard-q-studio href="#admin" variant=secondary label=:dashboard-q-studio style={borderRadius: "var(--radius-md, 8px)"}
          action dashboard-q-ops href="#operations" variant=secondary label=:dashboard-q-ops style={borderRadius: "var(--radius-md, 8px)"}
          action dashboard-out-settings href="#appearance" variant=ghost label=:dashboard-q-settings style={borderRadius: "var(--radius-md, 8px)"}
        }
      }
    }
      }
      view console-section-admin label="Posts" style={height: "100%", minHeight: 0} {
        view gap=lg visible=$session.authenticated style={height: "100%", minHeight: 0} {
        row gap=md cross=center style={justifyContent: "space-between"} {
          view gap=xs {
            h2 :admin-studio level=2 style={fontSize: "var(--type-subheading)"}
            p :admin-studio-desc intent=muted
          }
          action admin-out-compose href="#compose" variant=primary label=:admin-new-post style={borderRadius: "var(--radius-md, 8px)"}
        }
        view console-scroll-admin gap=sm size={flex: 1} style={overflowY: "auto"} {
        view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px", flexShrink: 0} {
          h3 :admin-lifecycle level=3 style={fontSize: "var(--type-body)"}
          p :admin-lifecycle-desc intent=muted
          row console-action-row-1 cross=start {
          action admin-out-settings href="#appearance" variant=secondary size=sm label=:admin-appearance style={borderRadius: "var(--radius-md, 8px)"}
          }
        }
        view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px", flexShrink: 0} {
        h2 :admin-content level=2 style={fontSize: "var(--type-body)"}
        h3 :admin-group-published level=3 style={fontSize: "var(--type-body)"}
        afs-list studio-published layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false emptyText=:admin-content-empty autoSelect=false clickMode=none from "/instance/app/arcblog/posts" style={flexShrink: 0} {
          row studioRow cross=start role=item style={background: "transparent", padding: "8px 0", borderBottom: "1px solid var(--color-border)"} {
            view studioLink gap=xs layout=inline href="/posts/${entry.content.slug}" target=_blank size={flex: 1} style={display: block, textDecoration: none, color: inherit, cursor: pointer, minWidth: 0} {
              h3 "${entry.content.title}" style={fontSize: "var(--type-body)"}
              row gap=xs cross=center {
                p "${entry.content.status}" scale=sm intent=muted
                p "${entry.content.category}" scale=sm intent=muted style={textTransform: capitalize}
              }
            }
            action studio-archive -> exec "/.actions/write" variant=secondary size=sm label=:admin-admin-archive args={path: "/instance/app/arcblog/drafts/${entry.content.slug}.json", content: {title: "${entry.content.title}", slug: "${entry.content.slug}", summary: "${entry.content.summary}", body: "${entry.content.body}", coverImage: "${entry.content.coverImage}", images: [], tags: "${entry.content.tags}", category: "${entry.content.category}", seoTitle: "${entry.content.seoTitle}", seoDescription: "${entry.content.seoDescription}", ogTitle: "${entry.content.ogTitle}", ogDescription: "${entry.content.ogDescription}", ogImage: "${entry.content.ogImage}", status: archived, authorDid: "${entry.content.authorDid}", authorName: "${entry.content.authorName}", published: false, publishedAt: "${entry.content.publishedAt}", archivedAt: "${generate.timeiso}", deletedAt: "", createdAt: "${entry.content.createdAt}", updatedAt: "${generate.timeiso}", version: 1}} confirm={title: :admin-admin-archive-title, message: :admin-admin-archive-msg} onSuccessToast={intent: success, message: "$t(admin.archived-ok)", duration: 3000} style={borderRadius: "var(--radius-md, 8px)"}
            action studio-unpublish -> exec "/.actions/delete" variant=destructive size=sm icon=trash label=:admin-admin-unpublish path="/instance/app/arcblog/posts/${entry.content.slug}.json" confirm={title: :admin-admin-unpublish-title, message: :admin-admin-unpublish-msg} onSuccessToast={intent: success, message: "$t(admin.unpublished-ok)", duration: 3000} style={borderRadius: "var(--radius-md, 8px)"}
          }
        }
        h3 :admin-group-drafts level=3 style={fontSize: "var(--type-body)"}
        afs-list studio-drafts layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false emptyText=:admin-content-empty autoSelect=false clickMode=none from "/instance/app/arcblog/drafts" style={flexShrink: 0} {
          row draftRow cross=start role=item style={background: "transparent", padding: "8px 0", borderBottom: "1px solid var(--color-border)"} {
            view draftLink gap=xs layout=inline href="/preview/${entry.content.slug}" target=_blank size={flex: 1} style={display: block, textDecoration: none, color: inherit, cursor: pointer, minWidth: 0} {
              h3 "${entry.content.title}" style={fontSize: "var(--type-body)"}
              row gap=xs cross=center {
                p "${entry.content.status}" scale=sm intent=muted
                p "${entry.content.category}" scale=sm intent=muted style={textTransform: capitalize}
              }
            }
