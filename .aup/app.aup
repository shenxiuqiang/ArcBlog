                  p "${entry.content.relation}" scale=sm
                  p "${entry.content.direction}" scale=sm intent=muted
                  p "${entry.content.status}" scale=sm intent=muted
                  p "${entry.content.freshness.state}" scale=sm intent=muted
                }
              }
              action hub-approve -> exec "/.actions/write" variant=primary size=sm label=:hub-admin-approve args={path: "${entry.path}", content: {id: "${entry.content.id}", hubDid: "${entry.content.hubDid}", endpoint: "${entry.content.endpoint}", status: "${entry.content.status}", relation: indexed, direction: "${entry.content.direction}", removedAt: "", registeredAt: "${entry.content.registeredAt}", updatedAt: "${generate.timeiso}", sync: "${entry.content.sync}"}} confirm={title: :hub-admin-approve-title, message: :hub-admin-approve-msg} onSuccessToast={intent: success, message: "$t(hub-admin.approved-ok)", duration: 3000} style={borderRadius: "var(--radius-md, 8px)"}
              action hub-reject -> exec "/.actions/write" variant=secondary size=sm label=:hub-admin-reject args={path: "${entry.path}", content: {id: "${entry.content.id}", hubDid: "${entry.content.hubDid}", endpoint: "${entry.content.endpoint}", status: "${entry.content.status}", relation: removed, direction: "${entry.content.direction}", removedAt: "${generate.timeiso}", registeredAt: "${entry.content.registeredAt}", updatedAt: "${generate.timeiso}", sync: "${entry.content.sync}"}} confirm={title: :hub-admin-reject-title, message: :hub-admin-reject-msg} onSuccessToast={intent: success, message: "$t(hub-admin.rejected-ok)", duration: 3000} style={borderRadius: "var(--radius-md, 8px)"}
              action hub-purge -> exec "/.actions/delete" variant=destructive size=sm icon=trash label=:hub-admin-purge path="${entry.path}" confirm={title: :hub-admin-purge-title, message: :hub-admin-purge-msg} onSuccessToast={intent: success, message: "$t(hub-admin.purged-ok)", duration: 2500} style={borderRadius: "var(--radius-md, 8px)"}
            }
          }
          p :hub-admin-relations-legend scale=sm intent=muted
        }
        view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px", flexShrink: 0} {
          h3 :hub-admin-cli-title level=3 style={fontSize: "var(--type-body)"}
          p :hub-admin-cli-desc intent=muted
          p "node scripts/arcblog-network.mjs hub add --hub-did <did>" scale=sm style={fontFamily: "monospace"}
          p "node scripts/arcblog-network.mjs hub index rebuild" scale=sm style={fontFamily: "monospace"}
        }
        view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px", flexShrink: 0} {
          h3 :hub-admin-index-card level=3 style={fontSize: "var(--type-body)"}
          afs-list hub-index layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false emptyText=:hub-admin-index-empty autoSelect=false clickMode=none from "/instance/app/arcblog/hub/index" {
            row gap=sm cross=center {
              view gap=xs style={flex: "1 1 0%"} {
                p "${entry.content.title}" scale=lg
                p "${entry.content.postId} · v${entry.content.version}" scale=sm intent=muted
              }
              p "${entry.content.status}" scale=sm intent=muted style={flexGrow: 0}
            }
          }
        }
      }
      }
      }
      view console-section-media-admin label="Media" style={height: "100%", minHeight: 0} {
        view gap=lg visible=$session.authenticated style={height: "100%", minHeight: 0} {
        view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px"} {
          h2 :media-admin-title level=2 style={fontSize: "var(--type-subheading)"}
          p :media-admin-desc intent=muted
        }
        view console-scroll-media-admin gap=sm size={flex: 1} style={overflowY: "auto"} {
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px", flexShrink: 0} {
        p :media-admin-admin-only scale=sm intent=muted visible="!$session.authenticated"
        view ops-media-gate visible=$session.authenticated {
          afs-list ops-media layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none emptyText=:media-admin-media-empty from "/instance/app/arcblog/media" {
            row opsMediaRow role=item gap=xs style={background: "transparent", borderBottom: "1px solid var(--color-border)", padding: "8px 0"} {
              h3 "${entry.content.id}"
              p "${entry.content.mimeType}" scale=sm intent=muted
            }
          }
        }
        p :media-admin-media-empty scale=sm intent=muted
      }
        }
        }
      }
      view console-section-agent-admin label="Agents" style={height: "100%", minHeight: 0} {
        view gap=lg visible=$session.authenticated style={height: "100%", minHeight: 0} {
        view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px"} {
          h2 :agent-admin-title level=2 style={fontSize: "var(--type-subheading)"}
          p :agent-admin-desc intent=muted
        }
        view console-scroll-agent-admin gap=sm size={flex: 1} style={overflowY: "auto"} {
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px", flexShrink: 0} {
        p :agent-admin-admin-only scale=sm intent=muted visible="!$session.authenticated"
        view ops-agent-gate visible=$session.authenticated {
          afs-list ops-agent layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none emptyText=:agent-admin-agent-grants-empty from "/instance/app/arcblog/config/agent-grants" {
            row opsAgentRow role=item gap=xs style={background: "transparent", borderBottom: "1px solid var(--color-border)", padding: "8px 0"} {
              p "${entry.content.agentDid}" scale=sm style={fontFamily: "monospace"}
              p "${entry.content.capabilities}" scale=sm
              p :agent-admin-agent-expires scale=sm intent=muted
              view style={fontSize: "var(--type-small)", color: "var(--color-dim)"} {
                time mode=display value="${entry.content.expiresAt}" timeMode=relative
              }
            }
          }
        }
        p :agent-admin-agent-grants-empty scale=sm intent=muted
        p :agent-admin-agent-closed scale=sm intent=muted
        p :agent-admin-mutations scale=sm intent=muted
      }
        }
        }
      }
      view console-section-policy-admin label="Policy" style={height: "100%", minHeight: 0} {
        view gap=lg visible=$session.authenticated style={height: "100%", minHeight: 0} {
        view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px"} {
          h2 :policy-admin-title level=2 style={fontSize: "var(--type-subheading)"}
          p :policy-admin-desc intent=muted
        }
        view console-scroll-policy-admin gap=sm size={flex: 1} style={overflowY: "auto"} {
      view console-grid-policy-admin style={display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(520px, 1fr))", gap: "14px", flexShrink: 0, alignItems: "start"} {
        view gap=sm propBind={policy: "/instance/app/arcblog/economy/policies/active.json"} style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px", flexShrink: 0} {
          h2 :policy-admin-policy level=2 style={fontSize: "var(--type-body)"}
          row opsPolicyRow gap=xs {
            p :policy-admin-policy-split scale=sm intent=muted
            p "${state.policy.creator} / ${state.policy.hub} / ${state.policy.protocol}" scale=sm
            p :policy-admin-policy-adapter scale=sm intent=muted
            p "${state.policy.paymentAdapter}" scale=sm
          }
          p :policy-admin-policy-empty scale=sm intent=muted
        }
        view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px", flexShrink: 0} {
          h2 :policy-admin-products level=2 style={fontSize: "var(--type-body)"}
            afs-list ops-products layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none emptyText=:policy-admin-products-empty from "/instance/app/arcblog/economy/products" {
              row opsProductRow role=item gap=xs style={background: "transparent", borderBottom: "1px solid var(--color-border)", padding: "8px 0"} {
                h3 "${entry.content.id}"
                p :policy-admin-product-price scale=sm intent=muted
                p "${entry.content.priceAmount} ${entry.content.priceAsset}" scale=sm
              }
            }
          p :policy-admin-products-empty scale=sm intent=muted
        }
      }
        }
        }
      }
      view console-section-access-admin label="Access" style={height: "100%", minHeight: 0} {
        view gap=lg visible=$session.authenticated style={height: "100%", minHeight: 0} {
        view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px"} {
          h2 :access-admin-title level=2 style={fontSize: "var(--type-subheading)"}
          p :access-admin-desc intent=muted
        }
        view console-scroll-access-admin gap=sm size={flex: 1} style={overflowY: "auto"} {
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", boxShadow: "none", padding: "14px", flexShrink: 0} {
        p :access-admin-admin-only scale=sm intent=muted visible="!$session.authenticated"
        view ops-grants-gate visible=$session.authenticated {
          afs-list ops-grants layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none emptyText=:access-admin-grants-empty from "/instance/app/arcblog/economy/access-grants" {
            row opsGrantRow role=item gap=xs style={background: "transparent", borderBottom: "1px solid var(--color-border)", padding: "8px 0"} {
              p "${entry.content.contentId}" scale=sm
              p :access-admin-grant-reader scale=sm intent=muted
              p "${entry.content.readerDid}" scale=sm
            }
          }
        }
        p :access-admin-grants-empty scale=sm intent=muted
      }
        }
        }
      }
      view console-section-compose label="Write" style={height: "100%", minHeight: 0} {
        view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
          h3 :compose-checks level=3
          p :compose-checks-desc intent=muted
        }
        view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
          h3 :compose-meta level=3
          input type=text label=:compose-f-title name=title required=true state={value: ""}
          input type=text label=:compose-f-slug name=slug required=true state={value: ""}
          p :compose-slug-hint intent=muted scale=caption
          input type=select label=:compose-category name=category options=[technology, design, life] state={value: technology}
          input type=text label=:compose-tags name=tags state={value: ""}
          input type=text label=:compose-f-summary name=summary state={value: ""}
          input type=text label=:compose-f-cover name=coverImage state={value: ""}
          p :compose-cover-hint intent=muted scale=caption
        }
        view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
          h3 :compose-seo level=3
          p :compose-seo-desc intent=muted
          input type=text label="SEO Title" name=seoTitle state={value: ""}
          input type=text label="SEO Description" name=seoDescription state={value: ""}
          input type=text label="OG Title" name=ogTitle state={value: ""}
          input type=text label="OG Description" name=ogDescription state={value: ""}
          input type=text label="OG Image" name=ogImage state={value: ""}
        }
        view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
          input type=textarea label=:compose-f-body name=body required=true state={value: ""}
        }
        row gap=sm {
          action save-draft -> exec "/.actions/write" variant=secondary label=:compose-save-draft args={path: "/instance/app/arcblog/drafts/${args.slug}.json", content: {title: "${args.title}", slug: "${args.slug}", summary: "${args.summary}", body: "${args.body}", coverImage: "${args.coverImage}", images: [], tags: "${args.tags}", category: "${args.category}", seoTitle: "${args.seoTitle}", seoDescription: "${args.seoDescription}", ogTitle: "${args.ogTitle}", ogDescription: "${args.ogDescription}", ogImage: "${args.ogImage}", status: draft, authorDid: "$session.did", authorName: "$session.displayName", published: false, publishedAt: "", archivedAt: "", deletedAt: "", createdAt: "${generate.timeiso}", updatedAt: "${generate.timeiso}", version: 1}} onSuccessToast={intent: success, message: "$t(compose.draft-saved)", duration: 3000}
          action publish-now -> exec "/.actions/write" variant=primary label=:compose-publish-now args={path: "/instance/app/arcblog/posts/${args.slug}.json", content: {title: "${args.title}", slug: "${args.slug}", summary: "${args.summary}", body: "${args.body}", coverImage: "${args.coverImage}", images: [], tags: "${args.tags}", category: "${args.category}", seoTitle: "${args.seoTitle}", seoDescription: "${args.seoDescription}", ogTitle: "${args.ogTitle}", ogDescription: "${args.ogDescription}", ogImage: "${args.ogImage}", status: published, authorDid: "$session.did", authorName: "$session.displayName", published: true, publishedAt: "${generate.timeiso}", archivedAt: "", deletedAt: "", createdAt: "${generate.timeiso}", updatedAt: "${generate.timeiso}", version: 1}} onSuccessToast={intent: success, message: "$t(compose.published-ok)", duration: 3000}
        }
        view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
          h3 :compose-images level=3
          p :compose-images-desc intent=muted
        }
        afs-dropzone
      }
      view console-section-appearance label="Appearance" style={height: "100%", minHeight: 0} {
      h2 :appearance-title level=2
      p :appearance-desc intent=muted
      auto-surface appearance-settings "Appearance" from "/instance/settings/arcblog"
      }
      }
      }
    }
    }
  }

  # Legacy URL alias: `?page=dashboard` predates the single-page console; the app
  # wrapper's console bridge hands the section over and redirects (spec §15.5).
  page dashboard "Dashboard" {
    view gap=sm {
      p "$t(wrapper.console-opening)" intent=muted
    }
  }
  # Legacy URL alias: `?page=admin` predates the single-page console; the app
  # wrapper's console bridge hands the section over and redirects (spec §15.5).
  page admin "Posts" {
    view gap=sm {
      p "$t(wrapper.console-opening)" intent=muted
    }
  }
  # Legacy URL alias: `?page=pages-admin` predates the single-page console; the app
  # wrapper's console bridge hands the section over and redirects (spec §15.5).
