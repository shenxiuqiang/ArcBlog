      pages-admin-f-title { en "Title" zh "标题" }
      pages-admin-gate-desc { en "Sign in with DID Wallet to manage standalone pages." zh "使用 DID Wallet 登录后管理独立页面。" }
      pages-admin-gate-title { en "Pages" zh "页面" }
