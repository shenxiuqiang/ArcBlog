      pages-admin-online-hint { en "Online pages are public at /pages/<slug>; they stay out of RSS and the Hub index." zh "上线页面公开于 /pages/<别名>；不进 RSS，也不被 Hub 索引。" }
      pages-admin-online-list { en "Online" zh "已上线" }
      pages-admin-published-ok { en "Page is online." zh "页面已上线。" }
      pages-admin-removed-ok { en "Removed." zh "已移除。" }
      pages-admin-title { en "Pages" zh "页面" }
      pages-admin-view-page { en "View" zh "查看" }
      policy-admin-desc { en "The split policy and the product catalogue." zh "分成策略与商品目录。" }
