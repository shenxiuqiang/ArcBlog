app "ArcBlog" {
  default index
  tone editorial
  palette natural
  mode light
  locales [en, zh]
  wrapper "wrapper.json"

  page console "Management" {
    i18n {
      gate-title { en "Management requires signing in" zh "管理后台需要登录" }
      gate-desc { en "Sign in with your DID to manage this ArcBlog instance." zh "使用你的 DID 登录后管理这个 ArcBlog 实例。" }
      login { en "Sign in" zh "登录" }
      access-admin-admin-only { en "Sign in as an administrator to see this list." zh "以管理员身份登录后可见该列表。" }
      access-admin-desc { en "Reading rights created when a paid order settles." zh "付费订单结算后生成的阅读权限。" }
      access-admin-gate-desc { en "Sign in with DID Wallet to view the economy and grants." zh "使用 DID Wallet 登录后查看经济与授权。" }
      access-admin-gate-title { en "Economy" zh "经济" }
      access-admin-grant-reader { en "Reader" zh "读者" }
      access-admin-grants-empty { en "Created automatically when a paid reading order settles." zh "付费阅读订单结算后自动生成。" }
      access-admin-login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      access-admin-title { en "Access grants" zh "访问授权" }
      admin-admin-archive { en "Archive" zh "归档" }
      admin-admin-archive-msg { en "This writes an archived copy to private drafts. The public post stays live until you remove it from public." zh "这会在私有 drafts 中写入一份 archived 副本。公开文章会继续保留，直到你执行从公开移除。" }
      admin-admin-archive-title { en "Archive this post?" zh "归档这篇文章？" }
      admin-admin-delete { en "Delete" zh "删除" }
      admin-admin-delete-msg { en "The record stays in drafts with status deleted and can be republished later." zh "记录会以 deleted 状态保留在 drafts 中，后续仍可重新发布。" }
      admin-admin-delete-title { en "Soft-delete this record?" zh "软删除这条记录？" }
      admin-admin-publish { en "Publish" zh "发布" }
      admin-admin-publish-msg { en "This publishes the current draft record. Deleted records can be republished." zh "这会发布当前草稿记录。deleted 状态记录也可以重新发布。" }
      admin-admin-publish-title { en "Publish this draft record?" zh "发布这条草稿记录？" }
      admin-admin-unpublish { en "Remove from public" zh "从公开移除" }
      admin-admin-unpublish-msg { en "Archive first keeps a copy in drafts. Removing from public deletes the original from public posts." zh "请先归档以在 drafts 保留副本。从公开移除会删除公开 posts 中的原记录。" }
      admin-admin-unpublish-title { en "Remove this post from public?" zh "将这篇文章从公开移除？" }
      admin-appearance { en "Appearance settings" zh "外观设置" }
      admin-archived-ok { en "Archived copy saved to drafts." zh "已在 drafts 中保存归档副本。" }
      admin-content { en "Your content" zh "你的内容" }
      admin-content-empty { en "Nothing here yet. Write your first post." zh "还没有内容。写下第一篇文章吧。" }
      admin-deleted-ok { en "Record soft-deleted." zh "记录已软删除。" }
      admin-edit { en "Edit" zh "编辑" }
      admin-gate-desc { en "Sign in with DID Wallet to view node health, Hubs, economy and agent state." zh "使用 DID Wallet 登录后查看节点健康、Hub、经济与 Agent 状态。" }
      admin-gate-title { en "Operations" zh "运维" }
      admin-group-drafts { en "Drafts & archived" zh "草稿与归档" }
      admin-group-published { en "Published" zh "已发布" }
      admin-lifecycle { en "Lifecycle controls" zh "生命周期控制" }
      admin-lifecycle-desc { en "Archive copies a post to the private drafts directory; Remove from public takes it off the public feed. Drafts can be published or soft-deleted from the row actions." zh "归档会把文章复制到私有 drafts 目录；从公开移除会把它从公开 feed 下线。草稿可在行内操作中发布或软删除。" }
      admin-login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      admin-new-post { en "New post" zh "新建文章" }
      admin-published-ok { en "Published." zh "已发布。" }
      admin-studio { en "Your studio" zh "你的工作室" }
      admin-studio-desc { en "Manage drafts, published stories, archived stories, and uploaded media from one wallet-bound workspace." zh "在一个与钱包绑定的工作区中管理草稿、已发布、已归档的文章和已上传的媒体。" }
      admin-unpublished-ok { en "Removed from public." zh "已从公开移除。" }
      agent-admin-admin-only { en "Sign in as an administrator to see this list." zh "以管理员身份登录后可见该列表。" }
      agent-admin-agent-closed { en "Default-closed (spec §130): settle_payment, change_wallet, change_role never run from the agent surface." zh "默认关闭（spec §130）：settle_payment、change_wallet、change_role 永不从 Agent 面执行。" }
      agent-admin-agent-expires { en "Expires" zh "到期" }
      agent-admin-agent-grants-empty { en "How to grant one: node scripts/arcblog-agent.mjs authorize --agent <did> --capability agent.write --ttl 30" zh "如何授权：node scripts/arcblog-agent.mjs authorize --agent <did> --capability agent.write --ttl 30" }
      agent-admin-desc { en "Time-boxed capability grants issued to agents." zh "发放给 Agent 的限时能力授权。" }
      agent-admin-gate-desc { en "Sign in with DID Wallet to view node health, Hubs, economy and agent state." zh "使用 DID Wallet 登录后查看节点健康、Hub、经济与 Agent 状态。" }
      agent-admin-gate-title { en "Operations" zh "运维" }
      agent-admin-login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      agent-admin-mutations { en "This console reports state only. Value-bearing mutations (settlement, wallets, roles, payments) stay deliberate CLI actions with a DID session." zh "本页只报告状态。涉及价值的写操作（结算、钱包、角色、支付）仍是需要 DID 会话的显式 CLI 动作。" }
      agent-admin-title { en "Agent grants" zh "Agent 授权" }
      appearance-desc { en "Theme, tone and palette for this site. Admins set the defaults; signed-in users can personalize their own theme." zh "本站的主题、风格与配色。管理员设置默认值；登录用户可以个性化自己的主题。" }
      appearance-gate-desc { en "Sign in with DID Wallet to set this site's palette and tone. Signed-in users can also personalize their own theme." zh "使用 DID Wallet 登录后可设置本站的配色与风格；登录用户还可以个性化自己的主题。" }
      appearance-gate-title { en "Appearance" zh "外观" }
      appearance-login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      appearance-title { en "Appearance" zh "外观" }
      categories-admin-cat-add { en "Add category" zh "添加分类" }
      categories-admin-cat-added { en "Category saved." zh "分类已保存。" }
      categories-admin-cat-empty { en "No categories yet." zh "还没有分类。" }
      categories-admin-cat-f-desc { en "Description" zh "描述" }
      categories-admin-cat-f-name { en "Name" zh "名称" }
      categories-admin-cat-f-slug { en "Slug" zh "标识（slug）" }
      categories-admin-cat-remove { en "Remove" zh "删除" }
      categories-admin-cat-remove-msg { en "Existing posts keep their category text, but the publish validator will reject it afterwards." zh "已有文章会保留其分类文本，但发布校验器之后会拒绝该分类。" }
      categories-admin-cat-remove-title { en "Remove this category?" zh "删除该分类？" }
      categories-admin-cat-removed { en "Category removed." zh "分类已删除。" }
      categories-admin-cat-slug-hint { en "Lowercase letters, digits and hyphens, e.g. technology." zh "小写字母、数字与连字符，例如 technology。" }
      categories-admin-desc { en "Taxonomy used by the publish validator and the public feed." zh "发布校验器与公开信息流使用的分类法。" }
      categories-admin-gate-desc { en "Sign in with DID Wallet to manage the site." zh "使用 DID Wallet 登录后管理站点。" }
      categories-admin-gate-title { en "Site" zh "站点" }
      categories-admin-login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      categories-admin-title { en "Categories" zh "分类" }
      compose-category { en "Category" zh "分类" }
      compose-checks { en "Pre-publish checks" zh "发布前检查" }
      compose-checks-desc { en "Title and slug are required. Publishing is immediately public; drafts stay private until published. Saving an existing slug overwrites that record." zh "标题和 slug 必填。发布即公开；草稿在发布前保持私有。相同 slug 会覆盖已有记录。" }
      compose-cover-hint { en "Shown as the card cover in the story list and at the top of the article. Upload via the Images panel below, then paste the URL here." zh "展示在文章列表的卡片封面和正文顶部。可先在下方图片面板上传，再把 URL 粘贴到这里。" }
      compose-draft-saved { en "Draft saved — preview it from the studio." zh "草稿已保存——可在工作室预览。" }
      compose-f-body { en "Body (Markdown)" zh "正文（Markdown）" }
      compose-f-cover { en "Cover image URL" zh "封面图 URL" }
      compose-f-slug { en "Slug" zh "Slug" }
      compose-f-summary { en "Summary" zh "摘要" }
      compose-f-title { en "Title" zh "标题" }
      compose-gate-desc { en "Sign in with DID Wallet to unlock the editor. Drafts stay in the private drafts directory until published." zh "使用 DID Wallet 登录以解锁编辑器。草稿保存在私有草稿目录中，直到发布。" }
      compose-gate-title { en "Publish with your wallet" zh "用钱包发布" }
      compose-images { en "Images" zh "图片" }
      compose-images-desc { en "Drop a cover or inline image here. Media is stored in the site file space; paste the resulting URL into Markdown: ![Alt text](URL)." zh "将封面或正文插图拖到这里。媒体文件保存在站点文件空间中；把生成的 URL 粘贴进 Markdown：![Alt text](URL)。" }
      compose-login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      compose-meta { en "Metadata" zh "元数据" }
      compose-publish-now { en "Publish" zh "发布" }
      compose-published-ok { en "Published." zh "已发布。" }
      compose-save-draft { en "Save draft" zh "存草稿" }
      compose-seo { en "SEO & social preview" zh "SEO 与社交分享预览" }
      compose-seo-desc { en "Optional: set seo title/description and OG title/description/image. Defaults fall back to post title, summary, and cover image." zh "可选：设置 SEO 标题/描述与 OG 标题/描述/图片。默认回退到文章标题、摘要和封面图。" }
      compose-slug-hint { en "Lowercase letters, numbers and dashes; used in the URL /posts/<slug>." zh "小写字母、数字和连字符；用于 URL /posts/<slug>。" }
      compose-tags { en "Tags" zh "标签" }
      dashboard-agents { en "Agent grants" zh "Agent 授权" }
      dashboard-agents-empty { en "No agent grants. Read-only tools are available by default; write tools need a grant." zh "还没有 Agent 授权。读工具默认可用；写工具需要授权。" }
      dashboard-capabilities-label { en "Capabilities" zh "能力" }
      dashboard-content { en "Recent published" zh "最近发布" }
      dashboard-content-empty { en "No published stories yet." zh "还没有已发布的文章。" }
      dashboard-desc { en "Node identity, roles, taxonomy and recent activity for this ArcBlog instance." zh "本 ArcBlog 实例的节点身份、角色、分类与近期动态。" }
      dashboard-economy { en "Economy" zh "经济" }
      dashboard-economy-empty { en "No orders yet. Products and tips appear here once readers pay." zh "还没有订单。读者付费后订单会出现在这里。" }
      dashboard-gate-desc { en "Sign in with DID Wallet to view node identity, roles, taxonomy and operations data." zh "使用 DID Wallet 登录后查看节点身份、角色、分类与运营数据。" }
      dashboard-gate-title { en "Dashboard" zh "仪表盘" }
      dashboard-login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      dashboard-node { en "Node" zh "节点" }
      dashboard-node-empty { en "No node profile yet. Run: node scripts/arcblog-node.mjs init" zh "还没有节点档案。运行：node scripts/arcblog-node.mjs init" }
      dashboard-q-ops { en "Operations" zh "运维" }
      dashboard-q-settings { en "Appearance" zh "外观" }
      dashboard-q-studio { en "Creator Studio" zh "创作者工作室" }
      dashboard-q-write { en "Write a post" zh "写文章" }
      dashboard-quick { en "Quick actions" zh "快捷操作" }
      dashboard-roles-label { en "Roles" zh "角色" }
      dashboard-title { en "Dashboard" zh "仪表盘" }
      feeds-admin-desc { en "Subscription and index surfaces generated from published content." zh "由已发布内容生成的订阅与索引入口。" }
      feeds-admin-feeds-agent { en "Agent access (llms.txt / MCP) is declared by the runtime." zh "Agent 访问（llms.txt / MCP）由运行时声明。" }
      feeds-admin-feeds-desc { en "These surfaces are always on and generated from published content — nothing to configure." zh "以下分发面由已发布内容自动生成，无需配置。" }
      feeds-admin-feeds-posts { en "Article index" zh "文章索引" }
      feeds-admin-feeds-rss { en "RSS feed" zh "RSS 订阅" }
      feeds-admin-gate-desc { en "Sign in with DID Wallet to view the distribution surfaces." zh "使用 DID Wallet 登录后查看分发面。" }
      feeds-admin-gate-title { en "Site" zh "站点" }
      feeds-admin-login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      feeds-admin-title { en "Feeds" zh "分发" }
      heroes-admin-content-empty { en "Nothing here yet. Write your first post." zh "还没有内容。写下第一篇文章吧。" }
      heroes-admin-desc { en "Home carousel records: title, image URL, target link and sort order." zh "首页轮播记录：标题、图片 URL、跳转链接与排序。" }
      heroes-admin-gate-desc { en "Sign in with DID Wallet to manage the site." zh "使用 DID Wallet 登录后管理站点。" }
      heroes-admin-gate-title { en "Site" zh "站点" }
      heroes-admin-hero-add { en "Add hero" zh "添加 Hero" }
      heroes-admin-hero-added { en "Hero added." zh "Hero 已添加。" }
      heroes-admin-hero-admin-desc { en "Heroes render as the homepage carousel. Each record needs a title, an image URL, and a target link; sort orders the slides ascending." zh "Hero 显示为首页轮播。每条记录需要标题、图片 URL 和跳转链接；sort 按升序决定播放顺序。" }
      heroes-admin-hero-delete { en "Delete" zh "删除" }
      heroes-admin-hero-delete-msg { en "This removes the hero record permanently." zh "将永久删除该 Hero 记录。" }
      heroes-admin-hero-delete-title { en "Delete hero?" zh "删除 Hero？" }
      heroes-admin-hero-deleted { en "Hero deleted." zh "Hero 已删除。" }
      heroes-admin-hero-dropzone-desc { en "Upload an image here, then paste the resulting URL into the form above." zh "把图片拖到这里上传，把得到的 URL 粘贴到上面的表单。" }
      heroes-admin-hero-f-desc { en "Description" zh "描述" }
      heroes-admin-hero-f-image { en "Image URL" zh "图片 URL" }
      heroes-admin-hero-f-sort { en "Sort order" zh "排序" }
      heroes-admin-hero-f-title { en "Title" zh "标题" }
      heroes-admin-hero-f-url { en "Link URL" zh "链接 URL" }
      heroes-admin-hero-form { en "Add hero" zh "添加 Hero" }
      heroes-admin-hero-id { en "ID (slug)" zh "ID（slug）" }
      heroes-admin-hero-id-hint { en "Lowercase letters, numbers and dashes; same ID overwrites." zh "小写字母、数字和连字符；相同 ID 会覆盖。" }
      heroes-admin-hero-list-empty { en "No heroes yet." zh "还没有 Hero。" }
      heroes-admin-hero-quickadd { en "Add to hero" zh "加入 Hero" }
      heroes-admin-hero-quickadd-hint { en "Click a post row to stage it below, then confirm. Title, summary, cover and /posts/<slug> link are copied automatically." zh "点击文章行将其暂存到下方，确认后加入。自动带标题、摘要、封面和 /posts/<slug> 链接。" }
      heroes-admin-hero-quickadd-title { en "Quick add from a post" zh "从文章快速加入" }
      heroes-admin-hero-quickadded { en "Added to heroes." zh "已加入 Hero。" }
      heroes-admin-login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      heroes-admin-title { en "Hero management" zh "Hero 管理" }
      hub-admin-approve { en "Approve" zh "通过" }
      hub-admin-approve-msg { en "The relation becomes indexed. Only meaningful for applied relations." zh "关系将变为 indexed。仅对 applied 状态的申请有意义。" }
      hub-admin-approve-title { en "Approve this application?" zh "通过这条申请？" }
      hub-admin-approved-ok { en "Approved — relation is indexed." zh "已通过——关系为 indexed。" }
      hub-admin-cli-desc { en "Relation ids are derived from the Hub DID by hashing, which the UI cannot compute — add a Studio and rebuild the index with:" zh "收录记录的 id 由 Hub DID 哈希派生，界面无法计算——主动收录与索引重建请使用：" }
      hub-admin-cli-title { en "Add & rebuild via CLI" zh "主动收录与索引重建（CLI）" }
      hub-admin-desc { en "Studio ↔ Hub relations and the derived content index. Indexing is the Hub's sovereignty: it only ever carries metadata, never the source body." zh "Studio ↔ Hub 收录关系与派生内容索引。索引是 Hub 的主权行为：只承载元数据，永不承载原文。" }
      hub-admin-gate-desc { en "Sign in with DID Wallet to curate Studios and the content index." zh "使用 DID Wallet 登录后管理 Studio 收录与内容索引。" }
      hub-admin-gate-title { en "Hub console" zh "Hub 管理" }
      hub-admin-index-card { en "Content index" zh "内容索引" }
      hub-admin-index-empty { en "Index is empty. Rebuild: node scripts/arcblog-network.mjs hub index rebuild" zh "索引为空。重建：node scripts/arcblog-network.mjs hub index rebuild" }
      hub-admin-login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      hub-admin-purge { en "Purge" zh "彻底删除" }
      hub-admin-purge-msg { en "Deletes the tombstone entirely. Prefer Terminate for auditability." zh "将记录彻底删除。为了可审计性，建议使用「终止」。" }
      hub-admin-purge-title { en "Purge this record?" zh "彻底删除这条记录？" }
      hub-admin-purged-ok { en "Record purged." zh "记录已删除。" }
      hub-admin-reject { en "Terminate" zh "终止" }
      hub-admin-reject-msg { en "The relation becomes a removed tombstone (kept for audit). Either side may terminate." zh "关系将变为 removed（保留 Tombstone 以供审计）。任一方都可终止。" }
      hub-admin-reject-title { en "Terminate this relation?" zh "终止这条关系？" }
      hub-admin-rejected-ok { en "Relation terminated (tombstone kept)." zh "关系已终止（保留 Tombstone）。" }
      hub-admin-relations { en "Studio relations" zh "收录关系" }
      hub-admin-relations-empty { en "No relations yet. A Studio applies with: node scripts/arcblog-network.mjs hub register --hub-did <did>" zh "还没有收录关系。Studio 申请：node scripts/arcblog-network.mjs hub register --hub-did <did>" }
      hub-admin-relations-legend { en "applied = awaiting review · indexed = live · removed = terminated (Tombstone kept) · freshness fresh/stale/never/offline (derived by `hub refresh`; offline = last sync failed)" zh "applied = 待审核 · indexed = 已收录 · removed = 已终止（保留 Tombstone）· 新鲜度 fresh/stale/never/offline（由 hub refresh 派生；offline = 最近一次同步失败）" }
      hub-admin-title { en "Hub console" zh "Hub 管理" }
      media-admin-admin-only { en "Sign in as an administrator to see this list." zh "以管理员身份登录后可见该列表。" }
      media-admin-desc { en "The upload index and where each file is referenced." zh "上传索引与引用关系。" }
      media-admin-gate-desc { en "Sign in with DID Wallet to view node health, Hubs, economy and agent state." zh "使用 DID Wallet 登录后查看节点健康、Hub、经济与 Agent 状态。" }
      media-admin-gate-title { en "Operations" zh "运维" }
      media-admin-login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      media-admin-media-empty { en "How to add one: node scripts/arcblog-media.mjs add" zh "如何添加：node scripts/arcblog-media.mjs add" }
      media-admin-title { en "Media" zh "媒体" }
      operations-desc { en "Live state of this node: health, discovery, Hubs, economy, media and agent grants." zh "本节点实时状态：健康、发现、Hub、经济、媒体与 Agent 授权。" }
      operations-discovery { en "Discovery document" zh "发现文档" }
      operations-discovery-empty { en "How to publish it: node scripts/arcblog-network.mjs discovery publish" zh "如何发布：node scripts/arcblog-network.mjs discovery publish" }
      operations-discovery-generated { en "Generated" zh "生成于" }
      operations-discovery-protocol { en "Protocol" zh "协议" }
      operations-discovery-transport { en "Transport" zh "传输" }
      operations-gate-desc { en "Sign in with DID Wallet to view node health, Hubs, economy and agent state." zh "使用 DID Wallet 登录后查看节点健康、Hub、经济与 Agent 状态。" }
      operations-gate-title { en "Operations" zh "运维" }
      operations-health { en "Node health" zh "节点健康" }
      operations-health-checked { en "Checked" zh "检查于" }
      operations-health-did { en "DID" zh "DID" }
      operations-health-status { en "Status" zh "状态" }
      operations-health-version { en "Blocklet version" zh "Blocklet 版本" }
      operations-hub-endpoint { en "Endpoint" zh "端点" }
      operations-hub-sync { en "Last sync" zh "最近同步" }
      operations-hub-version { en "Last version" zh "最后版本" }
      operations-hubs { en "Registered Hubs" zh "已注册 Hub" }
      operations-hubs-empty { en "How to add one: node scripts/arcblog-network.mjs hub register --hub-did <did>" zh "如何添加：node scripts/arcblog-network.mjs hub register --hub-did <did>" }
