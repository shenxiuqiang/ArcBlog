      pages-admin-desc { en "Standalone pages such as About. Two states only — online and offline; no post lifecycle, no RSS, no Hub indexing." zh "About 等独立页面。只有上线 / 下线两个状态——不复用文章生命周期，不进 RSS，不被 Hub 索引。" }
      pages-admin-f-body { en "Body (Markdown)" zh "正文（Markdown）" }
