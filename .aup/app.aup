  page index "Latest stories" {
    i18n {
      hero-title { en "A calmer place to read." zh "一个安静阅读的地方。" }
      hero-desc { en "Only published stories appear in the public feed. Every post remains DID-attributed and follows a draft → published → archived lifecycle." zh "公共 feed 只展示已发布的文章。每篇文章都带有 DID 署名，并遵循 草稿 → 发布 → 归档 的生命周期。" }
      hero-cta { en "Write a post" zh "开始写作" }
      hero-about { en "About this node" zh "关于本节点" }
      tf-all { en "All" zh "全部" }
      tf-tech { en "Technology" zh "技术" }
      tf-design { en "Design" zh "设计" }
      tf-life { en "Life" zh "生活" }
      feed { en "Latest published" zh "最新发布" }
      feed-empty { en "No published stories yet." zh "还没有已发布的文章。" }
      hero-empty { en "" zh "" }
      rss { en "Subscribe via RSS" zh "订阅 RSS" }
    }
    view page-topbar style={margin: "0 calc(-1 * var(--page-gutter, 32px))"} {
      app-header site-header variant=compact brand={title: ArcBlog, src: index} actions=[{kind: theme-toggle, icon: sun, ariaLabel: "$t(wrapper.theme-label)"}, {kind: locale-switcher, locales: [en, zh], labels: {en: EN, zh: "中文"}}, {kind: user-menu, items: [{id: console, label: "$t(wrapper.nav-console)", icon: "grid", exec: "console"}]}] events={user-menu-item: {target: _root, set: {page: $args.exec}}, nav-click: {target: _root, set: {page: $args.src}}}
    }
    view gap=lg {
      frame hero-carousel-frame src="/p/en/hero-carousel/" loading=eager aspectRatio="16 / 7" title="Hero carousel" sandbox="allow-top-navigation-by-user-activation"
      h2 :feed level=2
  afs-list published-feed layout=list itemStyle=row subscribe=true autoSelect=false showBreadcrumb=false showParent=false emptyText=:feed-empty clickMode=none from "/instance/app/arcblog/posts" {
        row postRow cross=stretch role=item style={padding: "0", border: "1px solid var(--color-border)", borderRadius: "var(--radius-lg, 12px)", marginBottom: "var(--space-block, 20px)", overflow: "hidden", minHeight: "176px"} {
          view postLink gap=sm layout=inline href="/posts/${entry.content.slug}" size={flex: 1} style={display: "flex", flexDirection: "column", justifyContent: "center", textDecoration: "none", color: "inherit", cursor: "pointer", minWidth: 0, padding: "24px 30px"} {
            h3 "${entry.content.title}" scale=lg style={margin: "0", fontSize: "clamp(1.3rem, 2vw, 1.62rem)", lineHeight: "1.25"}
            row gap=xs cross=center {
              p "${entry.content.category}" scale=sm intent=muted style={textTransform: capitalize}
              p "·" scale=sm intent=muted
              view style={fontSize: "var(--type-small)", color: "var(--color-dim)"} {
                time mode=display value="${entry.content.publishedAt}" timeMode=relative
              }
            }
            p "${entry.content.summary}" intent=muted scale=sm style={margin: "0"}
          }
          view postCover visible="${entry.content.coverImage}" layout=inline href="/posts/${entry.content.slug}" style={display: "block", flexGrow: 0, flexShrink: 0, flexBasis: "240px", width: "240px", alignSelf: "stretch", background: "url(${entry.content.coverImage}) center / cover no-repeat"} {
            text content=" "
          }
        }
      }
    }
    app-footer brand={title: ArcBlog, tagline: "$t(wrapper.tagline)", href: "/"} columns=[{links: [{label: "$t(wrapper.nav-about)", href: "/?page=about"}, {label: "$t(wrapper.nav-store)", href: "/store"}, {label: "$t(wrapper.nav-author)", href: "/?page=author"}, {label: "RSS", href: "/p/rss.xml", external: true}]}] bottomBar={copyright: "© 2026 ArcBlog"}
  }


  page compose-edit "Edit post" {
    i18n {
      title { en "Edit post" zh "编辑文章" }
      not-found { en "Draft not found." zh "草稿不存在。" }
      back { en "Back to studio" zh "返回工作室" }
      gate-title { en "Publish with your wallet" zh "用钱包发布" }
      gate-desc { en "Sign in with DID Wallet to unlock the editor. Drafts stay in the private drafts directory until published." zh "使用 DID Wallet 登录以解锁编辑器。草稿保存在私有草稿目录中，直到发布。" }
      login { en "Sign in with DID Wallet" zh "使用 DID Wallet 登录" }
      meta { en "Metadata" zh "元数据" }
      f-title { en "Title" zh "标题" }
      f-slug { en "Slug" zh "Slug" }
      slug-hint { en "Lowercase letters, numbers and dashes; used in the URL /posts/<slug>." zh "小写字母、数字和连字符；用于 URL /posts/<slug>。" }
      f-summary { en "Summary" zh "摘要" }
      f-cover { en "Cover image URL" zh "封面图 URL" }
      cover-hint { en "Shown as the card cover in the story list and at the top of the article. Upload via the Images panel below, then paste the URL here." zh "展示在文章列表的卡片封面和正文顶部。可先在下方图片面板上传，再把 URL 粘贴到这里。" }
      f-body { en "Body (Markdown)" zh "正文（Markdown）" }
      category { en "Category" zh "分类" }
      tags { en "Tags" zh "标签" }
      save-draft { en "Save draft" zh "存草稿" }
      publish-now { en "Publish" zh "发布" }
      seo { en "SEO & social preview" zh "SEO 与社交分享预览" }
      seo-desc { en "Optional: set seo title/description and OG title/description/image. Defaults fall back to post title, summary, and cover image." zh "可选：设置 SEO 标题/描述与 OG 标题/描述/图片。默认回退到文章标题、摘要和封面图。" }
      images { en "Images" zh "图片" }
      images-desc { en "Drop a cover or inline image here. Media is stored in the site file space; paste the resulting URL into Markdown: ![Alt text](URL)." zh "将封面或正文插图拖到这里。媒体文件保存在站点文件空间中；把生成的 URL 粘贴进 Markdown：![Alt text](URL)。" }
      editing { en "Editing" zh "编辑中" }
      publish-hint { en "Published. The draft copy is still in studio drafts — delete it there when done." zh "已发布。草稿副本仍保留在工作室草稿列表中，可随后删除。" }
    }
    view gap=lg propBind={post: "/instance/app/arcblog/drafts/$params.slug.json"} {
      view gap=md visible="!$session.authenticated" style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
        h2 :gate-title level=2
        p :gate-desc intent=info
        action -> navigate "/.well-known/service/login?return_to=%2F%3Fpage%3Dadmin&cancel_to=%2F%3Fpage%3Dadmin" variant=primary label=:login
      }
      view gap=lg visible=$session.authenticated {
        view gap=md visible="!$state.post" style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
          h2 :title level=2
          p :not-found intent=muted
          action compose-edit-back href="/?page=console#admin" variant=ghost label=:back
        }
        view gap=lg visible="$state.post" {
          view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
            h3 "$t(compose-edit.editing)" level=3
            p "${state.post.slug}" intent=muted scale=caption
          }
          view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
            h3 :meta level=3
            input type=text label=:f-title name=title required=true value="${state.post.title}"
            input type=text label=:f-slug name=slug required=true value="${state.post.slug}"
            p :slug-hint intent=muted scale=caption
            input type=select label=:category name=category options=[technology, design, life] value="${state.post.category}"
            input type=text label=:tags name=tags value="${state.post.tags}"
            input type=text label=:f-summary name=summary value="${state.post.summary}"
            input type=text label=:f-cover name=coverImage value="${state.post.coverImage}"
            p :cover-hint intent=muted scale=caption
          }
          view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
            h3 :seo level=3
            p :seo-desc intent=muted
            input type=text label="SEO Title" name=seoTitle value="${state.post.seoTitle}"
            input type=text label="SEO Description" name=seoDescription value="${state.post.seoDescription}"
            input type=text label="OG Title" name=ogTitle value="${state.post.ogTitle}"
            input type=text label="OG Description" name=ogDescription value="${state.post.ogDescription}"
            input type=text label="OG Image" name=ogImage value="${state.post.ogImage}"
          }
          view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
            input type=textarea label=:f-body name=body required=true value="${state.post.body}"
          }
          row gap=sm {
            action save-draft -> exec "/.actions/write" variant=secondary label=:save-draft args={path: "/instance/app/arcblog/drafts/${args.slug}.json", content: {title: "${args.title}", slug: "${args.slug}", summary: "${args.summary}", body: "${args.body}", coverImage: "${args.coverImage}", images: [], tags: "${args.tags}", category: "${args.category}", seoTitle: "${args.seoTitle}", seoDescription: "${args.seoDescription}", ogTitle: "${args.ogTitle}", ogDescription: "${args.ogDescription}", ogImage: "${args.ogImage}", status: draft, authorDid: "${state.post.authorDid}", authorName: "${state.post.authorName}", published: false, publishedAt: "", archivedAt: "", deletedAt: "", createdAt: "${state.post.createdAt}", updatedAt: "${generate.timeiso}", version: "${state.post.version}"}} onSuccessToast={intent: success, message: "$t(compose.draft-saved)", duration: 3000}
            action publish-now -> exec "/.actions/write" variant=primary label=:publish-now args={path: "/instance/app/arcblog/posts/${args.slug}.json", content: {title: "${args.title}", slug: "${args.slug}", summary: "${args.summary}", body: "${args.body}", coverImage: "${args.coverImage}", images: [], tags: "${args.tags}", category: "${args.category}", seoTitle: "${args.seoTitle}", seoDescription: "${args.seoDescription}", ogTitle: "${args.ogTitle}", ogDescription: "${args.ogDescription}", ogImage: "${args.ogImage}", status: published, authorDid: "${state.post.authorDid}", authorName: "${state.post.authorName}", published: true, publishedAt: "${generate.timeiso}", archivedAt: "", deletedAt: "", createdAt: "${state.post.createdAt}", updatedAt: "${generate.timeiso}", version: "${state.post.version}"}} onSuccessToast={intent: success, message: "$t(compose-edit.publish-hint)", duration: 3000}
          }
          view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
            h3 :images level=3
            p :images-desc intent=muted
          }
          afs-dropzone
        }
      }
    }
  }

  page reader "Read" {
    i18n {
      title { en "Article" zh "文章" }
      desc { en "This surface renders only published post records (status=published). Body remains Markdown at rest and is sanitized at render time." zh "此页面只渲染已发布的文章（status=published）。正文以 Markdown 存储，渲染时经过消毒。" }
      not-found { en "Post not found." zh "文章不存在。" }
      back { en "Back to latest stories" zh "返回最新文章" }
      paid-title { en "Paid content" zh "付费内容" }
      paid-notice { en "This is a paid article. The full text is released after purchase — it is never shipped to your browser before that." zh "这是一篇付费文章。购买后才会下发全文——在此之前正文不会送达你的浏览器。" }
    }
    view page-topbar style={margin: "0 calc(-1 * var(--page-gutter, 32px))"} {
      app-header site-header variant=compact brand={title: ArcBlog, src: index} actions=[{kind: theme-toggle, icon: sun, ariaLabel: "$t(wrapper.theme-label)"}, {kind: locale-switcher, locales: [en, zh], labels: {en: EN, zh: "中文"}}, {kind: user-menu, items: [{id: console, label: "$t(wrapper.nav-console)", icon: "grid", exec: "console"}]}] events={user-menu-item: {target: _root, set: {page: $args.exec}}, nav-click: {target: _root, set: {page: $args.src}}}
    }
    view gap=lg propBind={post: "/instance/app/arcblog/posts/$params.slug.json"} {
      row gap=sm {
        view reader-back href="/posts" style={cursor: "pointer", color: "var(--color-dim)"} {
          p :back scale=sm
        }
      }
      view gap=md visible="!$state.post" style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
        h2 :title level=2
        p :not-found intent=muted
      }
      view reader-article gap=md visible="$state.post" {
        view reader-cover visible="${state.post.coverImage}" style={minHeight: "280px", borderRadius: "var(--radius-lg, 12px)", background: "var(--color-border) url(${state.post.coverImage}) center / cover no-repeat"} {
          text content=" "
        }
        h1 reader-title "${state.post.title}" level=1 scale=display
        row gap=xs cross=center {
          p "${state.post.authorName}" scale=sm intent=muted
          view style={fontSize: "var(--type-small)", color: "var(--color-dim)"} {
            time mode=display value="${state.post.publishedAt}" timeMode=relative
          }
          p "${state.post.category}" scale=sm intent=muted style={textTransform: capitalize}
        }
        text reader-body format=markdown content="${state.post.body}"
        view gap=md visible="${state.post.previewOnly}" style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
          h3 :paid-title level=3
          p "${state.post.summary}"
          p :paid-notice intent=muted scale=sm
        }
      }
    }
    app-footer brand={title: ArcBlog, tagline: "$t(wrapper.tagline)", href: "/"} columns=[{links: [{label: "$t(wrapper.nav-about)", href: "/?page=about"}, {label: "$t(wrapper.nav-store)", href: "/store"}, {label: "$t(wrapper.nav-author)", href: "/?page=author"}, {label: "RSS", href: "/p/rss.xml", external: true}]}] bottomBar={copyright: "© 2026 ArcBlog"}
  }


  page preview "Draft preview" {
    i18n {
      back-home { en "Back to latest stories" zh "返回最新文章" }
      title { en "Preview" zh "预览" }
      notice { en "Draft preview — this record is not public." zh "草稿预览 — 该记录未公开。" }
      not-found { en "Preview not found." zh "预览不存在。" }
      back { en "Back to studio" zh "返回工作室" }
      edit { en "Edit" zh "编辑" }
      preview-publish { en "Publish" zh "发布" }
      published-ok { en "Published." zh "已发布。" }
      published-hint { en "Published. The draft copy is still in studio drafts — remove it when done." zh "已发布。草稿副本仍保留在工作室草稿列表中，可随后删除。" }
      preview-delete { en "Delete draft" zh "删除草稿" }
      preview-delete-title { en "Delete this draft?" zh "删除这篇草稿？" }
      preview-delete-msg { en "The record stays in the archive with status deleted (soft delete)." zh "记录将以 deleted 状态保留（软删除）。" }
      deleted-ok { en "Draft deleted." zh "草稿已删除。" }
    }
    view page-topbar style={margin: "0 calc(-1 * var(--page-gutter, 32px))"} {
      app-header site-header variant=compact brand={title: ArcBlog, src: index} actions=[{kind: theme-toggle, icon: sun, ariaLabel: "$t(wrapper.theme-label)"}, {kind: locale-switcher, locales: [en, zh], labels: {en: EN, zh: "中文"}}, {kind: user-menu, items: [{id: console, label: "$t(wrapper.nav-console)", icon: "grid", exec: "console"}]}] events={user-menu-item: {target: _root, set: {page: $args.exec}}, nav-click: {target: _root, set: {page: $args.src}}}
    }
    view gap=lg propBind={post: "/instance/app/arcblog/drafts/$params.slug.json"} {
      row gap=sm {
        view preview-back-studio visible=$session.authenticated {
          action preview-back href="#admin" variant=ghost label=:back
        }
        view preview-back-home href="/posts" visible="!$session.authenticated" style={cursor: "pointer", color: "var(--color-dim)"} {
          p :back-home
        }
        view preview-edit layout=inline href="/edit/${state.post.slug}" visible="$state.post" style={cursor: "pointer", color: "var(--color-dim)"} {
          p :edit scale=sm
        }
      }
      view gap=md visible="!$state.post" style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
        h2 :title level=2
        p :not-found intent=muted
      }
      view preview-article gap=md visible="$state.post" {
        row gap=sm {
          action preview-publish -> exec "/.actions/write" variant=primary label=:preview-publish args={path: "/instance/app/arcblog/posts/${state.post.slug}.json", content: {title: "${state.post.title}", slug: "${state.post.slug}", summary: "${state.post.summary}", body: "${state.post.body}", coverImage: "${state.post.coverImage}", images: [], tags: "${state.post.tags}", category: "${state.post.category}", seoTitle: "${state.post.seoTitle}", seoDescription: "${state.post.seoDescription}", ogTitle: "${state.post.ogTitle}", ogDescription: "${state.post.ogDescription}", ogImage: "${state.post.ogImage}", status: published, authorDid: "${state.post.authorDid}", authorName: "${state.post.authorName}", published: true, publishedAt: "${generate.timeiso}", archivedAt: "", deletedAt: "", createdAt: "${state.post.createdAt}", updatedAt: "${generate.timeiso}", version: 1}} onSuccessToast={intent: success, message: "$t(preview.published-hint)", duration: 3000}
          action preview-delete -> exec "/.actions/write" variant=destructive label=:preview-delete args={path: "/instance/app/arcblog/drafts/${state.post.slug}.json", content: {title: "${state.post.title}", slug: "${state.post.slug}", summary: "${state.post.summary}", body: "${state.post.body}", coverImage: "${state.post.coverImage}", images: [], tags: "${state.post.tags}", category: "${state.post.category}", seoTitle: "${state.post.seoTitle}", seoDescription: "${state.post.seoDescription}", ogTitle: "${state.post.ogTitle}", ogDescription: "${state.post.ogDescription}", ogImage: "${state.post.ogImage}", status: deleted, authorDid: "${state.post.authorDid}", authorName: "${state.post.authorName}", published: false, publishedAt: "${state.post.publishedAt}", archivedAt: "${state.post.archivedAt}", deletedAt: "${generate.timeiso}", createdAt: "${state.post.createdAt}", updatedAt: "${generate.timeiso}", version: 1}} confirm={title: :preview-delete-title, message: :preview-delete-msg} onSuccessToast={intent: success, message: "$t(preview.deleted-ok)", duration: 3000}
        }
        view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
          p :notice intent=info
        }
        view preview-cover visible="$state.post.coverImage" style={minHeight: "280px", borderRadius: "var(--radius-lg, 12px)", background: "var(--color-border) url(${state.post.coverImage}) center / cover no-repeat"} {
          text content=" "
        }
        h1 preview-title "${state.post.title}" level=1 scale=display
        row gap=xs cross=center {
          p "${state.post.status}" scale=sm intent=muted
          p "${state.post.authorName}" scale=sm intent=muted
          p "${state.post.category}" scale=sm intent=muted style={textTransform: capitalize}
        }
        text preview-body format=markdown content="${state.post.body}"
      }
    }
    app-footer brand={title: ArcBlog, tagline: "$t(wrapper.tagline)", href: "/"} columns=[{links: [{label: "$t(wrapper.nav-about)", href: "/?page=about"}, {label: "$t(wrapper.nav-store)", href: "/store"}, {label: "$t(wrapper.nav-author)", href: "/?page=author"}, {label: "RSS", href: "/p/rss.xml", external: true}]}] bottomBar={copyright: "© 2026 ArcBlog"}
  }

  page about "About" {
    i18n {
      title { en "About ArcBlog" zh "关于 ArcBlog" }
      desc { en "ArcBlog is a Blocklet blog: DID Wallet identity is the author credential, posts are Markdown-first, and images live in the Arc file space." zh "ArcBlog 是一个 Blocklet 博客：DID Wallet 身份即作者凭证，文章以 Markdown 优先，图片存放在 Arc 文件空间中。" }
      lifecycle { en "Lifecycle" zh "生命周期" }
      lifecycle-desc { en "Posts follow a draft → published → archived lifecycle with optimistic concurrency and a full audit trail. Soft deletes keep records recoverable." zh "文章遵循 草稿 → 发布 → 归档 的生命周期，带乐观并发控制和完整审计日志。软删除保证记录可恢复。" }
      rss { en "Subscribe via RSS" zh "订阅 RSS" }
    }
    view page-topbar style={margin: "0 calc(-1 * var(--page-gutter, 32px))"} {
      app-header site-header variant=compact brand={title: ArcBlog, src: index} actions=[{kind: theme-toggle, icon: sun, ariaLabel: "$t(wrapper.theme-label)"}, {kind: locale-switcher, locales: [en, zh], labels: {en: EN, zh: "中文"}}, {kind: user-menu, items: [{id: console, label: "$t(wrapper.nav-console)", icon: "grid", exec: "console"}]}] events={user-menu-item: {target: _root, set: {page: $args.exec}}, nav-click: {target: _root, set: {page: $args.src}}}
    }
    view gap=lg {
      view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
        h2 :title level=2
        p :desc
      }
      view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
        h3 :lifecycle level=3
        p :lifecycle-desc intent=muted
      }
      action -> navigate "/p/rss.xml" variant=secondary label=:rss
    }
    app-footer brand={title: ArcBlog, tagline: "$t(wrapper.tagline)", href: "/"} columns=[{links: [{label: "$t(wrapper.nav-about)", href: "/?page=about"}, {label: "$t(wrapper.nav-store)", href: "/store"}, {label: "$t(wrapper.nav-author)", href: "/?page=author"}, {label: "RSS", href: "/p/rss.xml", external: true}]}] bottomBar={copyright: "© 2026 ArcBlog"}
  }

  page store "Store" {
    i18n {
      title { en "Creator store" zh "创作者商店" }
      desc { en "Digital goods published by this node. The creator sets the price; buying happens with a DID wallet." zh "本节点发布的数字商品。价格由创作者定价；购买通过 DID 钱包完成。" }
      products { en "Products" zh "商品" }
      subscription { en "subscription" zh "订阅" }
      empty { en "No public products yet. Add one: node scripts/arcblog-economy.mjs product add --id <id> --creator-did <did> --price-amount <n>" zh "还没有公开商品。添加：node scripts/arcblog-economy.mjs product add --id <id> --creator-did <did> --price-amount <n>" }
      howto-title { en "How buying works" zh "购买流程" }
      howto-desc { en "A purchase is an Order paid through the configured adapter; settlement then splits the amount (creator / Hub / protocol), and a paid article unlocks through an Access Grant. This page is the catalogue only — there is no checkout here." zh "购买即一笔订单，通过配置的支付适配器支付；随后结算按分成（创作者 / Hub / 协议）拆分，付费文章凭 Access Grant 解锁。本页只是商品目录，不含收银台。" }
    }
    view page-topbar style={margin: "0 calc(-1 * var(--page-gutter, 32px))"} {
      app-header site-header variant=compact brand={title: ArcBlog, src: index} actions=[{kind: theme-toggle, icon: sun, ariaLabel: "$t(wrapper.theme-label)"}, {kind: locale-switcher, locales: [en, zh], labels: {en: EN, zh: "中文"}}, {kind: user-menu, items: [{id: console, label: "$t(wrapper.nav-console)", icon: "grid", exec: "console"}]}] events={user-menu-item: {target: _root, set: {page: $args.exec}}, nav-click: {target: _root, set: {page: $args.src}}}
    }
    view gap=lg {
      view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
        h2 :title level=2
        p :desc intent=muted
      }
      view gap=sm style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
        h3 :products level=3
        afs-list store-products layout=list itemStyle=row autoSelect=false clickMode=none subscribe=true showBreadcrumb=false showParent=false filter={field: "content.visibility", match: public} emptyText=:empty from "/instance/app/arcblog/economy/products" style={flexShrink: 0} {
          row storeProductRow role=item style={background: "transparent", borderBottom: "1px solid var(--color-border)", padding: "8px 0"} {
            view gap=xs size={flex: 1} style={minWidth: 0} {
              h3 "${entry.content.id}" style={fontSize: "var(--type-body)"}
              row gap=xs cross=center {
                p "${entry.content.priceAmount} ${entry.content.priceAsset}" scale=sm
                p "${entry.content.type}" scale=sm intent=muted
              }
            }
            p "content ${entry.content.contentId}" scale=sm intent=muted
          }
        }
      }
      view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
        h3 :howto-title level=3
        p :howto-desc intent=muted
      }
    }
    app-footer brand={title: ArcBlog, tagline: "$t(wrapper.tagline)", href: "/"} columns=[{links: [{label: "$t(wrapper.nav-about)", href: "/?page=about"}, {label: "$t(wrapper.nav-store)", href: "/store"}, {label: "$t(wrapper.nav-author)", href: "/?page=author"}, {label: "RSS", href: "/p/rss.xml", external: true}]}] bottomBar={copyright: "© 2026 ArcBlog"}
  }

  page page-view "Page" {
    i18n {
      title { en "Page" zh "页面" }
      not-found { en "Page not found." zh "页面不存在。" }
      back { en "Back to latest stories" zh "返回最新文章" }
    }
    view page-topbar style={margin: "0 calc(-1 * var(--page-gutter, 32px))"} {
      app-header site-header variant=compact brand={title: ArcBlog, src: index} actions=[{kind: theme-toggle, icon: sun, ariaLabel: "$t(wrapper.theme-label)"}, {kind: locale-switcher, locales: [en, zh], labels: {en: EN, zh: "中文"}}, {kind: user-menu, items: [{id: console, label: "$t(wrapper.nav-console)", icon: "grid", exec: "console"}]}] events={user-menu-item: {target: _root, set: {page: $args.exec}}, nav-click: {target: _root, set: {page: $args.src}}}
    }
    view gap=lg propBind={page: "/instance/app/arcblog/pages/$params.slug.json"} {
      row gap=sm {
        view page-back href="/posts" style={cursor: "pointer", color: "var(--color-dim)"} {
          p :back scale=sm
        }
      }
      view gap=md visible="!$state.page" style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
        h2 :title level=2
        p :not-found intent=muted
      }
      view page-article gap=md visible="$state.page" {
        h1 page-title "${state.page.title}" level=1 scale=display
        text page-body format=markdown content="${state.page.body}"
      }
    }
    app-footer brand={title: ArcBlog, tagline: "$t(wrapper.tagline)", href: "/"} columns=[{links: [{label: "$t(wrapper.nav-about)", href: "/?page=about"}, {label: "$t(wrapper.nav-store)", href: "/store"}, {label: "$t(wrapper.nav-author)", href: "/?page=author"}, {label: "RSS", href: "/p/rss.xml", external: true}]}] bottomBar={copyright: "© 2026 ArcBlog"}
  }















  page author "Author" {
    i18n {
      title { en "Author" zh "作者" }
      desc { en "Who publishes here: this node's DID-bound author identity." zh "谁在这里发布：与本节点 DID 绑定的作者身份。" }
      did { en "DID" zh "DID" }
      auth { en "Auth method" zh "认证方式" }
      roles { en "Roles" zh "角色" }
      stories { en "Stories" zh "文章" }
      stories-empty { en "No published stories yet." zh "还没有已发布的文章。" }
    }
    view page-topbar style={margin: "0 calc(-1 * var(--page-gutter, 32px))"} {
      app-header site-header variant=compact brand={title: ArcBlog, src: index} actions=[{kind: theme-toggle, icon: sun, ariaLabel: "$t(wrapper.theme-label)"}, {kind: locale-switcher, locales: [en, zh], labels: {en: EN, zh: "中文"}}, {kind: user-menu, items: [{id: console, label: "$t(wrapper.nav-console)", icon: "grid", exec: "console"}]}] events={user-menu-item: {target: _root, set: {page: $args.exec}}, nav-click: {target: _root, set: {page: $args.src}}}
    }
    view gap=lg propBind={profile: "/instance/app/arcblog/node/profile.json", identity: "/instance/app/arcblog/node/identity.json"} {
      view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
        h1 "${state.profile.name}" level=1
        p "${state.profile.description}" intent=muted
        p :did scale=sm intent=muted
        p "${state.profile.did}" scale=sm
        p :auth scale=sm intent=muted
        p "${state.identity.authMethod}" scale=sm
        p :roles scale=sm intent=muted
        p "${state.profile.roles}" scale=sm
      }
      view gap=md style={background: "var(--card-bg)", border: "var(--card-border)", borderRadius: "var(--radius-lg, 10px)", padding: "var(--space-block, 16px)"} {
        h2 :stories level=2
        afs-list author-posts layout=list itemStyle=row subscribe=true showBreadcrumb=false showParent=false autoSelect=false clickMode=none emptyText=:stories-empty from "/instance/app/arcblog/posts" {
          row authorPostRow role=item gap=xs style={background: "transparent", borderBottom: "1px solid var(--color-border)", padding: "8px 0"} {
            view authorPostLink layout=inline href="/posts/${entry.content.slug}" style={display: block, textDecoration: none, color: inherit} {
              h3 "${entry.content.title}" style={fontSize: "var(--type-body)"}
            }
            p "${entry.content.summary}" scale=sm intent=muted
          }
        }
      }
    }
    app-footer brand={title: ArcBlog, tagline: "$t(wrapper.tagline)", href: "/"} columns=[{links: [{label: "$t(wrapper.nav-about)", href: "/?page=about"}, {label: "$t(wrapper.nav-store)", href: "/store"}, {label: "$t(wrapper.nav-author)", href: "/?page=author"}, {label: "RSS", href: "/p/rss.xml", external: true}]}] bottomBar={copyright: "© 2026 ArcBlog"}
  }
}
