app "ArcBlog" {
  default index
  tone editorial
  palette natural
  mode light
  locales [en, zh]
  wrapper "wrapper.json"
  pages from "pages/*.aup"


  # Legacy URL alias: `?page=dashboard` predates the single-page console; the app
  # wrapper's console bridge hands the section over and redirects (spec §15.5).
  page dashboard "Dashboard" {
    view gap=sm {
      p "$t(wrapper.console-opening)" intent=muted
    }
  }
  # Legacy URL alias: `?page=admin` predates the single-page console; the app
  # wrapper's console bridge hands the section over and redirects (spec §15.5).
  page admin "Posts" {
    view gap=sm {
      p "$t(wrapper.console-opening)" intent=muted
    }
  }
  # Legacy URL alias: `?page=pages-admin` predates the single-page console; the app
  # wrapper's console bridge hands the section over and redirects (spec §15.5).
  page pages-admin "Pages" {
